null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fluffydrop.op.gp\\u0026rdid\\u003dcom.fluffydrop.op.gp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.fluffydrop.op.gp\"]],[\"qgJeGlwITEoTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCMAoaChRjb20uZmx1ZmZ5ZHJvcC5vcC5ncBABGAMSEgoECAEQAQoECAMQAQoECAQQAQ\\u003d\\u003d\"],null,[null,\"Fluffy Drop – A Cozy Puzzle Adventure Where Every Drop Counts!\\u003cbr\\u003e\\u003cbr\\u003eStep into the softest puzzle experience with Fluffy Drop, a delightful blend of color-matching strategy and satisfying drag-and-drop mechanics. Your mission is simple yet irresistibly engaging: guide fluffy balls into matching color zones, clear the board, and bask in the joy of perfectly planned moves. Whether you\\u0026#39;re a puzzle enthusiast or just looking for a relaxing brain break, Fluffy Drop wraps logic in charm and challenges in comfort. ☁️🎨\\u003cbr\\u003e\\u003cbr\\u003eWhy you’ll fall in love with Fluffy Drop:\\u003cbr\\u003e\\u003cbr\\u003eSatisfying Drag \\u0026amp; Drop Gameplay – Simple to learn, yet deeply rewarding to master.\\u003cbr\\u003e\\u003cbr\\u003eHundreds of Cozy Levels – From gentle warm-ups to brain-teasing puzzles, there’s always a new challenge waiting.\\u003cbr\\u003e\\u003cbr\\u003eVibrant Visuals \\u0026amp; Soothing Animations – Every color match comes to life with soft effects and smooth motion.\\u003cbr\\u003e\\u003cbr\\u003eStrategic Depth – Plan your moves, anticipate the next drop, and create chain reactions for maximum satisfaction.\\u003cbr\\u003e\\u003cbr\\u003ePlay Anywhere, Anytime – No Wi-Fi? No problem. Enjoy the full experience offline.\\u003cbr\\u003e\\u003cbr\\u003eReady to drop into a world of fluffy fun?\\u003cbr\\u003eDownload Fluffy Drop today and discover why every drop is a step toward pure puzzle joy! 🐻\\u200d❄️💖\"],\"UniRise Studio\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/9WmfKjOSAMtieg6Vl5zAm05tIICrIwNJHWYWQREztUlV0Vv5rxDq8NICYIREzHpvp4N3eDe1wAM2Jz4Dp9RpOw\"],null,[128,124,123,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,[null,\"Content is generally suitable for all ages. May contain minimal cartoon, fantasy or mild violence and/or infrequent use of mild language.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fluffydrop.op.gp\\u0026rdid\\u003dcom.fluffydrop.op.gp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $39.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Trivia\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"in.playsimple.wordsearch\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/BhSjXMNR8wZi48F4NWlRhskKyM_pa8DFNzisNTTa8_16uLNCk5nsZo_3fCmo1szCv05Qpe6VHNZBUsWBtSpjpA\"],null,[253,254,254,255],null,null,null,2],[[null,2,[2778,1284],[null,null,\"https://play-lh.googleusercontent.com/_2Mdn9g3byfFTH5WD6qvs1io-gFkFp3G6TP0y0nKxNLqrekpPOuA521sXbPpQqB_GeC6XuFvpsD2yahfAvGp0w\"]],[null,2,[2778,1284],[null,null,\"https://play-lh.googleusercontent.com/BGfjawbnEBgbemkN65sGNKw-5XuCo04tsBhlXyBxGT0nbYz916Lj21SJtfTY4UwfQKHzLNFqLAyUUk4Fjhwr\"]],[null,2,[2778,1284],[null,null,\"https://play-lh.googleusercontent.com/DuVu54XO98P2Ao2ZYpQIwYUcMb_jUvu4You-OhwxAlDjZkJJ6BXZlRN0KLrg5M-U2w0zce7Rts1O3FXP5Gh-EQ\"]],[null,2,[2778,1284],[null,null,\"https://play-lh.googleusercontent.com/L6YN1WPPb7Y6kv6BkDGdhuyOPP6x0BMDfdBS04M8rReUnkkTPNozleHG3HoIatu8mH2Lmpr_xMwu7t2PzmJo\"]]],\"Word Search Explorer\",[\"4.9\",4.9034467],\"Word\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003din.playsimple.wordsearch\\u0026rdid\\u003din.playsimple.wordsearch\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003din.playsimple.wordsearch\"]],[\"qgJiGmAITUoTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCNAoeChhpbi5wbGF5c2ltcGxlLndvcmRzZWFyY2gQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAQ\\u003d\"],null,[null,\"With Word Search Explorer embark on a wondrous quest of adventure and wisdom, where the fun never stops!\\u003cbr\\u003e\\u003cbr\\u003eThis FREE TO PLAY word game makes learning new words so easy and much more fun. Flex your brain, connect the letters and swipe your way through hundreds of word puzzles, while steadily growing your vocabulary and confidence for the challenges ahead!\\u003cbr\\u003e\\u003cbr\\u003eSuccessfully completing each puzzle will bring you closer to your next destination!\\u003cbr\\u003e\\u003cbr\\u003eBuckle-up and get ready to go on an endeavour that takes you through breathtaking landscapes while training your brain to become a TRUE champion of the mind!\\u003cbr\\u003e\\u003cbr\\u003eBelieve the hype, join thousands of word game enthusiasts and download Word Search Explorer today!\\u003cbr\\u003e\\u003cbr\\u003eHOW TO PLAY:\\u003cbr\\u003e\\u003cbr\\u003eAs easy as taking a walk in the park, find words that are hidden in the letter grid related to a common theme. Swipe your fingers to form the words that are hidden in plain sight. The puzzles get trickier as you progress while gaining more wisdom!\\u003cbr\\u003e\\u003cbr\\u003eGAME FEATURES:\\u003cbr\\u003e\\u003cbr\\u003e- FREE TO PLAY: Get this game for FREE and put your word game skills to the test\\u003cbr\\u003e- GUIDING HINTS: The game offers multiple hints which will guide and help you on your journey.\\u003cbr\\u003e- PLAY ANYTIME, ANYWHERE: Take a break and play offline wherever you want!\\u003cbr\\u003e- CHALLENGING PUZZLES: Easy to play, hard to master! A new challenge awaits for you after every puzzle\\u003cbr\\u003e- BOOSTS YOUR VOCABULARY: Improve your vocabulary as the game exposes you to a wide variety of words that will help you in your daily life\\u003cbr\\u003e- SYNC YOUR GAME PROGRESS: Login through facebook and sync your game progress across multiple devices\\u003cbr\\u003e\\u003cbr\\u003ePack your bags and get ready to Explore, Wander \\u0026amp; Discover. No need to wait, start playing Word Search Explorer and begin your voyage today!\"],\"PlaySimple Games\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/bu85q-jIe253HKf3M2y7kvrSdumFeLIjFSlCm0yfcDp-xI9UaaHsgjF2jcCSI3M_w6UktHOSMA5dHU7hva9a\"],null,[240,246,250,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8