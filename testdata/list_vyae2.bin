play-lh.googleusercontent.com/zGK0xKGkYMMJGGZSR5s2AiUHPOxT9KSGdDakHPN7xpszYND8gRRmvZvQY3dcbeMPW1Dxu4SP3mlwIBoIdbFwkbw\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/N1SF2sTydB0JOO_zRqMs6d5U2IdhE6LwlRy--o6oSGnuYRzKNrGPrwrzoWr-N33NaLIRthCLJ3gdL2TDrad7xA\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/5YcCoUAO-cqZj5zAXkXPI85y3iraRJ9tnWuyXJ0KnW18xLPZWNOQlBPtpv0RVoMVhRGu4IkzMCUbxm5GLtT8BQ\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/tXyr_NTDfhJeWslwCLMLI43Gjtg-IXx_Rt7x_v1SO51fE295iAGaJmRwX4CipKX04rpvmRPNs1g3dF7FE78o7Q\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/9209eLmVofbRWCBgGEcmfOvwpkeLY5ZkFsYouGKGuN_b5Ss33zaRK2Hhf9taqLsiX6EW9b9Q2Yb2baFZglhU\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/4laP1E_TzyMS_JKE4gYn0KovxfSTLbN4gmRXTn8egizyviCDiPH9ESv0qbi-z4lFMVccyniMopAo6CT82PbwhQ\"]]],\"Block Loop Shooter\",[\"4.5\",4.5485234],\"Puzzle\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dpuzzle.flow.blast\\u0026rdid\\u003dpuzzle.flow.blast\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dpuzzle.flow.blast\"]],[\"qgJkGmIIuQFKEwjK5+vmp/2UAxWjCbMGHSLLBov6ARcKFQjfrfPvo/mnjUMSCQoFZW4tVVMQALoCLQoXChFwdXp6bGUuZmxvdy5ibGFzdBABGAMSEgoECAEQAQoECAMQAQoECAQQAQ\\u003d\\u003d\"],null,[null,\"Block Loop Shooter is a fast-paced puzzle shooter where timing and color control are the key to victory. Blocks flow continuously along a conveyor system, and it’s your job to place shooters, aim carefully, and fire at the perfect moment to keep the flow moving.\\u003cbr\\u003e\\u003cbr\\u003eDesigned for quick sessions but challenging to master, Block Loop Shooter blends satisfying shooter mechanics with smart flow-control puzzles. The gameplay is simple to learn, yet increasingly intense as new block patterns, faster flows, and tricky color combinations appear.\\u003cbr\\u003e\\u003cbr\\u003eFeatures:\\u003cbr\\u003e- Color-based shooting with precise timing\\u003cbr\\u003e- Smooth, continuous flow gameplay\\u003cbr\\u003e- Increasing difficulty and dynamic block patterns\\u003cbr\\u003e- Satisfying blast effects and clean visuals\\u003cbr\\u003e- Easy to play, hard to master puzzle experience\\u003cbr\\u003e\\u003cbr\\u003eCan you keep the flow under control and blast through every jam?\\u003cbr\\u003e\\u003cbr\\u003eDownload Block Loop Shooter now and test your skills in this addictive color shooter puzzle.\"],\"Brave HK Limited\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Mi1OOIIkH-yB9oooSXPJy25tROR54YVYIlGJyzY65o3NTAhNl-OkIqnTc1sXb3a0Yj9HVvhimYZ0fgjN0AKKXw\"],null,[68,203,254,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dpuzzle.flow.blast\\u0026rdid\\u003dpuzzle.flow.blast\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $89.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,nu