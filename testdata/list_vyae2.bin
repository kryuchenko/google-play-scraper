ent.com/F9h-emrKGQJ23mNtDC6zwSfEak7ngGpQcT9XTVgEuuj_AGA0LJfvM4iHM8iwNLRtiVlRKDkogtYKs-Bw5I7Wtg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/xN69wMRSZLDVcoKqX11LkkIJMFcGBJACpeuyTbSCPkNjToWCys6B7YIYbsHSS2tdH8oxHIg2G_YR1atsW3oY\"]]],\"Idle Cat Gunner: Shooter RPG\",[\"4.6\",4.6174865],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Chodun.CatGunner\\u0026rdid\\u003dcom.Chodun.CatGunner\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.Chodun.CatGunner\"]],[\"qgJeGlwIMUoTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCMAoaChRjb20uQ2hvZHVuLkNhdEd1bm5lchABGAMSEgoECAEQAQoECAMQAQoECAQQBA\\u003d\\u003d\"],[[[null,null,null,[null,null,\"https://www.youtube.com/watch?v\\u003dom7pvunb_1I\"]],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/om7pvunb_1I/hqdefault.jpg\"]]]],[null,\"🐱 Tiny paws, MIGHTY guns! Welcome to the cutest idle cat shooter RPG ever!\\u003cbr\\u003e\\u003cbr\\u003eEver wondered what happens when adorable kitties pick up powerful guns? \\u003cbr\\u003ePure chaos. Pure cuteness. Pure addictive idle gameplay you can\\u0026#39;t put down.\\u003cbr\\u003e\\u003cbr\\u003eCollect cute kitties, merge devastating weapons, and rebirth your way to infinite power.\\u003cbr\\u003eYour fluffy gunner squad fights even when you\\u0026#39;re away — that\\u0026#39;s the magic of idle games!\\u003cbr\\u003ePerfect for cat moms, cat dads, and anyone who needs a satisfying break from reality.\\u003cbr\\u003e\\u003cbr\\u003eMeow-velous features await! 🎯\\u003cbr\\u003e\\u003cbr\\u003e▶ 25+ Adorable Kitty Heroes to Collect\\u003cbr\\u003eFrom fluffy snipers to shotgun-wielding tabbies — each kitty has its own personality and special abilities.\\u003cbr\\u003eCuteness + power + personality... what more could a cat lover ask for?\\u003cbr\\u003eBuild your dream squad and watch them become unstoppable!\\u003cbr\\u003e\\u003cbr\\u003e▶ 35+ Guns to Master — Cute Shooter, Real Firepower\\u003cbr\\u003ePistols, rifles, shotguns, miniguns! Your kitties auto-fire through enemies with pure feline precision.\\u003cbr\\u003ePew pew! Boom boom! Every shot feels SO satisfying in this idle shooter RPG.\\u003cbr\\u003eAdorable looks, devastating firepower — the gap is everything.\\u003cbr\\u003e\\u003cbr\\u003e▶ Gun Merge System — The Most Addictive Mechanic\\u003cbr\\u003eMerge identical guns to forge higher-tier weapons. The bigger the gun, the cuter the kitty holding it!\\u003cbr\\u003eThat sweet, sweet feeling of every successful merge... this is what idle RPG perfection feels like.\\u003cbr\\u003e\\u003cbr\\u003e▶ Rebirth System — Infinite Growth, Infinite Kitties\\u003cbr\\u003eHit milestone stages and rebirth for game-changing abilities.\\u003cbr\\u003eThe more you rebirth, the stronger your squad grows — classic idle game progression at its finest!\\u003cbr\\u003eOffline rewards keep your fluffy gunners earning power 24/7, even while you sleep.\\u003cbr\\u003e\\u003cbr\\u003e▶ Diverse Maps — From Cozy Forests to Snowy Peaks\\u003cbr\\u003eExplore forests, deserts, snowfields, and beyond with your gunner squad.\\u003cbr\\u003eBigger challenges, bigger rewards, bigger explosions await!\\u003cbr\\u003e\\u003cbr\\u003e🎮 This game is purr-fect for...\\u003cbr\\u003e\\u003cbr\\u003e✔ Cat moms and dads who can\\u0026#39;t walk past a kitty without saying \\u0026quot;awww\\u0026quot;\\u003cbr\\u003e✔ Idle game fans looking for their next addictive obsession\\u003cbr\\u003e✔ Shooter game enthusiasts who want something cuter than the usual\\u003cbr\\u003e✔ Busy people needing a satisfying break during commutes or coffee runs\\u003cbr\\u003e✔ Players who love merge mechanics and auto battle systems\\u003cbr\\u003e✔ Anyone who thinks \\u0026quot;cats with guns\\u0026quot; is the best concept ever\\u003cbr\\u003e✔ Fans of idle RPG, idle hero games, and casual one-hand gameplay\\u003cbr\\u003e\\u003cbr\\u003eReady to lead the cutest, deadliest army of kitties ever assembled?\\u003cbr\\u003eYour fluffy gunner squad is waiting. Time to make some noise! 🐱🔫💥\\u003cbr\\u003e\\u003cbr\\u003eDownload Idle Cat Gunner now!\\u003cbr\\u003e\\u003cbr\\u003e-----\\u003cbr\\u003e📩 Support: support@neptunecompany.kr \\u003cbr\\u003e📄 Terms of Service: https://neptunecompany.kr/gameterms\\u003cbr\\u003e🔒 Privacy Policy: https://neptunecompany.kr/gameprivacy\"],\"TREEPLLA\",\"500,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/1jFVH1ucrVd2ljIga96EmrnmuMiNHdGRJ2f03kj47KTtRdXVICiHZqz5bvCqsQCgRqsk5Mq4bGb6LuQqUloR\"],null,[109,129,63,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,[null,\"Content is generally suitable for all ages. May contain minimal cartoon, fantasy or mild violence and/or infrequent use of mild language.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Chodun.CatGunner\\u0026rdid\\u003dcom.Chodun.CatGunner\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $49.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,