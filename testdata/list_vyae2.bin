ll,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dio.supercent.weaponrpg\"]],[\"qgJgGl4IQUoTCMrn6+an/ZQDFaMJswYdIssGi/oBDwoNCAASCQoFZW4tVVMQALoCMgocChZpby5zdXBlcmNlbnQud2VhcG9ucnBnEAEYAxISCgQIARABCgQIAxABCgQIBBAE\"],[[[null,null,\"tc2FXCbMlj4\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:tc2FXCbMlj4?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:tc2FXCbMlj4\",null,null,null,null,\"AXH1eznb7mm0IDYDWfSxBQG7sWNwt-AJqe-x5RalLGBPh5jfHZxeP6YP4_YAd7LKBe9wlrZ-ocffJT9ymZBfsAWgDrP_svn4JmInHzH3Srtsqob2onIIss7OmlgSeJHYKPifefsYpWLLKHqg8imZQaoW9aI0TFUIUdyxb5rDONKSx8PNYSRwi8Cz9YuyY49612o8ghcyR6p_XYxiPcz8gB7bKCXxuMtjYZKrdidJT6W5LvHqblNx-HrQH1D46hbXytPtgx8YGh_qWSGccOYNK1jqxwXJQYSmbqLXajiKxrkMjGTNAHb4duO8q7QlKdUIfpI\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/tc2FXCbMlj4/hqdefault.jpg\"]]]],[null,\"⚔️ Survive the chaos and become the ultimate hero in XP Hero! 🔥\\u003cbr\\u003e\\u003cbr\\u003eEnter a mysterious world filled with monsters, darkness, and nonstop danger. Trapped in a deadly realm, your hero must fight to survive, grow stronger, and defeat every enemy standing in the way. Dive into an action-packed rpg game where fast combat, powerful upgrades, and thrilling boss fights await.\\u003cbr\\u003e\\u003cbr\\u003e⚡ Features ⚡\\u003cbr\\u003e👾 Face Powerful Enemies\\u003cbr\\u003e\\u003cbr\\u003eBattle through waves of monsters, deadly traps, and fast-moving threats. Every stage brings intense combat and new challenges that test your survival skills in this dark survival game.\\u003cbr\\u003e\\u003cbr\\u003e🔫 Unlock Powerful Weapons \\u0026amp; Skills\\u003cbr\\u003e\\u003cbr\\u003eEquip powerful weapons, from blades to firearms, and create your own combat style. Use each skill wisely, adapt to enemy patterns, and build the perfect setup for every battle.\\u003cbr\\u003e\\u003cbr\\u003e🗺️ Explore a Dark Fantasy World\\u003cbr\\u003e\\u003cbr\\u003eTravel across ruined lands, shadowy dungeons, and abandoned battlefields. Each area offers new enemies, fresh challenges, and valuable rewards in this immersive rpg game.\\u003cbr\\u003e\\u003cbr\\u003e👑 Defeat Massive Bosses\\u003cbr\\u003e\\u003cbr\\u003eTake on powerful bosses with deadly attack patterns and intense mechanics. Every boss fight is a true test of timing, strategy, and survival.\\u003cbr\\u003e\\u003cbr\\u003e⬆️ Upgrade Your Hero\\u003cbr\\u003e\\u003cbr\\u003eUpgrade weapons, improve abilities, and unlock new skill options as your hero grows stronger. The right upgrade can turn the tide of battle and help you survive even longer.\\u003cbr\\u003e\\u003cbr\\u003e⚡ Enjoy Fast-Paced Action Gameplay\\u003cbr\\u003e\\u003cbr\\u003eXP Hero blends fast combat, rewarding progression, and addictive gameplay into one exciting action game experience. Fight through nonstop danger and push forward with every run.\\u003cbr\\u003e\\u003cbr\\u003eFight, survive, explore, and upgrade your way through chaos.\\u003cbr\\u003eDefeat every enemy, conquer every boss, and become a living legend in XP Hero.\"],\"Supercent, Inc.\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/1i4YKyd5nLJ3WDeeUstNtHh4hKjAGUgkT5Iuj4tEel7bsXLqRaEJOgnFFWzII7OfU0w\"],null,[138,214,233,255]],null,[\"Everyone 10+\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/csiz76udPjXmaJddU_1sanHGlQAAbKkvlprK3DSUNmwu1nY3U6qnXRrI2IDMaivooYK1x11oxz3PEO4z\"]],[null,\"Fantasy Violence\"],[null,\"In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/bxs95MghtAOuZR_LPwVCUmUPYEvXsGVOH3chF1OCX0-Ns_S0qdHnzml2CGCgOGbYlftKsmt9gtpxLb8U\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[n