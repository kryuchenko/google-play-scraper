"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.cliffs.pro.cell.building.crazy.clever.craft\"]],[\"qgJ5GncIYUoTCMrn6+an/ZQDFaMJswYdIssGi/oBDwoNCAASCQoFZW4tVVMQALoCSwo1Ci9jb20uY2xpZmZzLnByby5jZWxsLmJ1aWxkaW5nLmNyYXp5LmNsZXZlci5jcmFmdBABGAMSEgoECAEQAQoECAMQAQoECAQQBA\\u003d\\u003d\"],null,[null,\"🧱 Block Crazy Robo World Craft – Unleash your creativity in a futuristic voxel universe!\\u003cbr\\u003eStep into an open-world sandbox where robots meet blocks. Craft, build, and explore limitless possibilities in a world full of tech, creativity, and imagination. Design futuristic bases, high-tech cities, and robotic landscapes in a fully customizable 3D environment.\\u003cbr\\u003e\\u003cbr\\u003e🔑 Key Features:\\u003cbr\\u003e\\u003cbr\\u003e🛠️ Build \\u0026amp; Create Freely\\u003cbr\\u003eConstruct anything you dream of! From robot factories and tech towers to epic cities and homes using hundreds of futuristic blocks.\\u003cbr\\u003e\\u003cbr\\u003e🤖 Futuristic Robo World\\u003cbr\\u003eExplore a world where technology and block-building collide! Discover robotic zones, digital landscapes, and secret AI labs.\\u003cbr\\u003e\\u003cbr\\u003e🔨 Craft \\u0026amp; Mine Resources\\u003cbr\\u003eCollect materials like metal, circuits, stone, and ores to craft tools, blocks, and robotic decorations.\\u003cbr\\u003e\\u003cbr\\u003e🎮 Simulation Gameplay\\u003cbr\\u003eExperience a smooth, fun, and intuitive simulator with controls optimized for all ages.\\u003cbr\\u003e\\u003cbr\\u003e🎨 Customize Your World\\u003cbr\\u003eChange terrains, install neon lights, add sci-fi decorations, and create your dream robotic world.\\u003cbr\\u003e\\u003cbr\\u003e👾 Survival \\u0026amp; Creative Modes\\u003cbr\\u003ePlay in Creative Mode to build freely or Survival Mode to gather resources and craft gear to thrive.\\u003cbr\\u003e\\u003cbr\\u003e🌐 Multiplayer Experience\\u003cbr\\u003eCollaborate with friends and build robot-themed worlds together in multiplayer mode.\\u003cbr\\u003e\\u003cbr\\u003e❓ Why Play Block Crazy Robo World Craft?\\u003cbr\\u003e\\u003cbr\\u003e🚀 Tech-Driven Creativity: Build cyber worlds with sci-fi blocks and robot elements.\\u003cbr\\u003e🎮 Fun for Everyone: Easy to play, suitable for kids, teens, and adults.\\u003cbr\\u003e🌍 Massive Open Sandbox: Travel through high-tech biomes while building futuristic creations.\\u003cbr\\u003e\\u003cbr\\u003e📥 Download Block Crazy Robo World Craft now and start building your robotic paradise today!\"],\"Prokids Studio\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/4pZjUkegkXk016tKezEG2mYLiSe7kLE_zCl6Ex31Ol7pzTj4XliI3qxDEw3cFXrBmw\"],null,[72,83,103,255]],null,[\"Everyone 10+\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/csiz76udPjXmaJddU_1sanHGlQAAbKkvlprK3DSUNmwu1nY3U6qnXRrI2IDMaivooYK1x11oxz3PEO4z\"]],[null,\"Fantasy Violence\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/bxs95MghtAOuZR_LPwVCUmUPYEvXsGVOH3chF1OCX0-Ns_S0qdHnzml2CGCgOGbYlftKsmt9gtpxLb8U\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.cliffs.pro.cell.building.crazy.clever.craft\\u0026rdid\\u003dcom.cliffs.pro.cell.building.crazy.clever.craft\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Simulation\"]],[null,null,null,[\"Sandbox\"]],[null,null,null,[\"Offline\"]],[nul