v3VLJdjyMFBeGtvkGSIJ0F5MOSq1lBX32kUpZVyZbAA5xfts_GP0_0A_zTSLH5PCXvSXi_GXe8y2jsC-n\"]],[null,2,[2752,2064],[null,null,\"https://play-lh.googleusercontent.com/7JXsLPW96pTNh_VexWKFmn-MEup121hC2odvd5J2fKZ-tZqhZYQ7ZKfxAn0Sbom-0urEkDwz-Wr_iSWCRuiM\"]],[null,2,[2752,2064],[null,null,\"https://play-lh.googleusercontent.com/Fn7bB20y-Zk2-NwUJAHQz9PweaS1pEokpsc8oajcHPYWVg8rbfunruSR76_0LL0BtvY2qhoit4hHDnCTYlWY\"]],[null,2,[2752,2064],[null,null,\"https://play-lh.googleusercontent.com/fCqaHId5dyoFt2NHytEwIcicaj7huXPqzqB6AUjLF4k7HFbhhLV0hjY4WX5_FobxV4-Jd8mAxVj8OKQR5GPW0A\"]],[null,2,[2752,2064],[null,null,\"https://play-lh.googleusercontent.com/i5oafPPjoRs0dBAfVleHr7tt4EIc-wMTUKBeBM5RhGfPg1dRLHUpodE4uIQPfcC4OtfktB1Wh8I4xPWIFXnHiQ\"]],[null,2,[2752,2064],[null,null,\"https://play-lh.googleusercontent.com/9JBv3VLJdjyMFBeGtvkGSIJ0F5MOSq1lBX32kUpZVyZbAA5xfts_GP0_0A_zTSLH5PCXvSXi_GXe8y2jsC-n\"]],[null,2,[2752,2064],[null,null,\"https://play-lh.googleusercontent.com/7JXsLPW96pTNh_VexWKFmn-MEup121hC2odvd5J2fKZ-tZqhZYQ7ZKfxAn0Sbom-0urEkDwz-Wr_iSWCRuiM\"]]],\"Smash Land!\",[\"4.6\",4.596774],\"Puzzle\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.flow.smashparty\\u0026rdid\\u003dcom.flow.smashparty\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.flow.smashparty\"]],[\"qgJjGmEIIEoTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCNQoZChNjb20uZmxvdy5zbWFzaHBhcnR5EAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQIBRAB\"],null,[null,\"Welcome to Smash Land!\\u003cbr\\u003eEnter a world where every shot can cause spectacular chaos.\\u003cbr\\u003eFire your cannon, smash through obstacles, send objects flying, and clear everything in your way. Watch towers collapse, and perfectly placed shots turn into satisfying chain reactions.\\u003cbr\\u003eEvery level brings a fresh setup and a new puzzle to smash your way through. Choose your target, make your shot, and let physics do the rest. Sometimes one perfect hit is all it takes to bring everything crashing down.\\u003cbr\\u003eSimple to play, satisfying to master, and packed with moments you’ll want to watch again and again.\\u003cbr\\u003eExplore Smash Land, discover new challenges, and see how much destruction you can create!\\u003cbr\\u003e\\u003cbr\\u003eKey Features\\u003cbr\\u003e- Stunning high-quality 3D visuals\\u003cbr\\u003e- Super satisfying physics-based destruction\\u003cbr\\u003e- Smash, shatter, knock down, and send objects flying\\u003cbr\\u003e- Hundreds of fun and challenging levels\\u003cbr\\u003e- Simple controls anyone can enjoy\\u003cbr\\u003e- Clever shots and satisfying chain reactions\\u003cbr\\u003e- New obstacles and challenges as you progress\\u003cbr\\u003e\\u003cbr\\u003eReady to smash?\\u003cbr\\u003eFire the cannon and conquer Smash Land!\"],\"Flow Games A.S.\",\"0+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/2MESp2I6pY_zysgg9kd1wU_nKM3KF5p1LqGZmROUZ6Uyl_OiMac4xjEhs-lWiFkrVQU4I813AXeB1kQd3TsscwI\"],null,[100,159,224,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,[null,\"Content is generally suitable for all ages. May contain minimal cartoon, fantasy or mild violence and/or infrequent use of mild language.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[nu