l,null,null,\"AXH1eznN9H1Wdt1YjglQ1i2HymWpYbZBmpqag96FKGguJ5iiANMXdtkO1PINAfWx90_BW_JgelJdEm_2-x5DTbft5sF1jCJlUYIraZoEE8f47HFAWlbzFTuqpl3YBwvx0TWqMIZCSR2cY6ogteXl_7fcF4q6vpGHue1BTFzc0vz66b6h2zncykuFexTGsCH8LNBn-D-t0oNyb6MmtAE7YVay0JSg965dK9jnrhoKz6rG365PZ_4p6mcd7KLnb7cc2iM0tmf8fWEUc1GVDsKgdWnCBJ9Mie8JOul0Y0PizB03_8STrw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/jmgOnqRPCQg/hqdefault.jpg\"]]]],[null,\"🐍 Snake Clash – A Fast Action Game Enjoyed by Over 100 Million! 🐍\\u003cbr\\u003e\\u003cbr\\u003eWelcome to Snake Clash, a fast and fun action battle game where you slither, eat, grow, and survive. Start small and hungry, slither through the arena, eat food and smaller enemies, and become big, powerful, and ready to dominate the battlefield.\\u003cbr\\u003e\\u003cbr\\u003e🍽️ Eat, Grow, and Survive\\u003cbr\\u003eSlither through a fierce arena full of worms and nonstop action. Eat fast, grow big, and challenge every rival that gets in your way. The more you eat, the bigger you become, giving you more power, more presence, and a better chance to survive.\\u003cbr\\u003e\\u003cbr\\u003e🚨 But be careful. Bigger rivals are always hunting, and one quick mistake can end the game. Slither smart, react fast, and become the last one standing.\\u003cbr\\u003e\\u003cbr\\u003e🧩 Collect Skins\\u003cbr\\u003eMake it truly yours. Collect colorful skins, funny worm designs, flashy looks, and unique styles as you play. Whether you want a cute worm, a cool look, or a big legendary serpent, there are plenty of ways to customize your style and stand out in every battle.\\u003cbr\\u003e\\u003cbr\\u003e🌐 Play Online iO Battles\\u003cbr\\u003eJump into multiplayer iO mode and play online against friends or players around the world. Slither into real-time action, eat smaller rivals, avoid bigger enemies, and grow fast before your opponents take over the arena.\\u003cbr\\u003e\\u003cbr\\u003eEvery online match is full of fun, speed, and challenge. Slither smart, survive longer, and become the top player.\\u003cbr\\u003e\\u003cbr\\u003e🏅 Challenge Global Rankings\\u003cbr\\u003eChallenge the Tower of Challenges, join seasonal events, and climb the global rankings. Collect rewards, earn special titles, and prove that you have what it takes to become #1.\\u003cbr\\u003e\\u003cbr\\u003e🎮 Play Free Anytime\\u003cbr\\u003eSnake Clash is free to play and easy to enjoy anytime, anywhere. No Wi-Fi? No problem. Slither, eat, grow, survive, and enjoy fast action wherever you are.\\u003cbr\\u003e\\u003cbr\\u003eDownload Snake Clash now and become the biggest in the arena!\"],\"Supercent, Inc.\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/W_r4QOtlv4plw-YhgFpSVqZsap8UNoC0nWbndRAasPVOuw2KGOwFncbT1Od_YqbQq1AVdwrKxLLdWvwQ1w4b4w\"],null,[42,45,49,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dio.supercent.linkedcubic\\u0026rdid\\u003dio.supercent.linkedcubic\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Arcade\"]],[null,null,nul