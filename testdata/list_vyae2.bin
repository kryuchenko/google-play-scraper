//play-lh.googleusercontent.com/t_-8jBkOtH3GNz_k_5to5U7gtm3Ffnk8RQf1O0BJWnzX7XA8tLsbIO6-H5o9MZCe64o\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/B_MisDJiap1_w_yyjIfi3JliZUXsgBMHB6i7xKG1wTC-yM39GrzUE-Fp7zEEssFBGQ\"]]],\"Vita Mahjong\",[\"4.8\",4.7832866],\"Board\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.vitastudio.mahjong\\u0026rdid\\u003dcom.vitastudio.mahjong\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.vitastudio.mahjong\"]],[\"qgJgGl4IBEoTCMrn6+an/ZQDFaMJswYdIssGi/oBDwoNCAASCQoFZW4tVVMQALoCMgocChZjb20udml0YXN0dWRpby5tYWhqb25nEAEYAxISCgQIARABCgQIAxABCgQIBBAE\"],null,[null,\"Vita Mahjong is an Exclusive Puzzle Game of Tile Matching. We are thrilled to present the mahjong  game that combines innovation with classic gameplay. It offers large tiles and a user-friendly interface compatible with pads and phones. Our goal is to provide a relaxing yet mentally engaging gaming experience, particularly focused on older adults.\\u003cbr\\u003e\\u003cbr\\u003eAt Vita Studio, we have always been dedicated to crafting mobile games designed for seniors that bring back relaxation, fun, and joy. Our repertoire includes popular titles like Vita Color, Vita Jigsaw, Vita Word Search, Vita Block, Vita Sudoku, and more.\\u003cbr\\u003e\\u003cbr\\u003eHow to Play Vita Mahjong:\\u003cbr\\u003ePlaying free Vita Mahjong game is simple. Just aim to clear all the tiles on the board by matching tiles with identical images. Tap or slide two matching tiles, and they will vanish from the board. Your objective is to match tiles that are not concealed or blocked. Once all tiles are eliminated, it signifies successful completion of a majong game!\\u003cbr\\u003e\\u003cbr\\u003eExclusive Vita Mahjong  Game Features:\\u003cbr\\u003e• Classic Mahjong : Staying true to the original gameplay, it presents traditional card tile sets and hundreds of boards.\\u003cbr\\u003e• Special Innovations: Besides the classic, our game introduces special tiles that add a fresh twist to the classic mahjong.\\u003cbr\\u003e• Large-Scale Design: Our mahjong games feature large, easily readable text sizes to alleviate the strain caused by small fonts.\\u003cbr\\u003e• Active Mind Levels: A special mode designed to sharpen your mind and improve memory abilities in the mahjong games. \\u003cbr\\u003e• Customizable Scoring:  You can enjoy free classic mahjong games without a timer and any score pressure.\\u003cbr\\u003e• Super Combo: When you consecutively match mahjong tiles during the game, you will unlock special experiences.\\u003cbr\\u003e• Helpful Hints: Our game provides free useful props, such as hints, undo, and shuffle, to help players overcome challenging puzzles.\\u003cbr\\u003e• Daily Challenge: Take on daily practice to collect trophies and improve your classic mahjong solitaire game skills.\\u003cbr\\u003e• Offline Mode: Full offline support lets you enjoy Vita Mahjong anytime, anywhere, without needing internet.\\u003cbr\\u003e• Multi-device: Optimized for pad and phone, ensuring everyone can enjoy the classic mahjong game.\\u003cbr\\u003e\\u003cbr\\u003eVita Mahjong is a versatile game made for those who love tile matching games. Download Vita Mahjong and start your mahjong dynasty now!\\u003cbr\\u003e\\u003cbr\\u003eNote: This is a puzzle game in the style of Mahjong Solitaire. It does not contain the rules of traditional Mahjong or other types of solitaire or card games. The term “Mahjong” here refers solely to the visual style of the tiles.\\u003cbr\\u003e\\u003cbr\\u003eContact us : support@vitastudio.ai\\u003cbr\\u003eFor more information, you can:\\u003cbr\\u003eJoin our Facebook group: https://www.facebook.com/groups/vitastudio\\u003cbr\\u003eVisit our official website: www.vitamahjong.com\"],\"Vita Studio.\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/3sqdtVJXYgwrZSs8ljJvbbePDSLDWvAJ6I4g9_V4mkqAVPRz5uWcZ1zSR7DtWdmoUg\"],null,[29,85,70,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.vitastudio.mahjong\\u0026rdid\\u003dcom.vitastudio.mahjong\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $49.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Board\"]],[null,null,null,[\"Puzzle\"]],[null,null,null,[\"Mahjong solitaire\"]],[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.luwukmeliana.profileperfect\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/fOCJHPbzplwDRQ1TlRq01tRkTMF25KsjYlI5BOiEklQJJYPbCm8fzOR4LQPy2mR1OJysnAdizmxLoCDRoUl8Dg\"],null,[251,252,253,255],null,null,null,2],[[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/88IacSxzNHH7Gj6jr6NEGIHP2nN2s_DfMLW4z11wwdN6OIiw24VCmicf__ms2zwKMm25q-CEk7v0QR6JJmoBSQ\"]],[null,2,[2208,1242]