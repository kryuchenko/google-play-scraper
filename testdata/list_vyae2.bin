null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dio.supercent.pizzaidle\"]],[\"qgJgGl4IVEoTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCMgocChZpby5zdXBlcmNlbnQucGl6emFpZGxlEAEYAxISCgQIARABCgQIAxABCgQIBBAE\"],[[[null,null,\"6obPnwWF5yU\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:6obPnwWF5yU?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:6obPnwWF5yU\",null,null,null,null,\"AXH1ezmruuL9owKL0F1v9nxkd-W_gRNJlquI182r_Es6FDyHYTzU-eRdNj2H1vihBVhXIqangGJhVm8ziAbzLDWGpULyMgW_H78bDrk1IbGQqaxq5BpC6gZIoHS5PWVkYyG_mukKsZTWTT6J3HRvi-l8rYbF6WT3svc8HebncFoA736-xuQ-o9k_YxepfxIbYysO2TcEyUXMxcYdgxgyEUl1lSgZXy6VU2zutwsAQggDJSMR3Q7KHc_1_Ds-88yEnZrY806WudEDVHgWYmzXfhr9Kn5K6uk7M4BttzerEft8NLVaeA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/6obPnwWF5yU/hqdefault.jpg\"]]]],[null,\"Pizza Ready! – Build a Restaurant Empire!\\u003cbr\\u003e\\u003cbr\\u003eWelcome to Pizza Ready, a pizza game where you cook, serve, manage, and build a growing restaurant business. Start with one shop, take every customer order, and turn a small kitchen into a busy business empire. If you love food, idle, simulator, and tycoon gameplay, this game is for you.\\u003cbr\\u003e\\u003cbr\\u003e🍕 Cook, Serve, and Grow\\u003cbr\\u003e\\u003cbr\\u003ePrepare fresh pizza for every customer and keep the restaurant moving fast. Take each order, complete each order, cook food in the kitchen, add tasty topping, and serve a delicious meal before the line gets too long. Every order gives you money, profit, and a chance to upgrade your shop.\\u003cbr\\u003e\\u003cbr\\u003eAs owner and manager, you control the restaurant from counter to kitchen. Manage each station, improve every recipe, master the flow, and serve more customers. The better you manage your business, the faster your restaurant can expand.\\u003cbr\\u003e\\u003cbr\\u003e👨\\u200d🍳 Upgrade Kitchen, Equipment, and Staff\\u003cbr\\u003e\\u003cbr\\u003eBuild a stronger kitchen with better equipment, ovens, appliances, and stations. Each upgrade helps you prepare more meals, complete more orders, and make your restaurant more efficient. Upgrade equipment, unlock fresh ingredients, upgrade each dish, and create delicious food that every customer will enjoy.\\u003cbr\\u003e\\u003cbr\\u003eHire chef and cashier staff to keep the shop running. Train your staff, increase order speed, and help every customer faster. Great staff, better equipment, and smart management help your business earn income, even while you are offline.\\u003cbr\\u003e\\u003cbr\\u003e💼 Become a Pizza Tycoon\\u003cbr\\u003e\\u003cbr\\u003ePizza Ready combines idle simulator gameplay with restaurant management and business growth. Collect money, boost profit, and unlock each level as your restaurant becomes bigger. Expand your store, design a better shop layout, and build an empire across new locations.\\u003cbr\\u003e\\u003cbr\\u003eEvery level brings a new challenge. Open another restaurant, upgrade every station, serve more customers, and become the ultimate pizza tycoon. Whether you enjoy a relaxing idle game, restaurant simulator game, clicker progress, or tapping game fun, Pizza Ready gives you a satisfying business journey.\\u003cbr\\u003e\\u003cbr\\u003e🌟 Features\\u003cbr\\u003e\\u003cbr\\u003eBuild and manage your pizza restaurant, cook food, serve every customer, complete each order, earn money, upgrade kitchen equipment, grow business profit, hire staff, expand your shop, and enjoy idle progress online or offline.\\u003cbr\\u003e\\u003cbr\\u003eDownload Pizza Ready. Cook delicious pizza, manage every order, upgrade your kitchen, expand your business, and become the greatest pizza tycoon!\\u003cbr\\u003e\\u003cbr\\u003eSupport: help.pizza@supercent.io\"],\"Supercent, Inc.\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/km21GpGt9bynbM7MFlKQ5SSkI7GhxOAHRFAHv4Tk6uizBEr_smCcQtt2DpBxrYtZv5_ywD0wGPG1T4bNOfC10A\"],null,[170,232,252,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dio.supercent.pizzaidle\\u0026rdid\\u003dio.supercent.pizzaidle\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $49.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Simulation\"]],[null,null,null,[\"Restaurant\"]],[null,null,null,[\"Casual\"]],[null,null,null,[\"Offline\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.budgestudios.googleplay.BlueyBLU\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/bfh2Ci4fIm7tJC_6uY0ZvZcSWLu3YMEv1D3s50MFH5_GZKOZFUtwBLQnN_f_tVceImUh_dp15EID3AIs2nbo0L8\"],null,[105,203,254,255],null,null,null,2],[[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/vQM9ET-wp_ZKD9821A60HPwvHlJzMDAdhV7HinpE6UHct0xyyi-xhOSWHbY5DDkF_UM6sbpaLK5FyiBvdkwThA\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/Cb-oV6qrZT-UPsRtOe5jmLFns7pJQwU_r-w0NZ-YsSls1W8qeynR0h6B523J21ta5ZVvOzMjUbFMUaSH-drZ4X8\"]],[null,2,[1242,2208],[null,