,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/xmg8wbR0sABOWBjYtb_5DHfa48o66dvQJNsyNabqORQm8gVEE4tNU3N_jOjqqJ11iTo\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/iTMVj5MaQj_UTzwGPCgR2XS2eU7yGXVjoakh9zEPwT2tW1xdkvuRk5PhNTr3fRqlwpaT\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/AWuqFZBBw6AuuflkJ4PnF9V_y1xmCTimF5zDUSn9iiduIxhxNlD28kjfQ1YCkvKr_p65\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/wwKV_YxMNFgeBtkPMUE7t_SL4mkNHNucBSJ3w2Axi2J_TccpJM9FVgQgjPPfB_5Od7pC\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/GFoGwzISEpVNJxXOJbdPISHmN-ZY3M4C_1GbVT1apATnXz13DrH-Ka3sZcxLEEbl8A\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/p0oSUYVAUOZdol7JvaTv7BYp0v6U-MGx3iSVGaY3vJwrF2qGvedDLA4tKHnOusLx5AyC\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/HxnYhrEcZxnKf8rLBmRXdThr024F_GKdiWuzjgrvDRNHd0V-TJcHohrJipG4LhExkMs\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/ChAwHAS57W3s2p10WYU-KEj4-qm6oVdUC5YfejqCWgea7E1gM1IZcgu79qcupsbMMSZ9\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/zz9DPU-7sLvA_2LAFhP1DxSFBunLUbYJmOi5AoHnzIs53XAzdP40U50Bj0m5D11vjg\"]]],\"Tile Explorer - Triple Match\",[\"4.9\",4.861455],\"Puzzle\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.oakever.tiletrip\\u0026rdid\\u003dcom.oakever.tiletrip\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.oakever.tiletrip\"]],[\"qgJeGlwIIUoTCMrn6+an/ZQDFaMJswYdIssGi/oBDwoNCAASCQoFZW4tVVMQALoCMAoaChRjb20ub2FrZXZlci50aWxldHJpcBABGAMSEgoECAEQAQoECAMQAQoECAQQBA\\u003d\\u003d\"],null,[null,\"Are you looking for a new match-3 game? Do you want to find relaxation and joy in it? Prepare to embark on the enchanting world of Tile Explorer, the relaxing tile match puzzle game. Tile Explorer transforms the act of tile matching into an art form. With each level, Tile Explorer invites you to immerse yourself in puzzle-solving fun, where each tile holds the potential for both relaxation and triumph!\\u003cbr\\u003e\\u003cbr\\u003e🍓Unlock a Journey of Innovative Tile Challenges🍓\\u003cbr\\u003eTile Explorer is a blend of traditional tile match games and innovative puzzle mechanics, offering a fresh twist on the beloved match puzzle genre. Here, matching tiles becomes more than a game—it\\u0026#39;s a journey. As you navigate through the myriad puzzles, Tile Explorer evolves, presenting new challenges that require you to think differently about your strategy. The thrill of making a triple tile match and clearing the board is unmatched, offering both satisfaction and the eagerness to tackle the next puzzle challenge.\\u003cbr\\u003e\\u003cbr\\u003eFour Features of Tile Explorer:\\u003cbr\\u003e- 🌺EMBARK ON A TILE Explorer: Journey through serene puzzles, matching tiles for tranquility. Engage in a tile-matching saga that delights both mind and sight.\\u003cbr\\u003e- 🌼MASTER TILE MATCHING: Elevate your intellect with every level of our match challenges. Dive into a realm where classic puzzles meet innovative tile matching, sharpening your cognitive skills.\\u003cbr\\u003e- 🪷EXPLORE A WORLD OF MATCH ADVENTURES: Navigate through diverse landscapes, from tranquil seasides to lush rainforests, as you progress in our tile-matching journey. Each new level brings a fresh backdrop, inviting you to a world where every match is a discovery.\\u003cbr\\u003e- 🪻DISCOVER THOUSANDS OF PEACEFUL PUZZLES AND BRAIN CHALLENGES: Find solace and stimulation in a vast collection of tile-matching puzzles designed to relax and challenge.\\u003cbr\\u003e\\u003cbr\\u003e🌸Explore a New Adventure🌸\\u003cbr\\u003eEmbark on a journey with Tile Explorer, the ultimate tile-matching adventure that redefines relaxation and mental stimulation. With a simple tap, match, and relax mechanism, Tile Explorer invites you to dive into a world where matching three tiles unravels endless possibilities and hours of enjoyment.\\u003cbr\\u003e\\u003cbr\\u003eTile Explorer isn’t just a game; it’s an expedition across captivating landscapes, challenging your intellect with every move. With puzzles that tease the brain and matching games that test your skills, Tile Explorer offers a comprehensive experience that sharpens your mind while providing immense satisfaction through tile puzzle triumphs.\\u003cbr\\u003e\\u003cbr\\u003e🌹Start Your Journey with Others🌹\\u003cbr\\u003eDownload Tile Explorer today and start your adventure through the world of triple tile matching. Whether you’re a seasoned puzzle pro or new to the world of relaxing puzzle games, Tile Explorer offers an unparalleled experience that promises hours of fun.\\u003cbr\\u003e\\u003cbr\\u003eJoin the millions who have discovered the joy and challenge of Tile Explorer. With every tap, tile match, and level conquered, you’re not just playing a game; you’re embarking on a journey of discovery, relaxation, and mental fortification through engaging puzzles.\\u003cbr\\u003e\\u003cbr\\u003e🍊Upcoming Features and Enhancements🍊\\u003cbr\\u003eIn the upcoming months, Tile Explorer will be enriched with numerous exciting features and additional puzzle levels. We warmly invite you to share your ideas and preferences for what you\\u0026#39;d love to see included in this tile-matching game adventure!\\u003cbr\\u003e\\u003cbr\\u003eFor any questions—including gameplay, rewards, or bundle purchase/refund—please visit Settings \\u0026gt; Support in the app to contact our Customer Support team.\"],\"Oakever Games\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/waohO4Lv0oaI3OBw4reNwxOCoISdCh6lQ5TaHlsVocSVfUHJFl_CpcZImEitx6qIuDQ\"],null,[250,2