[null,null,\"/store/apps/details?id\\u003dcom.aim.racing\"]],[\"qgJZGlcInQFKEwitldb9jr+WAxWFeYQGHSiCKVL6AQ8KDQgAEgkKBWVuLVVTEAC6AioKFAoOY29tLmFpbS5yYWNpbmcQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAQ\\u003d\"],[[[null,null,\"BSrLx9pnYyg\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:BSrLx9pnYyg?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:BSrLx9pnYyg\",null,null,null,null,\"AXH1ezkcsBrnWWd8QWv37K_I0Wb1zPCUKTwuEG20v0htzVN4PRdrWvziCAuDcqnz4IkvbmHmr2BQqci4hzoCZvxlBI6mBpn4E-zt96M5CqXg_1BtNQp_z1t39vDOSHxejV9DUrF96beuNHQl2g_nuXKzWLFLSNS3lDDMgLWOOa4jl7xwvgG3b5hT85y8nwImI2ny1_Jz7eSuuV3eR0HaNFJ8PdJKzKd3JceM1gioumyJI3Oeim6VfNfi80uj0I83iNadDnKus6akOHwUq8sRfuEwdGLzeaLEP8LNtQR55yOYYK05xA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/BSrLx9pnYyg/hqdefault.jpg\"]]]],[null,\"Extreme Car Driving Simulator is the open world car simulator since 2014, thanks to its advanced real physics engine\\u003cbr\\u003eEver wanted to try a sports car simulator? Now you can drive, drift and feel a racing sports car!\\u003cbr\\u003eBe a furious racer on a whole city for you. No need to brake because of traffic or racing other rival vehicles, so you can perform illegal stunt actions and run full speed without the police chasing you!\\u003cbr\\u003e\\u003cbr\\u003eDrifting fast and doing burnouts had never been so fun! Burn the asphalt of this open world city!\\u003cbr\\u003e\\u003cbr\\u003eGame Features\\u003cbr\\u003e\\u003cbr\\u003eMini game checkpoint mode\\u003cbr\\u003eDrive with traffic\\u003cbr\\u003eFull real HUD including revs, gear and speed\\u003cbr\\u003eABS, TC and ESP simulation. You can also turn them off!\\u003cbr\\u003eExplore a detailed open world environment\\u003cbr\\u003eRealistic car damage. Crash your car!\\u003cbr\\u003eAccurate physics\\u003cbr\\u003eControl your car with a steering wheel, accelerometer or arrows\\u003cbr\\u003eSeveral different cameras\\u003cbr\\u003eGamepad support\"],\"AxesInMotion Racing\",\"500,000,000+\