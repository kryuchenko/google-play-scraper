]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/RQ0yc-ihoepKoZX_8aMbizGkF8qxmk99UPrbEPoM_Fn1Jl3hOJ2Va8vY1Hl0f_s6k2qECxPCHL6TptvDBegrmw\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/ImFaD9XEOYZf2UkeGuqT1844_LKAzhGnChokdW1KSX3_qoDRXiIDEJn9R0q-pehXJwwxsVjCYg3Q9I3DHvaG\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/KQJG2PLsgZ-Zfkzh4li-nPtRT02Lqii-S9-qpyYBS387l8bRwj3aaFk4XUwQlPLYRQ3VYu6PyzA6VRo39zC5VPE\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/UD-fUHgaHYRwD1eY82Spk1d1fmUzwd91QUq2yILeykrs7b-xRO2TukxenHBcaqjjWUwQ0aFPNPnx1Xq8qkIeKHo\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/PZ5-7tpGsoJVYQW5k_LPZuGuQ7OqTL1u7VIUaeKRRQwjqU_Cx-a3sjaVlu2-9NyaX80wqPPgniOMxctzFH034A\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/Xg96oEjPhFZ0Q6FwIEzrznQ0Ah904zdp1Kpm-NMl7bIatGJ8kwMNmr4y2ObFEB78mBk73mdqTMb1TR59XWgqxw\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/b4ZTwm2-0I6i5kuDqQaC1BXnWEwYjvYNHWkv-067AbYkbeIVXm_BFRytk779tQfXLvxhJzlEqBqLtuEqnGVgWA\"]]],\"Crossword Master - Word Puzzle\",[\"4.8\",4.797204],\"Word\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.easybrain.crossword.puzzles\\u0026rdid\\u003dcom.easybrain.crossword.puzzles\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.easybrain.crossword.puzzles\"]],[\"qgJqGmgIqwFKEwitldb9jr+WAxWFeYQGHSiCKVL6AQ8KDQgAEgkKBWVuLVVTEAC6AjsKJQofY29tLmVhc3licmFpbi5jcm9zc3dvcmQucHV6emxlcxABGAMSEgoECAEQAQoECAMQAQoECAQQBA\\u003d\\u003d\"],[[[null,null,\"-9k0nY6pciA\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:-9k0nY6pciA?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:-9k0nY6pciA\",null,null,null,null,\"AXH1eznHTudEhau7Vl-SPLcCd8ameKuTT_gr8Ob5pRmlCxIPVGlildpZn6HYQIRyScpg1FVqOHcWDcOt0Y_JSvaUYXsvijNDPoagTvBuTPlOSwLy8_SOX89byRkIzvErh-EUf-rAdABrDAKey_C2pMZAKszP3WJZI7Wd55HXtDawgtTXv905Xf8i3L_A4PzvgbAZW22UExV8KPhG02UlHKiOntun4eqMBBZkqEDW2PTEVQLFyG39wFBXcHobis3YrwlHr7agR6UfgcmBU28Ox78PojvoCXwB-7_JHlNXXpp6FJhmvQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/-9k0nY6pciA/hqdefault.jpg\"]]]],[null,\"Crossword Master is a turn-based word puzzle game for adults where you and your opponent work together to complete a crossword puzzle while competing for the highest score. Dive into this highly addictive experience and enjoy endless fun! Solve crosswords, outsmart your opponents, and become a word master!\\u003cbr\\u003e\\u003cbr\\u003eCrossword Master combines the best elements of word puzzle games and classic crosswords with modern and intuitive gameplay, making it suitable for both expert wordsmiths and casual players. Inspired by Scandinavian-style crosswords, Crossword Master features clues within the cells to enhance gameplay convenience.\\u003cbr\\u003e\\u003cbr\\u003eDiscover a fresh take on daily crossword puzzles: draw letters from the deck, and craft words according to the clues. Some of the clues are pictures, which adds an extra layer of challenge and fun! If you enjoy word games for adults, daily newspaper crosswords, anagrams and logic puzzles, try this captivating crossword puzzle game, and you won\\u0026#39;t be able to put it down!\\u003cbr\\u003e\\u003cbr\\u003eAre you ready to challenge your vocabulary and sharpen your mind with an exciting word game? Crossword Master strikes the perfect balance between entertainment and a useful brain exercise. Each crossword puzzle is carefully designed to train your language skills, spelling, logic, and general knowledge. Explore thousands of words, enrich your vocabulary, and master the art of crossword games!\\u003cbr\\u003e\\u003cbr\\u003eWhat you get:\\u003cbr\\u003e\\u003cbr\\u003e✔ Engaging crossword game with smooth graphics and a modern look\\u003cbr\\u003e✔ Plenty of unique free crossword puzzles for adults packed with countless words to unravel, keeping you hooked for hours!\\u003cbr\\u003e✔ Enhancing your vocabulary. Learn new words and their meanings while playing crossword games for free\\u003cbr\\u003e✔ Hints available to assist when you\\u0026#39;re stuck solving crossword puzzles and need a clue\\u003cbr\\u003e✔ Auto-save ensures you can resume any unfinished crossword anytime without losing your progress\\u003cbr\\u003e✔ No time limit. Enjoy this free crossword game at your own pace\\u003cbr\\u003e✔ New crossword puzzle game from a top developer, guaranteeing quality and fun.\\u003cbr\\u003e\\u003cbr\\u003eHow to play Crossword Master:\\u003cbr\\u003e\\u003cbr\\u003e- Your goal in this turn-based word game is to craft words on the crossword board according to the clues and outscore your opponent.\\u003cbr\\u003e- Use blue cells with clues to guess words in this engaging crossword puzzle game. Find the right fit for each letter from a set of five and place them one by one from the deck to start forming words.\\u003cbr\\u003e- Try to place all the letters from the deck in each turn to maximize your score and solve crossword puzzles. Every correct letter earns one point, with additional points awarded for completing words. The score for a whole word equals the number of letters it contains. Aim to construct longer words and multiple words in a single move for the highest scores.\\u003cbr\\u003e- If you’re stuck playing word puzzle games, tap the Hint button to see possible placements for the letters.\\u003cbr\\u003e- Confirm your choices by clicking the Submit button once you’ve placed all your letters. The opponents are virtual so you don\\u0026#39;t waste precious time waiting for your opponent\\u0026#39;s next move.\\u003cbr\\u003e- Think strategically while solving crosswords. Sometimes, holding back a crucial letter for a future move can help create a longer word and boost your score potential.\\u003cbr\\u003e- The crossword game concludes when all words on the board are completed. The player with the highest score at the end is the winner.\\u003cbr\\u003e\\u003cbr\\u003eReady to embrace the challenge? Solve daily crossword puzzles anywhere, anytime, stretch your cognitive limits, and become a master of words!\\u003cbr\\u003e\\u003cbr\\u003eTerms of Use:\\u003cbr\\u003ehttps://easybrain.com/terms\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy:\\u003cbr\\u003ehttps://easybrain.com/privacy\"],\"Easybrain\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/E8E3zK_4w6WmxCueHx2qaZ1MLCzbyl76Bie1PyntofFHp-6caudmyNfNDVa21sGJcdMJURUWCT829h-vN70B\"],null,[241,244,248,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.easybrain.crossword.puzzles\\u0026rdid\\u003dcom.easybrain.crossword.puzzles\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$14.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Word\"]],[null,null,null,[\"Crossword\"]],[null,null,null,[\"Casual\