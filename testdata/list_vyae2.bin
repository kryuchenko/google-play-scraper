ull,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/zGmhxeTt55vTsjfa-G2nRwE9GXe-shgcTnfOX5x5lT5RKyb7P08zj0YH__NKjgX2vbtGGpbsdP3DMjr48-PdeCE\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/J3TQuO_Re_dV2FVIrFah6kOgrGIlG-Isl7Lagl3Uc0a3mATUqz-tMN0ptHNYXgK2kTy8rNW0N9v0ltpzk2Mhsw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/jRYXW9xWtt0iykCYH4ep0lORyWyBpGNMJ29nh1UCK_14HevVasGbIbIJFA1geasudqcsF9bt2OKVi5JG7R7ExQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/oY6OSJvvUyzc4z9FrumIXOYKwX8Nw_8cDQoc7naWqHerrtnt17Zj9MDKxl4AYXCOnKtuuu9bp7og2bk-DIddBw\"]]],\"Eye Color Mix\",[\"4.6\",4.58],\"Simulation\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.alexp.eyemix\\u0026rdid\\u003dcom.alexp.eyemix\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.alexp.eyemix\"]],[\"qgJbGlkIswFKEwjK5+vmp/2UAxWjCbMGHSLLBov6AQ8KDQgAEgkKBWVuLVVTEAC6AiwKFgoQY29tLmFsZXhwLmV5ZW1peBABGAMSEgoECAEQAQoECAMQAQoECAQQBA\\u003d\\u003d\"],null,[null,\"Unleash your creativity and dive into the world of vibrant colors with Eye Color Mix! This unique coloring game combines the art of painting with the excitement of a makeup kit. Experience the magic of mixing and matching with our innovative color wheel, where every tap brings a new shade to life. Whether you want to explore natural hues or experiment with bold, imaginative tones, Eye Color Mix is your playground!\\u003cbr\\u003e\\u003cbr\\u003eGet Ready to Play: With the Eye Color Changer, you can instantly transform your character\\u0026#39;s look by selecting from a dazzling array of eye colors. Navigate through different shades using the Color Wheel to create your unique palette. Feel the thrill of Tap Color gameplay as you mix colors effortlessly and see them come alive on your screen.\\u003cbr\\u003e\\u003cbr\\u003eUnleash Your Inner Artist: Discover endless possibilities with our immersive painting features. Choose from a variety of brushes and tools, then dive into a world of creative coloring games. From delicate pastels to vibrant neons, every tap reveals a new color that’s ready to blend and beautify. With our easy-to-use Makeup Kit, you can craft looks ranging from subtle elegance to bold drama.\\u003cbr\\u003e\\u003cbr\\u003eMix, Match, and Master the Art of Color: Become a color master in this fun and addictive game. Learn how to mix colors to get the perfect hue, challenge yourself with exciting levels, and explore endless combinations. Whether you\\u0026#39;re aiming for a realistic eye color mix or a fantastical creation, Eye Color Mix offers endless fun for everyone!\\u003cbr\\u003e\\u003cbr\\u003eAre you ready to embark on a colorful adventure? Download Eye Color Mix now and start painting your way to perfection!\\u003cbr\\u003e\\u003cbr\\u003eTo opt out of CrazyLabs sales of personal information as a California resident, please visit our Privacy Policy: https://crazylabs.com/app\"],\"CrazyLabs LTD\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/zwOCx-cyfEVxGHJ-Nf78o94Z1SDRJ96RqKTWepelCZhI_Nf77GGr0hB6WJlu9WIbe_XnXDeRUe1dr_JjcI1QO7U\"],null,[146,200,231,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.goog