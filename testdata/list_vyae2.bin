sercontent.com/iPhFm4uHUG9N2-t591pGL_FNYTaekOvXIdZ8X36vk1c_-NpSbng3dCz-wx_KdBFih9JUx9oALKbBsKSh5xVRCac\"]]],\"Last Asylum: Plague\",[\"4.7\",4.6909795],\"Strategy\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.phs.global\\u0026rdid\\u003dcom.phs.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.phs.global\"]],[\"qgJYGlYIUkoTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCKgoUCg5jb20ucGhzLmdsb2JhbBABGAMSEgoECAEQAQoECAMQAQoECAQQBA\\u003d\\u003d\"],[[[null,null,null,[null,null,\"https://www.youtube.com/watch?v\\u003dM9BVonbfSCk\"]],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/M9BVonbfSCk/hqdefault.jpg\"]]]],[null,\"A mysterious plague has swept across the world, leaving chaos in its wake. As a plague doctor, you become the town\\u0026#39;s final beacon of hope. Build and manage a sanctuary, heal those you can, and guide your people through the darkest days of the pandemic. Your strategy will shape their future.\\u003cbr\\u003e\\u003cbr\\u003e[The Sanctuary of Hope]\\u003cbr\\u003eRun your sanctuary as the last refuge against the plague.\\u003cbr\\u003eTreat patients, craft herbal remedies, and expand your wards to shelter the growing tide of the sick and desperate.\\u003cbr\\u003e\\u003cbr\\u003e[Counter the Rat Swarm]\\u003cbr\\u003eHold the last line against the Rat Swarm.\\u003cbr\\u003eRecruit and upgrade your heroes. Build as many defensive towers as you can. Slay the Rat King to repel the swarm.\\u003cbr\\u003e\\u003cbr\\u003e[Gather Resources, Rebuild the Town]\\u003cbr\\u003eDispatch survivors to gather resources and secure outposts in the wild.\\u003cbr\\u003eCollect timber, herbs, food, and other essential supplies. Construct production facilities, expand warehouses, and upgrade residential buildings to house more survivors.\\u003cbr\\u003e\\u003cbr\\u003e[Seize Abandoned Ruins]\\u003cbr\\u003eForm elite squads of heroes to reclaim plague-ridden towns.\\u003cbr\\u003eCreate the best lineup of different types of heroes. Outsmart contenders on the battlefield. Gain control of crucial cities. Expand your territory in this world.\"],\"37GAMES GLOBAL\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/O7oXgrWjMJlxZztgAX1pxnYV9PzLPYtKbMhJJylRVARRNvEppM8CIVXp8XnPYR7CIQWUdzY6GRv3C3oqhTnWtA\"],null,[34,50,75,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null,\"Violence, Blood\"],[null,\"In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.phs.global\\u0026rdid\\u003dcom.phs.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Strategy\"]],[null,null,null,[\"4X\"]],[null,null,null,[\"Single player\"]],[null,null,null,[\"Immersive\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.s01.global\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/4_JTVfSvadb3P01izF2fL47w183NO4oqje4gtwZIKf05-iCu9SI7ldG8vYfGZFpbN_-wXMWVexolzqqZqzJKWg\"],null,[187,7,3,255],null,null,null,2],[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/O8B4nXaSTTUMCyT2dwKJi3jVa0_zUkn45MsCds2MDKgahNCnSdHFlifaEL8kl3Jkqh8jTiGP-fVjlFF0H8HfMQ\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/L5mTsJ4TiOgceL1Ewt9ckQEB39bhNkD79RrgBtFv8o-gJu9PF2wecaPz0I3qAi_DjCCul8ZKCTXAdutY_-vRQw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/l_o7XkBmbAXh2p5E6oaVkXmG4OApwJloANZhCdR3hkpNq9mG4ouB5d4j6TkRQxUJU1S_bFRYwG7IPIYrA3xSpg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Kte1ZomqGkvJJ02gj-OYRDo2SDDfDm3ocYF9E7SjA4a6T46D8hYiE04K2XvssfEnxGmartEDJbTzbH8yoFzF\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/R8Fykme-bjAXmkioqQafgBLiogAcCcDPcFImhRsbXuZWBR4hzlRUQPSETsoVvnkZ0R1Ss30XTDI0CZp63-LrvA\"]]],\"Lordrush\",[\"4.4\",4.3824883],\"Strategy\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.s01.global\\u0026rdid\\u003dcom.s01.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.s01.global\"]],[\"qgJYGlYIU0oTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCKgoUCg5jb20uczAxLmdsb2JhbBABGAMSEgoECAEQAQoECAMQAQoECAQQAw\\u003d\\u003d\"],null,[null,\"Lordrush is a medieval tower defense strategy game where you rebuild a ruined fortress and defend your realm from attacks.\\u003cbr\\u003e\\u003cbr\\u003eGather resources, raise defenses, upgrade towers, and recruit heroes as you prepare for each assault.\\u003cbr\\u003e\\u003cbr\\u003eSet in a harsh medieval world of stone castles, armored heroes, war-torn battlefields, and rival lords, Lordrush blends fortress building, resource management, hero strategy, and tactical defense.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003e• Fight for Resources\\u003cbr\\u003eWood, stone, and iron are essential for expansion. Compete with exiles, rebels, and other forces for control of vital resources.\\u003cbr\\u003e\\u003cbr\\u003e• Build Fortress Walls\\u003cbr\\u003eConstruct defensive walls to slow enemy advances and give your towers more time to strike.\\u003cbr\\u003e\\u003cbr\\u003e• Upgrade Towers\\u003cbr\\u003ePlace and upgrade towers to expand your firepower, increase damage, and hold key defensive positions.\\u003cbr\\u003e\\u003cbr\\u003e• Strengthen Your Fortress\\u003cbr\\u003eAs enemy attacks grow stronger, reinforce your walls, expand your towers, and turn your settlement into a powerful medieval stronghold.\\u003cbr\\u003e\\u003cbr\\u003e• Defend Against Sieges\\u003cbr\\u003eEnemies attack your fortress in waves. Adjust your defenses based on enemy routes and strength, and hold the line.\\u003cbr\\u003e\\u003cbr\\u003e• Recruit Heroes\\u003cbr\\u003eRecruit medieval heroes with different abilities. Deploy them to change the course of battle.\\u003cbr\\u003e\\u003cbr\\u003e• Make Tactical Choices\\u003cbr\\u003eEvery building, upgrade, and hero deployment can affect the outcome. Plan carefully to survive the next siege.\\u003cbr\\u003e\\u003cbr\\u003e• Manage Your People\\u003cbr\\u003eAssign survivors as workers, hunters, or cooks to maintain resource production, food supplies, and daily fortress operations.\\u003cbr\\u003e\\u003cbr\\u003e• Maintain Health and Order\\u003cbr\\u003eYour people’s condition affects productivity. Keep food stocked, maintain stability, and help your fortress continue to grow.\\u003cbr\\u003e\\u003cbr\\u003e• Issue Decrees\\u003cbr\\u003eSet rules under pressure from scarce resources and outside threats. Maintain order and guide the growth of your stronghold.\\u003cbr\\u003e\\u003cbr\\u003e• Join Alliances\\u003cbr\\u003eCreate or join alliances, share resources, coordinate defenses, and face powerful enemies together.\\u003cbr\\u003e\\u003cbr\\u003e• Challenge Other Lords\\u003cbr\\u003eTrain heroes, build squads, and compete for points, rare rewards, and greater influence across the continent.\\u003cbr\\u003e\\u003cbr\\u003e• Claim the Throne\\u003cbr\\u003eStart from a single fortress, build your defenses, gather resources, expand your power, and become a lord who cannot be ignored.\"],\"Century Games Innovation Pte. Ltd.\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/vPYS_0CUemD7vuSrcBv9PAPE2MbK9dmhvJQW2dRVoTNlGLvq-Zf9bzzOwoIXkciKv-HDxjAZ6ww5-GTTnV4lhQ\"],null,[138,159,76,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"Users Interact\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.s01.global\\u0026rdid\\u003dcom.s01.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Strategy\"]],[null,null,null,[\"Tower defense\"]],[null,null,null,[\"Immersive\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,nul