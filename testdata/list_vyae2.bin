xn_ze1ij7daPu3UxO1HjEurABrC3HFrtpwRz1Wq_I6rd4B2bD4uYrg-Vtilfg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/Jk09_rclD8dnKRCqLdFTQ70uugO_NGYbMWfvyESIaEtXRtTz7C64UmaVROsJ9EQz1c3ZU-pV-MvquTGPyrePvA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/_9YdnIIEmF5d4hg3UScH7QelTxWfRx6L9uBN188jP4flAIL_7OX4739bDkJ_SLyGmTHl3XY6W-wsKI_CMMmK6g\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/9-cIalen2cCN3JkvjpGFk3OVeackfQe7EU9ecblKQhs5fv09zCGZ56oLTrV-QbzQs2r0S_OE0RAmSJ1wR0gG0g\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/TpctgpncTjachVQGkQMSdPpDKv30bXXTQlM7g-zmDAHbtI3tZ1tGbIxuGYHclvTOJC6iFq4J2BBYtW7Q4auIgg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/zl0nIaDfayclHIoCIHkL8Ryxn_ze1ij7daPu3UxO1HjEurABrC3HFrtpwRz1Wq_I6rd4B2bD4uYrg-Vtilfg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/Jk09_rclD8dnKRCqLdFTQ70uugO_NGYbMWfvyESIaEtXRtTz7C64UmaVROsJ9EQz1c3ZU-pV-MvquTGPyrePvA\"]]],\"Tap Tile!\",[\"4.8\",4.7672744],\"Puzzle\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.nebula.tiles\\u0026rdid\\u003dcom.nebula.tiles\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.nebula.tiles\"]],[\"qgJiGmAIK0oTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBFwoVCJ/Eoaeei7mNQxIJCgVlbi1VUxAAugIsChYKEGNvbS5uZWJ1bGEudGlsZXMQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAE\\u003d\"],null,[null,\"Tap Tile! is a calming and satisfying tile puzzle game where you tap, match, and clear tiles. Enjoy smooth and simple tile match gameplay while exploring thousands of relaxing levels.\\u003cbr\\u003e\\u003cbr\\u003eThis addictive triple tile match game combines classic match 3 mechanics with peaceful visuals, making it perfect for unwinding anytime.\\u003cbr\\u003e\\u003cbr\\u003eSimple \\u0026amp; Addictive Tile Matching Gameplay\\u003cbr\\u003eTap to collect and match 3 identical tiles\\u003cbr\\u003eClear each board by solving relaxing tile puzzles\\u003cbr\\u003ePlan your moves to complete challenging triple tile levels\\u003cbr\\u003eEnjoy smooth and easy tile match game controls\\u003cbr\\u003eWhether you love tile matching games, match 3 puzzles, or triple match challenges, Tap Tile! delivers a satisfying experience.\\u003cbr\\u003e\\u003cbr\\u003eA Relaxing Puzzle Game for Everyday Play\\u003cbr\\u003eDesigned for players who enjoy calm tile puzzle games\\u003cbr\\u003ePerfect for relaxing during breaks or quiet time\\u003cbr\\u003eA stress-free match 3 game with smooth gameplay\\u003cbr\\u003eBeautiful level backgrounds for a soothing experience\\u003cbr\\u003eTap Tile! is ideal for anyone looking for a relaxing tile match puzzle game.\\u003cbr\\u003e\\u003cbr\\u003eThousands of Levels to Explore\\u003cbr\\u003ePlay through thousands of unique tile match puzzles\\u003cbr\\u003eEach level features different scenic backgrounds\\u003cbr\\u003eGradually increasing difficulty for long-term fun\\u003cbr\\u003eFrom easy puzzles to more advanced triple tile challenges, there is always something new.\\u003cbr\\u003e\\u003cbr\\u003ePlay Anytime, Anywhere\\u003cbr\\u003eFully playable offline – no internet required\\u003cbr\\u003eSimple controls for all ages\\u003cbr\\u003eDesigned for easy and relaxing gameplay\\u003cbr\\u003eEnjoy this tile puzzle game offline wherever you go.\\u003cbr\\u003e\\u003cbr\\u003eTap Tile! combines tile match gameplay, triple tile puzzles, and classic match 3 game mechanics into one relaxing experience.\\u003cbr\\u003e\\u003cbr\\u003eDownload Tap Tile! now and enjoy a relaxing tile match puzzle game with thousands of levels.\"],\"Nebula  Studio\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/ck4ePBack10M3FM9DEQQbbuyh6XaivnV-MF