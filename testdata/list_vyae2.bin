[null,null,\"https://play-lh.googleusercontent.com/rAtKLH3mvoKoYO5V-_fdu_cxwvnXwCTF_3oQuFefoQf2B8ERT24zv7jbjGYG1rTWL-uzNsY80esASb0joTcy\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/lTylh8rbwCVfN_UaAC5MzePaKQpgp-tWyRZwUX31EyQOflBHPwNc4petqWoXKqnTC0F7lLWU9y0rIGjtUQvegjU\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/RuZWo5532Kv1CdXgEtHZR2fplXVSQ6OTnvKgKo89zuBp4zNlhFw5YQAz5IS-WkiovogEk7kX6jp5KOtqgYtCzA\"]]],\"Brawl Stars\",[\"4.2\",4.190785],\"Action\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.supercell.brawlstars\\u0026rdid\\u003dcom.supercell.brawlstars\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.supercell.brawlstars\"]],[\"qgJrGmkIkgFKEwjK5+vmp/2UAxWjCbMGHSLLBov6ARcKFQiJpcSfxqbej0MSCQoFZW4tVVMQALoCNAoeChhjb20uc3VwZXJjZWxsLmJyYXdsc3RhcnMQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAQ\\u003d\"],[[[null,null,\"vuAhNH2UL1Y\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:vuAhNH2UL1Y?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:vuAhNH2UL1Y\",null,null,null,null,\"AXH1ezkR5rMkzJxNf8-_WzKYBCpn-03M5HLKPNCGk-4loMKTLZ0TjJhWeQUm9Ya6TFZSKxbR9izkq4pE2M29K4fnru0jn01CuI2Bg2wSYi1Pn7rX_7XfUmioge8TTFJkD7r-4Hqr--LfXTii8fglInyVfzkvwE8LVQ8UGsm0VznSj22oxpj8mZriR24otjXVyAq9byhfAOpxX-XcWJTBEm8HmhnLPNuD_w1qsE5FEco1NIqgTX2PeXWw0_uqGcxnn-yXUwblfgVXSqlYPfrul79PyVWdzEianLAKWC4DQp3ExJsxWcZoR4WPb4duBdXKbqs\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/vuAhNH2UL1Y/hqdefault.jpg\"]]]],[null,\"Fast paced 3v3 \\u0026amp; 5v5 MOBA and Battle Royale made for mobile! Play online with friends or solo across a variety of PvP arena game modes in under three minutes.\\u003cbr\\u003e\\u003cbr\\u003eUnlock and upgrade dozens of Brawlers with powerful super abilities, star powers and gadgets! Collect unique skins to stand out and show off. Battle in a variety of mysterious arena locations within the MOBA Brawliverse!\\u003cbr\\u003e\\u003cbr\\u003eBrawl Stars is free to download and play, however, some game items can also be purchased for real money (including random items). If you don\\u0026#39;t want to purchase game items for real money, please disable in-app purchases in your device\\u0026#39;s settings.\\u003cbr\\u003e\\u003cbr\\u003e\\u003ch1\\u003eBattle in multiple game modes\\u003c/h1\\u003e\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eGem Grab (3v3,5v5)\\u003c/b\\u003e: Team up for real time 3v3 and 5v5 MOBA arena PvP battles against online players from across the world. Team up to battle and out strategize the opposing team. Collect and hold 10 gems to win, but get fragged and lose your gems.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eShowdown (solo/duo)\\u003c/b\\u003e: A MOBA battle royale style fight for survival. Collect power ups for your Brawler. Grab a friend or play solo, be the last Brawler standing in the rowdiest MOBA PvP battle royale yet. Winner takes it all!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eBrawl Ball (3v3,5v5)\\u003c/b\\u003e: It\\u0026#39;s a whole new brawl game! Show off your soccer/football skills and score two goals before the other team. There are no red cards here.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eBounty (3v3,5v5)\\u003c/b\\u003e: Battle to take out opponents and earn stars, but don’t let them pick you off. The squad with the most stars wins the match!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eHeist (3v3,5v5)\\u003c/b\\u003e: Protect your team’s safety and try to crack open your opponents’. Navigate the arena to sneak, blast, battle and blow your way clear to the enemies treasure.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eSpecial MOBA Events\\u003c/b\\u003e: Limited time special MOBA PvE and PvP arena battle game modes.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eChampionship Challenge\\u003c/b\\u003e: Join Brawl Stars\\u0026#39; esports scene with in-game qualifiers!\\u003cbr\\u003e\\u003cbr\\u003e\\u003ch1\\u003eUnlock and upgrade Brawlers\\u003c/h1\\u003e\\u003cbr\\u003e\\u003cbr\\u003eCollect and upgrade a variety of Brawlers with powerful super abilities, star powers and gadgets! Level them up and collect unique skin.\\u003cbr\\u003eA fast paced battle royale MOBA made for mobile. Unlock and collect new, powerful \\u0026quot;brawlers\\u0026quot;, each with a signature attack and super ability.\\u003cbr\\u003e\\u003cbr\\u003e\\u003ch1\\u003eBrawl Pass\\u003c/h1\\u003e\\u003cbr\\u003e\\u003cbr\\u003eComplete quests, open Brawl Boxes, earn Gems, pins and an exclusive Brawl Pass skin! Fresh content every season.\\u003cbr\\u003e\\u003cbr\\u003e\\u003ch1\\u003eBecome the star players\\u003c/h1\\u003e\\u003cbr\\u003e\\u003cbr\\u003eBattle to climb the local and regional PvP leaderboards to prove you’re the greatest MOBA brawler of them all! Join or start your own MOBA club with fellow players online to share tips and battle together. Climb to the top of the PvP leaderboards in global and local rankings.\\u003cbr\\u003e\\u003cbr\\u003e\\u003ch1\\u003eConstantly evolving MOBA\\u003c/h1\\u003e\\u003cbr\\u003e\\u003cbr\\u003eLook out for new \\u0026quot;brawlers\\u0026quot;, skins, maps, special events and game modes in the future. Customize Brawlers with unlockable skins. Enjoy PVP battles solo or with friends online.\\u003cbr\\u003eNew PVP and PVE events and game modes daily. Player designed maps offer challenging new terrain to master.\\u003cbr\\u003e\\u003cbr\\u003eFrom the makers of “Clash of Clans”, “Clash Royale” and “Boom Beach”!\\u003cbr\\u003e\\u003cbr\\u003eThe IGRS Rating for this game is 15+\\u003cbr\\u003e\\u003cbr\\u003eNotice of Access Permission:\\u003cbr\\u003e[Optional permission]\\u003cbr\\u003eBrawl Stars may request permission via in-game pop ups to access your camera and send you notifications.\\u003cbr\\u003eCamera: For in-game scanning of QR codes\\u003cbr\\u003eNotifications: For sending notifications related to the game\\u003cbr\\u003eConsent is optional and you can use the app and play the game regardless of whether or not you consent. You may refuse to give consent within the game. However, certain app features may not work properly if you refuse optional access permissions.\\u003cbr\\u003e\\u003cbr\\u003eSupport:\\u003cbr\\u003eContact us in-game via Settings \\u0026gt; Help and Support — or visit http://help.supercellsupport.com/brawlstars/en/index.html\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy:\\u003cbr\\u003ehttp://supercell.com/en/privacy-policy/\\u003cbr\\u003e\\u003cbr\\u003eTerms of Service:\\u003cbr\\u003ehttp://supercell.com/en/terms-of-service/\\u003cbr\\u003e\\u003cbr\\u003eParent’s Guide:\\u003cbr\\u003ehttp://supercell.com/en/parents/\"],\"Supercell\",\"500,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/7oc_JyKwUZ56fvWt_frWzt5jjgeRNwBnkvecffZvMeNxlnJIub20oOdP9boZ3-qvlk5S3A4K04-Js2iWDGQzvQ\"],null,[141,194,251,255]],null,[\"Everyone 10+\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/csiz76udPjXmaJddU_1sanHGlQAAbKkvlprK3DSUNmwu1nY3U6qnXRrI2IDMaivooYK1x11oxz3PEO4z\"]],[null,\"Fantasy Violence, Crude Humor\"],[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/bxs95MghtAOuZR_LPwVCUmUPYEvXsGVOH3chF1OCX0-Ns_S0qdHnzml2CGCgOGbYlftKsmt9gtpxLb8U\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.supercell.brawlstars\\u0026rdid\\u003dcom.su