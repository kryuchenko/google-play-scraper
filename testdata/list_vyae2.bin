,\"https://play-lh.googleusercontent.com/h9KarYycDxxtRntI6A6QlRbIq3bUVSIsMkjKNAjK1z82BJmn3db8zUlaUlzmo_FE8pGbQ_5fNQO_K9xJiudAxg\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/dJDx0grGTibx-m9WvVBkpnmMReTs4n2BjONsAr65N4CND_8IOupNxnlxxDRUYKs1lPV1u4iAPnRVixzoKnNu_g\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/1dUwmb-DbJLsly4_wsF_WTDTIqIOprcWUdnBjH65KxP-GZkPdngTHPoct5gGO50rIjwZmepK1negxmShybLTrA\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/5WRim6v-iNwYqUdWpRozSEmBnX7UnfZttXKru_7SBKDn--vhAoldZAl0Uac2rw_8iYoQLMNR6nwUVWh02Ns3\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/zkfd1TF9nz0RyfaaghLjzexReKtEwfYZQQd8bOBLHUX6pKJaNWDOIaJPxaOgjmgB6tBs5uGYc1tKiU3N4U1I\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/PZoXpq3AMc2TLm14SYL8xrvZ0uxgC9zINcDHCCJQysMnFFjOUFf4IsCEoy2c8PcA_wRcxkWCVVZ5K7PVo5XFX5o\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/h9KarYycDxxtRntI6A6QlRbIq3bUVSIsMkjKNAjK1z82BJmn3db8zUlaUlzmo_FE8pGbQ_5fNQO_K9xJiudAxg\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/dJDx0grGTibx-m9WvVBkpnmMReTs4n2BjONsAr65N4CND_8IOupNxnlxxDRUYKs1lPV1u4iAPnRVixzoKnNu_g\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/1dUwmb-DbJLsly4_wsF_WTDTIqIOprcWUdnBjH65KxP-GZkPdngTHPoct5gGO50rIjwZmepK1negxmShybLTrA\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/5WRim6v-iNwYqUdWpRozSEmBnX7UnfZttXKru_7SBKDn--vhAoldZAl0Uac2rw_8iYoQLMNR6nwUVWh02Ns3\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/zkfd1TF9nz0RyfaaghLjzexReKtEwfYZQQd8bOBLHUX6pKJaNWDOIaJPxaOgjmgB6tBs5uGYc1tKiU3N4U1I\"]]],\"You Know: Associations\",[\"4.3\",4.319328],\"Card\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tripledot.cardassociation\\u0026rdid\\u003dcom.tripledot.cardassociation\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.tripledot.cardassociation\"]],[\"qgJnGmUIIUoTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCOQojCh1jb20udHJpcGxlZG90LmNhcmRhc3NvY2lhdGlvbhABGAMSEgoECAEQAQoECAMQAQoECAQQAQ\\u003d\\u003d\"],null,[null,\"You Know: Associations is a fast, competitive card game where every move matters. Match by colour or category, play smart power cards, build strong combinations, and outscore your opponents in a fun and rewarding card association experience. If you enjoy a card game with strategy and satisfying card connect mechanics, You Know: Associations is made for you.\\u003cbr\\u003e\\u003cbr\\u003eIn this multiplayer card game, you take turns matching cards by CATEGORY or COLOUR. It sounds simple, but every round is full of pressure, timing, and powerful combinations. Use Flip, Block, Take 2, Change Category, and Change Category \\u0026amp; Take 4 to control the table and create major momentum swings. Whether you love a quick card game or a card connect challenge, this game keeps every round fresh.\\u003cbr\\u003e\\u003cbr\\u003eFEATURES:\\u003cbr\\u003e• Multiplayer card game for 4 players\\u003cbr\\u003e• Easy-to-learn card association rules\\u003cbr\\u003e• Match by category or colour\\u003cbr\\u003e• Create smart combinations and chain powerful plays\\u003cbr\\u003e• Enjoy strategic decisions in every turn\\u003cbr\\u003e• Use special action cards to flip, block, stack, and change category\\u003cbr\\u003e• Competitive coin rewards for top players\\u003cbr\\u003e• Quick matches with strategic depth\\u003cbr\\u003e• Resume your game if you return shortly after leaving\\u003cbr\\u003e\\u003cbr\\u003eYou Know: Associations combines the instant fun of a classic card game with strategic gameplay and satisfying card connect action. Every hand gives you new combinations to explore. Every round of card association challenges you to think ahead, manage risk, and hold the right cards for the perfect moment. If you like a card game that rewards smart choices, this is the card association game to download.\\u003cbr\\u003e\\u003cbr\\u003eHOW TO PLAY\\u003cbr\\u003e\\u003cbr\\u003ePlay one card at a time by matching the top card on the discard pile. You can match by category or by colour. If you cannot play, draw a card. Power Cards let you reverse the turn order, skip the next player, or make them draw cards. Special Cards let you change the category or put even more pressure on your opponents.\\u003cbr\\u003e\\u003cbr\\u003eStacking adds even more excitement. When a Take 2 or Change Category \\u0026amp; Take 4 card is played, the next player can answer with another penalty card instead of drawing. This creates bigger combinations and raises the total until someone cannot continue. That player takes all stacked cards and loses their turn. These high-pressure moments make every card game round more intense and strategic.\\u003cbr\\u003e\\u003cbr\\u003eWin by playing all your cards or by finishing with the lowest score when the game ends. Base Cards are worth 5 points, Power Cards are worth 20, and Special Cards are worth 50. Strong card association strategy, careful combinations, and smart card connect decisions are the key to victory. Place in the top 2 to earn coins, build your balance, and join more matches.\\u003cbr\\u003e\\u003cbr\\u003eIf you are searching for a card game with card association strategy, clever combinations, and exciting card connect action, You Know: Associations delivers it all. Download now and enjoy a card game that is easy to start, fun to master, and packed with replay value.\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy:\\u003cbr\\u003eTerms of Use:\\u003cbr\\u003eContact Us:\"],\"Tripledot Studios Limited\",\"100,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/YGOhsDmKFl7rZD3V1nkXdUIVw1ldDtivLxvx3QiGCrHtFYox44oduVIhfyb6I2_F0sJUBvllSjg0nerHYoN_\"],null,[46,101,33,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,[null,\"Content is generally suitable for all ages. May contain minimal cartoon, fantasy or mild violence and/or infrequent use of mild language.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tripledot.cardassociation\\u0026rdid\\u003dcom.tripledot.cardassociation\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Card\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.oakever.tiletrip\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/wKjQKwVmmmszLHE3YfgRqiSZcDKHcnpGBeLDVs2PERYUq0B9c_LxpM8jOXYcdE-oVhPmXcWnfqUaBKR656TSBA\"],null,[239,237,235,255],null,null,null,2],[[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/woWw6VkKqNbsY6q7yfQmZadOwM4q9KJXu3bxPt030kOyJMdYbfSUb3XtvCVYfI1V8gapN5mtJnFI5ImSpVC8DA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/EbqtmQFRhHXRNVX_74PekVV8MYMgRInaKC4mXhqh0kZxKdutUMYNISm6CYt84Gue5_2hPJbt-oo5ma