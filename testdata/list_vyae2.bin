Rdw75EnO2kLOnnyG4bzOFuPwC3T7S1toAl6pWmfyba20SssopHCp3DdSLNu9mqqFB_uH4f5mJxUGjEk\"]],[null,2,[1440,2560],[null,null,\"https://play-lh.googleusercontent.com/WE_RTF9Mr7glvR694SaojRXssOfk7f4rViVensLwWYkgeQrKQtNsVjG4jKbdz-wGcjAe5_vC4-vUNnzNfQZBBio\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/aPB4OcVyelcxXuAsKP4Xf3tjKW-bHxZ9rhP8VfmhzJwsMka6ACitpf5_fpFpgewu-HM2bgpYduN38AK2IcaVwQ\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/zQVooA5zsUVgjNW0nj5-jaZmiBGF9TIKHZtfp47caF1HMzasXbTP3uu5DXbjShFUMKXky-t0pXQHYVlvHa9x\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/AV-XyW1f9PTRpN06EAm70y08iiX2-K6_nhspOT4FLQf8rll4__5GWEMSMPJvltz9t7noUC4o8m5whMQV0DCr7g\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/KsGXWnY95bdev8rKy59yqf3zCKv3HCn9T_oDd0lcSa2PqL7Ulx7JIdemUwFAqcIm5M-bZrSoVJNIX3lqMJI5RQ\"]],[null,2,[1800,3200],[null,null,\"https://play-lh.googleusercontent.com/ane54jYDu2sqJDRsrEN6pX0XUX6lXoiqi7rqwwaygzpJWNoDAlVB04IgesS3VCq-VscD-O5AfSFSmghT4Pnw4xw\"]],[null,2,[1800,3200],[null,null,\"https://play-lh.googleusercontent.com/nSopcStpSxHkNu4wTSynOMJUVjVZ6ASSEVwn7uSoMEnM5ulbjvxIgerOzTrV85ePcLNlms5UoPj19Iup-j4s_pE\"]],[null,2,[1800,3200],[null,null,\"https://play-lh.googleusercontent.com/6J680Rdw75EnO2kLOnnyG4bzOFuPwC3T7S1toAl6pWmfyba20SssopHCp3DdSLNu9mqqFB_uH4f5mJxUGjEk\"]]],\"1 2 3 4 Player Games - Offline\",[\"4.7\",4.6506987],\"Arcade\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.JindoBlu.FourPlayers\\u0026rdid\\u003dcom.JindoBlu.FourPlayers\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.JindoBlu.FourPlayers\"]],[\"qgJjGmEInAFKEwitldb9jr+WAxWFeYQGHSiCKVL6AQ8KDQgAEgkKBWVuLVVTEAC6AjQKHgoYY29tLkppbmRvQmx1LkZvdXJQbGF5ZXJzEAEYAxISCgQIARABCgQIAxABCgQIBBAE\"],[[[null,null,\"AP1FzPenOn0\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:AP1FzPenOn0?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:AP1FzPenOn0\",null,[1920,1080],null,null,\"AXH1ezmH4IbSoyWwaqyoQ4OhvbIeE9i6rUpCQVMPMdnDyxgJSH3ZPXxWGki9HB7xhb9cjVASoyCzQ4e5lg7knEi15qPqjLBBjP1EeTiz0rSL20oPnBB7lqny-w5QBpteFL87Z1U6wo1Po5OSsdRXS4SqB8nDOycIT3quF7pW1EgMi-5k18p8AOtYgy4lkQ65Ek_G5HoZLGSkWoD5J25T0tuEo7aElp_ABGr-FfldyWdXVjL4mH-6hHQaYoJ_ZD8x-LtTdMx5XYA01MQt6frNDw-CsA2OQpn5hNBvncGCQphc3GQcBw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/AP1FzPenOn0/hqdefault.jpg\"]]]],[null,\"Can’t go online? Want to play offline?\\u003cbr\\u003eIf you want to play fun mini games with your friends all together on the same device, this is a great game for you!\\u003cbr\\u003eCompete with your friends and see who is best!\\u003cbr\\u003ePlay multiplayer pvp, 2v2, enjoy single player games, or play against the AI.\\u003cbr\\u003e \\u003cbr\\u003eChallenge your friends with this huge collection of games and minigames for 1, 2, 3 or 4 players. Enjoy puzzles, classic action arcade minigames, brain training and many more – we have a load of different games for you to play all in this one app. Try them all and decide your top choice.\\u003cbr\\u003e \\u003cbr\\u003eHere are just some of the games you can play:\\u003cbr\\u003e \\u003cbr\\u003eSnakes :\\u003cbr\\u003eDon\\u0026#39;t touch your opponent\\u0026#39;s body and stay alive! A simple goal but a challenge.\\u003cbr\\u003e \\u003cbr\\u003eTic tac toe :\\u003cbr\\u003eInstead of using pen and paper just open the app and challenge your friend on the same device! A two player classic!\\u003cbr\\u003e \\u003cbr\\u003ePool :\\u003cbr\\u003eThe classic pool game for 2 player on one device! Pot the balls to score!\\u003cbr\\u003e\\u003cbr\\u003ePaint fight :\\u003cbr\\u003eColoring race, to paint the paper fastest with your color!\\u003cbr\\u003e\\u003cbr\\u003eSpinner war :\\u003cbr\\u003ePush your opponent outside the stage! Two players on a small area are too much!\\u003cbr\\u003e\\u003cbr\\u003eMore classic fun like Archery, tug of war rope, whack a mole.\\u003cbr\\u003eOther brain games like Memory, maths, solitaire, jigsaw puzzles.\\u003cbr\\u003eRacing cars, sword duels, and much more!\\u003cbr\\u003ePlus, even more new games coming soon!\\u003cbr\\u003e \\u003cbr\\u003eAll these games in one app for 1 2 3 4 players. Get the collection for free now, and enjoy local multiplayer on one device / one phone / one tablet, and bring the fun to the party!\\u003cbr\\u003eDisclaimer: this multiplayer game can ruin friendships!\"],\"JindoBlu\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/OluzR89ONbfMYtc1Tch2QR21WMfeQVKMMN1lFgpJ5fTCpz4ekfU-_pWinIzR5GXxZZgifTW03S2tidwh-aZ6\"],null,[239,246,249,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],[null,\"Mild Fantasy Violence\"],[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.JindoBlu.FourPlayers\\u0026rdid\\u003dcom.JindoBlu.FourPlayers\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Arca