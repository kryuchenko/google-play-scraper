null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ea.gp.fifamobile\\u0026rdid\\u003dcom.ea.gp.fifamobile\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.ea.gp.fifamobile\"]],[\"qgJmGmQISUoTCMrn6+an/ZQDFaMJswYdIssGi/oBFwoVCNmZ8/SQz6CPQxIJCgVlbi1VUxAAugIwChoKFGNvbS5lYS5ncC5maWZhbW9iaWxlEAEYAxISCgQIARABCgQIAxABCgQIBBAD\"],[[[null,null,\"xpfsH7mzCL8\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:xpfsH7mzCL8?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:xpfsH7mzCL8\",null,null,null,null,\"AXH1ezmcKvkv1czBsgziJaewbAn-miw_Y31yqABUrS6Ri6zPcpIMS_mS3-NKGjeYFncOXFVoT6z3MkIstBIGD17vJCumxOYWb55Ehr8heao7DjWzB5tYt3ZO2h-4FexO7uycTi-b7rXSfRylM2jmQoPcLUn60ByOggd7QfDBzqvIoIsuWIFmxjOzJ3cikLqQFsxm33B914xKq5QFMPtD_eoAwPb3TZjvzDvKDIfCTNV-zBn-QWKActWpQkCB5y-qgCSNmHhKwhffcPDZhyb3R0n2JGpdkytXl1Jmqy1OpZjGBRIahWdls-o8zEoC6Zj17kE\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/xpfsH7mzCL8/hqdefault.jpg\"]]]],[null,\"This game includes optional in-game purchases of virtual currency that can be used to acquire virtual in-game items, including a random selection of virtual in-game items. \\u003cbr\\u003e\\u003cbr\\u003ePlay EA SPORTS FC™ Soccer, the ultimate online soccer game on mobile. \\u003cbr\\u003e\\u003cbr\\u003eCompete for national glory in The 2026 World’s Game Tournament \\u0026amp; build your dream Ultimate Team in this online multiplayer soccer / football game. Compete in real-time PvP matches with friends and play live events during the 2026 summer of soccer with 50+ officially licensed national teams, players, clubs, and competitions from around the world.\\u003cbr\\u003e \\u003cbr\\u003eTHE WORLD’S GAME TOURNAMENT\\u003cbr\\u003eTake part in a global soccer tournament. Choose your national team and compete to become champions and lift the cup in this soccer / football competition experience.\\u003cbr\\u003e- Select from over 50 national teams including Brazil, USA, Portugal \\u0026amp; more\\u003cbr\\u003e- Score big goals with heroes from each nation\\u003cbr\\u003e- Play through tournament brackets or customizable match games\\u003cbr\\u003e- Earn rewards based on performance\\u003cbr\\u003e- Replay tournaments and try different paths to victory\\u003cbr\\u003e\\u003cbr\\u003eBUILD YOUR 2026 ULTIMATE TEAM\\u003cbr\\u003ePlay as top soccer players and modern superstars like Jude Bellingham, Virgil van Dijk, and Cole Palmer, along with classic ICONs including David Beckham, Ronaldinho, Zinedine Zidane, and Ronaldo Nazário. \\u003cbr\\u003eDraft hero players from legendary teams including Real Madrid, Liverpool \\u0026amp; Chelsea. \\u003cbr\\u003e \\u003cbr\\u003eQUICK MATCH WITH FRIENDS\\u003cbr\\u003eJump into a soccer game instantly with Quick Match\\u003cbr\\u003e- Choose your Club, National Team or your Ultimate Team\\u003cbr\\u003e- Invite friends for a fast soccer match \\u0026amp; see who can score most\\u003cbr\\u003e- Play fast-paced games and play with true champs\\u003cbr\\u003e\\u003cbr\\u003eREAL-TIME PvP MULTIPLAYER\\u003cbr\\u003ePlay online soccer matches against other players worldwide in competitive PvP modes:\\u003cbr\\u003e- 1v1 Head-to-Head (H2H)\\u003cbr\\u003e- VS Attack\\u003cbr\\u003e- Club Challenge\\u003cbr\\u003e- Soccer Manager Mode - prove you are the top manager\\u003cbr\\u003e\\u003cbr\\u003eCOMPETE WITH FRIENDS\\u003cbr\\u003e- Compete in Division Rivals \\u0026amp; climb ranks in competitive online multiplayer.\\u003cbr\\u003e- Join a League to earn rewards as a team\\u003cbr\\u003e- Play multiplayer tournaments and seasonal competitions \\u003cbr\\u003e \\u003cbr\\u003eAUTHENTIC SOCCER / FOOTBALL GAMEPLAY\\u003cbr\\u003e- Fluid passing \\u0026amp; fast controls\\u003cbr\\u003e- Choose team formations and soccer tactics \\u003cbr\\u003e-  Authentic player attributes, skill moves, and PlayStyles that match real world soccer players\\u003cbr\\u003e- Smart matchmaking and gameplay balance\\u003cbr\\u003e \\u003cbr\\u003eOFFICIAL PLAYERS, CLUBS AND COMPETITIONS\\u003cbr\\u003ePlay with over 19,000 real soccer superstar players from 690 teams across 35 leagues, including the UEFA Champions League, Premier League, LALIGA EA SPORTS, Bundesliga, Serie A, and Ligue 1 from the 2026 season. \\u003cbr\\u003e\\u003cbr\\u003eLIVE EVENTS AND REWARDS\\u003cbr\\u003eComplete daily training and quests to earn rewards\\u003cbr\\u003e- Play live events to earn \\u0026amp; upgrade players. \\u003cbr\\u003e- Improve your soccer team throughout the 2026 season.\\u003cbr\\u003e- Enjoy arcade-style mini games \\u0026amp; football trivia for more rewards  \\u003cbr\\u003e\\u003cbr\\u003eBuild your soccer / football Ultimate Team, compete in online PvP, and play your way in EA SPORTS FC™ Mobile.\\u003cbr\\u003eThis app: Requires acceptance of EA’s User Agreement and Privacy \\u0026amp; Cookie Policy. Requires an Internet connection (network fees may apply). Contains direct links to the Internet and social networking sites intended for an audience over 13. Allows players (above the minimum age of digital consent in their country) to communicate via League chat; to disable for users under the age of majority with League chat access, use your device\\u0026#39;s parental controls.\\u003cbr\\u003e\\u003cbr\\u003eThis game includes optional in-game purchases of virtual currency that can be used to acquire virtual in-game items, including a random selection of virtual in-game items. \\u003cbr\\u003e\\u003cbr\\u003eUser Agreement: terms.ea.com \\u003cbr\\u003ePrivacy and Cookie Policy: privacy.ea.com \\u003cbr\\u003eVisit help.ea.com for assistance or inquiries. \\u003cbr\\u003eEA may retire online features after 30 days’ notice posted on ea.com/service-updates.\\u003cbr\\u003e\\u003cbr\\u003eNotice at Collection\\u003cbr\\u003ehttps://www.ea.com/legal/privacy-and-cookie-policy#information-for-california-residents\\u003cbr\\u003e\\u003cbr\\u003eYour Privacy Choices\\u003cbr\\u003ehttps://www.ea.com/legal/privacy-portal?modal-id\\u003dtargetedAdvertisingProvidedByThirdParties\"],\"ELECTRONIC ARTS\",\"500,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/5TcjrLCsy8_DYll3iYf6AfkjN3maI4Um-5aGm9gb6iHcz_HjrKV2cr4WUrxdHeWmmeQmKc4AVZCHtiYGAEupB84\"],null,[138,66,255,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ea.gp.fifamobile\\u0026rdid\\u003dcom.ea.gp.fifamobile\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.39 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Sports\"]],[null,null,null,[\"Soccer\"]],[null,null,null,[\"Sports\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.NewFolderGames.IAmCat\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/qPz2598bkAbZKDV5tm6-nt0xJdTeSp9rcw-msxEZAYUrvdEtHM8