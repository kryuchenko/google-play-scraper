/play-lh.googleusercontent.com/56dAwG7NiIVB3o1xEcLpGSZprg6A46p82_wvlcNPxFvB-0RGHwfb9OJzH3MZDkTvXUt3a_Ja1l2YmkKVArZEn_I\"]],[null,2,[2752,2064],[null,null,\"https://play-lh.googleusercontent.com/iwiEgUv35jcEJSqjwE3vQ98BaWtxBuBdEA6wxJKVGkos8uIONTxU9b0xYtwKFuqtuCwTqixV2BtarDndExCu\"]],[null,2,[2752,2064],[null,null,\"https://play-lh.googleusercontent.com/urZ0KCpkYM8so0fYsc_yvpVXT3fQCUeDaDmzxvDhSmdrnIqwy6Fl-PrX4z-BWxdNd9Sy4O-wq86XeYrMae-HcQ\"]],[null,2,[2752,2064],[null,null,\"https://play-lh.googleusercontent.com/ebfBsmAc1xkKqkp5pXJ3LEqo6LIqC82aXmJzlQqBRyMJN7IbpACzlXXwHJMkAlslsvmK8O_RPr4KWmzR30yDww8\"]],[null,2,[2752,2064],[null,null,\"https://play-lh.googleusercontent.com/EkjA0RR4cJvZbehqNJwykjGr6fc4da9o8KV6_68F9Ih55ggLnSvpCln5Fjf_JD40sfmbIsK8jqt-o1yjjsvLQA\"]],[null,2,[2752,2064],[null,null,\"https://play-lh.googleusercontent.com/mUKAd5qNHDkqsQis7NX33tFwp9P8vDyTzbnLqvOy8GusoK6a6Ncshq0yLtMN14H_irt1WIVSM6sAfPUeQa3i\"]]],\"Yarn Loop\",[\"4.5\",4.5090766],\"Puzzle\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.combo.yarnflow\\u0026rdid\\u003dcom.combo.yarnflow\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.combo.yarnflow\"]],[\"qgJcGloIJUoTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCLgoYChJjb20uY29tYm8ueWFybmZsb3cQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAQ\\u003d\"],null,[null,\"Yarn Loop is a relaxing and satisfying puzzle game featuring colorful yarn bobbins and knitted patterns.\\u003cbr\\u003e\\u003cbr\\u003eBobbins move onto the conveyor and collect stitches of their own color. Each bobbin has a capacity value that decreases as stitches are picked up. When its capacity reaches zero, the bobbin disappears. If capacity remains, the bobbin is transferred to the rack and can be used again later.\\u003cbr\\u003e \\u003cbr\\u003eComplete each knitted pattern by using the right bobbins in the right order.\\u003cbr\\u003e\\u003cbr\\u003eGame Features\\u003cbr\\u003e► Simple One-Tap Gameplay: Bobbins move smoothly through the conveyor system and collect matching stitches with ease.\\u003cbr\\u003e► Color-Based Collection Mechanic: Each bobbin clears only the stitches of its own color.\\u003cbr\\u003e► Capacity Management System: Every bobbin has a limited pickup value, creating thoughtful and satisfying puzzle decisions.\\u003cbr\\u003e► Rack Reuse Function: Bobbins that still have capacity return to the rack and remain available for later use.\\u003cbr\\u003e► Hundreds of Engaging Levels: New knitted layouts, color combinations, and puzzle arrangements appear throughout progression.\\u003cbr\\u003e► Cozy Yarn Aesthetic: Soft textures, warm colors, and pleasant animations create a calm and enjoyable experience.\\u003cbr\\u003e\\u003cbr\\u003eYarn Loop offers a smooth, calm, and visually charming journey through handcrafted yarn puzzles.\"],\"Combo Game\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/MntKpZCemrKE0EGg1-qb5Vm3EutWFA-3doCfeMjt_idSl1cLSHrYam8k9smSmqumDHEevF657_ZoSxaT-dpd\"],null,[100,79,135,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/