vynYqlH6UAfoKaMWfvEuOI_od9LVoJ9XDXZFLhHY0Z8tUyfqB6DxRh6tTSzsXCpwpsLnG1-QT\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/vMoPyqeX_oTCCJju8EGdJgy801pGWzdgAMqkoWGaQettdfKXIqogrwbf6D-YU2Eo6JUu6Wj1IMuyl6qHvsNh\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/wQWL1WaR7yuvOvC6pnurj_VCjfFB5LC1QNZULadrSoGCpSObHmpBwRf6pkRP23B9xBJocl8YdDbgvDWpjMWp\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/eZFLKlr9wvTYvSVUDZiDItDKhtxWQ-I3kWbs6srGegnewvBKARoJUw7t2LlT66rNDVDcH0Iod8Qw1htQrz6p\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/6Q4Vsp9W8OJaMI0XGnesCWzlfOKWh3-h81R9ZDFzsZOOGQAOfpOc4FszwmP_WQAVwfI0Kx_8LfFue8OrWShiAg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/Ct7wOvPwSThvynYqlH6UAfoKaMWfvEuOI_od9LVoJ9XDXZFLhHY0Z8tUyfqB6DxRh6tTSzsXCpwpsLnG1-QT\"]]],\"Fidget Toys Trading・Pop It 3D\",[\"4.7\",4.6629815],\"Simulation\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fidgettrading.game\\u0026rdid\\u003dcom.fidgettrading.game\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.fidgettrading.game\"]],[\"qgJgGl4IMkoTCMrn6+an/ZQDFaMJswYdIssGi/oBDwoNCAASCQoFZW4tVVMQALoCMgocChZjb20uZmlkZ2V0dHJhZGluZy5nYW1lEAEYAxISCgQIARABCgQIAxABCgQIBBAE\"],[[[null,null,\"H4vgzx5BqPg\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:H4vgzx5BqPg?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:H4vgzx5BqPg\",null,null,null,null,\"AXH1ezmEPXHg_xjUnOFxU7p8OX7flfHxokmyOWQ3yAfstz83anopZvNIMuHAaUPZYxH__g2macG4Ey5cAuU8QxWxrkGFplxrn4fIjvEOluUFRSkQvx51G6cTysB_ms7lJVKExilgz6UgBohO4efGRTY04uWysiWcdNT6G05A65FI25f4gIKrGpO3Io4FCRWCMNd3192OcidtIRfTPCKK0Thq0o9mezQzRm0tblS2LkfmhZnewEJH33pK88ykf-jGzDc_FKoYAScG_MLCX-2s1Ff05ZHmb_BOYRzPT0VYGnUuaeExDyI7PLsk5tqmaddccMI\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/H4vgzx5BqPg/hqdefault.jpg\"]]]],[null,\"Psst! Wanna some squishy magic? Get into the engrossing world of fun pop it games full of cool fidgets!\\u003cbr\\u003e\\u003cbr\\u003eOut of all antistress relaxing games, our fidget toys 3D sim will def let you chill out! You can get into it at home, in a park, at an airport—anywhere you seek stress relief or feel bored. Try yourself at a fidget trade and play with every cool and comforting pop it or squishy!\\u003cbr\\u003e\\u003cbr\\u003eOur pop it trading game will become your perfect solution to any situation! Have some sleep problems, or just being overwhelmed and needing anxiety relief? Get into this calm game developed for you to have fun and take a break from the outside world! Find it difficult to concentrate on a task? Try trading fidget toys 3D to refill your attention bar.\\u003cbr\\u003e\\u003cbr\\u003eThis amusing trade game gets you in the fidget toys trading filled with squishy puppets and bubble pop its of various shapes and colors! Ever tried squishing a unicorn or a pumpkin? Or pop it bat and dinosaur? Believe it or not, this is way more fun than just a spinner. \\u003cbr\\u003e\\u003cbr\\u003eThe more you swap, the more toys you’ll get. Throw any toy onto a table and wait for your opponent. Accept the offer and finish the fidget trade, or demand more. Reject it if you don’t like the bid. After every completed deal, you’ll also get coins! Upgrade the trading room or get new toys with them.\\u003cbr\\u003e\\u003cbr\\u003eOur trade game is better than other antistress relaxing games. Look at it yourself!\\u003cbr\\u003e\\u003cbr\\u003eGripping and bright gameplay. You should see through your opponent to hit the jackpot and master the fidget toys trading!\\u003cbr\\u003eSimple game mechanics. There are three options in this perfect game for stress-relief: swap, reject, or demand more. Don’t you think it’s easier than in any other slime simulator—yes or no?\\u003cbr\\u003eOne of the most popular fidget trading games for some stress relief. You can not only join the pop it trading, but also play with various puppets to unwind!\\u003cbr\\u003ePerfect game for concentration. Fidgets help us return our attention. So, to restore your energy, why not play some fidget trading games?\\u003cbr\\u003eFantabulous toys. This calm game has more than a spinner—a milk bag squishy puppet, a dinosaur simple dimple, and even a jellyfish bubble pop it! Get each of them in your chill games.\\u003cbr\\u003e\\u003cbr\\u003eGet every squishy puppet and pop it toy to find anxiety relief in this fascinating game! After all, it’s a unique blend of the fun of any slime simulator and the soothing mechanics of any stress-relief game.\\u003cbr\\u003e\\u003cbr\\u003eIt’s time you unleashed the squishy magic in one of the most engrossing chill games! Download this trading game now and master every deal with some fun pop it games! Are you ready? Yes or no?\"],\"Freeplay Inc\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Qx82BgD9mRzCFecqCq_clQ_ICXJEQVwfYxFt-iuVCobww0s-0M1xMO16EvP0IQXs_qfUKurSpUOyd3wFF1iKmQ\"],null,[171,31,252,255]],null,[\"Everyone 10+\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/csiz76udPjXmaJddU_1sanHGlQAAbKkvlprK3DSUNmwu1nY3U6qnXRrI2IDMaivooYK1x11oxz3PEO4z\"]],[null,\"Crude Humor\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/bxs95MghtAOuZR_LPwVCUmUPYEvXsGVOH3chF1OCX0-Ns_S0qdHnzml2CGCgOGbYlftKsmt9gtpxLb8U\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.