l,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dbeats.color.sing.star.rush\\u0026rdid\\u003dbeats.color.sing.star.rush\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dbeats.color.sing.star.rush\"]],[\"qgJsGmoIQkoTCMrn6+an/ZQDFaMJswYdIssGi/oBFwoVCN7Z65in8f2NQxIJCgVlbi1VUxAAugI2CiAKGmJlYXRzLmNvbG9yLnNpbmcuc3Rhci5ydXNoEAEYAxISCgQIARABCgQIAxABCgQIBBAE\"],[[[null,null,\"9MEHYvQcSYI\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:9MEHYvQcSYI?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:9MEHYvQcSYI\",null,null,null,null,\"AXH1ezkm15ptMMWMcQY7KLRah9fOkRPkyOcO9Ae8_cOXSMmmXHZofFFXakLB82bse6TBB6780nmbaY6gzGGTapCX0KkT39lOrfd76ic0bFB8Nuj4V3EW0ZaTW0XgsiqjXwfB3b0OT201saOREohyyt-O0jbieLhHejFVzG3SeWFzraL3zJfFpoqPugwOp7ESGSvbuZhi1TU7wLeg_oA5Q693ZxkWP84OIABocC7vdnQlY45Pv-4f9B4Z0pYE8LAXoG9g87bqmVxomDw7Wt2GAU_8FS_NvzPuXYvWeULvROlIirtPIAHa8SFz6QoDrd6M6S0\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/9MEHYvQcSYI/hqdefault.jpg\"]]]],[null,\"Magic Level 9 Music Piano Game\\u003cbr\\u003eUnlock songs. Discover secrets. Feel the rhythm!\\u003cbr\\u003e\\u003cbr\\u003eStep into a world where every tap reveals a musical surprise! 🎹 Piano Secret Tiles is the ultimate music adventure game that blends fun, rhythm, and mystery. Tap to the beat, unlock hidden songs, and explore stunning themes — all while collecting exciting gifts along your journey.\\u003cbr\\u003e\\u003cbr\\u003e🎵 Tap \\u0026amp; Play\\u003cbr\\u003eEasy to learn but thrilling to master! Feel the music flow as you tap through addictive piano challenges. Hit the right notes and keep up with the beat — one miss, and it’s game over!\\u003cbr\\u003e\\u003cbr\\u003e🎶 Unlock Hidden Songs\\u003cbr\\u003eEvery song is a secret waiting to be revealed! Progress through levels to uncover iconic hits, viral tracks, and exclusive melodies you won’t find anywhere else.\\u003cbr\\u003e\\u003cbr\\u003e🎁 Collect Gifts \\u0026amp; Surprises\\u003cbr\\u003eFrom coins to rare themes and premium tracks — unlock daily rewards and special surprises as you level up. The more you play, the more you earn!\\u003cbr\\u003e\\u003cbr\\u003e🌈 Customize Your World\\u003cbr\\u003eDiscover dreamy backgrounds, vibrant tile themes, and unique visual effects. Personalize your gameplay and make every tap feel like magic.\\u003cbr\\u003e\\u003cbr\\u003e🔥 Compete with Friends\\u003cbr\\u003eThink you\\u0026#39;re the fastest tapper? Prove it! Climb the leaderboard, beat your friends’ high scores, and show off your piano skills in real time.\\u003cbr\\u003e\\u003cbr\\u003eKey Features:\\u003cbr\\u003e🎼 Huge library of songs — from pop hits to relaxing melodies\\u003cbr\\u003e🎮 Multiple game modes for all skill levels\\u003cbr\\u003e🎨 Unlock and switch between beautiful visual themes\\u003cbr\\u003e🎁 Daily rewards, challenges, and gifts\\u003cbr\\u003e🌍 Global and friend leaderboards to track your progress\\u003cbr\\u003e🔓 Constant updates with new songs and surprises\\u003cbr\\u003e\\u003cbr\\u003eWhether you\\u0026#39;re a music lover or just looking for your next gaming obsession, Piano Game 9: Music Game will keep you coming back for \\u0026quot;just one more song.\\u0026quot; Download now and start unlocking the magic — one tile at a time!\"],\"Beatwave Studio\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/CVQMlwEo3g-Yv0dnK7cjiso-d0iQs7S3PqfWfkQ-qTmZTFmUS4CECis6MWnJg1V51gVShZvtaeawNY1jGqzVKlE\"],null,[251,222,254,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],[null,\"Mild Lyrics\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null