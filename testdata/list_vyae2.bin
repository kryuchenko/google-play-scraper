"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.playrix.gardenscapes\"]],[\"qgJjGmEIwAFKEwjK5+vmp/2UAxWjCbMGHSLLBov6AQ8KDQgAEgkKBWVuLVVTEAC6AjQKHgoYY29tLnBsYXlyaXguZ2FyZGVuc2NhcGVzEAEYAxISCgQIARABCgQIAxABCgQIBBAE\"],[[[null,null,\"WOxi5lnDshM\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:WOxi5lnDshM?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:WOxi5lnDshM\",null,null,null,null,\"AXH1ezkAwKmsdWKxccxZ5JTXEXfGFcS-FaswY9vNNmSgM17rPss8z1oMec_NGTm9DF8DUXgSCf9gFWi1o5VyJ7ptSOUZ3CH7KH3BCmTsuW76YVah6rgbcV8L60Phwr-zrzg-M-61qHkYiO90H8xe5NlV2CcOWdypPdpMNmuOMX4T-B5AUlgIhplOLoUKGgoY1WsP700tnf0R8CEAbUh9XzUuqzlOJDTEogSLZJwJVsMhjiFCjnVNTRQg78NQE_bm8bA06oU5GX8a7tgheaCJqbM8zEPUwRiCha-fqVtUXeOsqRIsYHm2_P_bQKi__jQ9UA0\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/WOxi5lnDshM/hqdefault.jpg\"]]]],[null,\"Welcome to Gardenscapes, the first game from the Playrix Scapes™ series! Make match-3 combinations and bring coziness and beauty to every corner of your garden.\\u003cbr\\u003e\\u003cbr\\u003eSolve fun puzzles, restore and explore new areas of the garden, and meet new friends in every chapter of the exciting storyline. Austin the butler is ready to welcome you to a world of incredible adventures!\\u003cbr\\u003e\\u003cbr\\u003eGame Features:\\u003cbr\\u003e● Gameplay loved by millions of players! Make match-3 combinations and decorate your garden while enjoying an entertaining story!\\u003cbr\\u003e● Over 16,000 captivating levels with explosive power-ups, useful boosters, and cool elements.\\u003cbr\\u003e● Exciting events! Embark on fascinating Expeditions, compete against other players in different challenges, and win awesome prizes!\\u003cbr\\u003e● One-of-a-kind garden areas with unique layouts, from fountain ensembles to island landscapes.\\u003cbr\\u003e● Loads of fun characters: meet Austin\\u0026#39;s friends and neighbors!\\u003cbr\\u003e● Adorable pets that will become your faithful companions!\\u003cbr\\u003e\\u003cbr\\u003ePlay with your Facebook friends, or make new friends in the game community!\\u003cbr\\u003e\\u003cbr\\u003eGardenscapes is free to play, but some in-game elements (including randomized items) can be purchased for real money.\\u003cbr\\u003e\\u003cbr\\u003eA Wi-Fi or internet connection is not required to play.\\u003cbr\\u003e *An internet connection is required to access competitions and additional features.\\u003cbr\\u003e\\u003cbr\\u003eDo you like Gardenscapes? Follow us!\\u003cbr\\u003eFacebook: https://www.facebook.com/Gardenscapes\\u003cbr\\u003eInstagram: https://www.instagram.com/gardenscapes_mobile/\\u003cbr\\u003e\\u003cbr\\u003eNeed to report an issue or ask a question? Contact Player Support through the game by going to Settings \\u0026gt; Help and Support. If you can\\u0026#39;t access the game, use the web chat by clicking the chat icon in the lower right corner of our website: https://playrix.helpshift.com/hc/en/5-gardenscapes/\\u003cbr\\u003e\\u003cbr\\u003eTerms of Use: https://playrix.com/terms/index_en.html\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy: https://playrix.com/privacy/index_en.html\"],\"Playrix\",\"500,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/IlnwZ4hs1xB5-tHlwLDYpe2LH-uWkwpPmZFSYLkymbB4IH2sZGoUUN980ewVQZfZ6R7yvIh0z5weBOKiUONVHA\"],null,[34,132,211,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null