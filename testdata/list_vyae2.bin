,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/nzeha0UTMZ0ll8JGcdyvWPw0SOUyJp3556hepZmZGgO_VitO74odRgVb1VsAwD101N37IygNFRBziujgNRQ3G5U\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/2dcdcUTt6knXqbUzyrYtx3mI5JqgE_bWY3yyeKuud9fsimSw3WeGsKSMEF15Zi6q50K8cHzmJNQubu8ZqA-xzgU\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/nfvNB5lfwlf3b8Ph1Kijt_VrHyc_PjXewQcPb0dweUWzYvJ6h5YexRUqvcS7CuWnNaUIFeGC0MrwJM9d9wfiRw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/CLXiJNO7fxDMvogpnghhWz-Tk1wtk9n025bJUXcj5DmK9ajM059o2EkVGR9r91zHi1wZ2c9kvGEfjLiXyTvi\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/ChGmzGF9vjOqrSQQB4ANN5t8qDNrmwCo_6IXEaCUXKnHrVrKwsjs2ddbQuRC7vPeNoB1u4jGWsw9fiqC3maf\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/JPAQcWW1O8U1DKjy3OosINpUG9I64q5oizzmqMieM2g7X931b1MvheUOztC9hIxWjVDRav3h1Etsay3Ut7wrZw\"]]],\"Brain Puzzle 3: Crazy Mind\",[\"4.6\",4.6108108],\"Puzzle\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.brain.crazy.joygame\\u0026rdid\\u003dcom.brain.crazy.joygame\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.brain.crazy.joygame\"]],[\"qgJhGl8IY0oTCMrn6+an/ZQDFaMJswYdIssGi/oBDwoNCAASCQoFZW4tVVMQALoCMwodChdjb20uYnJhaW4uY3Jhenkuam95Z2FtZRABGAMSEgoECAEQAQoECAMQAQoECAQQAQ\\u003d\\u003d\"],null,[null,\"Warning: This game may cause intermittent frustration, sudden bursts of laughter, and a strong desire to show off to your friends!\\u003cbr\\u003e\\u003cbr\\u003eSay goodbye to boredom! The Brain Puzzle series is back with a brand-new sequel, Crazy Mind—and this time, it\\u0026#39;s for real! 💥 We\\u0026#39;ve prepared countless mind-bending levels designed specifically to cure \\u0026quot;boredom\\u0026quot; and \\u0026quot;slow reflexes.\\u0026quot; Don\\u0026#39;t worry, this isn\\u0026#39;t an exam—it\\u0026#39;s a fun-filled mental adventure!\\u003cbr\\u003e\\u003cbr\\u003e💡 Think you\\u0026#39;re smart enough? That\\u0026#39;s because you haven\\u0026#39;t tried Crazy Mind!\\u003cbr\\u003eWe’ve taken things bigger, wilder, and more exciting! Get ready—your brain is about to go on the ultimate roller coaster! 🎢\\u003cbr\\u003e\\u003cbr\\u003e✨ Game Features :✨\\u003cbr\\u003e\\u003cbr\\u003e❖ A Huge Collection of Bizarre Levels: From dizzying visual puzzles, to quick-reflex challenges, to mind-melting logic traps… If you can imagine it, we’ve probably included it! You’ll be shouting, “Wait, that’s a thing?”\\u003cbr\\u003e\\u003cbr\\u003e❖ Sleek \\u0026amp; Simple Interface: Following the series\\u0026#39; clean and minimalist style, so you can focus entirely on solving puzzles and enjoy pure thinking fun.\\u003cbr\\u003e\\u003cbr\\u003e❖ Deep Cognitive Exploration: From pattern recognition to divergent thinking, we guide you step-by-step to explore the breadth and depth of your own mind.\\u003cbr\\u003e\\u003cbr\\u003e❖ Play Anytime, Anywhere: Waiting for the bus, standing in line, or taking a break… Whip out your phone anytime, anywhere, and give your brain a quick \\u0026quot;workout\\u0026quot; in just a few minutes!\\u003cbr\\u003e\\u003cbr\\u003eStill mindlessly scrolling through short videos? Come get something more nutritious!\\u003cbr\\u003eDownload now and see how far you can go! Your brain deserves this crazy party!\"],\"JoyGame Studio\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/9QUVKWzAaJsopw9JneSPHSBnANwJ0NCe28DS9OD0B-b4Wq_y069M9SMCotGClOJRfmkJaLbA77aUiJWjzxcIHeQ\"],null,[244,174,103,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null