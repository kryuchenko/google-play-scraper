],[null,2,[1280,768],[null,null,\"https://play-lh.googleusercontent.com/QGxdSmeqYtzSgIbj3NTlMn0zdCvp_5Wb208hSWzJJ3fp9J7NWReBlZmpzpaAKQkTQ5qTUajR-T4GqSa6xqyGZgk\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/3wth9OXUiiwbYUqgo8uaMU5G4BXgwPNQnw7Tb3T__dq1jBiElAO74AjtNtgzNa51O3LIevONC_qB09uKAm6dtw\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/RCntQAMvxnIgreupYAO0jgzgudMoB4v9q79U5WltsNHumt3_AdivxKnWYXBibvSS0VGl0I809qGL3C5G5Gjm9Yk\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/g5I4KsQtbLL-vHQFDKBhm8UQmbFZvauIgc9AndKBONh5bXGn-6ZOPz8lqFZdu4DRX1r2e7A1aJ8pXxW6rcDTAZs\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/680cJF6eJfqet9Dz6esdCKmLT29WeYcqigAzz6ePn1UTUoJqiZ6txI5lEpuwit1oRTPLtsQGJHvcZfVJJKK7\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/JiUQyoJ02USD2VBBAuw46PIc8qje04wkxQeHUibrqmBQf7S5YAkfd3bCQ44nX88XUerdExHy0nKu5T3oTc05\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/hYI6bS0EsdiWxzJBDu2tvb8juLyO9x39FHj0VXsweculqKnbgRuLRN1e0oww-csxCbBDFsz3GpAMFe7piwI2\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/rq8PM2jgx_9AOSh3b-CVKY9OgHKYCtOcdTODSqftkCAljMB-9_bGp9QlZHqVjGtASIBXpLFuPcRPOF48wFmIl8U\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/-NyRnOwkWu_5uU5nrfaq897qXbimAE-uvmefjXCd9Lql7MuVN0Zlf7EeUIwcbdd1eBW9YSSswvC63xn0XnVj1g\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/1xWZ2EsbNSd6PNAEVqYfojXnl29blBSDQl_St5rUKKgKRWYcwNGTC4m6wAeM8jqyyJJRkXwyry_dataSFiPx\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/ldQoxxWkcFRO3xd-F3YZ9Zec4s-NT9mUd9OXFH_CoFmPCKUlzsA8z1s3Ke49v68QRNf11zkM6q6w-rXFV1_tow\"]]],\"Candy Crush Saga\",[\"4.6\",4.627015],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.king.candycrushsaga\\u0026rdid\\u003dcom.king.candycrushsaga\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.king.candycrushsaga\"]],[\"qgJpGmcIZEoTCMrn6+an/ZQDFaMJswYdIssGi/oBFwoVCJvVzpP2l8WJQxIJCgVlbi1VUxAAugIzCh0KF2NvbS5raW5nLmNhbmR5Y3J1c2hzYWdhEAEYAxISCgQIARABCgQIAxABCgQIBBAE\"],[[[null,null,\"UPLO5JZvU2s\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:UPLO5JZvU2s?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:UPLO5JZvU2s\",null,null,null,null,\"AXH1ezksTZrLMQRWEQaa7kI3W_nYKXM8xms5mSpnrl_uOOTRRRA9Ov_0GHwPc3dPn85EAEmvYsiMcSUj9RMydeyKamW3thict_TVPxbL9NJhcIzst7VjtWApll_K3c_Cx8WaVVdnnPxFQIBP_sgWFiqgUo99jGp-WZvBXmA_8tBAqMHeGGeC0rYp37XAwkHWCkEsbZLhZ-h_FUZJtePQ5Xjkr2kylJN2mSWONCiuC5xhKxhME392bq7wUGIwgMRCq-I4n5X_ccBAOJmIe9sP3ogSIiASxXbX8RKhPnocrUwW7IF5E07sGxTBEvhuQjQqVY4\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/UPLO5JZvU2s/hqdefault.jpg\"]]]],[null,\"Candy Crush Saga is a bright, feel-good matching escape packed with colorful surprises, satisfying combos, and sweet moments of progress. Dive into a world of candy-coated challenges where every move can spark a delicious chain reaction. From quick relaxing breaks to longer play sessions, this playful puzzle adventure turns simple match 3 into pure fun.\\u003cbr\\u003e\\u003cbr\\u003e🍬 Why players keep coming back\\u003cbr\\u003eThousands of levels, creative obstacles, and candy-filled charm make every session easy to start and hard to put down. Each puzzle adds fresh twists, from Clear the Jelly to Rainbow Rapids, with jelly, chocolate, and other sweet blockers keeping the adventure lively while the fun stays light and accessible.\\u003cbr\\u003e\\u003cbr\\u003e🍭 What you can enjoy\\u003cbr\\u003e• Explore match 3 games filled with exciting combos, rewarding clears, and colorful surprises\\u003cbr\\u003e• Take on a match 3 puzzle with Color Bomb, Lollipop Hammer, and Jelly Fish boosters\\u003cbr\\u003e• Enjoy matching games that are easy to learn, satisfying to master, and full of fun twists\\u003cbr\\u003e• Use special candies and power-ups to solve each puzzle in delicious ways\\u003cbr\\u003e\\u003cbr\\u003e🚗 Play anywhere\\u003cbr\\u003eCandy Crush Saga fits quick sessions and longer play whenever you want a fun escape. This matching adventure feels smooth at home or on the go, with flexible play that suits every mood. Offline support lets you keep crushing through levels without missing the fun, and for anyone looking for an offline game, that makes every session easy to enjoy.\\u003cbr\\u003e\\u003cbr\\u003e🍫 More sweet reasons to play\\u003cbr\\u003eDaily rewards, limited-time events, and regular updates keep the experience fresh. Whether you love puzzle games with a relaxed rhythm or want a match 3 game that becomes more challenging over time, Candy Crush Saga keeps the adventure going with new levels, helpful boosters, and classic King charm. \\u003cbr\\u003eLooking for more brain-teasing fun? Try Candy Crush Soda Saga or Farm Heroes Saga for fresh twists on classic match 3 puzzle play. Or dive into sweet solitaire action with Candy Crush Solitaire.\\u003cbr\\u003e\\u003cbr\\u003e✨ Frequently asked questions\\u003cbr\\u003eWhat kind of game is Candy Crush Saga? Candy Crush Saga is one of the most popular match 3 games, blending bright visuals, clever matching, and rewarding progression.\\u003cbr\\u003eCan I play without wifi? Yes, many levels support offline play, so it works well as part of your offline routine.\\u003cbr\\u003eIs it good for solo play? Yes, it is a single player game that you can enjoy at your own pace.\\u003cbr\\u003e\\u003cbr\\u003e🍀 Start your candy adventure\\u003cbr\\u003eJump in, match your way through delicious levels, discover sweet surprises, and see why Candy Crush Saga remains a favorite for puzzle fans around the world.\\u003cbr\\u003e\\u003cbr\\u003eCandy Crush Saga is free to play, but optional in-game items require payment. You can turn off the payment feature in your device’s settings.\\u003cbr\\u003eBy downloading Candy Crush Saga, you agree to our terms of service at https://king.com/termsAndConditions.\\u003cbr\\u003eDo Not Sell My Data: King shares your personal information with advertising partners to personalize ads. Learn more at https://king.com/privacyPolicy.\"],\"King\",\"1,000,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/3_N72mNkXUluEvEtrNNin1hqbTMv_oP_dN1rpkouZmOQHWyJHPLzuMlBxkMtU0HPIj4PSWsnRtuun1kRKvspS3Q\"],null,[16,163,253,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.king.candycrushsaga\\u0026rdid\\u003dcom.king.candycrushsaga\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $149.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Puzzle\"]],[null,null,null,[\"Match 3\"]],[null,null,null,[\"Casual\"]],[null,null,null,[\"Offline\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com