,[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/ad49uC7_O2D6vzWQl6vohi71Hvg-eL1BTbM278g_q14rAUETCm0Qcvhsi_zLLJCOG1GLl3WkDoqtbT1da2P_\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/9YCpgQ6lr_hSTkmV5QxP5tjoY1CAnIkrgymANWxdtZWhM98e46izLhI2d4Gg0CD-iJ_UvjiD1GG_I_R1wY8E\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/HMstO-8rENRzhXSUHhPR7peZWKaz3DgwELsloVLKysmA_LlziB42GATHtYfwJCJFm1mDXMzEcCtAUQI4i3QYlrY\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/U4s313EQsOKGMxukfi4JqDUYW-CNBrJIwOCNpTmLLAlIhN5Agzy8T3YTDNuLiP1KEp2YB7DNr8lPnXEn4dsI\"]]],\"Arrow Out\",[\"4.6\",4.628627],\"Puzzle\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.arrow.out\\u0026rdid\\u003dcom.arrow.out\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.arrow.out\"]],[\"qgJXGlUIDEoTCMrn6+an/ZQDFaMJswYdIssGi/oBDwoNCAASCQoFZW4tVVMQALoCKQoTCg1jb20uYXJyb3cub3V0EAEYAxISCgQIARABCgQIAxABCgQIBBAD\"],null,[null,\"Arrow Out is a clever directional puzzle where every move matters, designed for fans of brain and mind challenges. Your goal is simple: guide the right arrow through the maze and reach freedom in this smart escape experience.\\u003cbr\\u003e\\u003cbr\\u003eRotate arrows, shift tiles, and plan ahead using pure logic and spatial thinking. Smooth flow and responsive tap controls make every decision feel precise and satisfying.\\u003cbr\\u003e\\u003cbr\\u003eWith gradually increasing difficulty and thousands of handcrafted levels, Arrow Out stands among the best games for iq improvement, training, and problem solving. Each level works like a compact teaser, pushing you to think ahead and adapt.\\u003cbr\\u003e\\u003cbr\\u003eWhen a level gets tricky, helpful boosters are there to support you:\\u003cbr\\u003eUse Zoom to closely inspect complex paths, Hint to reveal a helpful move, Magic Wand to break through difficult situations, Rubber to erase mistakes, and Grid Scale to adjust the board for better visibility and planning.\\u003cbr\\u003e\\u003cbr\\u003eGame Features\\u003cbr\\u003e• Direction-based logic puzzles with evolving mechanics\\u003cbr\\u003e• Relaxing yet challenging brain training games experience\\u003cbr\\u003e• Thoughtful escape puzzle and shape escape level design\\u003cbr\\u003e• Offline-friendly play with no wifi games for free\\u003cbr\\u003e• Precision controls, helpful boosters, and a comfortable dark mode for extended play\\u003cbr\\u003e\\u003cbr\\u003eArrow Out blends brain games, mind games, and smart interaction into a polished experience that rewards patience and clever thinking.\\u003cbr\\u003e\\u003cbr\\u003eCan you find the way out — or will your arrows go in circles?\\u003cbr\\u003e\\u003cbr\\u003eVisit https://lionstudios.cc/contact-us/ if you have any feedback, need help beating a level, or have any awesome ideas you would like to see in the game!\\u003cbr\\u003e\\u003cbr\\u003eFrom the studio that brought you Wordle!, Match 3D, Happy Glass, Hexa Sort, and many, many more!\\u003cbr\\u003e\\u003cbr\\u003eFollow us to get news and updates on our other award-winning titles:\\u003cbr\\u003ehttps://lionstudios.cc/\\u003cbr\\u003eFacebook.com/LionStudios.cc\\u003cbr\\u003eInstagram.com/LionStudioscc\\u003cbr\\u003eTwitter.com/LionStudiosCC\\u003cbr\\u003eYoutube.com/c/LionStudiosCC\"],\"Lion Studios Plus\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/rmolVnypXiDxMTJ1H0OnuHKm24VDgyUlkC2qoLurUst0e4fS36xjINZG3HAkoI3Du5to417XL_-v6klU0buL\"],null,[27,27,43,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,null,[null,\