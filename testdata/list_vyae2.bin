[null,null,\"https://play-lh.googleusercontent.com/IRTaIZgd0-eGSripT4pvIV6gA6qMPIbwakEsTmqP9aQ-9Cu-Nttl1A5quC0q5FTwyv9HwfdmIJdZ-MTecCEv4w\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/ymnW6F9N7fbtVWd9BiB35q6fcvjcOGOwPHyV2OEMibaL_IssUkR3e4vQB_Y0dNHgmJ_jkD-WPHmzQ0WF_z-xDZM\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/TFIuBN7Tc_txZruEJv9PmNF6KIazY9b6FRVFpgEp7v3msmDtxFTkUgJtWFA1HJHPqlLNWcPTaWC-L3Y1uWGZ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/dtKGVMsfvbUFDuhvR2ElgYFpw0kCOn8VxanoH8RIflEs-0ExIY7wUfQHbm6Lf9Zw7CDIZ3cGFm2TKOL4rHPeQSY\"]]],\"Cat Beats - Tiles Music Games\",[\"4.6\",4.6030927],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcats.tap.dacing.games.free\\u0026rdid\\u003dcats.tap.dacing.games.free\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcats.tap.dacing.games.free\"]],[\"qgJlGmMIjgFKEwitldb9jr+WAxWFeYQGHSiCKVL6AQ8KDQgAEgkKBWVuLVVTEAC6AjYKIAoaY2F0cy50YXAuZGFjaW5nLmdhbWVzLmZyZWUQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAQ\\u003d\"],null,[null,\"Step into the rhythmic world of Cat Beats, a charming and energetic rhythm adventure where adorable cats meet exciting song games action. If you are looking for cute games, challenging rhythm games, and engaging piano game mechanics, this musical journey is made for you. Feel every beat, follow the melody, and let your paws dance across glowing tiles in this fun collection of free games.\\u003cbr\\u003eIn Cat Beats, you guide music-loving kitties through colorful stages. It is the ultimate cats game for players who love cat music games. Tap, hold, and slide to stay on beat and complete each track. Whether you love Kpop games, challenging rhythm challenges, or just want a relaxing music game escape, every stage offers smooth controls and satisfying feedback for players of all ages.\\u003cbr\\u003e🐾 A Rhythm Journey Filled with Musical Magic \\u0026amp; Meow Meow Fun\\u003cbr\\u003e• Engaging Music Games Gameplay Enjoy intuitive rhythm game mechanics that blend tapping, sliding, and following melodies. Unlike other titles, we focus on the flow of the cat songs. Each level uses vibrant tiles that react to your timing. Progress through tracks that grow more exciting, making this one of the most addictive fun games available.\\u003cbr\\u003e• Dancing Cats \\u0026amp; Cute Characters Unlock cute cat performers with unique animations. Watch them jump, flip, and become dancing cats across the screen, bringing charm to every moment. Listen to the meow meow sounds as you collect cats, upgrade them, and see them shine in each cat piano games stage.\\u003cbr\\u003e• Smooth Piano Game Rhythm Experience familiar gameplay enhanced with lively visuals. Whether you prefer calm tracks or energetic beats, the piano game action is smooth and enjoyable. Each tap on the tile moves your cat toward rhythmic mastery.\\u003cbr\\u003e• Massive Song Library: From Pop to Kpop Music Play an expanding playlist of catchy tracks, relaxing melodies, and energetic rhythms. From classic pop to trending Kpop music and anime-inspired tunes, this music games collection has something for every player. It’s a song game where you can enjoy your favorite hits anytime.\\u003cbr\\u003e• Play Anywhere – No Wifi Games Needed Enjoy a flexible rhythm adventure perfect for players who need offline games. Play quick sessions during breaks or longer runs at home without an internet connection. No wifi games mean your cat music games are always available when you want a relaxing musical escape.\\u003cbr\\u003e🎮 HOW TO PLAY\\u003cbr\\u003e- Tap, hold, or slide on glowing tiles to match the beat.\\u003cbr\\u003e- Guide your cute cat across each melody without missing a step.\\u003cbr\\u003e- Complete cat songs to unlock new feline characters.\\u003cbr\\u003e- Master harder stages to sharpen your rhythm games skills.\\u003cbr\\u003e- Use headphones for the wonderful music game immersion.\\u003cbr\\u003eCat Beats brings rhythm, cats, and creativity together in an engaging and colorful world. Every level blends energetic action with smooth sequences and joyful animations. Whether you want a relaxing break or a fun rhythm game challenge, this collection of free games delivers long-lasting enjoyment.\\u003cbr\\u003eIf you enjoy music games, cat themed adventures, or simply want a refreshing piano game experience with Kpop games vibes, Cat Beats offers it all with style and charm.\\u003cbr\\u003eDownload Cat Beats now and let your cat groove! Feel the rhythm, follow the beats, and enjoy a delightful world of musical free games anytime you play.\"],\"Runyou\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/8eL0E0cetLMP97S9zITkvKogY1M13-K1YSneBIVathF3flVpG0UsmXTUJITYlrlAus0gx8-XGKsuOsNKyDNqjhY\"],null,[138,58,254,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,[null,\"Content is generally suitable for all ages. May contain minimal cartoon, fantasy or mild violence and/or infrequent use of mild language.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcats.tap.dacing.games.free\\u0026rdid\\u003