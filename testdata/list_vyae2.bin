]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.loomgames.pixelflow\"]],[\"qgJhGl8IF0oTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCMwodChdjb20ubG9vbWdhbWVzLnBpeGVsZmxvdxABGAMSEgoECAEQAQoECAMQAQoECAQQBA\\u003d\\u003d\"],[[[null,null,\"Hbi1fzQ7ggw\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:Hbi1fzQ7ggw?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:Hbi1fzQ7ggw\",null,null,null,null,\"AXH1ezkyPpPk0yJjtvETKMgXFR-Dcq0EqNI4437FaqtmBCGsBJ5N85E3RhV1tHA9LquuuGwmS6MCUmoPFmLU2dcYBqfQ4iU_Kyk0QIWaPNLVSZWuZGn4-P_opZ9wCln5Bt8b2hBgnTj1AW2JhFs-ITeodOzqZYXfFvMdbheVELRa6tZzSk0ng67w55R_C15ycSri2NLbooBGjF7NGSP2AYfiWTTzCopW-aSS6HauPj_eyos0r9q6G190Gc9g7-V-6Ehx8E_2xvrsK1fVCWhmj-_017c6VHfUxBM_YJhMH-P19ZUHZA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/Hbi1fzQ7ggw/hqdefault.jpg\"]]]],[null,\"Conveyor’s ready, pigs are on standby. Tap to send a pig onto the conveyor so it rains balls onto pixel cubes of its own color. The number above its head is its ammo: that’s how many hits it makes. Run out and it leaves the stage; if not, it slips into one of the 5 waiting slots and, when you tap again, it jumps back on the conveyor to fire another round.\\u003cbr\\u003eThe conveyor has a capacity—push past the limit and you’ll need to wait. Send them in the right order, manage the flow, and hit the cubes to clear the board piece by piece. Simple mechanic, sticky loop: tap → flow → repeat.\\u003cbr\\u003eHighlights\\u003cbr\\u003eOne-tap control: Quick sessions, easy one-handed play.\\u003cbr\\u003eColor matching: Pigs only hit their own color—no target-picking hassle.\\u003cbr\\u003eConveyor capacity: Timing and queue management add a bite-size strategy layer.\\u003cbr\\u003e5 waiting slots: Stack, sort, and launch at the perfect moment.\\u003cbr\\u003eShort but “one more round” feel: Perfect for micro-breaks.\\u003cbr\\u003eSatisfying pixel cleanup: Every hit leaves the board feeling crisp.\\u003cbr\\u003eFor anyone who loves fast action-puzzles, timing, and flow management. The pigs are ready. The cubes… not so much.\"],\"Loom Games A.Ş.\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/zy7H9h9TKF6H5ehU-4vi2eJ8aGhpAVrc3nSMBGuFHmYGbqR91O6rYYVu7RxLmJ60VQEa8VaG2hyMVLPVlR426bk\"],null,[64,164,254,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.loomgames.pixelflow\\u0026rdid\\u003dcom.loomgames.pixelflow\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$1.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Puzzle\"]],[null,null,null,[\"Logic\"]],[null,null,null,[\"Offline\"]],[null,null,null,[\"Single player\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.vincentb.MobControl\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/eYc7EHSPfZCXbS-oj4mdPH3sSX6ljrhAJntv-bN9zrRHp8qjuroDo_kknhgb0Tu4UGnl5DdkYCW1paSNlspt\"],null,[245,242,234,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/KW3oWqtjcHxaTaGvNAe6fz6AZcTCdhga5zF0xyYkMddugpAzpY-dWXiceluF4KM4ELnq9zshBJU64JaOs--rwQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/s862YlUb8QS6_bE0na-ysmliH6gDhNMo756cseHS3-Ss7SLEa79dZc-KBqiOnchbM2iVWr7mW51jDFjVGfn7\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/6QmxqxlRjsYGy-x8V-pnFaqmJ2NwO_x9Pa5WGvKK_J3XRwpwVymDRD-RVtX_Hd4DckxotGzFElbSNZu3-7b-\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/BEW24mxQw9qvhD1tCLvQa8GI55kAPL7mBlkQg7-jLlO9EyhDLg1w584-a-UMFPa1LlwrMYsRJd9VTZcChyCkuA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/umnFsfDpE0pTFkofEXsuEtStb_BC70CY7m4TZbccmboDO9OGZYPm9M18WCqhq_yGzQSBBrlO03I1mXmKx24gXw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/0uIOtZFFTNniWFgDNzA-oHWszV3cM-2A8dbzKD4WDRqxYO94nR5kJloynID2cFsIZw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/6D0RNqU51lKbvlFk3vpdO2mRmAHSyeLGwUAQxPQ9MuPI_upWjm0nrhtcm1OU2C5tpr1d\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/-VdUneCa7JojoPIFt_HilgQDuQ19ZEY_8ONEMt6mILIHjmAWz85Mxd-cfrIkvAAbug\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/cISNsj8bIL7zKMLoqKDuSVDL_I0_r8g4Lh9wg6NbZ7Y49EOeNmQlGg8redcfNSOZWTE\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/jQjX6UtFNo2W35b3wgNLfyhc-q9ieeWtL0AyWSWCNy8dlTTMhHgd5QJVMGqu98LXza0\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/vhLhIglu17CRpKW2aoKu2uFVVZY7A2KdgVx4hpBJ41w5sHQkxHbH7FvmD6ldkB0boL8\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/SyGhG8sqIozEUt0Ba1es6Snaz_IXgDPT9mZEJDvw8wn9pvsWEqzbo836KpAqVWU9nQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/Wtnxrg2ljNAFwuU208FznxdhJtlaSSHjnn5HNjFcS61i0PtA9QxPD1-BCra6mbDeud0\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/vfG7hEjuCl-oiCJpFN7QIlEF8-AmLH9CUYTznuvQLw7FcJ6jASSHbBdtx1ysvX2HkA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/rUOO3D-qjaVCzfSAjcEuCGUTOAlU5jf1S110ERlq1u5TXrISv14WR6531lxIWhUTk3k\"]]],\"Mob Control\",[\"4.4\",4.3546185],\"Arcade\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.vincentb.MobControl\\u0026rdid\\u003dcom.vincentb.MobControl\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.vincentb.MobControl\"]],[\"qgJhGl8IGEoTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCMwodChdjb20udmluY2VudGIuTW9iQ29udHJvbBABGAMSEgoECAEQAQoECAMQAQoECAQQBA\\u003d\\u003d\"],null,[null,\"🌟 Lead, Multiply, and Conquer! Mob Control delivers thrilling tower defense action where you grow your mob, deploy powerful champions, and crush enemy bases. Unlock collectible cards, conquer exciting modes, and climb the Champions League. Face new challenges, earn rewards, and discover fresh content as you rise to tower defense supremacy!\\u003cbr\\u003e\\u003cbr\\u003e🏰 Unleash Your Inner Commander in Mob Control: The Ultimate Tower Defense Clash! \\u003cbr\\u003e\\u003cbr\\u003e🏆 Defend, Conquer, and Rise to Victory in this Epic Tower Defense Showdown! \\u003cbr\\u003e\\u003cbr\\u003eAre you ready to become the ultimate champion in the world of tower defense battles? Mob Control brings you an unparalleled strategy and action-packed experience that will test your skills, wit, and tactical prowess. With oddly satisfying gameplay and a wide array of features, Mob Control is your gateway to tower defense supremacy.\\u003cbr\\u003e\\u003cbr\\u003eOddly Satisfying Gameplay: Create, Grow, and Lead!\\u003cbr\\u003e\\u003cbr\\u003eExperience the strangely satisfying thrill of watching your mob multiply as you aim and shoot at the gates. Witness your army grow to massive proportions!\\u003cbr\\u003eStrategically deploy your mighty Champions to break through enemy mobs and reach their bases. Choose the best combo for victory!\\u003cbr\\u003eExplore intriguing level elements like speed boosts, multipliers, moving gates, and more, adding depth and challenge to your gameplay.\\u003cbr\\u003e\\u003cbr\\u003eBecome an Immortal Player: Rise Through the Ranks!\\u003cbr\\u003e\\u003cbr\\u003eEarn Championship Stars by emerging victorious in battles, fortifying your bases, and dominating tournaments. Show the world your tower defense prowess!\\u003cbr\\u003e\\u003cbr\\u003eClimb the prestigious Champions League using your hard-earned Championship Stars and become an immortal player, joining the elite few who have conquered this tower defense realm.\\u003cbr\\u003e\\u003cbr\\u003eFortify Your Base: Shield Your Dominion!\\u003cbr\\u003e\\u003cbr\\u003eSecure your base from enemy raids by winning battles and earning valuable shields. Protect your hard-earned resources and maintain your tower defense dominance.\\u003cbr\\u003e\\u003cbr\\u003eUnlock and Upgrade Cards: Collect, Evolve, and Dominate!\\u003cbr\\u003e\\u003cbr\\u003eWin battles to unlock booster packs of varying rarities and enhance your card collection. Collectible cards hold the power to elevate your tower defense strategy to new heights.\\u003cbr\\u003e\\u003cbr\\u003eUnlock all the Cannons, Mobs and Champions in the armory and discover their amazing evolutions as you level them up.\\u003cbr\\u003e\\u003cbr\\u003eDiverse Game Modes: Challenge and Conquer!\\u003cbr\\u003e\\u003cbr\\u003eEngage in thrilling game modes that keep the action fresh:\\u003cbr\\u003eBase Invasion: Raid enemy strongholds, pilfer coins, and claim bricks from rival players. Plunder and dominate!\\u003cbr\\u003e\\u003cbr\\u003eRevenge and Counter-Attack: Turn the tables on attackers and seek retribution against those who challenge your tower defense might.\\u003cbr\\u003e\\u003cbr\\u003eBoss Levels: Test your tower defense mettle in unique level layouts, earning extra bonuses as you conquer the most challenging adversaries.\\u003cbr\\u003e\\u003cbr\\u003eSeason Pass: A Constant Stream of Fresh Content!\\u003cbr\\u003e\\u003cbr\\u003eDive into ever-evolving content with our monthly Season Pass.\\u003cbr\\u003eComplete quests, advance tiers, and unlock new heroes, cannons and skins\\u003cbr\\u003e\\u003cbr\\u003eAlways Improving: Join the Evolution!\\u003cbr\\u003e\\u003cbr\\u003eOur dedicated team is committed to delivering fresh mechanics and content every month. Stay connected and share your ideas via Settings \\u0026gt; Discord, actively contributing to the evolution of Mob Control.\\u003cbr\\u003e\\u003cbr\\u003eA Premium Experience: Your Choice to Play Ad-Free!\\u003cbr\\u003e\\u003cbr\\u003eMob Control is free to download and utilizes ads to support ongoing development. Opt for the Premium Pass or a permanent no-ads package to enjoy uninterrupted tower defense action.\\u003cbr\\u003eSpeed up your progress and reap extra rewards without watching ads, thanks to Skip’Its.\\u003cbr\\u003e\\u003cbr\\u003eSupport and Privacy: Your Satisfaction Matters! Connect with us in-game via Settings \\u0026gt; Help and Support whenever you need assistance or have questions. Your privacy is crucial to us. Review our comprehensive privacy policy at https://www.voodoo.io/privacy\\u003cbr\\u003e\\u003cbr\\u003eJoin the tower defense clash like never before with Mob Control! Rally your army, harness the power of collectible cards, and become the tower defense champion you were born to be. Download now and embark on your journey to tower defense glory!\"],\"VOODOO\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/3mana5VkQrdVLv_J0b2O6VP-J1YsInVtj0qP6Gq-qlKZ-RWmaVx7Nm8s7_fG1lr9odq1LJz24xIj9jVv4Tx6\"],null,[77,162,245,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],[null,\"Mild Fantasy Violence\"],[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.vincentb.MobControl\\u0026rdid\\u003dcom.vincentb.MobControl\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.84 - $399.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Arcade\"]],[null,null,null,[\"Action\"]],[null,null,null,[\"Casual\"]],[null,null,null,[\"Hypercasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.nebula.zoodoku\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/UEe42pjBXevhw2K8l6xzyJQWVyingMf3zrx9wx2hV_12AuQRGMwm-7uJL_DYbIxLXCN9x4htICrfscgX1U261A\"],null,[245,238,234,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/FplOzkGCc54_-X_pF3H85Gf3fbtXFwyQM09RTZfPpCQILll7TmY2rRgNBxUVX4NGVny8ybGxhCcfvAvySwmnog\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/1uT_CxlL0iWm9Pe7e9DZfIbsokoxkqF5SinOfLet2rV0IOtMKnDrQm0mF_b1TArm5hbaJYANOwqDvdr_XtZrDg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/jAa28ATjz18LAISb9UZrONPynsMFK03HT5E-IdCnVyJHSlbtN5ugYzgzMcFZv1