,\"https://play-lh.googleusercontent.com/4psXBlTA9X-pzKUI-NKhy5k3ZSaZvu2CxVdeLo2T9kWQh_cPJwSvVu1JYVNZv960dmhrLHaoFCUxBzoemI4m\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/RIEfuwFt3KEHdBRHP6_9CjOi_fbDHfs7vZpGTDGIrtIGGDf5kbBGT4SjMvlpmaOq3wElFr4f4iKhnVGKcfEbrQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/QVBQKnxHxMXwgjIEkErSheqTGr2aEJuVz2Ll9A_OF2qVcI24RD3oCKtcrtDdwTpCWgZV7p02vsBXoN5ZaVvgnA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/D1kxSPY7-R91JCEiEJWmmHABqvuEZ4d6ywvfAHGaWgTrPOAwpp9GVibqeQ4pr2LhvQWsT6D1NPN3bKnkn_nDB-c\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/pIASaDZwjpBmvcp8g-gYG1MRlcM6NCyLPjXgSbLaACHskq8KjUzgo9UTvdtvGBKrv-1oz4Sk14iXAGJrc-bZlQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/j2iJ59Plba2Dc6rqnef0DQzs_nvk3q2dPOJUAttEodPtmf6GR8X6XQo-gwTzDFumB47qWOFY8Gmc7cP_X7rUGw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/eFBROeRk9giXbqIH_sFC0xqe_8CsmqkGac8ibet8F5mCKXXUD9bZoGi3d8aAHNGzLhQ_gufngdfx4wUbP4YoAA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/zo57S5GmJZtnWeAy2Ri_X39IrK5z-4gxJ9KwSdDK-GX0KXPr-0sDV42m304cZFeXPsIdFJiYLtJ3BR0bfeUyxA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/4psXBlTA9X-pzKUI-NKhy5k3ZSaZvu2CxVdeLo2T9kWQh_cPJwSvVu1JYVNZv960dmhrLHaoFCUxBzoemI4m\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/RIEfuwFt3KEHdBRHP6_9CjOi_fbDHfs7vZpGTDGIrtIGGDf5kbBGT4SjMvlpmaOq3wElFr4f4iKhnVGKcfEbrQ\"]]],\"Total Battle: War Strategy\",[\"4.1\",4.114167],\"Strategy\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.totalbattle\\u0026rdid\\u003dcom.totalbattle\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.totalbattle\"]],[\"qgJhGl8IS0oTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBFwoVCKvhtsW4pomPQxIJCgVlbi1VUxAAugIrChUKD2NvbS50b3RhbGJhdHRsZRABGAMSEgoECAEQAQoECAMQAQoECAQQAw\\u003d\\u003d\"],null,[null,\"Build your empire and prepare for war with Total Battle, a multiplayer war strategy game that pits you against enemy factions across ancient civilizations, magic kingdoms and great empires.\\u003cbr\\u003e\\u003cbr\\u003eBecome immersed in your own world while battling for glory. Enjoy this multiplayer online strategy building game and show off your castle defense skills and tactical war strategies. Command and conquer kingdoms and castles, occupy forts, and feel the rush in this fantasy MMO RTS game.\\u003cbr\\u003e\\u003cbr\\u003eBattle alongside legendary heroes who’ll defend their territory at all costs and wage war against monsters, barbarians, wizards, elves, and other foes. Build a base and establish a strong tower defense strategy to win all the king’s battles in this medieval strategy war game and become the Lord of all the Kingdoms!\\u003cbr\\u003e\\u003cbr\\u003eBUILD YOUR EMPIRE \\u0026amp; DEFEND YOURSELF IN TIMES OF WAR\\u003cbr\\u003e● Build a base for your military, which lies at the heart of your castle\\u003cbr\\u003e● Progress from guardsmen with basic weapons to warriors and additional troops, including titans, dragons, elementals, and other fantastic beasts \\u003cbr\\u003e● Defend your empire, eliminate enemy troops, and conquer the world on your behalf\\u003cbr\\u003e● Summon the best captains to lead your warriors and achieve victory \\u003cbr\\u003e● Your skills as an empire-builder will determine the future, so do your best\\u003cbr\\u003e● Strategy games require you to make the right choices for managing the troops in your army—each unit has unique abilities for going to war against monsters and other players\\u003cbr\\u003e● Dozens of types of magic enemies of different levels\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eWAR STRATEGY GAMES \\u0026amp; MULTIPLAYER BATTLES\\u003cbr\\u003e● An MMO 4X real-time strategy game with PvE and PvP modes\\u003cbr\\u003e● A massive open world with hundreds of kingdoms and millions of lords\\u0026#39; castles\\u003cbr\\u003e● Play alongside dozens of legendary heroes and captains from different civilizations online\\u003cbr\\u003e● Find unique points of interest on the world map among deserts, forests, and mountain ranges\\u003cbr\\u003e● Battle through hordes of enemies, abandoned gold mines, battle arenas, and ancient crypts filled with treasure that are just waiting to be discovered! \\u003cbr\\u003e● Not every strategy will win you a war! Dedication, careful planning, and good management will. Build a strong empire and raise a civilization\\u003cbr\\u003e● Compete in regular competitions and challenges, putting your skills to the test\\u003cbr\\u003e\\u003cbr\\u003eRPG MECHANICS TO BOLSTER YOUR ARMY\\u003cbr\\u003e● Enhance your tactics with an RPG-style character leveling system\\u003cbr\\u003e● Your heroes and captains have various skills for dealing with different situations. \\u003cbr\\u003e● Craft equipment and level up your heroes just like in the best MMORPGs. \\u003cbr\\u003e● Put your heroes at the head of your legion of troops, earn XP, and win wars!\\u003cbr\\u003e\\u003cbr\\u003eCALL ON YOUR DRAGON\\u003cbr\\u003e● Accept the challenge of epic monsters and raise your dragon \\u003cbr\\u003e● Give him a name and summon him to fight against your most dangerous enemies \\u003cbr\\u003e● The strength of your dragon will be indispensable when besieging mighty magical citadels\\u003cbr\\u003e\\u003cbr\\u003eBATTLE ONLINE \\u0026amp; JOIN CLANS\\u003cbr\\u003e● Battle and play online with different clans\\u003cbr\\u003e● Play with users from all over the world and fight for battle glory.\\u003cbr\\u003e● Join a clan of like-minded people, play with friends, and achieve your goals together in this online strategy game.\\u003cbr\\u003e● Capture territory, climb to the top of the war rankings, and enlist the support of thousands of allies to help you achieve world domination\\u003cbr\\u003e\\u003cbr\\u003eTotal Battle is a war strategy game with various historical epochs: from ancient times to medieval and then to the age of discovery. Join the online battle strategy game, build an empire, and win!\\u003cbr\\u003e\\u003cbr\\u003eOfficial Site: https://totalbattle.com/\\u003cbr\\u003eCustomer Service Email: support@totalbattle.com\\u003cbr\\u003e\\u003cbr\\u003eJoin a massive community of strategy lovers!\\u003cbr\\u003eFacebook: https://www.facebook.com/totalbattle/\\u003cbr\\u003eYouTube: https://www.youtube.com/c/totalbattletacticalstrategy\"],\"Scorewarrior\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Y7MAWewScMrqI8vGttprlMesxQSt_6TtT31QiBe51RjlF1wfOuxGsCFzHoomcR6-3HEKi3s9-gPySONwKg1ru1w\"],null,[74,94,38,255]],null,[\"Everyone 10+\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/csiz76udPjXmaJddU_1sanHGlQAAbKkvlprK3DSUNmwu1nY3U6qnXRrI2IDMaivooYK1x11oxz3PEO4z\"]],[null,\"Fantasy Violence\"],[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/bxs95MghtAOuZR_LPwVCUmUPYEvXsGVOH3chF1OCX0-Ns_S0qdHnzml2CGCgOGbYlftKsmt9gtpxLb8U\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.totalbattle\\u0026rdid\\u003dcom.totalbattle\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,fa