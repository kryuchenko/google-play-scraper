ar\"]],[\"qgJfGl0If0oTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCMQobChVjb20uUXVlc3RMYWIuRHJhZnRXYXIQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAM\\u003d\"],[[[null,null,\"0foK-sucZkc\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:0foK-sucZkc?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:0foK-sucZkc\",null,null,null,null,\"AXH1eznxi_UNRsu5aSOwoTua-TyxwObcQlfTQFGvQmIi0A5UEjjJDHEHzso2Y4K-RJHpSwfsuaXQ07LkXDmdTiXJtGa2iLq-_l3z9Wolqa_oaWZyvkD7nQmUz6bwnLGozVkbSDp9BDkvHO7zS7i_FrFHUELWVZz0ZOpgSgyk0xFAP-s6alRuTDNIvhmYEnRiyhA0LF_VFRUFspi_KVAo3qCDY21bWpiSmpf4QcN7RPjSFRlE2sCOUxTknnC_bTX7R9dE8tk762VVSZYYZp3NJiNAQN5y2g0JNrijCHRjqTpOdrc4jQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/0foK-sucZkc/hqdefault.jpg\"]]]],[null,\"Ready your strategy, Commander!\\u003cbr\\u003e\\u003cbr\\u003eDraft Showdown hurls you onto a dynamic battleground where every choice can crown a champion or spell defeat. In brisk duels, you’ll draft a squad, watch them clash in real‑time auto‑combat, and pivot your tactics round after round.\\u003cbr\\u003e\\u003cbr\\u003eDRAFT IN SECONDS, OUTSMART IN MOMENTS\\u003cbr\\u003eThree draws, three picks, limitless outcomes. Will you unleash an Archer volley, roll explosive TNT into enemy lines, or gamble on a mighty Goose Army? No two drafts are ever alike.\\u003cbr\\u003e\\u003cbr\\u003eAUTO-COMBAT, REAL STAKES\\u003cbr\\u003eOnce the horn sounds, your hand is off the board - units fight automatically, and the first player to lose all lives bows out. Victory is decided long before the swords touch steel.\\u003cbr\\u003e\\u003cbr\\u003eEPIC COMEBACKS\\u003cbr\\u003eFell behind? The innovative fourth draw grants a surge of fresh options, keeping matches tense until the final blow.\\u003cbr\\u003e\\u003cbr\\u003eBUILD YOUR SIGNATURE DECK\\u003cbr\\u003eCraft a four‑card load‑out that reflects your style. Chain synergies, counter popular metas, and surprise rivals with off‑beat combos.\\u003cbr\\u003e\\u003cbr\\u003eHYBRID-CASUAL THRILLS\\u003cbr\\u003eMatches last minutes, not hours, making Draft Showdown perfect for a quick break or an evening ladder grind - depth for veterans, accessibility for newcomers.\\u003cbr\\u003e\\u003cbr\\u003eDraft, adapt, and dominate! Download Draft Showdown NOW and prove your tactical brilliance!\"],\"VOODOO\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/m9-qzbChjgy6P3QRZGi61TIvuffKV21ie_JuPfJjBLmoExeUCNoHAPZpgBE-Gs4RRkPCElhS6gOBm3pDXMiCBQ\"],null,[39,114,229,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null,\"Violence, Blood\"],[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.QuestLab.DraftWar\\u0026rdid\\u003dcom.QuestLab.DraftWar\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Strategy\"]],[null,null,null,[\"Tower defense\"]],[null,null,null,[\"Immersive\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.pawakuma.hitfortune\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercont