ull,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkingtomfree\\u0026rdid\\u003dcom.outfit7.mytalkingtomfree\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.outfit7.mytalkingtomfree\"]],[\"qgJnGmUIvgFKEwitldb9jr+WAxWFeYQGHSiCKVL6AQ8KDQgAEgkKBWVuLVVTEAC6AjgKIgocY29tLm91dGZpdDcubXl0YWxraW5ndG9tZnJlZRABGAMSEgoECAEQAQoECAMQAQoECAQQBA\\u003d\\u003d\"],null,[null,\"Talking Tom is the cat making every day a fun adventure.\\u003cbr\\u003e\\u003cbr\\u003ePlayers adopt this virtual pet, keep him happy and help him explore his world.\\u003cbr\\u003e\\u003cbr\\u003e- Talking Tom can really talk \\u003cbr\\u003e- Fashion and furniture items to collect \\u003cbr\\u003e- Mini games add action, adventure and fun \\u003cbr\\u003e- Travel destinations are waiting to be explored \\u003cbr\\u003e- Photo albums to be filled with memories \\u003cbr\\u003e- And more \\u003cbr\\u003e\\u003cbr\\u003eFrom Outfit7, creators of My Talking Tom 2, My Talking Tom Friends, My Talking Angela 2 and My Talking Angela.\\u003cbr\\u003e\\u003cbr\\u003eThis app contains:\\u003cbr\\u003e- Promotion of Outfit7\\u0026#39;s products and advertising;\\u003cbr\\u003e- Links that direct customers to Outfit7’s websites and other apps;\\u003cbr\\u003e- Personalization of content to encourage users to play the app again;\\u003cbr\\u003e- YouTube integration to allow users to watch videos of Outfit7\\u0026#39;s animated characters;\\u003cbr\\u003e- The option to make in-app purchases;\\u003cbr\\u003e- Subscriptions which automatically renew at the end of a subscription period unless cancelled. You can manage and cancel your subscription any time via Settings in your Google Play account;\\u003cbr\\u003e- Items to purchase (available in different prices) using virtual currency, depending on the player’s progress;\\u003cbr\\u003e- Alternative options to access all functionalities of the app without making any in-app purchases using real money.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eTerms of use: https://talkingtomandfriends.com/eula/en/\\u003cbr\\u003ePrivacy policy for games: https://talkingtomandfriends.com/privacy-policy-games/en\\u003cbr\\u003eCustomer support: support@outfit7.com\"],\"Outfit7 Limited\",\"1,000,000,000+\",null,null,null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Uj6LsxlFPOs32u69TW5dPRgxeHCyv9xbIe3PPHEMTv92D5KHoYIYCJfsh-Xd1cWBS-iw9JQtneI69mgqtsJp\"],null,[118,208,229,255]],null,[\"Everyone 10+\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/csiz76udPjXmaJddU_1sanHGlQAAbKkvlprK3DSUNmwu1nY3U6qnXRrI2IDMaivooYK1x11oxz3PEO4z\"]],[null,\"Mild Fantasy Violence, Crude Humor\"],[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/bxs95MghtAOuZR_LPwVCUmUPYEvXsGVOH3chF1OCX0-Ns_S0qdHnzml2CGCgOGbYlftKsmt9gtpxLb8U\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkingtomfree\\u0026rdid\\u003dcom.outfit7.mytalkingtomfree\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Simulation\"]],[null,null,null,[\"Pet\"]],[null,null,null,[\"Casual\"]],[null,null,null,[\"Offline\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.playval