null,\"/store/apps/details?id\\u003dcom.ecffri.arrows\"]],[\"qgJbGlkIDUoTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCLQoXChFjb20uZWNmZnJpLmFycm93cxABGAMSEgoECAEQAQoECAMQAQoECAQQBA\\u003d\\u003d\"],null,[null,\"Welcome to Arrows – Puzzle Escape, a minimalist puzzle game that challenges your logic, planning, and spatial thinking. Your goal is simple: extract each arrow without causing a collision. \\u003cbr\\u003e\\u003cbr\\u003e🧠 Features:\\u003cbr\\u003e- Challenging logic puzzles that test your planning skills\\u003cbr\\u003e- Thousands of handcrafted levels with increasing complexity\\u003cbr\\u003e- Clean, minimalist design that lets you focus on the puzzle\\u003cbr\\u003e- Relaxing, no-pressure gameplay – no timers, just your brain\\u003cbr\\u003e- Hint system to help when you\\u0026#39;re stuck\\u003cbr\\u003e\\u003cbr\\u003eWhether you have a few minutes or want a longer challenge, Arrows – Puzzle Escape is the perfect blend of strategy and calm.\\u003cbr\\u003e\\u003cbr\\u003eCan you clear the grid without losing a single heart?\"],\"Lessmore GmbH\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/PM-Y0D8BU6Nx_cjjtw7QnLTilRfGPBoGKJs0BMhEITgJM-v-mXrkcLxf6bfAXrMwjSnG5Lyb7Hn8bBUDZNJBXg\"],null,[254,254,254,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,nu