3dcom.dreamgames.royalkingdom\"]],[\"qgJlGmMIB0oTCMrn6+an/ZQDFaMJswYdIssGi/oBDwoNCAASCQoFZW4tVVMQALoCNwohChtjb20uZHJlYW1nYW1lcy5yb3lhbGtpbmdkb20QARgDEhIKBAgBEAEKBAgDEAEKBAgEEAQ\\u003d\"],null,[null,\"From the creators of Royal Match comes a brand new match 3 puzzle adventure in Royal Kingdom, starring the extended Royal Family!\\u003cbr\\u003e\\u003cbr\\u003eYou’ll meet King Richard, King Robert\\u0026#39;s younger brother, as well as a charming cast of new characters, including Princess Bella and the Wizard, to embark on a journey to build legendary kingdoms! Solve match 3 puzzles to explore new lands and defeat the Dark King \\u0026amp; his army!\\u003cbr\\u003e\\u003cbr\\u003eMASTER MATCH 3 PUZZLES\\u003cbr\\u003eTest your skills and become the ultimate match 3 expert by solving fun yet challenging puzzles! Beat thrilling levels and overcome unique obstacles!\\u003cbr\\u003e\\u003cbr\\u003eBUILD AND EXPLORE KINGDOMS\\u003cbr\\u003eWith the help of the Builder, craft a kingdom befitting royalty. Solve puzzles, earn coins, and unlock diverse districts - from the Parliament Square to the University and the Princess Tower.\\u003cbr\\u003e\\u003cbr\\u003eCONQUER THE DARK KING\\u003cbr\\u003eDefend the kingdom from the Dark King’s attack by solving match 3 puzzles - destroy his castles and evil minions to see him fall. Victory is one match away!\\u003cbr\\u003e\\u003cbr\\u003eEXPAND YOUR RULING\\u003cbr\\u003eRise through the ranks and claim the top spot on the leaderboard, master your puzzle solving skills for generous rewards, and expand your kingdom by uncovering uncharted lands as you play!\\u003cbr\\u003e\\u003cbr\\u003eENJOY THE FINEST VISUALS\\u003cbr\\u003eImmerse yourself in Royal Kingdom\\u0026#39;s stunning graphics and smooth animations. A puzzle game experience like never before - captivating and seamless.\\u003cbr\\u003e\\u003cbr\\u003eWhat are you waiting for? Download Royal Kingdom and join the ranks of the noble adventurers! With hours of fun, challenging gameplay, and a magical world, this puzzle game is fit for royalty!\\u003cbr\\u003e\\u003cbr\\u003eNeed some help? Visit our support page in the Royal Kingdom app or send us a message at contact@dreamgames.com.\"],\"Dream Games, Ltd.\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/ELIW5UsQ-6rx1I-nOnXgdUvUXaP11EFDF9EGDzzw_mRixPw1fbsv3_Ix8ozkZTw_6Yg\"],null,[43,48,51,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.dreamgames.royalkingdom\\u0026rdid\\u003dcom.dreamgames.royalkingdom\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Puzzle\"]],[null,null,null,[\"Match 3 adventure\"]],[null,null,null,[\"Casual\"]],[null,null,null,[\"Offline\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.AppFore.BubbleWordJam\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/fdcTtmp3L4Z9fNbcWyjD3X7BZpzfpsxvQAMqBk3lM1y8