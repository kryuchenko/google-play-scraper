,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcolor.number.paint.pixle.art.sort.jigsaw\\u0026rdid\\u003dcolor.number.paint.pixle.art.sort.jigsaw\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcolor.number.paint.pixle.art.sort.jigsaw\"]],[\"qgJyGnAIKUoTCMrn6+an/ZQDFaMJswYdIssGi/oBDwoNCAASCQoFZW4tVVMQALoCRAouCihjb2xvci5udW1iZXIucGFpbnQucGl4bGUuYXJ0LnNvcnQuamlnc2F3EAEYAxISCgQIARABCgQIAxABCgQIBBAB\"],[[[null,null,\"iNeT6TqSXdc\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:iNeT6TqSXdc?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:iNeT6TqSXdc\",null,null,null,null,\"AXH1eznLeT0FYCOrZa1QCWVfz_jKWAcUWqJAiFXWEXyL7PWnVLX7rv9J3c6tisjvDdeZ79ULUKaMVFnDqF2OJ1KpG7bbKWTH10fWiCwCAIjLztxruy6Aoc5mXOhPj8TdptKnpTHxH-roFnnQBV59i3NFVn3P7XFlXnBUAhEUIga9N1My71l_dofAc6lAoVkB68HAzbG0KSiTOjOiXsxqKhp8g8JZIQy7bRuoy2HFsbUUg2XUjjikp2Gb_nRr1fevP2ORpQXuURhlxdQDPuuogZsxV_1VlYSkyhyswKJROEXH1RfD-CScq-siLkpZnS93jVc\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/iNeT6TqSXdc/hqdefault.jpg\"]]]],[null,\"Jewel Coloring: Sparkle \\u0026amp; Create with Pixel Art Puzzles\\u003cbr\\u003eEnter a vibrant world of glowing jewels where creativity and puzzle-solving come together in perfect harmony! Designed for easy, relaxing fun, this one-of-a-kind experience combines color sorting, pixel art creation, and satisfying casual gameplay all in one. With smooth, user-friendly controls and levels that gently grow more engaging, it’s the perfect way to unwind while keeping your mind active.\\u003cbr\\u003eHow to Play: Color, Sort, \\u0026amp; Craft Beautiful Pixel Art\\u003cbr\\u003e- Sort Jewels by Color with Ease: Just tap and arrange sparkling jewels into their matching color groups. No confusing rules or complicated steps—just simple, enjoyable sorting action.\\u003cbr\\u003e- Plan \\u0026amp; Organize Your Workspace: Keep your jewel shelf neatly arranged and think ahead to clear each puzzle efficiently. Every small choice helps you complete the picture smoothly.\\u003cbr\\u003e- Uncover Stunning Pixel Art Masterpieces: As you sort and place each jewel, watch as hidden pixel art designs slowly come to life. Every level reveals a brand-new, dazzling image to enjoy.\\u003cbr\\u003e- Enjoy Endless Creative Satisfaction: There’s no pressure—just calm, rewarding gameplay that turns every moment into a peaceful artistic break.\\u003cbr\\u003eWhat Makes Jewel Coloring Special\\u003cbr\\u003e- Hundreds of Unique Levels \\u0026amp; Themes: Enjoy a huge variety of pixel art puzzles, with fresh themes and exclusive limited-time collections added regularly.\\u003cbr\\u003e- Polished Visuals \\u0026amp; Immersive Feedback: Bright, detailed 3D jewels, crisp visual effects, and satisfying audio feedback make every tap feel smooth and rewarding.\\u003cbr\\u003e- Play Anywhere, No Wi-Fi Needed: Play offline whenever you have free time. Pause, resume, and play at your own speed, no internet connection required.\\u003cbr\\u003e- Easy for Everyone, Fun for All Ages: Simple mechanics make it accessible for casual players, while thoughtful level design keeps it interesting for puzzle and art fans alike.\\u003cbr\\u003eWhy You’ll Love Jewel Coloring\\u003cbr\\u003e- Gentle Brain Exercise: Sorting, planning, and matching help support focus, logic, and spatial thinking—all while having fun.\\u003cbr\\u003e- Natural Stress Relief: Lose yourself in calming, rhythmic jewel sorting that helps you relax and unwind after a busy day.\\u003cbr\\u003e- For All Skill Levels: Whether you’re looking for a quick distraction or a creative hobby, it’s made for kids, adults, and everyone in between.\\u003cbr\\u003eDownload Jewel Coloring today and step into a bright, peaceful world of color, jewels, and pixel art. Create, sort, and relax—your next artistic adventure is just a tap away!\"],\"TaTa Game Technology Limited\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/RmR8xH7Hsp2bGzGqudhQCyXsRgKKayDZi24ZcSdag2aX_PweMAn5JSQOiIGW5xKt3SJh94I9edbBa9S4mNeI\"],null,[197,182,255,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,[null,\"Content is generally suitable for all ages. May contain minimal cartoon, fantasy or mild violence and/or infrequent use of mild language.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcolor.number.paint.pixle.art.sort.jigsaw\\u0026rdid\\u003dcolor.number.paint.pixle.art.sort.jigsaw\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.studio27.MelonPlayground\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/9KgS1cF6vWMF9Fl25S36bKr8zDh0ddkTOeN7WpBcQAE-pKfahG2DjUxbQ8sespNoe3KW3qbcaVD8H6DfNys6\"],null,[21,21,21,255],null,null,null,2],[[null,2,[1320,2868],[null,null,\"https://play-lh.googleusercontent.com/BpqzdYsGTzG9FfNSxDL