ll,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/ywUh8JLONz2bOuT_LrEFGzfK3rNLpu-H4Zgixae02CecuOJZaDAzC5GcUxV3wZXbnq2y_XksoGScGEK9stvBpw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/LA9Ll-DhFKb2zQAe3GUyVU3xJKB69ZQGf49wixp0NeGgs-hUjNXwtKdpFl1E9Y8In-m-cV3QQKK8DIkvbKra9A\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/MvlxIaZzwcIm7w2rTNMpeFvOiI_SpwKwM79uF3Ych7XISyDa7JqqjzUApkuV9YvB_OUBkoKR_thh66_cWKnvXw\"]]],\"Sprunki Beat: Full Mod Music\",[\"4.7\",4.6689296],\"Music\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.game\\u0026rdid\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.game\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.game\"]],[\"qgKOARqLAQiiAUoTCMrn6+an/ZQDFaMJswYdIssGi/oBFwoVCOab69zZtuKPQxIJCgVlbi1VUxAAugJWCkAKOmNvbS5zcHJ1bmtpLm1vZC5ob3Jyb3IuaW5jcmVkaWJveC5tb25zdGVyLmJlYXRzLm11c2ljLmdhbWUQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAQ\\u003d\"],[[[null,null,\"93f8AVcOhpk\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:93f8AVcOhpk?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:93f8AVcOhpk\",null,null,null,null,\"AXH1ezmNBFdf2Pk3S59bYePlu9V6L7l2s9k4bY_SMdCNh6Oha07r3FdXOuMlWDS2DhuSgjLUHueh-yXEXWgWidof3ZJskL73KJR3vQL8d2_mGX64HgK71qNskF0Q7Ttm86L7RG59UAMUCMLUn_aLJ6W1lutGGwx1TyKKTSNcVIMk73HcwRRvk4MMUs-QErgctTqGb9Kkmt6En1c0VsexsocV3dnd1beNIU_0xF8KiX4rD4WGluwvipnIGbvJyLO0tBGGesBZgMP8GIyv__c4kljZE-_JT82jjscabJM7lP1jr3ONqp0npnjYS0d4fg3M5pI\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/93f8AVcOhpk/hqdefault.jpg\"]]]],[null,\"\\u003cb\\u003eOfficially Licensed Sprunki Beat: Full Mod Music – Embark on a Musical Creation Fantasy\\u003c/b\\u003e\\u003cbr\\u003eAre you ready to step into a vibrant and electrifying world of incredible music with Sprunki Beat: Full Mod Music? Welcome to this fun and interactive music mixer game! Whether you\\u0026#39;re a rhythm master or a casual gamer, you can find your own musical joy here.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eInnovative Gameplay: Ignite Unlimited Creativity\\u003c/b\\u003e\\u003cbr\\u003eIn Sprunki Beat: Full Mod Music, you can freely select your sounds, picking from a diverse range of beats, including cute and scary ones, as well as a mix of normal and horror sound effects, fun and spooky melodies, and unique vocals. With simple drag-and-drop controls, assign these sounds to cute and distinctive characters, which includes a lineup of iconic Sprunki personalities like Oren, Raddy, Clukr, Fun Bot, Vineria, Gray, Brud, Sky, Mr. Tree, Simon, Durple, Tunner, Mr. Sun, Jevin, Wenda, Black, Pinki, and Mr. Fun Computer.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eExpanded Sprunki Universe: Explore Diverse Mods\\u003c/b\\u003e\\u003cbr\\u003eSprunki Beat isn’t just one game – it’s a whole music universe! Dive into various exciting mods like:\\u003cbr\\u003e🎵 Sprunki Original – classic vibes with smooth urban rhythm.\\u003cbr\\u003e🎵 Sprunki Mustard – retro visuals and unique gameplay modes like Beatbox, Melody, and Freestyle.\\u003cbr\\u003e🎵 Sprunki Babies Phase 3 – a creepy yet fun horror experience with chilling audio effects.\\u003cbr\\u003e🎵 Sprunki Phase 5 (a.k.a. Mustard Sprung) – full of experimental sound design for true creators.\\u003cbr\\u003e🎵 Plus: Stay tuned for Sprunki REJOYED, an upcoming expansion set to redefine the music-mixing experience!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eAbundant Modes: Experience Diverse Fun\\u003c/b\\u003e\\u003cbr\\u003eNormal mode gives you creative freedom, while horror mode delivers a thrilling challenge with eerie sound effects and visual tension. For surprises, drag the black button onto a character and unlock hidden horror elements. Additional secret phases await as you play!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eUnlock Content: Create a Personalized Music Experience\\u003c/b\\u003e\\u003cbr\\u003eComplete challenges to unlock rich levels and unique Sprunki mods, sound libraries, and new characters. Customize appearance of characters, mix new audio styles, and earn generous rewards!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eEndless Sound Combinations: Explore the Infinite Possibilities of Music\\u003c/b\\u003e\\u003cbr\\u003eSprunki Beat: Full Mod Music has a vast sound library that covers various types of sounds and sound effects. You can freely experiment with endless sounds and character combinations, exploring multiple diverse musical styles. Whether it\\u0026#39;s a warm and cute melody or a strange and thrilling rhythm, it can be easily achieved here. Drag, drop, mix, and share your original beats in this magical music playground.\\u003cbr\\u003e\\u003cbr\\u003eCome and join Sprunki Beat: Full Mod Music and start your music creation journey! Here, you will experience the infinite charm of music, unleash your creativity with incredible Sprunki music box, and create your own musical legend! Stay tuned for multiple incredible musical atmospheres to explore and regular updates to keep the fun going. Think your beats are fire? Let your musical imagination soar as you dive into a funny music battles - Friday sprunkin night game. Download now and start your journey to becoming a music legend!\"],\"Gotstar Studio\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/to3fFWaf_AsmjhxCRBrhojo7762S7ZKGAd2XeXwwq3TlNX2WFAgHOEfZ3QEtBUzZQN4-cj9_mGNwq-uDaeD2wg\"],null,[16,229,249,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null,\"Mild Violence, Mild Blood\"],[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.game\\u0026rdid\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.game\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$3.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Music\"]],[null,null,null,[\"Casual\"]],[null,null,null,[\"Offline\"]],[null,null,null,[\"Single player\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.stealthgame.master\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/sITfIt7fe2R1_xUbibi1NdbBT8GGC3K_J8dnBsA5ZDDuFHdsAc3JVNdYld6LVRNaRg\"],null,[32,22,74,255],null,null,null,2],[[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/8AJuzeYDdW_1HOK6JKByICTzVAdgHZD-Rt7cDjo-v6wML7fs57AK9MU8hVRR3GROD6c\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/0LGXSJt1GwqEOb4bn5pJns-F9CsLNvAl1gwnOvdE-lPddiBXInXmmNbxwVYnPY5VTA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/9pUsEPnn5K7iSw6G7oXt-uz3Njh1hBu3zu_OPeL_HREhNJb2f4nqcbgAVNTB_sjo_w\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/_aTZlNSi9l_iEDJw5k_NAkMQNYiLLYX28kYR