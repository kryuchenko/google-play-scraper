[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/slQx8sAeMBsq1Mu-_6Tg7bGjapNyeJfbSm40uiK1YmjsjkhLoygw9F5WcWKq9NhAzR_6NZ31gejhEBkDSWT0XLU\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/qrJ11rGyKZFjFPy0KHUcTNovMH5YpM7v_Jo8zXRcGi75iatsQUz8n48Mtv7BZeLxMzHiaCM8veFZrXIdG6xnhw\"]]],\"Kingshot\",[\"4.4\",4.391313],\"Strategy\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.run.tower.defense\\u0026rdid\\u003dcom.run.tower.defense\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.run.tower.defense\"]],[\"qgJfGl0IR0oTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCMQobChVjb20ucnVuLnRvd2VyLmRlZmVuc2UQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAQ\\u003d\"],null,[null,\"Kingshot is an innovative idle medieval survival game that combines strategic gameplay with rich details waiting to be explored.\\u003cbr\\u003e\\u003cbr\\u003eWhen a sudden rebellion overturns the fate of an entire dynasty and ignites a devastating war, countless people lose their homes. In a world riddled with societal collapse, rebel invasions, rampant disease, and mobs desperate for resources, survival is the ultimate challenge. As a governor in these turbulent times, it\\u0026#39;s up to you to lead your people through these adversities, devising internal and diplomatic strategies to rekindle the spark of civilization.\\u003cbr\\u003e\\u003cbr\\u003e[Core Features]\\u003cbr\\u003e\\u003cbr\\u003eDefend Against Invasions\\u003cbr\\u003eStay vigilant and ready to repel invasions at any moment. Your town, the last bastion of hope, depends on it. Gather resources, upgrade your defenses, and prepare for battle to ensure survival in these tough times.\\u003cbr\\u003e\\u003cbr\\u003eManage Human Resources\\u003cbr\\u003eEnjoy a unique gameplay mechanic involving the allocation of survivor roles such as workers, hunters, and chefs. Monitor their health and happiness to ensure they remain productive. Respond quickly to illness to make sure everyone receives timely treatment.\\u003cbr\\u003e\\u003cbr\\u003eEstablish Laws\\u003cbr\\u003eCodes of law are vital for sustaining civilization and are crucial for the growth and strength of your town.\\u003cbr\\u003e\\u003cbr\\u003e[Strategic Gameplay]\\u003cbr\\u003e\\u003cbr\\u003eResource Struggle\\u003cbr\\u003eAmidst the sudden state collapse, the continent is flooded with untapped resources. Refugees, rebels, and power-hungry governors are all eyeing these precious materials. Ready yourself for battle and use every strategy at your disposal to secure these resources!\\u003cbr\\u003e\\u003cbr\\u003eBattle for Power\\u003cbr\\u003eCompete against other players for the ultimate honor of becoming the strongest governor in this grand strategy game. Claim the throne and reign supreme!\\u003cbr\\u003e\\u003cbr\\u003eForge Alliances\\u003cbr\\u003eEase the burden of survival in this chaotic world by forming or joining alliances. Collaborate with allies to rebuild civilization!\\u003cbr\\u003e\\u003cbr\\u003eRecruit Heroes\\u003cbr\\u003eThe game features a roster of unique heroes, each waiting to be recruited. Bringing together heroes with various talents and skills is essential for taking the initiative and ensuring safety in these desperate times.\\u003cbr\\u003e\\u003cbr\\u003eCompete with Other Governors\\u003cbr\\u003eHone your heroes\\u0026#39; skills, assemble your squads, and challenge other governors. Victory not only earns you valuable points, but also grants access to rare items. Lead your town to the top of the rankings and showcase the rise of a great civilization.\\u003cbr\\u003e\\u003cbr\\u003eAdvance Technology\\u003cbr\\u003eWith the rebellion obliterating almost all technological advancements, it\\u0026#39;s crucial to start rebuilding and reclaiming the fragments of lost tech. The race to master cutting-edge technology could determine the dominator of this new world order!\\u003cbr\\u003e\\u003cbr\\u003e[Stay Connected]\\u003cbr\\u003eDiscord: https://discord.com/invite/5cYPN24ftf\"],\"Century Games PTE. LTD.\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/DnGRN1DORz-ufSd8yvQv2i9aNFsVrzTEA4XgJZDmteorjBEYXsYb3jFyxWsqX_Rv_ITizboFPRmo_UlJuOdL\"],null,[105,176,120,255]],null,[\"Everyone 10+\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/csiz76udPjXmaJddU_1sanHGlQAAbKkvlprK3DSUNmwu1nY3U6qnXRrI2IDMaivooYK1x11oxz3PEO4z\"]],[null,\"Fantasy Violence, Alcohol Reference\"],[null,\"Users Interact, In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/bxs95MghtAOuZR_LPwVCUmUPYEvXsGVOH3chF1OCX0-Ns_S0qdHnzml2CGCgOGbYlftKsmt9gtpxLb8U\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.run.tower.defense\\u0026rdid\\u003dcom.run.tower.defense\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Strategy\"]],[null,null,null,[\"Tower defense\"]],[null,null,null,[\"Single player\"]],[null,null,null,[\"Medieval fantasy\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.advant.streamer\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleus