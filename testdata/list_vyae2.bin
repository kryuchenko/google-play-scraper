]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/Gg1-bCIaxRWrh3CwVXWVzfk7raLqOdoxRPCAqTK8EnmZq8Owmr_Xe3F4PBCdWiVBa2zuEom27fmAO9o0tR6W5J8\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/YR6fIC4ZyOY486qYCAwVBw77St39SCcPZ6i4YvR7FwdUHCgwnByfO9OyDYQM7lf6NugwrWQgQJgyQszz8pBk8g\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/vJ6vAhFcmRojB5TOUPbmLnkTCZN29sp7u1uvNdK-T-VGDTvTFKgRUVuUuv4pT4a5bn5U4s0Q1SwbiHJdxe1_UQ\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/ajrs6jlf46MjwpTOefupfgmGZyIGjlCvaIM13yj3w8J2MDqNSx6TpFlMCI2M4b1UusdK3RzmxHdp1hr0bOUMkvU\"]]],\"Pokémon TCG Pocket - Card Game\",[\"4.6\",4.565354],\"Card\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003djp.pokemon.pokemontcgp\\u0026rdid\\u003djp.pokemon.pokemontcgp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003djp.pokemon.pokemontcgp\"]],[\"qgJoGmYITUoTCMrn6+an/ZQDFaMJswYdIssGi/oBFwoVCI39+pznz72MQxIJCgVlbi1VUxAAugIyChwKFmpwLnBva2Vtb24ucG9rZW1vbnRjZ3AQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAQ\\u003d\"],[[[null,null,\"un1XGPwHf8c\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:un1XGPwHf8c?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:un1XGPwHf8c\",null,null,null,null,\"AXH1ezmm9CZBKpB-3Tty4l7pf2gJMaPl37B1MlVfW7TpX8qlKMDw9ymRmabYOO7WPjNP_p_BBwqsGBvSlMHLgdoJrbZjGBHD_4bAMCp4FYa8b4ks0Cb63VYrB9KlzLzIlSsaIX14Dr0OYnqnbG8zT5INIQnCGTJX4gjDuU-cMKj9LzWaUSkF8odNc5bGcWQQo-mRV9abns2AMVJ9tnoKMtCLnHFCgn8JM57t0j90Tx8ap3sjt9vODPb-9ukQeAWb_YYVWm8CygbU7d2lfICOplGs-oeOmxG3vy0xUrlpfQ6EJ3xMjqynrnyUAQLd4Yf9XKg\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/un1XGPwHf8c/hqdefault.jpg\"]]]],[null,\"Pokémon Trading Card Game Pocket has players in 150 countries and regions around the world.\\u003cbr\\u003eUse your mobile devices to enjoy collecting and battling with Pokémon cards anytime, anywhere!\\u003cbr\\u003e\\u003cbr\\u003e■ Open packs every day to collect cards!\\u003cbr\\u003ePlayers can enjoy the experience of collecting, with two booster packs available to open every day at no cost. Collect different kinds of Pokémon cards, like those with nostalgic illustrations from the past, as well as completely new cards exclusive to this game!\\u003cbr\\u003e       \\u003cbr\\u003e■ Experience a new kind of Pokémon card!\\u003cbr\\u003eThe app features new immersive cards with illustrations that have a “3D feel.” Players can feel like they’ve leapt into the world of the card’s illustration!\\u003cbr\\u003e\\u003cbr\\u003e■ A new way to collect with the share feature!\\u003cbr\\u003eSharing has just been added.\\u003cbr\\u003eIt’s a feature that lets you give one 1-4-diamond rarity card to your in-game friends—and receive one in return!\\u003cbr\\u003e\\u003cbr\\u003e■ Trade cards with friends!\\u003cbr\\u003eUse the trade feature to collect even more cards!\\u003cbr\\u003eCertain cards can be traded with friends.\\u003cbr\\u003eYou can now trade cards from even the most recent booster packs. In addition, cards of 2-star rarity, Shiny 1, and Shiny 2 rarities can also be traded.\\u003cbr\\u003e       \\u003cbr\\u003e■ Show off your collection!\\u003cbr\\u003eDisplay your cards with binders or display boards, and showcase them to players around the world! Try building a collection that you’re proud to show off!\\u003cbr\\u003e       \\u003cbr\\u003e■ Enjoy casual battles!\\u003cbr\\u003eYou can enjoy quick and exciting battles with your cards!\\u003cbr\\u003ePlayers who want to test their skills even more can take on ranked matches.\\u003cbr\\u003e\\u003cbr\\u003eTerms of Use: https://www.apppokemon.com/tcgp/kiyaku/kiyaku001/rule/\"],\"The Pokémon Company\",\"50,000,000+\",null,null,null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-