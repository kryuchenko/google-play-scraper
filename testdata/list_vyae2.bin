36],[null,null,\"https://play-lh.googleusercontent.com/T0trjocIQc_bSo9nsOtZWm3J5ilOWXlgoG9cBOlhm7xtSPaDf41g8X8j1fvF5zqgf-GV8OTVxNDgOVcHgILF-w\"]],[null,2,[2048,1536],[null,null,\"https://play-lh.googleusercontent.com/lJdoOKALuxU3CSfUi0t9tC9j4uXXCRMS3UjbZDn1lcfaYxls_88w4138jACAjRPSWI1jrTJrAi39Wv0ES3HJ\"]],[null,2,[2048,1536],[null,null,\"https://play-lh.googleusercontent.com/48jf-6c9pbzRtL_Kld1ZZdyrVGqwXE6aGsPw4kEK9Q_tpHyfSDSYxGalOSGPnhDRlLvVD9KD0zbIZc3Es4TQmw\"]],[null,2,[2048,1536],[null,null,\"https://play-lh.googleusercontent.com/poCr9pec8vx1-HKKhzax1BPInlvE_K69Vhi1rZs1TM6QKLJgLVxxMAWjpfjgiFrj3YHTPvgcvFNZSYEl33ix\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/arNx1X6k39eROipccExxmq3QayFZlW0Ofks1uw9CxuE_0EzoDaEY4oNH4rRj5NQ2d-QogdquSLv3DOV_3Xpn\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/cAGQ1wx-u97g1mhzuEuCN27OfZ60KbScpIeXvwsQKrK7yXygbNiDUYX5OT4pfmPuVlCuIBPc0PdBIkn8Eina\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/IYnjGMoDSLwHibjzJPHWdUZdu8tWyQIzI-KAcRKYjkAOc-n9sR2N2cMwadGCabuQy5yE86uQPN_3Ry4e8BkM\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/GqXLpLPhLQTmjE-xSt67xv3Gqo7YtLzlT7xQkKVbEppoVXyVz6TpHtrg66ftBlOu6x4DyHW5f-HPmkFTNsjDnsk\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/bOmB0y-5hMcpqbJgvq60p-4LLHyHhdLEYusymn-0vG6CnO66BD1o0n1cs6Qb7obksD489z1_SBrFVW3u60a7\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/EY0hi8ikJYl4DqXcyxT1MUAMrqiMvTUF2D2d9NezkMmUsbNTWKTwIMoX-6zRmSNJ4TBfN5zFv8cHpYH5nA0X0w\"]]],\"Coin Master - Board Adventure\",[\"4.7\",4.696505],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.moonactive.cmboard\\u0026rdid\\u003dcom.moonactive.cmboard\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.moonactive.cmboard\"]],[\"qgJgGl4IL0oTCMrn6+an/ZQDFaMJswYdIssGi/oBDwoNCAASCQoFZW4tVVMQALoCMgocChZjb20ubW9vbmFjdGl2ZS5jbWJvYXJkEAEYAxISCgQIARABCgQIAxABCgQIBBAD\"],[[[null,null,\"lLvsioUZrpQ\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:lLvsioUZrpQ?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:lLvsioUZrpQ\",null,null,null,null,\"AXH1ezm7deuC6-tSeMal364ZPXaHAqAB3b0_pWITqYp7UIUPGLuWADMrXJE3yeBC1Ljmdu7vPdbRh41zq-ynNPNP6Bh8W6zh54cFkHZC-6qQs1bII3IH62gfDi30MTYcA0KKcZC6nDG9fgcVIzb1HaJdTxtcVdZRTpNfHQ1w9GWf6j3vgqZ_NkTzS9LXME3xl_ycx0IcTxOlNVVnU9-yb6l408g3yHYj4CuCr07Qqr8preM-YFij5c3SvMszHxBGchxuzWT4dVSfxsIsS-TvOQOR3pmU8N6B5Z4n54gy61umYXrbkTH64FH7qjYH3tz1gDg\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/lLvsioUZrpQ/hqdefault.jpg\"]]]],[null,\"Roll, raid, and rule the board!\\u003cbr\\u003e\\u003cbr\\u003eWelcome to Coin Master: Board Adventure, where every dice roll takes you closer to riches, revenge, and all-out fun! Collect coins, attack villages, build your empire, and explore wild new boards full of surprises. It’s not just a board game - it’s a bold adventure!\\u003cbr\\u003e\\u003cbr\\u003eROLL THE DICE, MAKE YOUR MOVE\\u003cbr\\u003eEvery roll brings a new opportunity. Land on coin tiles to stack your fortune, shields to protect your village, or raid tiles to steal from your Coin Master friends! Just like a real board game, your strategy—and a little luck—will decide your fate.\\u003cbr\\u003e\\u003cbr\\u003eBUILD YOUR WAY TO THE TOP\\u003cbr\\u003eUse your loot to upgrade buildings, complete themed villages, and grow your collection. From fantasy kingdoms to tropical getaways, every board you explore unlocks new worlds to conquer.\\u003cbr\\u003e\\u003cbr\\u003eROLL AND ATTACK\\u003cbr\\u003eLanding on the attack tile? Time to strike! Attack villages across the map, break through defenses, and send your rivals back to square one. It\\u0026#39;s payback with a bonus.\\u003cbr\\u003e\\u003cbr\\u003eCOLLECT COINS, RAID FRIENDS\\u003cbr\\u003eRaid your friends’ boards and dig up massive treasures. Want more? Steal coins, disrupt their progress, and climb the ranks. Being nice won’t win you this game!\\u003cbr\\u003e\\u003cbr\\u003eCOLLECT CARDS, COMPLETE SETS\\u003cbr\\u003eLove collecting? Get hooked on rare card games! Gather themed cards as you play, complete sets, and earn powerful rewards. Trade with friends to finish your collection faster.\\u003cbr\\u003e\\u003cbr\\u003ePLAY CASUAL, COMPETE HARD\\u003cbr\\u003eWhether you\\u0026#39;re in for a quick spin or an all-day binge, Coin Master: Board Adventure delivers fun at your own pace. Play solo or team up with friends to swap cards, trade boosts, and dominate events together!\\u003cbr\\u003e\\u003cbr\\u003eWhy Players Love Coin Master: Board Adventure:\\u003cbr\\u003e\\u003cbr\\u003e- Exciting roll and attack gameplay\\u003cbr\\u003e\\u003cbr\\u003e- Strategic board movement\\u003cbr\\u003e\\u003cbr\\u003e- Build epic villages and unlock new boards\\u003cbr\\u003e\\u003cbr\\u003e- Collect coins and spend them wisely\\u003cbr\\u003e\\u003cbr\\u003e- Battle friends\\u003cbr\\u003e\\u003cbr\\u003e- Fun and competitive casual game style\\u003cbr\\u003e\\u003cbr\\u003e- Exciting card collecting and trading\\u003cbr\\u003e\\u003cbr\\u003e- Constant events, bonuses, and surprises\\u003cbr\\u003e\\u003cbr\\u003eIt’s your turn.\\u003cbr\\u003eAre you ready to roll your way to glory, fortune, and board domination?\\u003cbr\\u003eDownload Coin Master: Board Adventure now and become the master of the board!\\u003cbr\\u003e\\u003cbr\\u003eTerms of Service: https://static.moonactive.net/legal/terms.html?lang\\u003den\\u003cbr\\u003ePrivacy Notice: https://static.moonactive.net/legal/privacy.html?lang\\u003den\"],\"Moon Active\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/fzFnnq9QNBxRlaaOmWWvyX6uK80qybtL2KUtKCSvmaBfEToOtMSYg6