,2048],[null,null,\"https://play-lh.googleusercontent.com/cDBMTap_2F64iTY7SjWY8N1px5NcFn3AW35UrlOkV4G8maD13X23j11_MLicPU2zYly5PTckqiAg-s6-tB-bX_c\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/klEcQrULSERS155GJP_g-27nqe4gvnCgfzV0U8VEzFYIy1XicCgEMLiMI-tKUa5uwuX3EslyQchGhv1RUQv-\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/6wG_-08PudQDdXAkx0tjvKyD8JbvDznCMpLTDLQ92k-2QbkS_NNaCdeg9I8TwJ10u_DlDP5LnC9jEdztd2txuo0\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/D9Vo9mixjaQ9EPBtspgD133q6oI9TYtNPeOY37CzGpyzJNT0VO-COMahPf6Q808xj1hLPbXjOebvDIBbVO7pnqw\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/S0OlMQUlayneb-7Bpen3dtABNBAljk9dKgIF4I1R8E04Q0QIW4BrTcdEmpBIoDe8VdsbxNfuXuhXtVYINVLazA\"]]],\"Gossip Harbor: Merge \\u0026 Story\",[\"4.3\",4.3132277],\"Puzzle\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mergegames.gossipharbor\\u0026rdid\\u003dcom.mergegames.gossipharbor\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.mergegames.gossipharbor\"]],[\"qgJtGmsILkoTCMrn6+an/ZQDFaMJswYdIssGi/oBFwoVCIukytfl6OyLQxIJCgVlbi1VUxAAugI3CiEKG2NvbS5tZXJnZWdhbWVzLmdvc3NpcGhhcmJvchABGAMSEgoECAEQAQoECAMQAQoECAQQBA\\u003d\\u003d\"],[[[null,null,\"Kl-0KPlQ76M\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:Kl-0KPlQ76M?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:Kl-0KPlQ76M\",null,null,null,null,\"AXH1ezmbr66qTKcCUvrv1YqkCdpVgR8JlQqfUhPurdwlHm_THpgJnNyr3WJ4ewpeiVe9xCslSe1L9OMIYQMg0Vvp1ynWH106X5Z8EXwOPv5MBzpdH8FfF_uBv8hvfPkD-NBaoVGuRDmbWDXGZI3aFWB_lmA6fLBE7XEVQzdKHm7LPOqTbNpkIE0h1b9QCP5PZZUsl17b2gxYO6IyoxIs6bBTCqEtbRAW3KPYa8N6BirbJHSI6GiltjNfan-2dvNHw7XyooR9dIsmXbQDc1ZmOEtue5CTQ60pJzdb3542xX7tDddwNpb7OeF13t225mcc0tw\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/Kl-0KPlQ76M/hqdefault.jpg\"]]]],[null,\"Welcome to Gossip Harbor 🌊\\u003cbr\\u003eFollow Quinn Castillo as her picture perfect life on Brimwave Island crumbles around her. Divorce, sabotage and secrets. Help answer the question everyone\\u0026#39;s thinking: Who\\u0026#39;s trying to ruin her life? \\u003cbr\\u003eMerge flavorful dishes, restore and decorate Quinn\\u0026#39;s restaurant and watch the mystery unfold. \\u003cbr\\u003eBut who can you trust in Brimwave? \\u003cbr\\u003e\\u003cbr\\u003eWhip Up Tasty Dishes🥪\\u003cbr\\u003eServe coffee, sandwiches, seafood, and a range of other dishes, to your customers. The more you play, the more dishes you’ll find to add to your menu!\\u003cbr\\u003e\\u003cbr\\u003eRestore the Restaurant🧰\\u003cbr\\u003eRebuild and design the best beach restaurant around! Choose the flooring, wallpaper and furniture to restore restaurant to its former glory! \\u003cbr\\u003e\\u003cbr\\u003eBuild Relationships💞\\u003cbr\\u003eConverse with customers and hang out with old friends. Or explore the possibility of a new budding romance. \\u003cbr\\u003e\\u003cbr\\u003eCatch up on the Gossip🤫\\u003cbr\\u003eYou\\u0026#39;ll renovate and merged to reveal clues, and uncover hidden secrets of the residents on Brimwave Island. And perhaps even unveil the Castillo\\u0026#39;s hidden secrets…\\u003cbr\\u003e\\u003cbr\\u003eEnjoying Gossip Harbor? Learn more about the game on our Facebook Fan Page!\\u003cbr\\u003ehttps://www.facebook.com/GossipHarbor\\u003cbr\\u003e\\u003cbr\\u003eNeed help? Contact us by sending an email to gossipharbor-service@microfun.com\\u003cbr\\u003eWe\\u0026#39;re here to help you! \\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy: https://www.microfun.com/privacy_EN.html\\u003cbr\\u003eTerms of Service: https://www.microfun.com/userAgreementEN.html\"],\"Microfun Limited\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googl