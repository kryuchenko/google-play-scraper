eusercontent.com/F7cS0Uj9cKKM8T7WKmKB9depp0SP7vYyxibMcd_q1qlaokYE0bPOlgb4IjieYkxnEYCcDYxniOKziQVrGIg1Tw\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/lyvdv1c5pFssiVfDhPiCd8e_6BH6W7KMp5faw7l3L1FjM8oCF9XBnS-1o2vsmK-ZUc1VHAmEoaPHlAma6ckWJg\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/R9vCFxIZjAMhZT97ZgPyip_H1pidxdt_WebKFwZmD-58jXB2GXjZ9-VllAU8SeXQCrKDE8U6A09dbi6cQvSDl5A\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/nnLIxHKcMlLR5PyxqXPY0ccZCem0rjVULasZJhEFBBjzL6_DaUTaPdtU1fTb8GDN6JG16X3rpoKeTNkWAbFR\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/ZkCtL1_BVubpVfegWlfBYLmPEfEEVSvNcHgI86viYpJ8G7imH27uJ1Z8QAGnMKi23IrwDxRvriYB85NsF8Jr\"]]],\"School Party Craft\",[\"4.4\",4.4489455],\"Adventure\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.candyroom.clubcraft\\u0026rdid\\u003dcom.candyroom.clubcraft\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.candyroom.clubcraft\"]],[\"qgJiGmAIsAFKEwjK5+vmp/2UAxWjCbMGHSLLBov6AQ8KDQgAEgkKBWVuLVVTEAC6AjMKHQoXY29tLmNhbmR5cm9vbS5jbHViY3JhZnQQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAQ\\u003d\"],null,[null,\"Dear players, our game is under active development! We ask you to write your wishes and suggestions, what you would like to see in the next update.\\u003cbr\\u003e\\u003cbr\\u003eSchool Party is a cubic style life simulator for schoolchildren and teenagers.\\u003cbr\\u003eYou have a big city at your disposal, in which there are many cute girls and nice boys.\\u003cbr\\u003eYou not only have to hang out and do shopping, but also buy mansions, meet cool characters and even ride the coolest cars!\\u003cbr\\u003eIn this city, your possibilities know no boundaries: building houses, buying blocks, furniture and doors is just the beginning of a big adventure.\\u003cbr\\u003eBe trendy and stylish - dress up, walk around town, swim in the pool, go to the movies and dance in the crazy disco!\\u003cbr\\u003e\\u003cbr\\u003eCrafting and building:\\u003cbr\\u003eMany beautiful mansions with large plots where you can demolish the purchased house and build the cottage of your dreams.\\u003cbr\\u003eA large collection of various blocks for construction and decoration.\\u003cbr\\u003eHundreds of types of furniture for every taste: chairs, tables, sofas and beds, wardrobes and more.\\u003cbr\\u003eDoors, houseplants and chandeliers will complete the design of your home.\\u003cbr\\u003e\\u003cbr\\u003eRelationship between players:\\u003cbr\\u003eDon\\u0026#39;t worry, you are not alone in the city.\\u003cbr\\u003eThere are thousands of people in the city with whom you can communicate, be friends, walk together, visit a restaurant and a park, ride supercars together and hang out in a nightclub.\\u003cbr\\u003eIf you like the character, add him to the phone book and communicate with him via SMS at any time.\\u003cbr\\u003e\\u003cbr\\u003ePaintball:\\u003cbr\\u003eLarge selection of paintball weapons:\\u003cbr\\u003eMiniguns, Pistols, Assault Rifles and exclusive Dinogun, Bazooka-Shark and more.\\u003cbr\\u003eAll this shoots colored bullets with paints.\\u003cbr\\u003eShoot the hooligans who took your coins and they will return them to you.\\u003cbr\\u003e\\u003cbr\\u003eInteresting places:\\u003cbr\\u003e- Market (furniture, blocks, doors, skins and paintball guns)\\u003cbr\\u003e- Disco (order music from DJs and dance with your friends)\\u003cbr\\u003e- Large park\\u003cbr\\u003e- Beach and sea with sun loungers\\u003cbr\\u003e- Restaurant and cinema\\u003cbr\\u003e- School and bank\\u003cbr\\u003e- Car dealership and gas station\\u003cbr\\u003e- City pool\\u003cbr\\u003e\\u003cbr\\u003eFeatures of the game:\\u003cbr\\u003e- Driving cars and tuning\\u003cbr\\u003e- Sport: motorcycles, bicycles, scooters and skateboards\\u003cbr\\u003e- Mini-games (barman in the disco (2nd floor), barman in the restaurant (1st floor), game of smiles)\\u003cbr\\u003e- Chests with coins and many bonuses\\u003cbr\\u003e- Ship cruise and airplane flight\\u003cbr\\u003e- Swimming (on the beach and in the pools)\\u003cbr\\u003e- Beautiful character animation\\u003cbr\\u003e- First and Third person camera\\u003cbr\\u003e- Interactive with furniture (sit, sleep etc)\\u003cbr\\u003e- Change of weather and time of day\\u003cbr\\u003e- Convenient and intuitive controls\\u003cbr\\u003e- Optimization for weak devices (from 1 GB of RAM)\\u003cbr\\u003e- Customization of gameplay and buttons to your liking\\u003cbr\\u003e\\u003cbr\\u003eCreate your pixel interior in the world of fairy tales and fantasy.\\u003cbr\\u003eEnjoy your game.\"],\"Candy Room Games \\u0026 RabbitCo\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/4Cxg59Ecm6xcgwwPtVfIgDQBMGgh8AGdy7vj_QHXkBn7hWwJIuaRGlUnPaiAHlYs7q222NS_KKWqDI6nzQmEcg\"],null,[62,81,107,255]],null,[\"Everyone 10+\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/csiz76udPjXmaJddU_1sanHGlQAAbKkvlprK3DSUNmwu1nY3U6qnXRrI2IDMaivooYK1x11oxz3PEO4z\"]],[null,\"Fantasy Violence\"],[null,\"Users Interact\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/bxs95MghtAOuZR_LPwVCUmUPYEvXsGVOH3chF1OCX0-Ns_S0qdHnzml2CGCgOGbYlftKsmt9gtpxLb8U\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.candyroom.clubcraft\\u0026rdid\\u003dcom.candyroom.clubcraft\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\