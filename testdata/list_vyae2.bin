ull,2,[2560,1920],[null,null,\"https://play-lh.googleusercontent.com/o0p249OJe6sTHcUky-YNiCYm9lthVkAaNXnyl_vMUI-IlaqWs2FXB-76PSO0dAkIROt7lH7I4QE2EPnUa8FTdg\"]],[null,2,[2560,1920],[null,null,\"https://play-lh.googleusercontent.com/PhjWM-HkpVNi9vWyJ3ffLTw17wBDT6eOdZw5Vl2DpMXa9mlg35hONutTDj1r9MxutIn_RvsfyD5vl3kmXA0Q\"]],[null,2,[2560,1920],[null,null,\"https://play-lh.googleusercontent.com/DUPzP29S_9k9VYt3Z8HTsYIcu1iBGKldrtoWxa37M_nXFY2WObTRsVbbYWn96sUm09KhJGGDngl7hBq__7xwpQ\"]],[null,2,[2560,1920],[null,null,\"https://play-lh.googleusercontent.com/bQj26G0fpEOF77sqo9fSSkOfI0DKenZp1cVJM-qGnSjs7mQxtV2c6vwz_vKEjR8Ut4i2UZU5iTdl0ztYYCnt5w\"]],[null,2,[2560,1920],[null,null,\"https://play-lh.googleusercontent.com/5863w3O2k_Flt358dYftFIHGd_d0f2f6YayAZ0DyWd6IZRWy8e0gfgh7GCc9sO9WRw-L-kD-btQH0InHumAftQ\"]]],\"Loop Sort\",[\"4.6\",4.5666666],\"Puzzle\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Garawell.LoopSort\\u0026rdid\\u003dcom.Garawell.LoopSort\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.Garawell.LoopSort\"]],[\"qgJfGl0IBkoTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCMQobChVjb20uR2FyYXdlbGwuTG9vcFNvcnQQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAQ\\u003d\"],null,[null,\"Get ready for a fun and addictive truck puzzle challenge!\\u003cbr\\u003eTap once to send the cubes from the truck onto the conveyor and watch them sort automatically. Match, clear, and progress through exciting levels filled with tricky obstacles!\\u003cbr\\u003e\\u003cbr\\u003eHow to play:\\u003cbr\\u003e\\u003cbr\\u003eTap the truck to release cubes onto the conveyor.\\u003cbr\\u003e\\u003cbr\\u003eSort and match the cubes to clear the line.\\u003cbr\\u003e\\u003cbr\\u003eOutsmart unique obstacles that keep every level fresh.\\u003cbr\\u003e\\u003cbr\\u003eObstacles you’ll face:\\u003cbr\\u003e\\u003cbr\\u003eHidden Blocks – reveal what’s behind them to continue.\\u003cbr\\u003e\\u003cbr\\u003eCurtains – sort the required color to lift them.\\u003cbr\\u003e\\u003cbr\\u003eIce Blocks – break through to free the cubes.\\u003cbr\\u003e\\u003cbr\\u003eBarriers – prevent cubes inside from going out, but allow new cubes to enter.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eSimple to play, hard to master! Can you clear them all?\"],\"VOODOO\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/2i1eP0pgSAYDlDl4qzLE3Wv4EfRLtm358y2MgenA2iG7i6ANfHg6m0IL29K0dPLHnlwF27d1cc_PbwhTo-Va4g\"],null,[252,180,7,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Garawell.LoopSort\\u0026rdid\\u003dcom.Garawell.LoopSort\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Puzzle\"]],[null,null,null,[\"Sort\"]],[null,null,null,[\"Offline\"]],[null,null,null,[\"Single player\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null