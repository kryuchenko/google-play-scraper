tent.com/DAMRsUQD8-ccdXfyeLwxNhRfkrUo57nq8f98OR6PY4j-aBTKhQvayiNJdUq7qczoCmvZX74QdwEeIQZE7zXb\"]],[null,2,[2560,1920],[null,null,\"https://play-lh.googleusercontent.com/Lr0zletqYA7GOCmtiFQKpjxBXP8KeUacsUIMJungjAvCXx4RdEoix-AQsf-lDfn31UAm8mFEm-6b7ZMAfxQ6mw\"]],[null,2,[2560,1920],[null,null,\"https://play-lh.googleusercontent.com/-wlfHdszSnZ613A0TOl_zmqdUcS6kik6wKgf2mtwSjKWyR3pfd9mVfcApxBNI8qstZsPFtjiKyzbyeLr1pSbkw\"]],[null,2,[2560,1920],[null,null,\"https://play-lh.googleusercontent.com/aZalLxTotRUtKlFiJxuC0kcRprDwVTVIy1KMHfigEos7FGMZrrZiLb1mskOJrhaoyzr6I8weoRKc4bwvAJNLWv8\"]],[null,2,[2560,1920],[null,null,\"https://play-lh.googleusercontent.com/5DGMPdkS_5JJYOSACWpPT_2G1i1eNs0883BzFrhPGMMircyi9TVfuiLQENiGxVyyVk5QsAKu2y9dBBshVQGairY\"]],[null,2,[2560,1920],[null,null,\"https://play-lh.googleusercontent.com/09SBw_wdJ-uDg3gNt-mAP6pNvIJ4NNxs0DbjnBrfI8CN660emsn0amA-NsdAc6GoEhDKW-UEVBjaxFCO6-gt\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/DAMRsUQD8-ccdXfyeLwxNhRfkrUo57nq8f98OR6PY4j-aBTKhQvayiNJdUq7qczoCmvZX74QdwEeIQZE7zXb\"]]],\"Jigsawcard Solitaire Puzzle\",[\"4.6\",4.621886],\"Puzzle\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.oakever.jigsawcard\\u0026rdid\\u003dcom.oakever.jigsawcard\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.oakever.jigsawcard\"]],[\"qgJgGl4ISkoTCK2V1v2Ov5YDFYV5hAYdKIIpUvoBDwoNCAASCQoFZW4tVVMQALoCMgocChZjb20ub2FrZXZlci5qaWdzYXdjYXJkEAEYAxISCgQIARABCgQIAxABCgQIBBAE\"],null,[null,\"Jigsawcard – The HD Jigsaw Puzzle \\u0026amp; Solitaire Card Game\\u003cbr\\u003eExperience an exciting new way to enjoy jigsaw puzzles! In Jigsawcard, you’ll flip, slide, match, and snap puzzle cards to reveal breathtaking HD images. The game seamlessly blends classic jigsaw satisfaction with smooth solitaire card-sliding mechanics and mysterious face-down cards that await your revealing flip, creating a relaxing yet addictive, surprising, and truly memory‑challenging adventure.\\u003cbr\\u003eHow to Play\\u003cbr\\u003e- Slide cards into place with easy, intuitive swipes\\u003cbr\\u003e- Strategically flip face-down cards to uncover their image and reveal vital clues.\\u003cbr\\u003e- Match \\u0026amp; snap pieces to finish puzzles faster\\u003cbr\\u003e- Plan moves carefully to keep sets intact and clear the board efficiently\\u003cbr\\u003eKey Features\\u003cbr\\u003e- Stunning HD jigsaw pictures: nature, art, animals \\u0026amp; more\\u003cbr\\u003e- Satisfying snap \\u0026amp; chain reactions when multiple cards connect\\u003cbr\\u003e- Mysterious face-down cards —  expect unpredictable reveals and a genuine memory challenge\\u003cbr\\u003e- No timers, no pressure — perfect for all ages and skill levels\\u003cbr\\u003e- From quick casual puzzles to complex challenges for dedicated players\\u003cbr\\u003e- Unlock different sceneries to keep your puzzle journey fresh\\u003cbr\\u003ePerfect For\\u003cbr\\u003e- Fans of jigsaw puzzles, sliding puzzles, card matching, or unique blend of jigsaw and solitaire gameplay\\u003cbr\\u003e- Players seeking a relaxing yet rewarding puzzle experience\\u003cbr\\u003e- Those who love beautiful, high‑quality visuals while training their brain\\u003cbr\\u003eJigsawcard is more than a jigsaw puzzle game — it’s your daily escape, your moment of calm, and a celebration of creativity. Flip, slide, match, and watch stunning HD puzzle cards come to life one satisfying snap at a time.\\u003cbr\\u003eDownload now and join jigsaw puzzle lovers worldwide in the beautiful and rewarding fusion of jigsaw and solitaire card puzzle experience!\"],\"Oakever Games\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/uFoOedzXhJN5sbPYI6qECrASwXt2eCkdw7wwrx6n5jzqvU_9MuCM87eX2iBdcVVP-h