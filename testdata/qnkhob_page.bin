],\"Action\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.talkingtomgoldrun\\u0026rdid\\u003dcom.outfit7.talkingtomgoldrun\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.outfit7.talkingtomgoldrun\"]],[\"qgJoGmYIDhIlCiMKHWNvbS5vdXRmaXQ3LnRhbGtpbmd0b21nb2xkcnVuEAEYA0oTCKb7lvCDgpUDFYacCgkdcoApQ5oBEwi4n+S5gYKVAxWhvQoJHbUpAMT6AQ8KDQgAEgkKBWVuLVVTEAA\\u003d\"],[[[null,null,\"k0N8xwKko_U\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:k0N8xwKko_U?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:k0N8xwKko_U\",null,null,null,null,\"AXH1eznjRMRfq3JZjipT6x4SljQakBEliPgjEGpYixWuV9blL6dgp5hbCnSAjYeyNaiR7aGe1bzLgVTVTG9oQqvm88mpnEa0x31FXHmF08dRk_qUiGy49K6qoYVqbMlOQnnAA_Q1E8vGgLIANONNFORmeKemgPodM2tLQW1VQbKsLcf1UlxgyjLimAqs9dDGH5RhqwTcmUxzl0Lw63sqelyrxcAlurj8lmp52zvDvnOQANF-LNfSjoNSkJE4iO5w48ZgnDAzjRXf8Wiajk68xg2KiJmDndljLkhyTlonoJ0f3UsgzPfDY3zaskXoGlxiPY0\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/k0N8xwKko_U/hqdefault.jpg\"]]]],[null,\"Run, dash, and chase Rakoonz with Talking Tom and friends in the ultimate endless runner adventure!\\u003cbr\\u003eHelp Talking Tom speed through vibrant worlds, dodge exciting obstacles, and collect stolen gold. Unlock Talking Angela, Ginger, Ben, Hank, and Becca, and customize them with amazing outfits!\\u003cbr\\u003e\\u003cbr\\u003eExciting Endless Runner Action\\u003cbr\\u003eDash through vibrant worlds, including Venice Canals, Winter Wonderland, and China Dragon World. Every run is a new adventure full of surprises!\\u003cbr\\u003e\\u003cbr\\u003eEpic Skateboarding Challenges\\u003cbr\\u003eHop on your skateboard and enter exciting side worlds! Show off your moves, perform awesome stunts, and complete action-packed time trials to win amazing rewards.\\u003cbr\\u003e\\u003cbr\\u003ePowerful Boosts and Power-Ups\\u003cbr\\u003eUse jetpacks, magnets, and speed boosts to fly, dash, and sprint your way to new records. Accelerate your runs and experience unbeatable chasing thrills!\\u003cbr\\u003eUnlock and Customize Characters\\u003cbr\\u003eUnlock your favorite friends, including Talking Angela, Ginger, Hank, Ben, and Becca. Collect gold and tokens to build and upgrade their dream homes and personalize their style with amazing outfits! \\u003cbr\\u003e\\u003cbr\\u003eCompetitive Race Mode\\u003cbr\\u003eChallenge players to exciting races! Set new records, climb leaderboards, and prove you’re the fastest runner around.\\u003cbr\\u003e\\u003cbr\\u003eReady, Set, RUN! Perfect for kids and families who love arcade running games! Experience endless excitement, nonstop action, and hours of fun with Talking Tom Gold Run, the ultimate cat runner game!\\u003cbr\\u003e\\u003cbr\\u003eFrom Outfit7, creators of My Talking Tom, My Talking Angela, My Talking Tom Friends and Talking Tom Hero Dash.\\u003cbr\\u003eThis app is certified by PRIVO, an FTC Children’s Online Privacy Protection Act (COPPA) Safe Harbor.\\u003cbr\\u003e\\u003cbr\\u003eThis app contains:\\u003cbr\\u003e- Promotion of Outfit7\\u0026#39;s products and advertising;\\u003cbr\\u003e- Links that direct customers to Outfit7’s websites and other apps;\\u003cbr\\u003e- Personalization of content to encourage users to play the app again;\\u003cbr\\u003e- The option to make in-app purchases;\\u003cbr\\u003e- Items to purchase (available in different prices) using virtual currency, depending on the player’s progress; and\\u003cbr\\u003e- Alternative options to access all functionalities of the app without making any in-app purchases using real money.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eTerms of use: https://talkingtomandfriends.com/eula/en/\\u003cbr\\u003ePrivacy policy for games: https://talkingtomandfriends.com/privacy-policy-games/en\\u003cbr\\u003eCustomer support: support@outfit7.com\"],\"Outfit7 Limited\",\"500,000,000+\",null,null,null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Yxa0jvt79_xSRR46KW4WPEAurXcOH6lzGXHIENn8F_YbZ8d5K6_Y3vNmJjRB7M0c8Zr0xbUQ-AYpxjPtobFT0Q\"],null,[111,116,140,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],[null,\"Mild Fantasy Violence\"],[null,\"In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.talkingtomgoldrun\\u0026rdid\\u003dcom.outfit7.talkingtomgoldrun\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $149.99 per item\",[false]]]],[\"Run, jump, run!\",null,[null,null,null,null,[null,null,\"/store/apps/collection/cluster?gsr\\u003dSo8BEi8KAggHEDsaC0dBTUVfQUNUSU9OIhZyZWNzX3RvcGljX0F2a21xeU9nV0VzKgIIAko6CjgIABC1l8n3DRDC0rDoCRDFn9iDBxCH-KqXChC9nu6jBxC60OXtBRDn0fi6ChCdg_SIDxCbz9qyCVAJahhhUmhuTGtEbUlqNEViaC8vczArUVdnPT34AQCwEgA%3D:S:ANO1ljJoLqo\"]],null,true]]]]",null,null,null,"generic"]]
