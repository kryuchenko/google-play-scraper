1dVY4wmTmEGQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/reUosjWOTWKItwyicLuQFV0AfP6GY8RVBf8sH-PeMCqcs0gJXpnHdhGCfteDAztROniV\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/wT4DvoBlOsvT2JxNEK-uu4t1BErKbFgoUmCY6iOp_7_1Q6pnsP6-H3uoQIHwhy8EHsQJ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/ZauMYoSplaFrnzx9UxJesTV52Qrl0NB9zltaPR0zSKYGjoyxCf_1QIGFHVJP6SQSpeIuuhxPSbBIfbaYjzV6\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/ixuoIOLVwmLgyB-gUddzBC-d8X_pvHwrMTqg1SBhHdsKtT7sxHW1x6v4jMOPPD2CQw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/6Radk4AoyBjyeYFbRgf9sMwRZG2c8EKo31tryT9iCamGb-lSeak-ZYBaQGBICBkj28E\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/GF81UoQnIokhsd66fBC_9dDnj6OEpZfW-Tn_gdcPdKfmEy8NVUXgOImOFrQeprPH5Q\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/-ZcaFnjsvAkxZQ5EKt5pOMgM1i_bhAq4I7ARkpuo7vxqHLHKY2SPqBInEmdCUN6cEB9fy1EOpT1dVY4wmTmEGQ\"]]],\"Talking Tom: Hero Dash Run\",[\"4.3\",4.275187],\"Action\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.herodash\\u0026rdid\\u003dcom.outfit7.herodash\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.outfit7.herodash\"]],[\"qgJnGmUIDRIcChoKFGNvbS5vdXRmaXQ3Lmhlcm9kYXNoEAEYA0oTCKb7lvCDgpUDFYacCgkdcoApQ5oBEwi4n+S5gYKVAxWhvQoJHbUpAMT6ARcKFQjp7MnW086tiUMSCQoFZW4tVVMQAA\\u003d\\u003d\"],null,[null,\"The race is on! Welcome to Talking Tom Hero Dash – the ultimate endless runner adventure where the fun never stops!\\u003cbr\\u003e\\u003cbr\\u003eThe Rakoonz are on the loose! They\\u0026#39;ve captured Talking Angela, Ben, Hank, and Ginger, and it\\u0026#39;s up to you to be the hero, save Tom\\u0026#39;s friends, and clean up the city! Are you ready to join them on this thrilling quest?\\u003cbr\\u003e\\u003cbr\\u003e- Epic Runs: Feel the adrenaline rush as you dash, jump, slide, and avoid obstacles in stunning environments. \\u003cbr\\u003e\\u003cbr\\u003e- Battle the Rakoonz: The Rakoonz are back, wreaking havoc and causing chaos. Unleash your inner superhero, show off your skills, and save your friends from their clutches!\\u003cbr\\u003e\\u003cbr\\u003e- Collect Awesome Rewards: Gather gold coins, treasure chests, power-ups, gadgets, suits, and diamonds as you blaze through the city.\\u003cbr\\u003e\\u003cbr\\u003e- Unlock and Upgrade Heroes: Rescue and play as your favorite characters from the My Talking Tom and Friends universe. Unlock unique superhero outfits and power them up for even more fun!\\u003cbr\\u003e\\u003cbr\\u003e- Restore the City: Defeat the Rakoonz and complete heroic missions to clean up and rebuild the city. \\u003cbr\\u003e\\u003cbr\\u003e- Exciting Power-Ups: Use incredible power-ups to boost your run and gain an edge over the Rakoonz. \\u003cbr\\u003e\\u003cbr\\u003eEmbark on a Supercharged Adventure: Dive into a world of endless excitement and high-speed action with Talking Tom Hero Dash! Dash through vibrant cities, ancient temples, scorching deserts, and icy mountains. Leap over obstacles, dodge buses, and collect gold coins and tokens to help restore peace and order.\\u003cbr\\u003eFrom Outfit7, creators of My Talking Tom, My Talking Tom Friends, My Talking Angela, and Talking Tom Gold Run.\\u003cbr\\u003eThis app is certified by PRIVO, an FTC Children’s Online Privacy Protection Act (COPPA) Safe Harbor.\\u003cbr\\u003e\\u003cbr\\u003eThis app contains:\\u003cbr\\u003e- Promotion of Outfit7\\u0026#39;s products and advertising;\\u003cbr\\u003e- Links that direct customers to Outfit7’s websites and other apps;\\u003cbr\\u003e- Personalization of content to encourage users to play the app again;\\u003cbr\\u003e- The option to make in-app purchases;\\u003cbr\\u003e- Items to purchase (available in different prices) using virtual currency, depending on the player’s progress; and\\u003cbr\\u003e- Alternative options to access all functionalities of the app without making any in-app purchases using real money.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eTerms of use: https://talkingtomandfriends.com/eula/en/\\u003cbr\\u003ePrivacy policy for games: https://talkingtomandfriends.com/privacy-policy-games/en\\u003cbr\\u003eCustomer support: support@outfit7.com\"],\"Outfit7 Limited\",\"500,000,000+\",null,null,null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/3ab2r1_AM844b_vM-SZ2AKi-rcc-owNqHEinHXmhbsSOlXPmqVGkOcO-k4JHTJEMchwlQR28LtgnBe9e96sW\"],null,[132,78,227,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],[null,\"Mild Fantasy Violence\"],[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.herodash\\u0026rdid\\u003dcom.outfit7.herodash\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $114.99 per item\",[false]]],[[\"com.outfit7.talkingtomgoldrun\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/HympGTcpiPUnufrkfbRIdE6XoMvho7nAzvz-298nBWB