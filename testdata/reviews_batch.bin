)]}'

[["wrb.fr","oCPfdb","[[[\"21360732-d8b6-40bf-bb27-06be083512e5\",[\"Spencer Cashdollar\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVf1rTQ-rxyWFyO15cU9UXDYMNnnD3RwCaSnJRmVDLqZua4JV4IYw\"]]],1,null,\"i don't know how an app like this manages to become worse with every update. nearly useless at this point, you're better off with a paper map. Today it routed me to the middle of an interstate, nowhere near an exit, and said I'd arrived at my destination. A few days ago it only offered one route through backroads no matter how many times i tried to hit the alternate route button. I took the highway route i already knew, and unsurprisingly got there in less time and distance. Absolute Trash 0/5 ⭐\",[1776805245,167000000],50,null,null,[\"109430057684136752920\",\"Spencer Cashdollar\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVf1rTQ-rxyWFyO15cU9UXDYMNnnD3RwCaSnJRmVDLqZua4JV4IYw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.15.01.894202351\",null,[[[\"vaf_never_display_disruptive_ads\",[2]]]],null,[true,false],null,1],[\"b5f1540b-95be-4065-aa35-cd46506ebd6c\",[\"Roddy Graham\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKS_eePHBaWR7rxTh9Zf3FCAq5hG9tN88mg9tStw4aSwTMjUQ\\u003dmo\"]]],1,null,\"it used to turn the route red or yellow depending on traffic. now it only shows blue. we have always relied on those colors to help us change routes. also, the alternative route button doesn't give options that are helpful. it keeps trying to bring us through DC, which, is never a fast route. I can change it.\",[1776096051,502000000],52,[\"Google LLC\",\"We understand your concern, Roddy. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1776126347,389000000]],null,[\"108244722176461854863\",\"Roddy Graham\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKS_eePHBaWR7rxTh9Zf3FCAq5hG9tN88mg9tStw4aSwTMjUQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.14.09.891313448\",null,null,null,null,null,1],[\"ad5acb1c-3e40-47cb-b84c-f1ed25dcfd58\",[\"Vivek Hegde\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXEkBRaTyfGL61UpxGd7bYJoSAES2nIX1DuW7pXJbcIbxETxczX\"]]],2,null,\"Does not save my navigation settings between device upgrades, when you switch phones - The settings to turn off fuel efficient routes do not get saved between device upgrades. It used to remember my destination patterns - Monday evening karate place, Tuesday evening gym etc. It doesn't do that anymore. When you search for a chain business (say Starbucks), it doesn't list the location options in order of distance.\",[1777344174,137000000],39,[\"Google LLC\",\"Hi Vivek. Let's give these steps a try, clear cache and uninstall the updates: https://goo.gle/3oW0tVa. Hope this helps.\",[1677440969,827000000]],null,[\"104972003593085233705\",\"Vivek Hegde\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXEkBRaTyfGL61UpxGd7bYJoSAES2nIX1DuW7pXJbcIbxETxczX\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.17.05.901412876\",null,null,null,[true,false],null,1],[\"4dd5ed4c-0ba6-4721-90f4-001138770bda\",[\"Kris McQ\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVctNZE5K4TkRlu57SMPbrORY9NI6_upCg46PDY32lIgNx6kEAj\"]]],1,null,\"I work out a map on my laptop because my phone won't let me edit it to the specific roads I want to take, and then my phone changes it anyway? Even if sent directly from the laptop? Also, even if I do set it how I want, sometimes the AI decides to change it while driving because it's \\\"faster and more efficient\\\" and it forces you to click to keep it how you want, but I can't exactly do that while flying down the highway. Like I didn't have my route set a specific way intentionally. Awful app.\",[1731689210,34000000],1644,[\"Google LLC\",\"That doesn't sound good, Kris. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: https://goo.gle/3vosTcH. Hope this helps.\",[1731693258,816000000]],null,[\"112962053705447738664\",\"Kris McQ\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVctNZE5K4TkRlu57SMPbrORY9NI6_upCg46PDY32lIgNx6kEAj\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.154.0104\",null,null,null,null,null,1],[\"da379234-c054-4688-9880-7c00374f5085\",[\"Nikola Stojanovic\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL_irsjMd2UaJuRNw13pNcnelv52XK1wIBtNAhsaRvFs615gQ\\u003dmo\"]]],2,null,\"I just got the new android update, and notification no longer shows total miles left, nor the time of an arrival, and it doesn't pop up when you're approaching a turn anymore! Please bring it back!! Edit: More than 2 months later, still no fix. I depended on this feature for almost a decade for my work. It impacted my work life a lot.\",[1751301539,130000000],1545,[\"Google LLC\",\"Hi Nikola, thank you for your suggestion. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1744664235,683000000]],null,[\"114723512165439872185\",\"Nikola Stojanovic\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL_irsjMd2UaJuRNw13pNcnelv52XK1wIBtNAhsaRvFs615gQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.26.04.774458481\",null,[[[\"vaf_phase1_in_app_rewards\",[1]],[\"vaf_points_of_interest\",[1]],[\"vaf_turn_by_turn_navigation\",[1]]]],null,[true,false],null,1],[\"eb84e0fe-3520-4344-9329-38672ee40854\",[\"Rachel Patrick\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV23e3Qa_4RWaN9_YfyFV0NlHrTE_GtAvIi0sK0BU-Tovg1LoDj\"]]],2,null,\"The app is unusable. No matter where I'm going it will take me the most backward, long way to get me there. Sometimes even the wrong way altogether. Even right here in town it's has 3 specific streets it dictates you to take no matter where you're going, which are nowhere Near where you're trying to get. There's no way to select a 'shortest' vs 'quickest' route. I've done everything I can. Turned off all the gas saving, toll settings, avoid highways, hob settings, cleared maps cache.\",[1762203943,100000000],2018,[\"Google LLC\",\"Hi Rachel, we would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of product experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1762216180,726000000]],null,[\"112582932550993368162\",\"Rachel Patrick\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV23e3Qa_4RWaN9_YfyFV0NlHrTE_GtAvIi0sK0BU-Tovg1LoDj\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.43.04.821534312\",null,[[[\"vaf_never_display_ease_of_use\",null,[2]]]],null,null,null,1],[\"59c1ade9-6cdb-4584-a3a9-a93250995a0c\",[\"Jenica Pitts\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXGPAWvFoC9xD438aAn3qthqS19aG-TQGKt8bJ0KmEqjIfJisjd\"]]],4,null,\"I use this all the time, and it works pretty well. occasionally it crashes my phone, but so do a lot of apps on my phone (it's old). My only complaint is that they removed the ability to have the Maps voice synced to your assistant voice. I personally use the Green voice, and when I went to navigate, I was greeted by the regular Google voice(which I don't like quite as much as Green). please bring back the ability to use the different voices for Maps, I don't like the regular English one\",[1750117847,563000000],2586,null,null,[\"118087977187191656102\",\"Jenica Pitts\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXGPAWvFoC9xD438aAn3qthqS19aG-TQGKt8bJ0KmEqjIfJisjd\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.24.01.768809388\",null,[[[\"vaf_apps_category_food_and_drink_v1\",[3]]]],null,null,null,1],[\"3e8d43fa-5d70-478d-a36a-c4e97532f29c\",[\"Millwood Naturals and Organics\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUw8IX33ESzL4U7FtbO-PHcNBk2SyBXc3TpIJgEu6dIGQq7OeVZ\"]]],1,null,\"Keep rerouting without notifications. I've had so much anxiety associated with this app that I've cried. Wasted so much gas going in circles, outdated routes, unpaved roads, long routes despite making preferences. Have to run three different apps just to make sure I'm not rerouted. Just use an Atlas. These apps are full of ads and won't allow usage of the Internet to drive as it consumes so much data. Not worth the headache\",[1734881208,90000000],618,null,null,[\"102502574718517594899\",\"Millwood Naturals and Organics\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUw8IX33ESzL4U7FtbO-PHcNBk2SyBXc3TpIJgEu6dIGQq7OeVZ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.49.06.703287473\",null,null,null,[true,false],null,1],[\"92227abd-bb85-4568-804f-1e44bf733e86\",[\"Jacqueline Jarrett\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVQPYojzpvH-RujCxCRILVb6exRX7NdSCp_kZF4RRv4zJphXLTG\"]]],2,null,\"I always use Maps and it usually works just fine, but with the new updates, it's removed my Spotify entirely and when I go to settings with the Night color scheme, the text is unreadable. When I roll back the updates, Spotify works like normal, but trying to get it to work with the jew version is impossible, despite following advice on how to fix it. Edited to add that now it won't switch back to the voice I use for my assistant, instead using the generic default voice.\",[1742059229,893000000],667,[\"Google LLC\",\"Hi Jacqueline. Let's try these steps: Settings \\u003e Navigation settings \\u003e Assistant default media provider \\u003e Select/Link Spotify music player. If that doesn't help, please create a post in our Google Maps forum so that our community of product experts can assist you goo.gle/3vosTcH. Hope this helps.\",[1742082706,572000000]],null,[\"110037317064494430594\",\"Jacqueline Jarrett\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVQPYojzpvH-RujCxCRILVb6exRX7NdSCp_kZF4RRv4zJphXLTG\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.10.04.732665141\",null,null,null,[true,false],null,1],[\"6310ee45-a746-43b1-a719-a473782b170b\",[\"William Neu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX8RRbzBoUA62Dzr7tSIxSioAr8NLDEG_diAvFVJcGDpWI6ulI\"]]],1,null,\"Honestly it feels like I'm fighting with phone anytime I try to use my phone while trying to find an address, whether it's typing in addresses only for it to suggest someplace 30-40 miles away when it's only a mile away. The suggested places are irritating because I'm looking for a specific business. Or you try to change the route and accidentally tap to close to a town name so it's gotta bring up info on that. Now the screen stays on and follows you after you've gotten to the place you were goi\",[1743946586,531000000],821,null,null,[\"103555249895500214178\",\"William Neu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX8RRbzBoUA62Dzr7tSIxSioAr8NLDEG_diAvFVJcGDpWI6ulI\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.13.06.739783266\",null,null,null,null,null,1],[\"fbb33332-a40b-4e87-aa63-ae3d6472ffa9\",[\"Milan Puscas\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLjwq5Gyyh8okR-HY-FvJmCSYp8jA9RorlcgYNvIDt8C_HoWA_t\\u003dmo\"]]],1,null,\"Sometimes the calibration is off and shows that I am going a completely different direction from the direction I am actually traveling. If I am in an unfamiliar area, it is extremely stressful having the map lag and not orient itself to reflect the path I am actually traveling. This doesn't happen all the time, but it is significant enough for me to consider using a different app that is more reliable.\",[1728398360,235000000],410,[\"Google LLC\",\"We understand your concern. This article has some great tips on getting the most out of your location on Maps: https://goo.gle/3Q2acbB. Hope this helps.\",[1728411479,197000000]],null,[\"102103845362968635772\",\"Milan Puscas\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLjwq5Gyyh8okR-HY-FvJmCSYp8jA9RorlcgYNvIDt8C_HoWA_t\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.148.0700.W\",null,null,null,[true,false],null,1],[\"f66b94d1-bee5-422d-b1f4-a8dbd995909f\",[\"Janette Stevens\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLXKEyEPYhMtMpGGHW-P_wxN4NS0Ni-TBaT0fmj6OYGswPXDg\\u003dmo\"]]],1,null,\"This app is not as good as it has been in the past. It will avoid a red light and take you down back roads where you have to cross a four lane road during rush hour to continue to your destination. The speed limit option is way off. Clarksville TN lowered some of the speed limits months ago, and google maps still hasn't been updated. Also, it will have you going thru a subdivision where the speed limit is definitely 30, and the app states 55! Sometimes, it takes you the most roundabout way.\",[1747742975,140000000],1712,[\"Google LLC\",\"We understand your concern, Janette. Thank you for your feedback. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1750414910,955000000]],null,[\"113460937198779718017\",\"Janette Stevens\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLXKEyEPYhMtMpGGHW-P_wxN4NS0Ni-TBaT0fmj6OYGswPXDg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.20.01.757436837\",null,null,null,null,null,1],[\"5a6edbd9-9ab5-45a5-8496-784df1de5124\",[\"Suzy Spurgeon\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLZSifIVS4YBnyMaOwRxFeB3fKkAdCnNAH8dnX4YknlWEhzSg\\u003dmo\"]]],1,null,\"It just keeps getting worse. The app keeps turning on my Do Not Disturb. Not bad when im driving but it dose it when I'm the passenger. Ugh! They need to fix what they broke during the last update. Maps not turning off, keyboard not being displayed, and several other issues. I'm not the only one. Several friends with different phones are experiencing the same issues. Never had these issues till the update they did around the end of June.\",[1737490141,407000000],1109,null,null,[\"114916202470486663729\",\"Suzy Spurgeon\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLZSifIVS4YBnyMaOwRxFeB3fKkAdCnNAH8dnX4YknlWEhzSg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.02.04.714794535\",null,null,null,[true,false],null,1],[\"6c66a8ea-c196-4569-93b8-6b8942e4655f\",[\"BabyGrandma\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVif0JHs8U01uctkGlAg3LH3FGnKLZOCBI_gSseS3XslfPTDaWk\"]]],1,null,\"It's worse than than useless. It literally changes direction in the middle of driving, tells me to take a right then changes to left. Can't figure out what way I'm driving and just goes all over the place. The orientation goes off and it's like trying to drive upside down and it's nothing to do with my phone. It stopped even giving me the recenter option and won't zoom in to the immediate area Im driving in. This is crazy DO BETTER. maps req for my job!!\",[1759451413,78000000],1160,[\"Google LLC\",\"That doesn't sound good. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1759479153,167000000]],null,[\"113031709412643948120\",\"BabyGrandma\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVif0JHs8U01uctkGlAg3LH3FGnKLZOCBI_gSseS3XslfPTDaWk\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.39.07.809715466\",null,[[[\"vaf_never_display_make_you_happy\",[2]],[\"vaf_never_display_negative_ads_impact\",[2]],[\"vaf_never_display_app_description\",[2]]]],null,null,null,1],[\"e5db3110-a1e7-4b1b-818c-5efc22762814\",[\"Georja Johnston\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJd8Wabn4SVnp5UebJ4RbqqI6GHUcP6RH4znOs3ecgxzpJavQ\\u003dmo\"]]],1,null,\"I've been having an awful time with this app lately! Tried updating, deleting and redownloading, powering my phone off and back on. It will work for a few minutes and then says \\\"searching for gps\\\" and times out on directions. Or shows me in a completely different area no where near my current location or destination. It doesn't matter where I'm at or where I'm trying to go, this happens every time I use the app now\",[1758045322,885000000],1366,[\"Google LLC\",\"That doesn't sound good, Georja. This article has some great tips on getting the most out of your location on Maps: https://goo.gle/3Q2acbB. Also, please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1758082811,884000000]],null,[\"106668054241923666966\",\"Georja Johnston\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJd8Wabn4SVnp5UebJ4RbqqI6GHUcP6RH4znOs3ecgxzpJavQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.37.00.805077116\",null,null,null,null,null,1],[\"925ca99e-986d-4d1a-9af9-68749626b739\",[\"Chris M\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVQJmrFKtIszTEBcburA23ccPvDGzeAMdK_21UIOldZt2BbcyJM\"]]],2,null,\"Very buggy lately, changes directions while driving. Just recently it'll tell me to take a right, then switch to a left when I get in the right lane at a stop light. it's re-routed a straight line 2 miles to going in a square to get to the same destination, only after being on the road. getting dangerous to use it, shouldn't change directions without confirming mid drive. pixel 8 pro\",[1754498078,304000000],1100,[\"Google LLC\",\"That doesn't sound good, Chris. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: https://goo.gle/3vosTcH. Hope this helps.\",[1754501140,957000000]],null,[\"106737729035725301803\",\"Chris M\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVQJmrFKtIszTEBcburA23ccPvDGzeAMdK_21UIOldZt2BbcyJM\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.30.03.785163646\",null,null,null,[true,false],null,1],[\"b4b359c0-2771-4ab1-b8bc-4c848d488010\",[\"Matt Hightower\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKiClU5i1jx7CkBQTfz00M8sA_aGHnnDoLodcKJmLrTx6ioiw\\u003dmo\"]]],1,null,\"August 2026 update removed popular times. The only way to see popular times for businesses is to uninstall the update, but if you do that, then it doesn't give accurate directions. You can't talk to someone who actually works for Google. I've sent feedback after every subsequent update that didn't fix my issue. I've posted about it on message boards. Still no popular times.\",[1787329116,786000000],1,null,null,[\"101376442768727192599\",\"Matt Hightower\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKiClU5i1jx7CkBQTfz00M8sA_aGHnnDoLodcKJmLrTx6ioiw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.34.02.965633971\",null,[[[\"vaf_app_quality_visual_appeal\",[2]],[\"vaf_app_quality_usability\",[2]],[\"vaf_app_quality_performance\",[2]]]],null,null,null,1],[\"39c0b186-e780-4e2a-89ee-826455b55a33\",[\"Alec Franklin\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ8B7V2uNV27oog1erITdcPAMDwOmM0SUUpE9uFshhr0-n7w7k\\u003dmo\"]]],2,null,\"was good for years, but recently, it's been incredibly stupid. routing me the most roundabout and complicated ways that add extra time to my drive. It also won't pick a consistent route, it's given me 3 different routes for the same destination, when there's one that I'll click and it'll actively fight me and try to switch to the \\\"best\\\" route that actively wastes my time and gas.\",[1786056629,235000000],6,[\"Google LLC\",\"That doesn't sound good, Alec. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1786098909,158000000]],null,[\"101432604924752951063\",\"Alec Franklin\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ8B7V2uNV27oog1erITdcPAMDwOmM0SUUpE9uFshhr0-n7w7k\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.31.02.954292984\",null,null,null,null,null,1],[\"520a1588-d3c2-4fac-ab03-c504cc87c903\",[\"Wes Slocum\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUqXDttYn0FxXrFryv_GR5J531Ct2jM0clGr4rwY0o6VBOO8sDt\"]]],1,null,\"The newest update has made it so the app is incredibly slow, and the addition of listening to music thru the app doesn't sync correctly. When connected via bluetooth, you've been able to listen and control music already for years now. Really sad that Google can't get it right hardly ever when \\\"updating\\\" things that have already previously existed for some time. I'll be using Waze from now on.\",[1786911115,901000000],37,null,null,[\"112349855403087027653\",\"Wes Slocum\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUqXDttYn0FxXrFryv_GR5J531Ct2jM0clGr4rwY0o6VBOO8sDt\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.32.07.958047303\",null,[[[\"vaf_real_time_traffic_data\",[2]],[\"vaf_booking_events\",[3]],[\"vaf_managing_itineraries\",[2]]]],null,null,null,1],[\"8891f75f-0d40-4b07-9268-be36b87fe78b\",[\"T\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKy5QQawn3B4ng6TYqQHMv8vNIQNokyzGdNyhotpBtrhAD_1uA\\u003dmo\"]]],1,null,\"Not keeping accurate information. it's not showing my review and photo views or reactions on my personal page. I can see reactions on them on the pages I've reviewed. it's keeping me from advancing my badges. I've did everything that maps help has suggested. Frustrating because I put a lot of time and effort into reviewing and taking pictures and videos of as many different places as I can.\",[1786466165,320000000],4,[\"Google LLC\",\"Hi there. The best place to get help with this is the Google Maps Help Community, just create a post there, and our experts will jump in to assist you: goo.gle/2ZrRUGt. Hope this helps.\",[1786470447,746000000]],null,[\"105399451777198653524\",\"T\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKy5QQawn3B4ng6TYqQHMv8vNIQNokyzGdNyhotpBtrhAD_1uA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.32.06.958047303\",null,[[[\"vaf_app_quality_ads_presence\",[2]]]],null,null,null,1],[\"681cb97c-e38e-4eb8-8e27-b72c715b4458\",[\"Perry Mason\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV1lIcBOQHasxG7GIoa985JCSAIHXMi5pzvH7psFQ8bNYaXDAI\"]]],3,null,\"Works most of the time quite well. One glaring issue for me is that when I search \\\"laundromat\\\" I get dry cleaners and carpet cleaners as results cluttering up the map. They are not remotely related to a laundromat. I search \\\"flex fuel near me\\\" and it pulls up every gas station regardless if they have the flex fuel or not. I'd try to edit this info in, but there doesn't seem to be a way besides putting it in a review and that's not fair to the gas station.\",[1786226777,479000000],5,null,null,[\"116241300267743266647\",\"Perry Mason\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV1lIcBOQHasxG7GIoa985JCSAIHXMi5pzvH7psFQ8bNYaXDAI\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.31.02.954292984\",null,null,null,[true,false],null,1],[\"1300f466-da01-4eb7-b754-07d6280acc9c\",[\"John Shell\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIoJ49sK-RzL9wPwfzkc7GBc5ao4JAGK0N6HCaZ47u9uHrsLA\\u003dmo\"]]],4,null,\"On a recent trip, it kept routing me on alternates of the main highway, when the main highway was not congested and way faster. Even though I kept telling it to go on the main route, it continued to tell me to take the next exit. Added an hour to my trip. Update!! I found out why my maps were acting so strange. Somehow a box was checked in settings that said avoid highways, and I know I never checked that box. ok now. I have no idea how that setting got changed.\",[1786112910,662000000],15,[\"Google LLC\",\"That's not the experience we want you to have, John. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1781831703,853000000]],null,[\"104506860481577599691\",\"John Shell\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIoJ49sK-RzL9wPwfzkc7GBc5ao4JAGK0N6HCaZ47u9uHrsLA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.31.02.954292984\",null,null,null,[true,false],null,1],[\"d7b9133c-453b-4102-a04c-4fc52bd44e51\",[\"kylie Flores\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKCruqI5aFuKrDWmKQ5GwLnKjaJGxEC1mDQiWV32w7gsvOj9w\\u003dmo\"]]],2,null,\"it no longer finds correct routes. I used it to go the same path to work daily, then after an update, it no longer can find the route, instead it tries to guide me through a giant mountain to \\\"save time\\\". it has put me in random neighborhoods trying to get to different stores. ive had to switch to waze instead and they havent been an issue with any of the stuff Google maps struggled with.\",[1787281828,517000000],1,[\"Google LLC\",\"Hi Kylie. Let's try clearing your cache and uninstalling updates using these steps : goo.gle/3rF6Ewz. If it keeps happening, please send feedback here: goo.gle/43OR0Ce. Hope this helps.\",[1787300949,650000000]],null,[\"114499983077043008301\",\"kylie Flores\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKCruqI5aFuKrDWmKQ5GwLnKjaJGxEC1mDQiWV32w7gsvOj9w\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.33.02.961351034\",null,null,null,null,null,1],[\"75b87e9c-f546-45c0-9306-772a42ed8ba0\",[\"Scott Jones\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU1OmzoJ9BRP-Yj78i-YH-XkY1uhB8UeNChuLxUIu0_tlsjAVJAiQ\"]]],2,null,\"Google can't even do their own software on their own phone correctly. Disappointing. 3D view on maps turns itself back on periodically, which wouldn't be a problem, but that makes my Pixel 10 Pro (Google's current flagship phone) very hot and laggy, even when doing no active tasks except Android Auto. Android Auto works well, except for when you're setting the destination from the phone itself, which is when Android Auto decides to keep giving you notifications as if you are in another app.\",[1786203329,229000000],7,null,null,[\"118018234736071765527\",\"Scott Jones\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU1OmzoJ9BRP-Yj78i-YH-XkY1uhB8UeNChuLxUIu0_tlsjAVJAiQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.32.06.958047303\",null,null,null,null,null,1],[\"c825bd70-9a14-4faf-ad4d-c7fbb815a932\",[\"Its Me\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLRCOMxRVIDcF1jiH7oX1ELpBoC_rrCr2Z0fH3o4Ir_0bL3-A\\u003dmo\"]]],2,null,\"IT IS WONDERFUL FOR BRAIN DEAD PERSONS... It no longer shows you all the streets so it can control the corporate narrative that pay them more. It no longer gives you other options like it use too sometimes up to 4 or 5 from the start. Even when you zoom in to try to see street names on your route. It wants you to take ONLY the route THEY WANT immediately takes away your option to use better routes.... USE WAZE IS BETTER NOW.\",[1787430718,415000000],1,null,null,[\"108917674163561122130\",\"Its Me\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLRCOMxRVIDcF1jiH7oX1ELpBoC_rrCr2Z0fH3o4Ir_0bL3-A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.33.02.961351034\",null,[[[\"vaf_app_quality_performance\",[2]],[\"vaf_app_quality_visual_appeal\",[3]],[\"vaf_app_quality_usability\",[2]]]],null,null,null,1],[\"5dae48ba-5ef3-452f-bd50-8baa7090ed0f\",[\"Joey Jones\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVl8GCsUk85sLsYA0r1nk11Q1N6UsFS7y5E5ezYRzILPhffviJN\"]]],2,null,\"Used to be great, now only okay. Kind of frustrating when taking a long trip and selecting no tolls to only be given toll routes there but somehow no toll back? Also when you start off and turn left out of driveway instead of right like it wants it routes you to the \\\"quickest\\\" route which again involves tolls when you clearly select avoid tolls. Lastly it doesn't know when places are being built and will take you to a restaurant that isnt even open yet. Just to disappoint you more. wayze better\",[1787443384,504000000],1,[\"Google LLC\",\"That's not the experience I want you to have, Joey. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1787445976,472000000]],null,[\"109771720054362686891\",\"Joey Jones\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVl8GCsUk85sLsYA0r1nk11Q1N6UsFS7y5E5ezYRzILPhffviJN\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.33.02.961351034\",null,null,null,null,null,1],[\"61ffe03f-477e-4ead-9675-7bcb152fb28f\",[\"Ben Foutz\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXcKRzFgj7T39lsYyXz43iKM2xRuUaA5oyFRnlsS9s9tZ82_UL4pQ\"]]],1,null,\"Used to be decent enough, now it is comically bad. It now tries to take you down roads that don't exist, roads that are closed, tells you to turn when you are AT the turn vs before it, will tell you \\\"your destination is on the left\\\" when you're in the middle lane of an interstate(??), or choose the worst route possible. Not sure what has happened over the last few months, but Google Maps is truly unreliable for getting you to your destination in the quickest or safest way possible.\",[1787269868,381000000],2,[\"Google LLC\",\"That's not the experience I want you to have, Ben. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Appreciate it.\",[1787270901,522000000]],null,[\"118185402976215059008\",\"Ben Foutz\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXcKRzFgj7T39lsYyXz43iKM2xRuUaA5oyFRnlsS9s9tZ82_UL4pQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.33.02.961351034\",null,[[[\"vaf_app_quality_stability\"],[\"vaf_app_quality_ads_frequency\"],[\"vaf_app_quality_battery_efficiency\"]]],null,[true,false],null,1],[\"d2095dc0-35d8-433e-9f2c-de95c0e227fb\",[\"Carl Masnec\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLtKmsPUxyJ6ifDgchd1BDHg2eYRWqM-WTY6mQbDTns1mVT3Q\\u003dmo\"]]],1,null,\"after the last update the map is so zoomed in I keep missing turns the only way to fix this is to manually zoom out the map each time which sometimes doesn't track and you also lose the speedometer. after performing the steps reccomended (cleared cache, Uninstaller, reinstalled) it did fix the problem. for 1 trip. then it went back to zoomed in. I dont need to see trees and houses while going 75 down the highway. I need to see the shape of the road over the next mile or two amd the speed.\",[1787074680,994000000],2,[\"Google LLC\",\"Hi Carl. Let's try clearing your cache and uninstalling updates using these steps : goo.gle/3rF6Ewz. If it keeps happening, please send feedback here: goo.gle/43OR0Ce. Thanks.\",[1786949355,114000000]],null,[\"116464124221875473823\",\"Carl Masnec\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLtKmsPUxyJ6ifDgchd1BDHg2eYRWqM-WTY6mQbDTns1mVT3Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.33.02.961351034\",null,[[[\"vaf_app_quality_visual_appeal\",[2]],[\"vaf_app_quality_ads_presence\",[2]],[\"vaf_app_quality_usability\",[2]]]],null,[true,false],null,1],[\"5f1b5d64-49e2-4ca5-a29c-d4aef7932c16\",[\"Jeff\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKwE_Pmmhf3tlQX0FxXOVwjUkyM3zhHIEpwK8nJqO1ngDqdyg\\u003dmo\"]]],1,null,\"Driving directions didn't quit and then got stuck on the screen and I couldn't stop it. Never mind the Gemini integration problems. On a Google Pixel phone, anything that pops up a \\\"Next\\\" button on the bottom (i.e. reporting a road closure) the \\\"Next\\\" button is UNDER the phone navigation buttons so it is almost impossible to hit \\\"Next.\\\" This has been a problem for at least a year. Unbelievable. For some reason it has mo\",[1787360195,84000000],38,[\"Google LLC\",\"Hi again, thanks for flagging this. We will pass this to the right team.\",[1648937939,994000000]],null,[\"101173459699922552591\",\"Jeff\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKwE_Pmmhf3tlQX0FxXOVwjUkyM3zhHIEpwK8nJqO1ngDqdyg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.32.06.958047303\",null,[[[\"vaf_estimating_arrival_time\",[3]],[\"vaf_phase1_calling_businesses\",[3]],[\"vaf_map_based_search\",[3]]]],null,null,null,1],[\"a4190c0b-4f87-471c-9fbb-1f045708c0c9\",[\"Samuel Fehling\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXr2umE1Mfq4nqV8fpbFar2MDnwsqKswRH9P7IrTcFI1JoAXsEfJQ\"]]],3,null,\"Significant regression in this last release, at least through Android Auto. Rendering artifacts are present at the top of the display when navigating and zoomed out, the navigation line changes from blue to gray randomly during the drive (and this is not easy to see), and my arrow keeps randomly changing from an arrow to a car figure (which I never set).\",[1786797390,233000000],2,null,null,[\"106836091491291158660\",\"Samuel Fehling\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXr2umE1Mfq4nqV8fpbFar2MDnwsqKswRH9P7IrTcFI1JoAXsEfJQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.32.06.958047303\",null,[[[\"vaf_sharing_arrival_time\",[3]],[\"vaf_map_based_search\",[1]],[\"vaf_points_of_interest\",[1]]]],null,null,null,1],[\"65e6989a-9b06-48f1-b825-81c060f12400\",[\"Lacey Thorner\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUF5hNzluvGxH2xUMnCQj3xTONWK3PXWRmh4-xKPWYBQZxHzynVMQ\"]]],1,null,\"Previously, maps would offer you an option of an alternate route when you approached the point to make a decision and act on it. On a cross country trip, it's constantly telling us there's a slower route available. First option was 2.5 hours down the road. next was another hour down the road. Just cleared that one and gor another \\\"8 minutes slower\\\" option--for the last 15 minutes of our trip. Alternate route options should not be crowding the map while I'm driving. Trash \\\"feature.\\\"\",[1785860541,762000000],5,null,null,[\"100994971469121948417\",\"Lacey Thorner\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUF5hNzluvGxH2xUMnCQj3xTONWK3PXWRmh4-xKPWYBQZxHzynVMQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.31.02.954292984\",null,null,null,null,null,1],[\"9baa0ccf-48a7-4232-bfa5-5d5798602f05\",[\"ATalkingBadger\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUXKyEc6-ngWd-DQS0FYLGuZuLa99qOEnwcDqSf_SThIOtWjwIa8Q\"]]],1,null,\"They messed this app up for no reason. I had my favorites list where it doesn't show on the map since that'd be too many things on my map, but now, when you add a place to favorites, it adds a mandatory checkmark icon that you can't get rid of, even with that list hidden from your map. What a stupid and unnecessary mess up on their end. Fix that BS if you want a higher rating.\",[1786940878,698000000],1,[\"Google LLC\",\"That doesn't sound good. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1786974874,112000000]],null,[\"108840663283653526638\",\"ATalkingBadger\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUXKyEc6-ngWd-DQS0FYLGuZuLa99qOEnwcDqSf_SThIOtWjwIa8Q\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.32.06.958047303\",null,null,null,null,null,1],[\"d7b6bbd2-54ef-47c6-9bf9-b8532f6dc8b8\",[\"Sparky\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLL11pZamAI3FsLMDQmHV3vvDPVnqUpEguUqetxcGbMrRj1Kw\\u003dmo\"]]],3,null,\"This app constantly updates, and finding places you have saved is not where it used to be. This is a major problem with this app as being out in the public, one depends on finding the correct location - especially if you have saved that location. Time waster: it's better to write down the location, then refer later, so you can get to where you are going faster, instead of spending time on a new learning-curve in Google Maps.\",[1786248820,419000000],2,[\"Google LLC\",\"That doesn’t sound good, Sparky. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1786266324,891000000]],null,[\"109521852627154168770\",\"Sparky\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLL11pZamAI3FsLMDQmHV3vvDPVnqUpEguUqetxcGbMrRj1Kw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.30.10.950492155\",null,null,null,[true,false],null,1],[\"8f9f19bb-9ca3-449f-ab97-86739249363b\",[\"Quas NaArt\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX9NfFdNHfEcCa9moZXGZ7hAp_iTsSTZ34Aj84IJ7NFcPc0vLFm\"]]],1,null,\"Does not navigate to indicated waypoint. It's there on the map, with the red pin where it's been for years. Now the directions and the final white dot lead to a location many miles away. USELESS. ed: This has supposedly been replied to, but the reply is not showing anywhere, nor even is this review. I've looked for it using strict filters and can't find it. Guess the 1-star will stay forever in the pile.\",[1786542210,456000000],3,[\"Google LLC\",\"That doesn't sound good. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Hope this helps.\",[1786470950,60000000]],null,[\"117378479119483871421\",\"Quas NaArt\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX9NfFdNHfEcCa9moZXGZ7hAp_iTsSTZ34Aj84IJ7NFcPc0vLFm\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.32.06.958047303\",null,[[[\"vaf_app_quality_stability\",[2]],[\"vaf_app_quality_performance\",[2]],[\"vaf_app_quality_ads_presence\",[1]]]],null,[true,false],null,1],[\"3bc1e488-6da2-4e15-9e6d-883585e41642\",[\"Amanda Bacallao\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXgz3W7w6W8Yb53-QjGKBor53hE7FBfsSIAFlalLztVQA3otNpI\"]]],1,null,\"The app has gone significantly worse in the past year. I have the avoid tolls setting on and it will still suggest a route with tolls over one without. The suggested routes are not the fastest options either. Can't convince me that it's \\\"fuel efficient\\\" route either. It's suggesting a route that takes me 3 hours out of the way into the tolls. If I add a midway point the suggested route will avoid tolls and doesn't take me on a 3 hour detour. Why should I have to add a stop to have the app work.\",[1787158713,6000000],2,[\"Google LLC\",\"That's not the experience I want you to have, Amanda. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1787181573,58000000]],null,[\"112944801559890762637\",\"Amanda Bacallao\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXgz3W7w6W8Yb53-QjGKBor53hE7FBfsSIAFlalLztVQA3otNpI\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.33.02.961351034\",null,null,null,null,null,1],[\"c2cf631e-9a48-4485-9065-a5075505745e\",[\"Sarah Kennedy\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKZoptD7tz79fEep3WKGu6xpI0u9vJr-Zgdd8K0cJy1f1AXeQ\\u003dmo\"]]],1,null,\"awful lately!!! I've always depended on my maps app and lived it as I travel a lot. but, for the past several weeks this app has been absolutely horrible!!! 2 of my trips that normally take 45 minutes has turned into 3½ hour drives and in all the wrong directions!!! I thought the update I did today would solve the massive glitching but it made no difference!!! PLEASE fix this asap, I use it quite frequently and can't depend on it now!!!\",[1787315441,92000000],2,[\"Google LLC\",\"That's not the experience I want you to have, Sarah. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Hope this helps.\",[1787316096,693000000]],null,[\"115827077038140754438\",\"Sarah Kennedy\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKZoptD7tz79fEep3WKGu6xpI0u9vJr-Zgdd8K0cJy1f1AXeQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.33.03.961351034\",null,null,null,null,null,1],[\"4393e5ac-608c-4835-8471-cd70d5cdcc5f\",[\"Dominik Richter\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXGM4GXrmKTx3t9qCT3Rlj8HLOhV3mI1x990oepn9ujWK7lAX6LJg\"]]],1,null,\"I use this app for driving (navigation) and for public transportation options from/to airports. It's good at walking navigation and decent on driving. However, it's bad at driving in places like Los Angeles and dangerous in countries like Japan, where it will lead you down horribly small streets you should never drive in. I'm writing this after it messed up the schedule for the airport shuttle again, this time in Osaka, Japan. The scheduled times do not exist.\",[1787179600,252000000],17,[\"Google LLC\",\"That doesn't sound good, Dominik. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you https://goo.gle/3vosTcH. Hope this helps.\",[1757930495,479000000]],null,[\"101750517485362910857\",\"Dominik Richter\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXGM4GXrmKTx3t9qCT3Rlj8HLOhV3mI1x990oepn9ujWK7lAX6LJg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.33.02.961351034\",null,null,null,[true,false],null,1],[\"6618360b-4c54-4b71-bc3e-cfeb01ee182c\",[\"Steve Levy\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUMdVAKnnCJowtejS0tJJNqsg-eTBX1yWsX14jKDwAaritM-xRm\"]]],1,null,\"No Longer Useful. I just did a long road trip and the amount of bad choices Maps made and tried to send me on was not acceptable. It detours you through residential neighborhoods to save 30 seconds. Keep me on the freeway, unless essential. It appears the AI used for Maps is as useless as Gemini Pro, consistent incorrect information from both.\",[1787427282,670000000],1,[\"Google LLC\",\"That's not the experience I want you to have, Steve. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1787437305,991000000]],null,[\"111490267702259953312\",\"Steve Levy\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUMdVAKnnCJowtejS0tJJNqsg-eTBX1yWsX14jKDwAaritM-xRm\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.33.02.961351034\",null,null,null,null,null,1],[\"c8c821d1-40f4-4063-b62e-26bb61c860c5\",[\"Lucy Howell\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLoHgP7MRF4DZtwyNAIkyftO0gk_jvCIow-8LZoroety_PbSw\\u003dmo\"]]],2,null,\"I don't need an alternate business or ads when I input a known address, you were able to navigate without difficulty the last 3+ years. Waze had zero issues with it. Unable to chose directions to a place, like the plan, add on a destination past that and get a whole new navigation path. I have to pull over at the 1st destination, clear it and then add the second one. There's no saving a often used route that makes sense. I do not need to interact with you while driving to stop route changes\",[1785262694,619000000],6,null,null,[\"101788032473917743011\",\"Lucy Howell\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLoHgP7MRF4DZtwyNAIkyftO0gk_jvCIow-8LZoroety_PbSw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.29.02.946673643\",null,[[[\"vaf_app_quality_usability\",[1]],[\"vaf_app_quality_visual_appeal\",[3]],[\"vaf_app_quality_battery_heat\",[3]]]],null,null,null,1],[\"3127da4c-1af7-4cbc-a330-c8ce72b8bd5d\",[\"Jessica “티타” Muñoz\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXiUp2TsH6m2lrDFsSKmV8tZWuhwizpUOUNokDR4zxqSBBvWAOr\"]]],2,null,\"After I select my route and begin my trip, the app automatically changes the route to a toll route without notice. I end up going in an unexpected direction when I planned stops for necessary breaks, which I then cannot take because there are no bathrooms on the PA turnpike until the final exit, and I don't feel comfortable pulling over to get out and stretch on the turnpike. The app also tracks me all the time even when I'm not driving. It asks me to rate places I didn't visit, but was near.\",[1785457002,874000000],6,[\"Google LLC\",\"That's not the experience I want you to have, Jessica. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1785494492,999000000]],null,[\"104659194431022014367\",\"Jessica “티타” Muñoz\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXiUp2TsH6m2lrDFsSKmV8tZWuhwizpUOUNokDR4zxqSBBvWAOr\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.29.00.947241282.W\",null,null,null,null,null,1],[\"80f2ea8b-23a3-4b45-830e-0bc3131550da\",[\"Dragonfly\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUfdPdLyC9RTZhYn5gH9Uak85VTkeijqo14q5xRKAP0LHNtTjNi\"]]],1,null,\"The app hasn't been working. It changes routes. In one particular drive, I had to do this 3x because it just changed the street I was driving on. A 45 minute drive turned into 1.5 hours. Also, Maps just shuts off as I'm driving! It doesn't appear that Google is fixing the problems. Perhaps you're running it with AI which makes too many mistakes. The Google Community hasn't helped. I went to that site, no assistance.\",[1784404981,89000000],17,[\"Google LLC\",\"Hi there. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Appreciate it.\",[1783819059,567000000]],null,[\"108860456694230237884\",\"Dragonfly\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUfdPdLyC9RTZhYn5gH9Uak85VTkeijqo14q5xRKAP0LHNtTjNi\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.28.04.942936911\",null,null,null,[true,false],null,1],[\"06ab6d8d-64dc-4f72-9c1a-3cb9e13fb206\",[\"Stephen Kleiss\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWCl_UbNJRWXqhVOlAn02HINiLS7BdoBtkC_WkrXx1cI9EcD5mEmg\"]]],1,null,\"Over the past few eeks I've been interviewing and commuting for several jobs that are about 45 minutes away from me, so naturally, having reliable navigation is important when going into unfamiliar territory. But the way things have been going here are... hardly functional. \\\"skip this light, then take a left at the next one.\\\" There was only one light. \\\"I've found a faster route for you!\\\" -through a construction zone that made my trip 20 minutes longer. I'm getting an alternative right now.\",[1782340600,181000000],18,null,null,[\"103745944209090359496\",\"Stephen Kleiss\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWCl_UbNJRWXqhVOlAn02HINiLS7BdoBtkC_WkrXx1cI9EcD5mEmg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.25.05.932239228\",null,[[[\"vaf_app_quality_performance\",[2]],[\"vaf_app_quality_stability\",[3]]]],null,null,null,1],[\"8913663b-e209-4f1f-842b-c5b33288d9ee\",[\"Joon Cho\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUheFaO7VdE0o_69YCBwVgCotsZ-cA-vP1pXhy5B_vyFxQujbBibw\"]]],1,null,\"This used to be my go-to navigation app, but not anymore. The AI/Gemini integration has made voice interactions slower and more frustrating. When I'm driving, I need quick, hands-free results. Before, I could simply say where I wanted to go and immediately get destination options to select from. Now it feels like the app wants to have a conversation instead of just navigating. If I say \\\"take me here\\\" or \\\"navigate there,\\\" it should do exactly that—not give me a lengthy explanation or unnecessary\",[1781709470,613000000],14,[\"Google LLC\",\"We understand your concern, Joon. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1781738680,460000000]],null,[\"103505559221969468327\",\"Joon Cho\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUheFaO7VdE0o_69YCBwVgCotsZ-cA-vP1pXhy5B_vyFxQujbBibw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.24.07.928892089\",null,null,null,null,null,1],[\"d7c9b966-c888-4482-95cf-a6df8d1b047d\",[\"Taneshia Brown\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVsclLAHcJHsOr4Na85Sb8q_lQuC09eg8otnT_HHjUPVFX71dpq\"]]],1,null,\"Since the most recent download, I've been experiencing issues with the app. When getting directions to places, it has messages (could not calculate directions, unable to find a route/ no route found, or can't seem to find a way there). I followed the instructions to fix the issue multiple times and those instructions did not work (cleared cache, uninstalled the most recent update, restart the device, etc.). It was my go to map at one time, but not anymore. Oh, and I can not delete the app!!\",[1784924432,642000000],10,[\"Google LLC\",\"That's not the experience I want you to have, Taneshia. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1784927073,325000000]],null,[\"103345332669405771041\",\"Taneshia Brown\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVsclLAHcJHsOr4Na85Sb8q_lQuC09eg8otnT_HHjUPVFX71dpq\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.29.00.947241282.W\",null,null,null,null,null,1],[\"a7434c07-a433-4e8b-bebc-71acd569eea1\",[\"A B\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI5HUbSy6CUeOarymCgZsZIDcR9wBrslAnmjumK6ojIKqCW2A\\u003dmo\"]]],1,null,\"It's becoming useless. This has been our go-to mapping service for years. It's become almost useless. It misses street numbers frequently, takes very weird long routes, takes you 1/2 mile past places. And parking lots? it has zero idea how to navigate them now - but it used to. How can you make something that was great this terrible and not know?\",[1783383606,469000000],14,[\"Google LLC\",\"That's not the experience I want you to have. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Hope this helps.\",[1783431282,478000000]],null,[\"113259720551218521555\",\"A B\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI5HUbSy6CUeOarymCgZsZIDcR9wBrslAnmjumK6ojIKqCW2A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.26.03.935742811\",null,null,null,null,null,1],[\"07f3785f-71a4-47d6-b301-e36a93506249\",[\"Rdx 1998\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXFw-__27Wr0dFndbk_Z3OLyBw9CFyXSjZy-jHjCjiufkqcVezX\"]]],1,null,\"How is this app so horribly incompetent at performing what is literally its only task? When I open the app, it starts off by telling me I'm in a completely different location than where I actually am. It then can't correctly direct me to where I need to go. It is unable to find alternate routes when it has taken me on those routes SEVERAL times in the past to avoid traffic. Today, it turned a 35 minute drive into an hour and a half because it failed to identify an alternate route. INCOMPETENT!!!\",[1783740219,581000000],10,[\"Google LLC\",\"Hi there. That doesn't sound good. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1783767015,124000000]],null,[\"107784480345562705975\",\"Rdx 1998\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXFw-__27Wr0dFndbk_Z3OLyBw9CFyXSjZy-jHjCjiufkqcVezX\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.22.04.920688788\",null,[[[\"vaf_app_quality_performance\",[2]]]],null,[true,false],null,1],[\"5dcb6be5-b8df-4cce-b249-17c972a5b701\",[\"Kathy Gullicks\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIqXqkXvH2KMGgXoPAUm4354lqYqgdQwFMAeqYj0ol3luxjkA\\u003dmo\"]]],5,null,\"This app has helped me to navigate around accidents, construction, road conditions , even weather , fog,flooded lanes,and ice. I check before I venture out. I'm not a fan of highways, I like the choice of using alternate routes. The audio voice is a major plus I do not have to look at my phone to check the route. Should the need arise I need to look at route,yes I pull over . Do not look down at the phone, a seconds glance could just end a life.\",[1781186491,558000000],22,null,null,[\"107965750283397474922\",\"Kathy Gullicks\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIqXqkXvH2KMGgXoPAUm4354lqYqgdQwFMAeqYj0ol3luxjkA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.23.01.924285238\",null,null,null,null,null,1],[\"35b80434-0d4f-4f64-a517-7f43ea59ffde\",[\"Will Iregretthis\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLqB_UocmP8ZWvzsIx1Xyqo-OC_Eqg0jgcXx_faKu6E_qnUGQ\\u003dmo\"]]],2,null,\"Trying to find the nearest Starbucks and it can't even do that. It literally doesn't sort the options by closest to farthest and it also doesn't even show the distance on l search results! Click on filter options and it's not even an option to sort by distance. I knew it wasn't very intuitive in general but this is just too much. The best thing about it is that it's free. That's it. I'm looking to replace it immediately because of such a simple thing being overlooked intentionally.\",[1782854283,765000000],14,[\"Google LLC\",\"Hi Will. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1782856639,243000000]],null,[\"102724785742009705947\",\"Will Iregretthis\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLqB_UocmP8ZWvzsIx1Xyqo-OC_Eqg0jgcXx_faKu6E_qnUGQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.25.05.932239228\",null,null,null,null,null,1],[\"4e6049cd-5049-4f99-8f14-4c09c1d575ab\",[\"Lindsay McCormick\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV0ALLXfio_YU5jvkOrdSAn7LfTSyqCDr9nVr4Ir5JQNvfKW1sUng\"]]],3,null,\"This app truly does get a little bit worse with each update. Firections get worse, more ads, routed by more places paying for you to go by or paying for you not to go by, features disappearing, things glitching. Currently, it has me parked in the middle of an intersection. Every time I go to click the icon to get rid of it, it takes me to an address immediately after pulling up the parking and I can't get rid of the park spot that I didn't mean in the first place. Impressive Google.\",[1784163032,909000000],9,[\"Google LLC\",\"That doesn't sound good, Lindsay. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Thanks.\",[1784180280,413000000]],null,[\"115004249729357047847\",\"Lindsay McCormick\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV0ALLXfio_YU5jvkOrdSAn7LfTSyqCDr9nVr4Ir5JQNvfKW1sUng\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.28.03.942936911\",null,[[[\"vaf_app_quality_ads_presence\",[1]],[\"vaf_app_quality_battery_heat\",[1]]]],null,[true,false],null,1],[\"42a8e366-97e1-467b-955a-3d32e4665ce7\",[\"Matthew Haskins\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXyvg1wlaXsc_QwGdb3lIbKTopiCbpk_rrLheUbAStR-Zk34yEBBA\"]]],1,null,\"I keep having to uninstall and reinstall the app as it won't display anything other than the map itself. No street names. No businesses. Nothing. Search won't work, and it just forever tries to load or says no results for something generic like \\\"gas station\\\" or \\\"coffee.\\\" Force stopping and clearing the cache does nothing. It becomes worthless as a maps app. This has been going on for months and I don't understand how it's still not fixed.\",[1783910671,280000000],10,null,null,[\"111322473132029359236\",\"Matthew Haskins\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXyvg1wlaXsc_QwGdb3lIbKTopiCbpk_rrLheUbAStR-Zk34yEBBA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.27.05.941319029\",null,null,null,null,null,1],[\"6baa8956-a91b-48f5-be26-f8b7e41c8c03\",[\"alek dewall\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ_fXvQ6wx_7gQxz0004QCfQRq1EZHXsVQVJKAo6hr7MeYjMA\\u003dmo\"]]],1,null,\"I dont need a weather warning every single time I search for an address across town. I use this app for work, and can put in about 20 addresses in an hour. I can see the sky. I saw the weather warning the first time. there doesnt seem to be a way to turn off the notification, and it pops up every time I put in a different address. Not to mention all the stupid routes it tries to send me when there's a perfectly good road that, according to Google maps, doesn't exist.\",[1783404210,278000000],13,[\"Google LLC\",\"That's not the experience I want you to have, Alek. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1783431897,546000000]],null,[\"102342266257166810594\",\"alek dewall\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ_fXvQ6wx_7gQxz0004QCfQRq1EZHXsVQVJKAo6hr7MeYjMA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.26.03.935742811\",null,null,null,null,null,1],[\"a5cfead6-94c6-46b4-9275-55340e953539\",[\"Kelly Curtin, Soprano\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW9thoBByiobcrTvfkqew8IyI3AnxJeIhIdPGZ3DjoD-wKt0-DC\"]]],4,null,\"Maps has improved so much over the years. I use it all the time. Still hoping for an option to avoid express lane tolls, while keeping the more necessary bridge or tunnel tolls. I never want to take paid express lanes and it would be nice to be able to see how long the trip will take without having to avoid Tolls entirely, because that's not a real representation of the time it will take either.\",[1784890972,416000000],17,null,null,[\"101129148748967043413\",\"Kelly Curtin, Soprano\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW9thoBByiobcrTvfkqew8IyI3AnxJeIhIdPGZ3DjoD-wKt0-DC\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.29.02.946673643\",null,null,null,null,null,1],[\"e3cbd413-86f3-4178-ae93-dc45ecb47a74\",[\"Eric Pressman\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJuDJaPGzGX1dWHzGxqPv-rD0DPdTOrVgDox8OcSK6aoimmjg\\u003dmo\"]]],3,null,\"I rely on it more often than not because it's a good app, but recently it's been doing some infuriating stuff. It'll show me one route that I want like over the cheapest toll (queensboro) and then it'll take me to the most expensive (QMT) and leave me cursing out Google while I manually reroute myself. Other times it'll put my location where I'm not at (like the other side of the block or under and overpass) and reroute me right as I need to make a turn or something. I want the route locked in\",[1785721655,124000000],6,[\"Google LLC\",\"That doesn't sound good, Eric. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Appreciate it.\",[1785767658,779000000]],null,[\"111930768208645886667\",\"Eric Pressman\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJuDJaPGzGX1dWHzGxqPv-rD0DPdTOrVgDox8OcSK6aoimmjg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.30.10.950492155\",null,[[[\"vaf_app_quality_battery_heat\",[1]]]],null,null,null,1],[\"611c895a-ebb7-48f3-b6a1-073f72812916\",[\"Beau Hampton\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUEpunhA3JQWoBuZqoREqIcuNXHUMRaqU2spYVZcnig-1_JhgMv\"]]],1,null,\"Quite possibly the worst maps app available. It is somehow worse than apple maps. When acquiring your location the app almost never finds you accurately, and this is after \\\"calibrating\\\" it to provide more accuracy. The \\\"shortcuts\\\" that it provides will try to take you through gated communities which usually have gate codes, but the bigger issue is having to find a way around without the gps. Re-routing will try to take you on the same path so it's useless. Ads are everywhere. Use organicmaps.\",[1785791716,60000000],4,[\"Google LLC\",\"That doesn’t sound good, Beau. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Appreciate it.\",[1785798736,32000000]],null,[\"101688059969888913994\",\"Beau Hampton\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUEpunhA3JQWoBuZqoREqIcuNXHUMRaqU2spYVZcnig-1_JhgMv\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.30.09.950492155\",null,[[[\"vaf_app_quality_stability\",[2]],[\"vaf_app_quality_visual_appeal\",[2]],[\"vaf_app_quality_ads_presence\",[1]]]],null,null,null,1],[\"051561a0-da19-4612-ae23-b658c2658e6a\",[\"Charles Knapp\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXOFYCX8hk_2uNTWrP3YEyLs0iTIWQQnFxX98q98bIdDTJiEq9yog\"]]],3,null,\"Been using the app daily as a truck driver for years. Would be nice if you would make a more truck friendly version. Also, the latest update caused the app to be unable to find ANYTHING while searching along route. This is incredibly bothersome. Seems to be getting worse instead of better. Here we are 5 years after your reply. Where is the truck friendly version!?\",[1787191585,628000000],4,[\"Google LLC\",\"Hi Charles. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1787218938,625000000]],null,[\"105953181215276762702\",\"Charles Knapp\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXOFYCX8hk_2uNTWrP3YEyLs0iTIWQQnFxX98q98bIdDTJiEq9yog\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.33.02.961351034\",null,null,null,[true,false],null,1],[\"0c617ffa-59a7-4b67-a638-5ebf366d4561\",[\"christian lund\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXGCRAVCfGBvcUdFgfjWtnGL_eaHG6Bb0t-zIOYVjo0HZQTbhY\"]]],1,null,\"this app has become garbage. if I didn't have to rely on it so much for my job I wouldn't use it at all. like for example I tried entering the address of a hospital to visit someone, and the app decided I wanted to go to a closer hospital instead. Google maps does this all the time. not only that the app is so much buggier than it was years ago, and it'll always show you sponsored results over the places you actually search for. I wish there was a good alternative for me to use as an Androiduser\",[1787418083,522000000],2,[\"Google LLC\",\"That doesn’t sound good, Christian. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Hope this helps.\",[1787437225,457000000]],null,[\"114458828229050924279\",\"christian lund\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXGCRAVCfGBvcUdFgfjWtnGL_eaHG6Bb0t-zIOYVjo0HZQTbhY\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.33.02.961351034\",null,[[[\"vaf_app_quality_battery_heat\",[1]],[\"vaf_app_quality_battery_efficiency\",[1]],[\"vaf_app_quality_ads_intrusiveness\",[1]]]],null,null,null,1],[\"45c85350-f55d-4cc2-8643-9fcf29d2170b\",[\"u12bdragon\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVtbXaZQQr3ahFqwdzyL_3-wO8e5e8r6kl_PZiehtooUmFpnqY\"]]],2,null,\"PLEASE fix the bug where when you click the compass, it doesn't re-orient the screen northward, instead it just moves you a half mile over on the map for some reason. EDIT: no, Google, an article about \\\"tips on getting the most out of your location on maps\\\" is not helpful in this situation. What does that even mean? This has nothing to do with location. It has to do with the issue of the map panning instead of rotating when you click the button that should orient the map northward.\",[1787001487,101000000],3,[\"Google LLC\",\"That doesn’t sound good. Here are a few tips on getting the most out of your location on Maps, goo.gle/3Q2acbB. Hope this helps.\",[1786987279,659000000]],null,[\"110550563106892794186\",\"u12bdragon\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVtbXaZQQr3ahFqwdzyL_3-wO8e5e8r6kl_PZiehtooUmFpnqY\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.33.02.961351034\",null,null,null,[true,false],null,1],[\"bc08413b-9f0d-4ae0-bcaa-66c72323ff53\",[\"The President\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ5qf1mIfRFujB26m5yru7Qvzuf_KCVphBDIV7dIIDpHibuikQ\\u003dmo\"]]],1,null,\"I stopped using the app and changed over to waze. the geniuses at google though it was a good idea to cover all the street names for the route your taking making it so you cant glance to see what the streets are that you need to take. or if you want to see the next street so you dont literally need to watch the phone the whole time while your driving you have to take your hands off the wheel and two thumb zoom in so much you could see a bug on the road If you simply want to check the next road.\",[1787101899,103000000],2,[\"Google LLC\",\"Hi there. Thanks for the feedback! You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1787135062,181000000]],null,[\"101456748712253306906\",\"The President\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ5qf1mIfRFujB26m5yru7Qvzuf_KCVphBDIV7dIIDpHibuikQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.33.02.961351034\",null,[[[\"vaf_app_quality_battery_efficiency\",[3]],[\"vaf_app_quality_ads_intrusiveness\",[3]],[\"vaf_app_quality_ads_frequency\",[3]]]],null,null,null,1],[\"d25ba8f1-85b6-42de-ab61-528a0d8bc4c2\",[\"j\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV4xQdBoQkm3Uq3QCret-_GWXwsIbdC11y-Gvfc_5r33qIo7PwW\"]]],1,null,\"I hate your apps so much. I search nearest \\\"pet supermarket,\\\" you say dial now. so I call them, turns out you gave me a Petco. fine they have what I need. so I spend $2.53 in tolls to get there. turns out the phone number you gave me isn't the same as the directions that you gave me. so now I have to spend $2.53 to go back to the other place. Please stop wasting my money on places that I didn't ask for.\",[1787497004,599000000],1,null,null,[\"102703559004203681454\",\"j\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV4xQdBoQkm3Uq3QCret-_GWXwsIbdC11y-Gvfc_5r33qIo7PwW\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.33.02.961351034\",null,[[[\"vaf_app_quality_ads_presence\",[1]],[\"vaf_app_quality_ads_frequency\",[1]],[\"vaf_app_quality_usability\",[2]]]],null,[true,false],null,1],[\"56317a15-3499-4cd9-af7e-07a112545c2b\",[\"Mike Tweedy\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXm9Kr9mY-uZENxo4_oYgbu7gQITAzt4JeLPzEE49kyzpoMMNfGpQ\"]]],1,null,\"Can't use the app while navigating. No reason it should not have full functionality even when navigating or connected to a vehicle. Do they not understand that passengers often navigate? Right now you have to shut off navigation for the driver to check for any other stops you might want. It's dangerous and needs to be fixed.\",[1787243514,535000000],1,[\"Google LLC\",\"That's not the experience I want you to have, Mike. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Appreciate it.\",[1787264523,703000000]],null,[\"108349787089039819566\",\"Mike Tweedy\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXm9Kr9mY-uZENxo4_oYgbu7gQITAzt4JeLPzEE49kyzpoMMNfGpQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.32.06.958047303\",null,null,null,null,null,1],[\"83b8717e-02db-4930-9e1b-9450e646775c\",[\"john jurgensen\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJtBfdZ178alrs6IexMRpPK5pKlCnTXOSt04eALUyjSfXnqBA\\u003dmo\"]]],3,null,\"Navigates well, but needs further development to be able to save specific routings between desktop and phone. I rerouted a trip to avoid a construction area, sent it to my phone, and it gave me the original route instead of the one I rerouted. Ended up looking at the directions I had printed out. Very frustrating. One reason I preferred my old Garmin system.\",[1781087043,518000000],15,[\"Google LLC\",\"Hi John. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1781088625,224000000]],null,[\"117519273288445381809\",\"john jurgensen\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJtBfdZ178alrs6IexMRpPK5pKlCnTXOSt04eALUyjSfXnqBA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.23.01.924285238\",null,null,null,null,null,1],[\"e6effe05-72e2-4cc9-8da9-f4a83c349687\",[\"Alaina Love\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJmAc2NW9PyU3Awa1u5TKYDmCbi53wIxkXOlRtma7ZHikU36g\\u003dmo\"]]],5,null,\"I am a daily user of Google Maps, most days multiple times. it not only allows me to search/preview destinations and routes it allows me to see the route by bus, by car, by bike or foot. the maps has many different interfaces allowing you to see everything by satellite as well as showing traffic or street view if you are wanting to see a more detailed view of a destination or place! I love it.\",[1785629666,549000000],10,null,null,[\"103764192843542384915\",\"Alaina Love\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJmAc2NW9PyU3Awa1u5TKYDmCbi53wIxkXOlRtma7ZHikU36g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.29.02.946673643\",null,null,null,null,null,1],[\"3ca8353c-c59d-43b3-81cb-856cc5d32506\",[\"Yili Alexis Ou\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXR4PvPGFOM68stVlWLLpVGz_R1AIHVKesQtwwQ3B0Vj7QMrnGo1Q\"]]],1,null,\"It's been months of constantly rerouting my directions back and forth while driving, changing orientation of car direction even while I'm driving straight for miles. It takes me to turn at always the worst intersections with no traffic lights and busy streets when even a block away would be more efficient. It also randomly freezes and never centers my car (map showing upside down). This app is completely unusable, not only does it not give me accurate directions but it will also get me lost.\",[1786048914,369000000],6,[\"Google LLC\",\"Hi Yili. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Hope this helps.\",[1786088343,714000000]],null,[\"115655440434039337027\",\"Yili Alexis Ou\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXR4PvPGFOM68stVlWLLpVGz_R1AIHVKesQtwwQ3B0Vj7QMrnGo1Q\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.31.02.954292984\",null,[[[\"vaf_app_quality_usability\",[2]],[\"vaf_app_quality_stability\",[2]],[\"vaf_app_quality_performance\",[2]]]],null,null,null,1],[\"0319b0b1-029e-4784-aedc-57856b89f177\",[\"Michael Delcambre\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocINVSl3EmSN6g2SciEfG9Qgif7y7cglSZdYv37kYcCCLlP1-w\\u003dmo\"]]],1,null,\"The map orientation has started to tilt left/right in anticipation of the upcoming turn. This is a totally braindead decision, when I'm looking at the map to confirm the upcoming turn, the map now no longer is oriented exactly how the road is oriented, instead it's now \\\"tilted\\\" to the upcoming turn, as though that would help me determine where I'm turning. Google. please nix this!! It's so stupid. I want the map orientation to mirror the road. this tilting behavior is unsafe.\",[1783944093,282000000],9,[\"Google LLC\",\"That's not the experience I want you to have, Michael. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1783970473,924000000]],null,[\"114743614971268995914\",\"Michael Delcambre\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocINVSl3EmSN6g2SciEfG9Qgif7y7cglSZdYv37kYcCCLlP1-w\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.27.06.941319029\",null,[[[\"vaf_app_quality_ads_frequency\",[3]],[\"vaf_app_quality_ads_intrusiveness\",[3]],[\"vaf_app_quality_battery_heat\",[3]]]],null,null,null,1],[\"f61ebda7-4713-4611-a8e0-2444bbfd01be\",[\"James B\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI7JXrS1GlW-v2ZLqs03UMHt_55zsvgH3IhB7Y_4RsRhgwhUQ\\u003dmo\"]]],1,null,\"Google maps is going to CAUSE accidents!!!!! I told the dumb app where I wanted to go, sitting there parked. Then selected the route I wanted to take. Keep in mind I'm in an unfamiliar place with a loaded equipment trailer, in busy traffic. The damn app tried to put me on the interstate twice while driving, completely blocking my route view in extremely busy areas. Hand's on my phone to deselect it's best route. Absolutely the worst, especially when I already selected the route. Zero stars!!\",[1785287189,966000000],7,[\"Google LLC\",\"That's not the experience I want you to have, James. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Hope this helps.\",[1785321512,653000000]],null,[\"112607486852807325754\",\"James B\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI7JXrS1GlW-v2ZLqs03UMHt_55zsvgH3IhB7Y_4RsRhgwhUQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.30.09.950492155\",null,[[[\"vaf_app_quality_ads_intrusiveness\",[2]],[\"vaf_app_quality_battery_heat\",[3]],[\"vaf_app_quality_usability\",[2]]]],null,null,null,1],[\"fcc863ad-cf2c-41ea-9812-c04892ab4457\",[\"Sulman Khan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLhrMQAja944HvLUJmHad1YJJXNVLtMjN7BEZ_grnCnfrpbJw\\u003dmo\"]]],1,null,\"When I first started using this app it was amazing, knew all the routes properly, entrances to plazas, detours, everything. Now this is the worst navigation app, it makes you take weird routes to enter a plaza, takes you to an alley of the destination you put in, doesn't know of any construction happening which it use to or gives option for a detours, you cant even report a road closed up ahead. This is the only app I can't think of that actually got worse year over year\",[1782924097,480000000],17,[\"Google LLC\",\"That doesn't sound good, Sulman. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Appreciate it.\",[1782927664,501000000]],null,[\"109667742980246716301\",\"Sulman Khan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLhrMQAja944HvLUJmHad1YJJXNVLtMjN7BEZ_grnCnfrpbJw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.26.03.935742811\",null,[[[\"vaf_app_quality_visual_appeal\",[2]],[\"vaf_app_quality_performance\",[2]],[\"vaf_app_quality_ads_intrusiveness\",[2]]]],null,null,null,1],[\"0b440ecf-5e1f-457d-81b3-8ee27d0d8ada\",[\"J Perreault\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIrzlHrmOqgp-7-F6vj30gIDkoBOUQS_hQQmdpK5pKvk_W_Rg\\u003dmo\"]]],1,null,\"What made you believe removing traffic data was an improvement? Yes, I see it is still (poorly) visible on your navigated route. But I don't use navigation for driving to the grocery store. So now I no longer have visibility to traffic during normal daily routines nor do I see adjacent traffic even when I am navigating. Do your Product Managers even use your own product????\",[1785505561,190000000],6,null,null,[\"110014251064193734646\",\"J Perreault\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIrzlHrmOqgp-7-F6vj30gIDkoBOUQS_hQQmdpK5pKvk_W_Rg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.30.09.950492155\",null,null,null,null,null,1],[\"bae53332-355e-4169-92c7-ec1aee949247\",[\"Stephanie Anderson\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX4koqlLEy56-kHwGGXiW568eWa4YIKHE3gz9LmmbgNkRJA6WUK\"]]],2,null,\"This app used to be useful. I chose it over waze for my drives because it let me choose my route. Now, it automatically keeps changing it around on me and I can't fix it as I'm driving. Suddenly, my route is taking me ways I don't want to go. And, yes, that includes when I have preferences on and it ignores the preferences. It gets 2 stars because it also offers other information I use when it's not just routing.\",[1783032114,447000000],11,[\"Google LLC\",\"Hi Stephanie. Thanks for the feedback! You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1783067372,967000000]],null,[\"111187700359096760492\",\"Stephanie Anderson\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX4koqlLEy56-kHwGGXiW568eWa4YIKHE3gz9LmmbgNkRJA6WUK\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.26.03.935742811\",null,null,null,null,null,1],[\"34890ef5-ceac-4539-bd8e-5c72439a3815\",[\"Hammad Shahid\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUQ1RtjLGXNux2CTYy2yYefM7VHa5_gaGIxJjRfmVyBXh6Be99V\"]]],1,null,\"Has become almost unusable. The GPS coordination goes wild in the middle of driving, and it keeps rotating the my direction back and forth crazily. The recent update has basically killed it for me. For some reason, when I connect to Android Auto, my map is so zoomed out and there is no way for me to zoom it back in like it was. Plus, I get the message, \\\"Something went wrong,\\\" when starting Google maps on Android Auto. Horrible! Just revert it back to how it was in 2023 and I'm good.\",[1781070513,965000000],14,null,null,[\"116788881021541112661\",\"Hammad Shahid\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUQ1RtjLGXNux2CTYy2yYefM7VHa5_gaGIxJjRfmVyBXh6Be99V\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.22.04.920688788\",null,null,null,null,null,1],[\"6a261047-9890-4cfe-a8c2-8d2e6941cbe3\",[\"Angi Blue\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIW_7IEDbH9IcExHgCRqeLxEVVhVqLcRdcQHcwYDi4b2nThPQ\\u003dmo\"]]],1,null,\"New update for safety isn't safer. The new ultra zoomed in version won't show me the upcoming traffic, which is why I use it when commuting. I've tried changing settings, but the only way is to zoom out while driving, which is taking my eye off the road longer. Bring it back or at least offer it as a settings option. oh \\u0026 drop the AI.\",[1785135720,211000000],3,null,null,[\"107638892704221316520\",\"Angi Blue\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIW_7IEDbH9IcExHgCRqeLxEVVhVqLcRdcQHcwYDi4b2nThPQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.29.02.946673643\",null,null,null,null,null,1],[\"f4d6e46a-289c-4835-9afb-47eff073218f\",[\"Martin Grady\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVWNGeBiSTswB0t5B45tkRKL7G821EpD3R5O5btUtWQM453PNQ\"]]],1,null,\"I used to love this app as it was my main source of navigation. It worked well and i love the updates. HOWEVER, recently I was input an address and hit search, drive to that location and it ended up being the wrong address as the app somehow changed the location to a totally different place on the opposite side of town. this is frustrating because it makes me late to my deliveries and messes up my source of income. App would also freeze mid drive making me miss streets. VERY DISSAPPOINTED.\",[1785596843,310000000],6,[\"Google LLC\",\"That's not the experience I want you to have, Martin. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Hope this helps.\",[1785609916,992000000]],null,[\"106960891353683401597\",\"Martin Grady\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVWNGeBiSTswB0t5B45tkRKL7G821EpD3R5O5btUtWQM453PNQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.30.09.950492155\",null,[[[\"vaf_app_quality_ads_presence\",[2]],[\"vaf_app_quality_ads_frequency\",[2]],[\"vaf_app_quality_performance\",[2]]]],null,null,null,1],[\"6c5bb03c-8654-4c74-ba06-a8eb5e457f9c\",[\"Lauren Watkins\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWYm8twC8AEBoDBvIx5lw28F2BGhH-ymU4o3iN8U_5hxDkUNyA\"]]],2,null,\"I don't understand how the navigation is getting worse, but it is. Instead of choosing the truly best route, it takes weird side roads and crazy routes. I have even noticed it will route me down roads I've taken when I've done wrong turns.. like it's an AI \\\"learning\\\" where to go from where I've gone before. Wastes time and gas!\",[1785769512,865000000],6,[\"Google LLC\",\"That doesn’t sound good, Lauren. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Hope this helps.\",[1785779243,467000000]],null,[\"105457047926778459087\",\"Lauren Watkins\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWYm8twC8AEBoDBvIx5lw28F2BGhH-ymU4o3iN8U_5hxDkUNyA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.30.09.950492155\",null,null,null,null,null,1],[\"43a4bc86-31d5-4f65-95b4-48a3a8b02aa3\",[\"J. S. (darkocean)\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVy3mWlNqJI1un_6VJizCjJeRaLbFIil5RLCj3-WdM4f27yGPVy\"]]],5,null,\"Works great, I like to walk to places in town so appreciate the \\\"500 feet turn left at...\\\" is very helpful, as is the automatic updating route when I go a different way than the maps wants me to go. This is helping me to memorize how to travel to the areas I visit. :) Why is the stars so low? 😲 This works 10 x better than it did 8 years ago.\",[1785695828,617000000],7,null,null,[\"107784513031528205506\",\"J. S. (darkocean)\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVy3mWlNqJI1un_6VJizCjJeRaLbFIil5RLCj3-WdM4f27yGPVy\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.30.09.950492155\",null,[[[\"vaf_app_quality_battery_efficiency\",[2]],[\"vaf_app_quality_stability\",[1]],[\"vaf_app_quality_ads_intrusiveness\",[2]]]],null,[true,false],null,1],[\"cd46d016-c233-44c8-906e-7515773aa263\",[\"Lady Grace\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVc50oAa6izkzv2siCvNUxqQZ0l4sw3B1wALBvSmzctwQ_-nASz\"]]],1,null,\"This app has steady gotten worse, from its inability to stay on the route you chose, to its inability to provide 3 good routes, and none of which it does provide, is the shortest nor quickest. It stops navigating before your destination as well. Used to be a good app. Response to Google- If you want to pay me for the work, contact me. Otherwise, no I'm not taking the time to type out all the issues your app has.\",[1781358502,47000000],15,[\"Google LLC\",\"That doesn't sound good, we would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1781284896,925000000]],null,[\"115312523676124746054\",\"Lady Grace\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVc50oAa6izkzv2siCvNUxqQZ0l4sw3B1wALBvSmzctwQ_-nASz\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.23.01.924285238\",null,null,null,[true,false],null,1],[\"825f06f3-d4e9-44dc-a716-535d7d89fb7f\",[\"Kyle Kennedy\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKgz_B3Ht1HqQkG8_6MuDpCXqe5vaKfUDDxan8Kif3AxQKDrg\\u003dmo\"]]],2,null,\"1 - if I'm clicking on a route option, dont try to select a new destination 2 - if I'm selecting a route option, don't try to change the car color 3 - use directories, I don't need to click on 3-7 listing at the same location to figure out if I'm actually looking at the correct destination 4 - illegal driving directions. I tried submitting reports but goog don't care. it's asinine that they have pictures of all the streets but can't read a sign that says no left turn ever. trash\",[1784468415,634000000],9,[\"Google LLC\",\"That’s not the experience I'd want you to have, Kyle. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app. Appreciate it.\",[1784474444,267000000]],null,[\"110680922667073465241\",\"Kyle Kennedy\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKgz_B3Ht1HqQkG8_6MuDpCXqe5vaKfUDDxan8Kif3AxQKDrg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.28.03.942936911\",null,null,null,null,null,1],[\"12f03a47-bb7c-4a24-98ab-9a53167df219\",[\"Rae Sandoval\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjURdGzHmkSYATf-thHbbuFIB33UDN1Xgh-PhYiTbfOQ-he9Tk0u\"]]],1,null,\"I used to use google maps all the time, and it helped get me from A to B, but now its just TERRIBLE!!!! It takes you on back roads \\u0026 thru neighborhoods when there is absolutely no reason. I've noticed it takes me on LONGER routes now \\u0026 makes it harder to get there. The traffic tracking is USELESS- it will randomly pick a different route that has MORE TRAFFIC \\u0026 then takes me down a closed road \\u0026 constantly reroutes even if you made the turn IT SAID. Im giving it ONE more chance then its gone.\",[1781296885,89000000],16,[\"Google LLC\",\"We understand your concern, Rae. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of product experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1781314566,720000000]],null,[\"106484877148552263166\",\"Rae Sandoval\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjURdGzHmkSYATf-thHbbuFIB33UDN1Xgh-PhYiTbfOQ-he9Tk0u\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.23.01.924285238\",null,[[[\"vaf_app_quality_stability\",[2]],[\"vaf_app_quality_ads_intrusiveness\",[2]],[\"vaf_app_quality_battery_heat\",[2]]]],null,null,null,1],[\"045f29d5-82e0-4bcf-afa3-5ff92dcbb4db\",[\"Christopher Douglass\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLQAvYKI0uu-T0cWAf1qfM75w9tQiJDDgchD_6LpnHtW55ebFo\\u003dmo\"]]],1,null,\"New 'assistant' is horrible, there are several settings that no longer work well with Android Auto (North-orientated map and avoid toll option). When these issues occur I've had to restart the app while the phone isn't connected to the vehicle, sometimes multiple times before it will work again. I would pay to not receive updates at this point, but I'm now afraid that writing this will give Google ideas on how to further enshittify their products.\",[1780859453,633000000],11,null,null,[\"100126894359943666303\",\"Christopher Douglass\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLQAvYKI0uu-T0cWAf1qfM75w9tQiJDDgchD_6LpnHtW55ebFo\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.22.04.920688788\",null,null,null,null,null,1],[\"e0820f74-9426-4eff-8234-e0dd37bfc822\",[\"Jude V.\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX-8xMbheZ4M5kF7KTa66AjZJrqIHrFf2Au4Vhm2vyPzjRFqErQHA\"]]],1,null,\"find another app. this might be easy to use, but more slow and unreliable than ever. maps has gotten noticeably, significantly worse in the last 5 years and likely due to Google's AI grift- i mean investment. maps navigation is slow, inaccurate, and harder to use than ever, genuinely buy a real map and an erasable pen at this point. the AI ads only piss me off and get in my way, like all AI, should be removed in the interest of the future of the planet and species. pathetic and shortsighted.\",[1781454923,699000000],13,null,null,[\"117477969723022013321\",\"Jude V.\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX-8xMbheZ4M5kF7KTa66AjZJrqIHrFf2Au4Vhm2vyPzjRFqErQHA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.23.01.924285238\",null,[[[\"vaf_app_quality_ads_frequency\",[1]],[\"vaf_app_quality_stability\",[2]],[\"vaf_app_quality_usability\",[1]]]],null,null,null,1],[\"68ac68b7-f177-4d98-89e7-f2464cd17c0b\",[\"Sean McClellan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW1ZjvcNXZOPPTgV_DS3h_P8LDzcjtAYvNCuh1iLJF2RgM3ZNzE\"]]],1,null,\"The app just doesn't work anymore. Every time I try to get directions I just get a black screen, with the start option at the top and nothing works. I've cleared the cache and uninstalled and reinstalled. it'll work for like 2 hours and then start showing the black screen again. completely useless, can't even get directions, defeats the whole purpose of having the app. Just another app Google has broken with their horrible updates, and forced AI slop.\",[1782068935,859000000],13,[\"Google LLC\",\"That doesn't sound good, Sean. If you're running into issues with Google Maps, try the troubleshooting steps here: https://goo.gle/43EOVsN. If you continue to experience the issue, send us feedback here: https://goo.gle/43OR0Ce. Appreciate it.\",[1782090437,776000000]],null,[\"110858250628430860172\",\"Sean McClellan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW1ZjvcNXZOPPTgV_DS3h_P8LDzcjtAYvNCuh1iLJF2RgM3ZNzE\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.24.10.928892089\",null,[[[\"vaf_never_display_ads_experience\",null,[1]],[\"vaf_never_display_ease_of_use\",null,[1]]]],null,null,null,1],[\"0cdfc0fc-83c1-49b4-8af9-52003af1483d\",[\"Sarah Lyons\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK7bUgKGUYIXXFVDkGjklHOj7c3gPEtauhj0INPEOZZ570aLA\\u003dmo\"]]],1,null,\"If you want: - specific directions - reliable estimates of when you'll arrive - the fastest route Probs not the app for you. Made me late to work twice with its \\\"faster routes\\\". Very frustrating and makes me curious on how they estimate routes cause what they doin ain't working. It also feels like it's possible to make up any time on this app no matter what speed you're going at.\",[1781300264,983000000],13,[\"Google LLC\",\"That's not the experience we want you to have, Sarah. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of product experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1781314653,531000000]],null,[\"110982048347590933896\",\"Sarah Lyons\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK7bUgKGUYIXXFVDkGjklHOj7c3gPEtauhj0INPEOZZ570aLA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.23.01.924285238\",null,null,null,null,null,1],[\"12e3e05e-dfe2-4d28-8865-f43db5c81e35\",[\"Michael Lehmann\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVArgLtYvzoiWeEoD8ur70m4SYpzCaA7xKBZ7BE_FnG6hdxUNrt\"]]],3,null,\"Most of the time it is great, but it really sucks for driving on base sometimes directing you to hazardous offroad trails when there is a safe road nearby. A lot of the unrestricted roads for on base are missing or chopped up. I often have to use the Iphone program through my browser because of these issues. I've tried logging them into the system or make corrections but they have mostly been dismissed.\",[1780269968,266000000],15,null,null,[\"112765338983255008687\",\"Michael Lehmann\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVArgLtYvzoiWeEoD8ur70m4SYpzCaA7xKBZ7BE_FnG6hdxUNrt\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.22.04.920688788\",null,[[[\"vaf_app_quality_ads_frequency\",[3]],[\"vaf_app_quality_usability\",[3]],[\"vaf_app_quality_performance\",[2]]]],null,null,null,1],[\"95fb1013-8a0f-4193-bc9f-8d692b4089ae\",[\"Heather Johnson (Heather)\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWsszYJa4MjG0hsULOX7r4CCCy6bGyFyVUyxmt_mw163XTD2WQ-\"]]],1,null,\"for years this app has told me to turn left when the image clearly shows right \\u0026 visa versa but today takes the cake. I moved to a state with tolls \\u0026 I have the toll option off. but today, maps took me on SO MANY toll roads racking me up $10 in fees! I cannot afford that every day! I confirmed it's turned off, I look at the path\\u0026 see 0 $ amounts, I zoom in to make sure I'm in the clear \\u0026 even look at the steps before accepting the route. yet I get on the highway \\u0026 before long I'm on a toll!!!!\",[1784065386,519000000],10,[\"Google LLC\",\"That doesn't sound good, Heather. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1784102582,751000000]],null,[\"100572043842438475951\",\"Heather Johnson (Heather)\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWsszYJa4MjG0hsULOX7r4CCCy6bGyFyVUyxmt_mw163XTD2WQ-\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.28.03.942936911\",null,[[[\"vaf_app_quality_battery_heat\",[1]],[\"vaf_app_quality_stability\",[2]],[\"vaf_app_quality_visual_appeal\",[3]]]],null,null,null,1],[\"cb4558ab-49cb-45c6-a7d4-c396a5d414a9\",[\"Adam Hiatt\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUodvy8Bb3b_6NZI97fwmMYWDbYvLPo7Wmrv5kth34YVexDYMLQ\"]]],1,null,\"This app used to be great but now I'm never sure if I can trust the results. Used to be able to search for a place and go to the top result. now it puts sponsored results in which has messed me up a couple times. I searched for pizza places and sorted by distance and it listed places in canada! hundreds of miles north! searched for the closest place for certain items and it lists multiple places miles past other closer stores. FIX IT! drop Gemini!\",[1782777872,888000000],10,[\"Google LLC\",\"That's not the experience I want you to have, Adam. You can manage in-app ads by following the steps in this article: https://goo.gle/4s98ZQi. If it keeps happening, please send feedback here: goo.gle/43OR0Ce. Hope this helps.\",[1782831717,363000000]],null,[\"109908816032577157471\",\"Adam Hiatt\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUodvy8Bb3b_6NZI97fwmMYWDbYvLPo7Wmrv5kth34YVexDYMLQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.25.05.932239228\",null,[[[\"vaf_app_quality_stability\",[1]],[\"vaf_app_quality_ads_presence\",[1]],[\"vaf_app_quality_ads_frequency\",[1]]]],null,null,null,1],[\"6dfa09ed-6d94-4ae7-b200-112a0784e858\",[\"Bob Liger\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUrWIE4OdE9qX0HJHOnFVmP90kqpD8BZHAiXMe3FAHC9cBytKs-\"]]],1,null,\"Not sure what happened, but after the last update it no longer tries to avoid tolls, even if the route takes the same amount of time! It's pretty frustrating because now I'm not sure if I need to take other alternate routes due to traffic, I have to manually change the route. Really dumb and annoying and Google doing nothing about it. Bums.\",[1783917687,883000000],10,[\"Google LLC\",\"That doesn't sound good, Bob. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app. Appreciate it.\",[1783942433,66000000]],null,[\"115254203677921056784\",\"Bob Liger\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUrWIE4OdE9qX0HJHOnFVmP90kqpD8BZHAiXMe3FAHC9cBytKs-\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.27.05.941319029\",null,[[[\"vaf_app_quality_ads_intrusiveness\",[2]],[\"vaf_app_quality_stability\",[1]],[\"vaf_app_quality_battery_heat\",[3]]]],null,null,null,1],[\"2fb3af89-b81e-4a6a-8cd5-48b6abec30c5\",[\"Kirill K\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKGbNeEnRX0tOp_kWPAcC0GqketLm8-cXKaxGNItYwH0OIUGQ\\u003dmo\"]]],1,null,\"I would give it a zero 0. It was good but with AI... can't even find simple places like Safeway that are close by. I keep on getting \\\"No results found\\\", I had to go through the AI slop to just find the closest Safeway. This happens with almost all searches now. Why did it only work when I asked AI? AI did not make it quicker, just added extra steps I had to go through. I will be looking into alterative maps and deleting this garbage\",[1783878032,680000000],6,null,null,[\"109448683579493760261\",\"Kirill K\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKGbNeEnRX0tOp_kWPAcC0GqketLm8-cXKaxGNItYwH0OIUGQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.27.05.941319029\",null,null,null,[true,false],null,1],[\"aac18786-c7de-477d-a065-f04e9e4f30eb\",[\"Melissa D\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUoxL8tOWPXVdjnnqwYvfU37h8ZsC4Rg0dGtaI002bOLR187Jkh1Q\"]]],2,null,\"Never thought I'd be hating on Google Maps. Been using it exclusively for YEARS. Within the last month, it has taken a turn from being the unsung hero to being a villain. Over the course of a week-long vacation, it has taken us through unnecessary loops on foot and while driving. Additionally, it told us to turn at very nondescript businesses (turn at the Longhorn Steakhouse - which is situated behind trees and has no sign). What the heck is happening to this app???\",[1780518814,727000000],9,[\"Google LLC\",\"We understand your concern, Melissa. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1780531610,451000000]],null,[\"113935433837785958375\",\"Melissa D\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUoxL8tOWPXVdjnnqwYvfU37h8ZsC4Rg0dGtaI002bOLR187Jkh1Q\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.22.04.920688788\",null,null,null,null,null,1],[\"a89d5298-46ca-4074-a25d-4fca3ea2ccf1\",[\"Caleb Schenck\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVSkFdlE55DZSimsTgKCzbWFSknyOWTaoYvt3FcyC46-wsf7bmY\"]]],1,null,\"This app gets worse every time they update it. Yesterday I missed an appointment because midway through a drive I've taken half a dozen times before it apparently forgot that a bridge exists and rerouted me. a drive that should have been 30-40 minutes ended up taking well over an hour. Now I'm out $25 for the missed appointment and I used way more gas than I would have otherwise. The push I needed to finally ditch maps and find a better app. update: no relevant info at the link in G's response\",[1782313306,679000000],9,[\"Google LLC\",\"That doesn't sound good, Caleb. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Thanks.\",[1782207879,628000000]],null,[\"103400631279616378740\",\"Caleb Schenck\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVSkFdlE55DZSimsTgKCzbWFSknyOWTaoYvt3FcyC46-wsf7bmY\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.23.01.924285238\",null,[[[\"vaf_app_quality_usability\",[2]],[\"vaf_app_quality_performance\",[2]],[\"vaf_app_quality_visual_appeal\",[2]]]],null,[true,false],null,1],[\"4debebfd-9b52-4a14-b8c1-15bdab0c0a82\",[\"David Missey Jr\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU_ORw4cjIqWO6-fuJYagOSb-WHVXdpye50g0Gtmf-i60zSYbG50A\"]]],2,null,\"the location tracking sucks and the chick telling me where to go needs to tell me sooner and stop telling me to turn \\\"right now\\\".. (into the woods, oncoming traffic etc), the rerouting is ridiculous! instead of telling us to turn around if we miss a road, Google maps tries to take us around the city instead of going 1000ft or whatever back to turn at the correct place. maps used to be tha bomb, I'm not impressed anymore. Especially with the advancement of technology... it went backwards🤷\",[1780191593,552000000],15,[\"Google LLC\",\"That doesn't sound good, David. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1780219798,525000000]],null,[\"108467411053112900542\",\"David Missey Jr\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU_ORw4cjIqWO6-fuJYagOSb-WHVXdpye50g0Gtmf-i60zSYbG50A\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.02.916832833\",null,[[[\"vaf_app_quality_ads_frequency\",[2]],[\"vaf_app_quality_battery_efficiency\",[3]],[\"vaf_app_quality_performance\",[2]]]],null,[true,false],null,1],[\"08072e5d-15ab-4707-ba61-823c6ee3a5cf\",[\"Julian Picardo\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVFePivMAP1LQ45VnGJvbv3gokFIFDzLtuHPYMFH3cNym6rGTim\"]]],1,null,\"Continuous Platform Decay. There was a time, Google stole your private information, in exchange for a map service. These days it's just theft. Maps guides you through LONGER routes, randomly changes the map scale, takes you through unpaved roads, etc. I am back to doing things the old fashioned way of following street navigation. Maybe need to buy a book of street maps next.\",[1780453129,819000000],17,null,null,[\"116946725728559649539\",\"Julian Picardo\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVFePivMAP1LQ45VnGJvbv3gokFIFDzLtuHPYMFH3cNym6rGTim\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.22.04.920688788\",null,[[[\"vaf_app_quality_performance\",[3]],[\"vaf_app_quality_visual_appeal\",[2]],[\"vaf_app_quality_usability\",[2]]]],null,[true,false],null,1],[\"fab83ccd-32c7-46a3-9146-392792a8d510\",[\"Jennifer Lopez\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW9_RXHgY46wHpbngcTsMbsau68zvp7vljJOZ_LPfrAOVEnihFy_Q\"]]],1,null,\"this app really sucks, especially for a solo female traveler. it doesn't re-enter when driving a car or bike which i find very dangerous. it gives wrong directions and instructions. Most of the time it makes you take the longer route. After another year of using this app, it has just gotten worse. It changes the direction of my destination, takes me to different, it's constantly lagging, the navigation needle is stuck most of the time, and it constantly interrupts my view with the pop up msges.\",[1783823774,295000000],8,[\"Google LLC\",\"We understand your concern, Jennifer. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1766507991,349000000]],null,[\"100537257089710019120\",\"Jennifer Lopez\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW9_RXHgY46wHpbngcTsMbsau68zvp7vljJOZ_LPfrAOVEnihFy_Q\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.27.05.941319029\",null,[[[\"vaf_never_display_visually_bad\",[1]],[\"vaf_never_display_disruptive_ads\",[1]],[\"vaf_never_display_useful_notifications\",[3]]]],null,[true,false],null,1],[\"1377cf09-1b52-412f-8a92-48a429863bd1\",[\"Kevin Mielke\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU1VCMR0A7Ew6d-WN6m4C3RFBQYX3qOVELbdWLSBWiuEETKoB0E\"]]],5,null,\"I really really really wish that there would be a little text in a corner of the screen that told me what city I'm in, especially when navigating. Also, another thing that has bugged me forever is when I tap to navigate somewhere a button appears and a timer starts for confirming my choice, I wish it was opposite, where it immediately starts navigation and a button appears to cancel. Other than that the app works pretty good.\",[1781873643,564000000],16,null,null,[\"111822640695611717152\",\"Kevin Mielke\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU1VCMR0A7Ew6d-WN6m4C3RFBQYX3qOVELbdWLSBWiuEETKoB0E\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.23.01.924285238\",null,null,null,null,null,1],[\"95e1232d-925a-4741-b05f-9d721d1cf9ec\",[\"Kove Hernandez\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVrTUnGFwCsaSPdYt0dHH3pCHkpxjHZLinbQylGLgGWNGCBbH_C5w\"]]],1,null,\"Google Maps keeps giving terrible directions. There's a road near me where you can literally drive straight, but it constantly reroutes me for no reason. Today it wasted 30 minutes sending me toward closed streets instead of the obvious route. It also regularly shows me on the wrong street and takes me the longest way possible. Navigation is supposed to save time, not make every trip more frustrating. Getting worse with every update.\",[1782343181,489000000],13,[\"Google LLC\",\"That doesn’t sound good, Kove. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Hope this helps.\",[1782344224,136000000]],null,[\"109016099145413148907\",\"Kove Hernandez\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVrTUnGFwCsaSPdYt0dHH3pCHkpxjHZLinbQylGLgGWNGCBbH_C5w\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.25.05.932239228\",null,null,null,null,null,1],[\"27875a66-274e-4fff-9b90-72ead5e00a3b\",[\"MJ Zeek Daniels\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU8rZGGd6MnIkNGd5tMWd41VTHeKmdSInsFxzoyrx6ZG3-zCzAPYA\"]]],2,null,\"Maps is good sometimes, but the amount of inaccuracies is devastating. I travel internationally, on average, 70 times a year and nothing is more frustrating than arriving at a destination and it's closed. I have contributed changes to maps, many of which I've provided accurate information and most are rejected. Most recently I updated hours for a venue including the signage and my office location and they were both rejected with no ability to add comments or indication why it wasn't accepted.\",[1784075779,537000000],9,[\"Google LLC\",\"That doesn’t sound good, Zeek. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Hope this helps.\",[1784119730,984000000]],null,[\"112131259642212100393\",\"MJ Zeek Daniels\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU8rZGGd6MnIkNGd5tMWd41VTHeKmdSInsFxzoyrx6ZG3-zCzAPYA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.28.03.942936911\",null,null,null,null,null,1],[\"b556caa1-418d-488f-9804-2b9c73be891f\",[\"JP MGEO\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI1hVloMRP_IeHGPIzg0iv_x11fOjOg9ZMrFO3TervH7TreFg\\u003dmo\"]]],3,null,\"Not sure if it's a bug but it's no longer offering all routes. Tried to plan a cross country trip. Best route is I-80 all the way to my destination. It completely avoids I-80 east of Rawlins, WY. Won't let me drag to change the route anymore. It wants to take a longer route with more expensive tolls. No filters selected that would change routes for any reason. It also wants to exit the freeway several times to travel on business routes through cities rather than staying on the interstate.\",[1784255100,407000000],8,[\"Google LLC\",\"That's not the experience I want you to have. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1784296882,806000000]],null,[\"103083329713400329985\",\"JP MGEO\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI1hVloMRP_IeHGPIzg0iv_x11fOjOg9ZMrFO3TervH7TreFg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.28.03.942936911\",null,null,null,[true,false],null,1],[\"50190173-9bc4-47af-9b15-a071bdaae022\",[\"Brian Bloom\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXivqZ4yQvVurSkui78fCc00Xl-fWUOIarP_EjuiUKmsa7GpC60KA\"]]],1,null,\"By far the worst map app available on here. Daily it routes me into construction zones, accidents, other delays, without warning of the delay until you're in it. Today this caused me a 30 minute (just under) increase on my drive that could've been completely avoided if it routed me off the exit before the one it took me too. I stopped using this app when they went with Apple's colors. Came back and couldn't regret it more. Again. WORST. NAVIGATION. APP. EVER.\",[1783626790,984000000],75,null,null,[\"111562002378887681733\",\"Brian Bloom\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXivqZ4yQvVurSkui78fCc00Xl-fWUOIarP_EjuiUKmsa7GpC60KA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.27.05.941319029\",null,[[[\"vaf_sharing_arrival_time\",[2]],[\"vaf_phase1_offline_navigation\",[2]],[\"vaf_phase1_seeing_photos_of_places\",[1]]]],null,[true,false],null,1],[\"4f3686ca-097a-4196-9e86-294480f46942\",[\"Jerome Daniels\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVJhZMQLcUjYiwlxUP3qK8wBP-MAImVbHjYYpTsgZ8pXRha29AwLQ\"]]],2,null,\"I absolutely hate when I get to a split on the highway, and maps doesn't say anything. I end up taking a last second guess. Maps navigation should tell me beforehand left or right at an upcoming split/fork. It doesn't say anything until you've already went the wrong way. The visual map isn't helpful either. Google should have it expand slightly and momentarily so you can see beforehand which direction I should travel before the fork. That would be awesome\",[1784660943,797000000],9,[\"Google LLC\",\"That doesn't sound good, Jerome. You can submit the details of what you're experiencing by following these steps: goo.gle/355m3NU, so our team gets the right information to help improve the app.\",[1784708556,791000000]],null,[\"115632737336047935382\",\"Jerome Daniels\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVJhZMQLcUjYiwlxUP3qK8wBP-MAImVbHjYYpTsgZ8pXRha29AwLQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.29.02.946673643\",null,null,null,null,null,1],[\"94c9c8e9-18a7-4aef-afb3-ea8279701a61\",[\"Rachel B\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIT7gZZmFCYu_iIra-P2i-ULezhDMNYzL0JmBM9K3yUiQT5Lg\\u003dmo\"]]],3,null,\"Good but some things have stopped working. You used to be able to add disabled cars on the side of the road, that is now gone. Some of the gas stations, including membership ones no longer show the prices for gas. The app used to integrate other audio apps at the bottom so you could play/pause/skip without getting out of maps. That no longer works or was removed as a feature.\",[1784501156,756000000],4,[\"Google LLC\",\"That doesn't sound good, Rachel. To help me look into this further, please create a post in our Google Maps Help Community. Our team and community experts can assist you there: goo.gle/3vosTcH. Appreciate it.\",[1784505396,63000000]],null,[\"117738980803726310271\",\"Rachel B\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIT7gZZmFCYu_iIra-P2i-ULezhDMNYzL0JmBM9K3yUiQT5Lg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.28.04.942936911\",null,[[[\"vaf_app_quality_performance\",[1]],[\"vaf_app_quality_stability\",[1]],[\"vaf_app_quality_battery_efficiency\",[3]]]],null,null,null,1],[\"d0a6f51e-c07e-4885-a819-703a4f87e945\",[\"Dark King\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUBUOxY4mB6MqytsQQrtGBDraqKA34tSgVhiLvkgCKBWkWPKktd\"]]],3,null,\"Most of the time it tells me well before I'm supposed to turn but today it started to only tell me when to turn after I've already passed it or too late to switch lanes to turn. Also we need to be able to drop pins to choose a specific route, like if there's road work. And if we add a stop and we don't go to that stop and avoid it multiple times while heading to our final destination it should add a pop up to ask to remove the stop so we get directions to our destination.\",[1784730660,155000000],6,[\"Google LLC\",\"That doesn't sound good. If you're running into issues with Google Maps, make sure you are on the latest version of Google Maps: https://goo.gle/43EOVsN. If you continue to experience the issue, send us feedback here: goo.gle/43OR0Ce. Appreciate it.\",[1770420380,211000000]],null,[\"100791314104739437488\",\"Dark King\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUBUOxY4mB6MqytsQQrtGBDraqKA34tSgVhiLvkgCKBWkWPKktd\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.29.02.946673643\",null,[[[\"vaf_never_display_ads_experience\",null,[1]],[\"vaf_never_display_ease_of_use\",null,[2]]]],null,[true,false],null,1],[\"6111ee81-ca29-4bfe-b537-2c75b39544db\",[\"Rob\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUPJp9zDN4n5SPPf7n9gHIdr1nR5lE8Auq0KPYDtTnasIxC1h_T\"]]],1,null,\"Mediocre navigation: it doesn't say what lane to get into early enough. The offline downloading needs improvement. The region selection is limited to tall rectangles that can overlap or have gaps. There's no way to download satellite images of regions. Also, there should be an option while searching to disable the screen moving to the closest match. The compass button doesn't always work to angle the map north.\",[1783340483,27000000],37,null,null,[\"117452623740306500014\",\"Rob\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUPJp9zDN4n5SPPf7n9gHIdr1nR5lE8Auq0KPYDtTnasIxC1h_T\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.26.03.935742811\",null,null,null,[true,false],null,1],[\"e9718636-892c-4a63-ba23-12fe0bdd8b34\",[\"Two PointO\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIMW3WHze-AR1aTRoiNVDOWDuqlCQ-ge2vxZnsmIPduEDRnmA\\u003dmo\"]]],4,null,\"I may have been a little hasty with my review. I will say it is a lot better these days and all in all it is a pretty good at . and I do use it just about every day. However one thing Google that you could do that would by far and wide bumped us to a five-star and I'm sure everyone else is well is to when choosing somewhere to go before the routes pop up if you could give the option to trace your own route that you would like to go that would be amazing!\",[1785103694,271000000],3,null,null,[\"107252650335363024120\",\"Two PointO\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIMW3WHze-AR1aTRoiNVDOWDuqlCQ-ge2vxZnsmIPduEDRnmA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.18.01.905972481\",null,[[[\"vaf_app_quality_ads_frequency\",[2]],[\"vaf_app_quality_visual_appeal\",[3]],[\"vaf_app_quality_battery_heat\",[2]]]],null,[true,false],null,1],[\"f4b14d2a-03b6-4a76-98f0-851b00486cae\",[\"S. Sobelsohn\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIWRHobCMRmQpAysiy17Bh_76YguZpAPWeKpGmVKPff9FcB-g\\u003dmo\"]]],1,null,\"This app takes a long time to update and it frequently freezes, when updating. No other app does that, making it frustrating to update Google Maps. Also, the choices I get, when asking for transit info, aren't as good as they used to be. Some logical choices aren't given, as if the product itself needs to be reworked.\",[1787355205,81000000],1,[\"Google LLC\",\"That doesn't sound good. If Google Maps is crashing, let's make sure you're on the latest version: goo.gle/43EOVsN. If it keeps happening, please send feedback here: goo.gle/43OR0Ce. Hope this helps.\",[1787360230,125000000]],null,[\"117299641864794444184\",\"S. Sobelsohn\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIWRHobCMRmQpAysiy17Bh_76YguZpAPWeKpGmVKPff9FcB-g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.12.05.884026066\",null,[[[\"vaf_app_quality_ads_frequency\",[2]],[\"vaf_app_quality_battery_heat\",[2]],[\"vaf_app_quality_performance\",[2]]]],null,null,null,1],[\"8990a3ec-ffbd-451a-a0f0-93d0e985fa77\",[\"Alexis Winters\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUyH56V8SftwAdnLGVASA0hywkQn84CpEQhL-S86iXtTlbVa29CIA\"]]],1,null,\"Once I find another navigation app to use, I'm switching to it. Google Maps has a horrible \\\"feature\\\" that changes your route mid-trip and you won't even know it. Just to \\\"save\\\" you 1 minute of driving time, and it usually ends up being about 10 extra minutes of driving time. There used to be a feature where they'd ask if you'd like the alternate route and now it's simply automatic, no asking at all. Which of course, allows for people to get lost or stopped by a train on a side road.\",[1779904994,367000000],21,[\"Google LLC\",\"Hi Alexis, thank you for your suggestion. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look. Appreciate it.\",[1779928934,197000000]],null,[\"106945678577506459455\",\"Alexis Winters\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUyH56V8SftwAdnLGVASA0hywkQn84CpEQhL-S86iXtTlbVa29CIA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.01.916832833\",null,[[[\"vaf_app_quality_ads_frequency\",[2]],[\"vaf_app_quality_visual_appeal\",[1]],[\"vaf_app_quality_ads_intrusiveness\",[2]]]],null,null,null,1],[\"1cb37e10-f9f3-474d-9607-b5b2dd93060f\",[\"Doug Simpkins\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUBiU6ynrIZc1525qa3wkHcJwS-lCwlNBxB6B8SrtsRdk5JR9xV\"]]],2,null,\"If you don't have any other gps apps on your phone, this can suffice, but it's extremely problematic. It'll change your route without your knowledge or consent. It's lied to me (traffic jam backup for miles, told me the road was closed and tried to reroute me, kept going and turns out it was just a traffic jam). Tried to take me onto a private road (complete with fence), all sorts of stupid stuff. You can use it but watch out for any number of technical deficiencies.\",[1780173943,815000000],19,[\"Google LLC\",\"We understand your concern, Doug. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1780187049,275000000]],null,[\"100688204580947495144\",\"Doug Simpkins\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUBiU6ynrIZc1525qa3wkHcJwS-lCwlNBxB6B8SrtsRdk5JR9xV\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.01.916832833\",null,[[[\"vaf_app_quality_ads_presence\",[2]]]],null,null,null,1],[\"f78cbe57-d166-4440-8f75-20150cced95e\",[\"T\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLr0MAtvc8BIwhQNWInDE1eFt4yE9O5_riC3E9KqNtu6It9eqN8\\u003dmo\"]]],2,null,\"update July 16 of \\\"bug fixes\\\" actually introduced bugs for users that use 3-button nav. can't sort results by distance. sort buttons are under the 3 button nav. Messy routing, annoying alerts (yes it's still under construction, we have 2 seasons, winter and construction, alerts to confirm things are annoying). the created_at for reviews should also display the whole date not relative time. 1 year ago is not helpful. sometimes knowing the month is important for some locations.\",[1784657715,757000000],221,null,null,[\"102930328425469859984\",\"T\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLr0MAtvc8BIwhQNWInDE1eFt4yE9O5_riC3E9KqNtu6It9eqN8\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.29.02.946673643\",null,null,null,[true,false],null,1],[\"38feff7a-d4d6-40c0-b966-bebc97189de7\",[\"Crystal H.\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWe9yRVHpCHBZA-kWbJqHEZ0a6CA9hYFR1xeIy4OLdp2zRdcXyI\"]]],1,null,\"July 2026 Update: Worse! Now, the directions are convoluted, doubling the distance or actual time to travel (e.g. a 3 min. trip GM now routes as 6)! Update: Sometime around January 2026, the starting location in my Google Maps (GM) app has been wrong. For example, when starting from my \\\"Home\\\", some random address nearby comes up. This never used to happen. I've cleared the app cache, verified that my location features are accurate \\u0026 turned on in the GM app, etc. Nothing seems to fix the issue.\",[1784403136,759000000],204,[\"Google LLC\",\"We understand your concern, Crystal. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1771200103,868000000]],null,[\"100761443677006162732\",\"Crystal H.\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWe9yRVHpCHBZA-kWbJqHEZ0a6CA9hYFR1xeIy4OLdp2zRdcXyI\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.28.03.942936911\",null,[[[\"vaf_real_time_traffic_data\",[1]],[\"vaf_estimating_arrival_time\",[1]],[\"vaf_reduced_sized_maps\",[1]]]],null,null,null,1],[\"cb52956c-d70f-4c37-ac27-39eb3c2a4658\",[\"Andrej Tomić\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJsbKW_eaxNoVL03x5ArKUzJ-mM-9py0ZHbOZe8G9xjcZt0vA\\u003dmo\"]]],1,null,\"Most times I can't even put I'm in some place, although I've been there for a while and haven't moved. Also can't leave review as I used to, now it's much more complicated then it used to, and I should know, since I'm local guide level 7. Horrible changes, whatever they are. Keep removing my reviews for no particular reason, although I was there and added photos and all. Ridiculous! Also half of the stuff no matter how relevant it is, can't be put, and they remove it because they feel like it.\",[1776152879,477000000],90,null,null,[\"101171041777256282903\",\"Andrej Tomić\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJsbKW_eaxNoVL03x5ArKUzJ-mM-9py0ZHbOZe8G9xjcZt0vA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.14.09.891313448\",null,[[[\"vaf_never_display_ease_of_use\",null,[1]]]],null,[true,false],null,1],[\"a4f2a6f1-d433-4541-8675-1e7b0fdc8910\",[\"Lee Nicholson\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVUAyyOi4J6c4TtMbmi2WzIeBBqQHwVZhZ_si33bp7mwRE0ZMTOYw\"]]],1,null,\"After being reliable for so long, the app recently has become unusable on several occasions. It seems to think there is a limited/poor connection, even when on strong WiFi or 5G. No other apps have had the same issue. This means it won't search for destinations or plot routes, rendering it useless. Restarting or reinstalling the app makes no difference, but it seems to update regularly.\",[1776773735,787000000],47,[\"Google LLC\",\"We understand your concern, Lee. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1776819752,604000000]],null,[\"104071863303863601853\",\"Lee Nicholson\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVUAyyOi4J6c4TtMbmi2WzIeBBqQHwVZhZ_si33bp7mwRE0ZMTOYw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.16.05.898594237\",null,null,null,null,null,1],[\"36514adc-26df-4179-849d-211f23c35998\",[\"Tocs Yelrom\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUg2MMSMwvWMrKCFTZnUnUM9e2Z_FKihCV3AKO5TmEceOkJc_vS\"]]],1,null,\"Gets worse and worse. Used to be a great app you could always count on. The amount of times it's sent me the wrong way lately, or put me in the wrong lane at an island.. Just annoyances that put a lot of time on to your journey. Just feels they've taken a massive backwards step to me. Hopefully they fix these issues and it goes back to how it was.\",[1777485943,255000000],45,[\"Google LLC\",\"We understand your concern. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1777507922,967000000]],null,[\"118277260936580061256\",\"Tocs Yelrom\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUg2MMSMwvWMrKCFTZnUnUM9e2Z_FKihCV3AKO5TmEceOkJc_vS\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.17.05.901412876\",null,null,null,null,null,1],[\"8079a127-2754-4150-a54b-8f40c02a06f1\",[\"Paweł Szymański\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWokerujuQNPPCytcaeXqKvvUWl2nTFdh_J1jFLCgzsAFBb5Qv1\"]]],1,null,\"I like Maps. I think they are an infinitely useful app. However, when I search for a CONTACT'S ADDRESS in a hurry, and I'm shown two sponsored locations instead, and I mistakenly click the \\\"route to\\\" button on one of them cause, again, I'm in a hurry, and I find myself being dragged through the city center traffic, adding 30 odd minutes to my travel time and inevitably extending the \\\"I really need to use the bathroom\\\" state by the same amount, I cannot, in good conscience, give it more than 1 ⭐\",[1746377756,476000000],416,null,null,[\"115727244825440042332\",\"Paweł Szymański\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWokerujuQNPPCytcaeXqKvvUWl2nTFdh_J1jFLCgzsAFBb5Qv1\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.17.00.749564752\",null,null,null,null,null,1],[\"d5009a13-bb73-4bf0-b6d9-5bd10e7eff9c\",[\"Richard Bacon\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL_B238R3x58yzDFsgZlGm4fWbG-GW0St0vxt2zDyjTJ-rRJQ\\u003dmo\"]]],4,null,\"Okay, so as a navigation tool, it is pretty good for driving, really good for public transport, but in walking mode, especially in built-up areas, it is all over the place. After a recent update, it started asking road status questions. These are distracting and so dangerous and can't be switched off. The issue of the app stopping in the car is an issue with Android Auto, not with Maps and relates to USB cable length, keep the cable very short. Overall, pretty good but could be better.\",[1731863811,863000000],802,[\"Google LLC\",\"That doesn't sound good, Richard. Let's give these steps a try, clear cache and uninstall the updates: https://goo.gle/3rF6Ewz. Also, please create a post in our Android Auto forum so that our community of experts can assist you: https://goo.gle/2TJzeS7. Hope this helps.\",[1718319294,753000000]],null,[\"102210244717486370703\",\"Richard Bacon\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL_B238R3x58yzDFsgZlGm4fWbG-GW0St0vxt2zDyjTJ-rRJQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.154.0103\",null,null,null,[true,false],null,1],[\"3f323607-e1b5-45ee-9fed-ebf9a2d49476\",[\"Daniel\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJOE0Gn2EYJCUJrM_fMI1wFiQiEaX3_nO6BZcHpzQAIoLA9_Q\\u003dmo\"]]],1,null,\"I choose a journey out the options, and then it just sends me down the one it had first suggested rather than the one I chose. It happens all the time. I also wish I could edit the journey like you can on the Google maps site, pulling and dragging the line to the paths I want to go by. I also wish it could save certain paths, because the options of path sometimes are different and doesn't let me pick the one I want. I don't care if there's traffic, let me create my journey.\",[1729781414,656000000],381,[\"Google LLC\",\"That doesn't sound good, Daniel. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: https://goo.gle/3vosTcH. Hope this helps.\",[1729789635,808000000]],null,[\"111326283940767208306\",\"Daniel\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJOE0Gn2EYJCUJrM_fMI1wFiQiEaX3_nO6BZcHpzQAIoLA9_Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.151.0901\",null,null,null,[true,false],null,1],[\"440b994c-388a-4c1e-9bbf-f0aaca327f27\",[\"Roy Frost\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKnWCkYyJZsZRdZ8XUTclPFKepEGOsHrvfBT9iiTgsUpRVgaQ\\u003dmo\"]]],4,null,\"it's a very good navigation app, probably the best. I'm amazed tho that you only get a small audio bleep to warn you of speed cameras instead of a voice warning. Almost all other navigation apps provide thus. surely it's not beyond your technical knowledge to do this. Makes it so much easier to hear a voice than a little bleep that you may miss whilst driving. I'm sure your ratings would go up 5 fold .\",[1759387695,591000000],3556,null,null,[\"104865427955838608187\",\"Roy Frost\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKnWCkYyJZsZRdZ8XUTclPFKepEGOsHrvfBT9iiTgsUpRVgaQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.39.07.809715466\",null,[[[\"vaf_never_display_disruptive_ads\",[2]],[\"vaf_never_display_spend_more_time\",[2]],[\"vaf_never_display_easy_to_use\",[1]]]],null,null,null,1],[\"f0a2d86b-00f1-4859-a17b-f0fc5447fec5\",[\"Sylvain Boissé\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX8ZaAA0k9DSzRE6C0YTNmEy4WI98NlQdvoVrFnW7X3B5d41di8\"]]],1,null,\"Since a few says the app keeps failing connecting to the internet. But there is internet access on the phone and can use it normally with all the other apps. The same problem happens both using WiFi and using mobile data. I have to close the app, restart it a few times, then it ends up working. And the a few minutes later, the problem is back again and I have to kill it a few times until it succeeds connecting. Super frustrating. Please fix this asap.\",[1760300489,445000000],6673,[\"Google LLC\",\"Hi there. The issue is now resolved. If you continue experiencing issues, please submit a feedback report: Open Google Maps App \\u003e tap top right profile picture or initial \\u003e Help \\u0026 feedback \\u003e Send product feedback. Appreciate it!\",[1761186046,678000000]],null,[\"114784589183561004826\",\"Sylvain Boissé\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX8ZaAA0k9DSzRE6C0YTNmEy4WI98NlQdvoVrFnW7X3B5d41di8\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.40.11.812611599\",null,null,null,null,null,1],[\"12b9328f-f376-4c32-83be-a062a2a9bbc8\",[\"Peter Glynn\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUH-JDkHe6o8ivwatpYHb_W1ApB9XHKRdCbKYyLdG3vF7faIvVS_w\"]]],2,null,\"Not as good as it used to be. I gave up using it as a satnav when out on my motorbike as it kept giving up and saying it had no connection, whereas it could travel exactly the same route in the car without any issue. Now it's not properly recording the journeys I've taken, just putting best guess straight lines to where it thinks I went, often inaccurately, and requesting manual confirmation when I review. Do we have to have the map crowded with adverts of fast food outlets and similar?\",[1735570120,800000000],293,null,null,[\"107740050134584381958\",\"Peter Glynn\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUH-JDkHe6o8ivwatpYHb_W1ApB9XHKRdCbKYyLdG3vF7faIvVS_w\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.50.04.705335264\",null,null,null,null,null,1],[\"430bf610-ed2f-4fde-b5bf-fd43bfa3baa1\",[\"Harsh Dave\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUyHOGeQedVC_OHvZw3cuxacMBsNiS6tezNdpXMTqfbEIKpxS0Q\"]]],2,null,\"There are many times when it keeps getting stuck on the \\\"Starting Navigation\\\" step. It appears to be an issue with the destination address. It looks like when the route has Highway included, the maps do not work. But if I disable highway (avoid highway) the maps work normally. And this is only happening to certain locations as other destinations with same highway work fine.\",[1734472820,294000000],361,[\"Google LLC\",\"Hi Harsh. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: https://goo.gle/3vosTcH. Hope this helps.\",[1734399265,256000000]],null,[\"105792596093610703314\",\"Harsh Dave\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUyHOGeQedVC_OHvZw3cuxacMBsNiS6tezNdpXMTqfbEIKpxS0Q\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.49.06.703287473\",null,null,null,[true,false],null,1],[\"cf044c88-9af7-44ec-8a09-d3850331285f\",[\"Paul Seligman\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXt1hJaRNA0KV2O6tOoZDVHjEJjrlSxHAcSOQKCx4BGMy3jPPGc\"]]],4,null,\"Great app, which I've used for many years with only occasional problems. I can't find a way to report a bug without posting a review. And I can't post a screenshot here, which would make a problem easier to understand. Here's a bug: If you use it for public transport, it shows how busy a particular station or stop is, based on the approx. current time of your phone. It should use the predicted time and day, which may be very different, and is based on selected day \\u0026 time for travel.\",[1733591350,47000000],1311,null,null,[\"104314927961408370632\",\"Paul Seligman\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXt1hJaRNA0KV2O6tOoZDVHjEJjrlSxHAcSOQKCx4BGMy3jPPGc\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.48.05.700553417\",null,null,null,null,null,1],[\"0ac8d9e5-b299-4d6e-9f19-353514eba0a8\",[\"Alexandru Lipan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX3vwcqjg9GFTuItkBHodRwN5ALgK-EsZHtuN2qHJrt1wVkLdSS\"]]],1,null,\"This a reloaded update. Navigation broken to the point that I can't select what mode I have (especially public transport navigation that seems to have disappeared). On top of it, now suddenly I find that \\\"because policies\\\" 80% of my reviews are deleted, together with pinned places and favourites. Maps is also cluttered with square pins (basically ads) of sport betting offices and high profile shops, that I don't need at all in a navigation app.\",[1738680909,499000000],411,null,null,[\"107513826796258425840\",\"Alexandru Lipan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX3vwcqjg9GFTuItkBHodRwN5ALgK-EsZHtuN2qHJrt1wVkLdSS\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.05.02.719889437\",null,null,null,null,null,1],[\"716909d4-5712-44fd-ab29-ef2edaf74cbb\",[\"Meredith Navin\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUgg3vybuJjtcoupygal6yQeOojevGRczB67VUdg4U10kkJqjA\"]]],3,null,\"Not sure why the popup window is constantly disappearing when changing app. I listen to a podcast on YouTube and whenever I try to play it, the popup window (which, frankly, needs to be bigger) keeps disappearing. It's very frustrating, as YouTube will stop playing if it's not the main window open. And before you ask, no, I'm not watching YouTube, I'm just listening to it. Also, please make it easier to change from driving to walking.\",[1734244028,714000000],645,null,null,[\"110800972149993912177\",\"Meredith Navin\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUgg3vybuJjtcoupygal6yQeOojevGRczB67VUdg4U10kkJqjA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.49.06.703287473\",null,null,null,null,null,1],[\"d4ea73fb-463d-40d2-a58a-1fef22cc076a\",[\"Alan Dollery\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXLo-Rlzz5iiIzKOsYh1th7doZ1-T4yoI_gaxJJzV7oLTe_sFtU\"]]],1,null,\"Still no speed cameras icons position's on the map or the option to turn them on in Settings, Navigation, Driving Options, Speed Limits option. Just Speedometer, driving notifications and Bluetooth tunnel beacons. There seems to be an update every week for years and still nothing. I've tried uninstalling it clear cache, data all suggestions I can find, and on multiple phones and tablets and a laptop. But nothing is displayed I thought the UK was one of the areas all set up for it.\",[1754386017,158000000],264,[\"Google LLC\",\"Hi Alan. Thanks for the feedback, we really appreciate it! We will pass it on to the right team.\",[1754406531,239000000]],null,[\"112264386035149037230\",\"Alan Dollery\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXLo-Rlzz5iiIzKOsYh1th7doZ1-T4yoI_gaxJJzV7oLTe_sFtU\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.31.02.787720732\",null,null,null,null,null,2],[\"a1d7c9ea-1e73-413e-992b-5f5dfe4995a3\",[\"Humarno Schoonwinkel\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUftjTmN4kTiGk88W5u4BKVCrdN3RDadsj_mG4tzS0uTakol64\"]]],4,null,\"Greetings, App works amazingly. Can I request that a speed warning/alert option be added to the app to help stay under the speed limit. (this can be toggled on/off) Reason being, in my country the signs are often not there anymore and then one speeds without knowing it. Such a useful feature and if the speedometer can also show in android auto please.\",[1732824742,527000000],954,null,null,[\"106366260863632192377\",\"Humarno Schoonwinkel\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUftjTmN4kTiGk88W5u4BKVCrdN3RDadsj_mG4tzS0uTakol64\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.47.04.699095382\",null,null,null,null,null,1],[\"bd8253da-ac1b-4601-8a96-a31054c46d0c\",[\"Praveen Kandukuri\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWpjLN2citK5YRRew1Otrrzyi1zby_jepIuzGYVRPgg6j2U8k8\"]]],1,null,\"why the heck you have to reroute always and expect us to click \\\"no\\\" when the phone is in the pocket, while we are driving. You are forcing us to take a shorter route as we bikers cannot click no when you are rerouting, because our phones will be in our pockets and we cannot stop suddenly just so we have to click \\\"No\\\". Sometimes we don't want a shorter route due to safety concerns (that road is famous for robbery) and bad road conditions..etc So provide an option to pause \\u0026 resume rerouting.\",[1752760240,668000000],518,[\"Google LLC\",\"We understand your concern, Praveen. Thanks for flagging this. We will pass this to the right team.\",[1752758523,884000000]],null,[\"103095144030920345151\",\"Praveen Kandukuri\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWpjLN2citK5YRRew1Otrrzyi1zby_jepIuzGYVRPgg6j2U8k8\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.21.01.760306150\",null,null,null,[true,false],null,1],[\"97942161-b95e-4e4e-9dce-1a4d9224d383\",[\"G S\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU36hF4S_g_CnmaPiNPKHfA5RM1E-BBUgtOe50N_WEC3aUPrgvu0Q\"]]],1,null,\"I used to love this app - I could switch between routes without having to manually add waypoints to force the AI to go specific ways. Recently it's also been ignoring random junctions that split the route, both on and off the motorway, rurally and in cities, leaving you having to make last minute decisions. Sudden lane changes are also its forte - especially fun in city traffic in the last possible 5m before a turn! Traffic estimations are also way off. As it is, it's pretty much pointless.\",[1754917719,793000000],2071,[\"Google LLC\",\"That doesn't sound good. Thanks for the feedback, we really appreciate it! We will pass it on to the right team.\",[1754952943,192000000]],null,[\"100939535473089665238\",\"G S\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU36hF4S_g_CnmaPiNPKHfA5RM1E-BBUgtOe50N_WEC3aUPrgvu0Q\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.32.00.790560726\",null,null,null,null,null,1],[\"03241a52-a2e3-4432-b35f-b1a91c16cdfe\",[\"Cassi\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVpgEzCFOwhx1dxfHdkfUm28HNaHqAqacHtFU1QAX_Tfu4FexR9xQ\"]]],1,null,\"No idea what has changed with Google, but this GPS is absolutely trash now. The directions are awful. It's happened multiple times where the route it says is the fastest takes at least 20 minutes longer than the usual more direct route. I usually use it to check traffic on my way to and from work, and at this point it's completely useless.\",[1740801629,680000000],452,[\"Google LLC\",\"We understand your concern, Cassi. Thanks for the feedback, we really appreciate it! We will pass it on to the right team.\",[1740809232,531000000]],null,[\"104131783490875458776\",\"Cassi\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVpgEzCFOwhx1dxfHdkfUm28HNaHqAqacHtFU1QAX_Tfu4FexR9xQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.08.01.727565367\",null,null,null,null,null,1],[\"7136ec4c-da41-4f3d-8f5f-1f7daf3aed50\",[\"John E. Quick III\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXrVTqfjwdESlFH82XSRuREnlCyH6RznN5oNGVWnVcfoZyRytKP\"]]],3,null,\"Why on earth is the \\\"Your visits and Maps activity\\\" section on the very very bottom of any listing on the map? That should be up near the top, where it used to be, not hidden under literally everything else. Some of us use this feature to tell whether we've been somewhere before and when, and shouldn't be hidden. I just recently found it again. Please put this back in the expanded information for locations, where it used to be, so those of us that use it can find it.\",[1750555129,713000000],198,[\"Google LLC\",\"Hi John, thank you for your suggestion. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1750585875,685000000]],null,[\"107765933022054470729\",\"John E. Quick III\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXrVTqfjwdESlFH82XSRuREnlCyH6RznN5oNGVWnVcfoZyRytKP\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.24.02.768809388\",null,[[[\"vaf_never_display_ease_of_use\",null,[5]],[\"vaf_never_display_ads_experience\",null,[5]]]],null,[true,false],null,1],[\"664f343a-c343-4836-8ecc-87e84d47193c\",[\"Erin Schwenke\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLkcg0BppZ7C3vV7aQzlRueix9tOxJLL9txgCKXVmR4wLAtew\\u003dmo\"]]],4,null,\"Use it daily and was great. But hate the new pop up for speed cameras, it blocks half the screen so can't see the direction bit and stays up for ages. It also says it's a mobile speed camera but it's not, it's permanent. I tap the no longer there button but still pops up everytime. Can't seem to turn off in settings? Much preferred the old speed camera notifications.\",[1738889434,436000000],457,null,null,[\"107528035820287379841\",\"Erin Schwenke\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLkcg0BppZ7C3vV7aQzlRueix9tOxJLL9txgCKXVmR4wLAtew\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.05.02.719889437\",null,null,null,null,null,1],[\"b397730d-f1c5-41e8-9890-d42fdeb05af4\",[\"Dawn Koch\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWP4aL4ZOwHjlp3XmcIZvZVxLLP349KR9y2PLXrkOvgLEUhc1Y\"]]],1,null,\"When starting the directions, it gives the first verbal command but then that's it. No more audio instruction. Also, there's no longer a way to have it not come across Bluetooth in my car without disconnecting my phone from my car. Everything used to work fine until the last 2 months or so. Very frustrating.\",[1750444880,977000000],232,[\"Google LLC\",\"That doesn't sound good, Dawn. Try the steps in this guide to fix voice navigation problems: https://goo.gle/3PB32ZH. Hope this helps.\",[1750521123,859000000]],null,[\"117757609535460145235\",\"Dawn Koch\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWP4aL4ZOwHjlp3XmcIZvZVxLLP349KR9y2PLXrkOvgLEUhc1Y\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.24.01.768809388\",null,null,null,[true,false],null,1],[\"1e22767a-1218-404b-ab4b-0cb6a3c3825d\",[\"Raf Bini\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVt9O6BIaPrS_pkxDWiydT9n8FTqdTt0JDGkeCnRK7EmqtCDYY2\"]]],4,null,\"2 very annoying things with reviews: 1. when you use the separate ratings for \\\"rooms\\\" or \\\"food\\\" or whatever, then go back and edit the review, Maps deletes all the text that was in those boxes! 2. when you try to scroll down and click \\\"see all reviews,\\\" you can't because the nav buttons are covering the link. this is on a pixel 7, Google's own phone!\",[1752414663,25000000],380,null,null,[\"108601635299935409420\",\"Raf Bini\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVt9O6BIaPrS_pkxDWiydT9n8FTqdTt0JDGkeCnRK7EmqtCDYY2\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.28.03.779859351\",null,[[[\"vaf_apps_category_restaurant_v1\",[1]],[\"vaf_apps_category_food_and_drink_v1\",[2]]]],null,null,null,1],[\"d742a8e6-61bb-4942-aed8-fa3c59897d16\",[\"Andrew Watson\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKheQT7WtNjeNThQMySaDnBc2n-EMaexUf0Qxr07BWvKXUhsQ\\u003dmo\"]]],3,null,\"I don't know what happened, but Maps has been giving bad directions a lot more frequently in the past year than it did before. Often, the app will say something like \\\"use the second from the right lane to turn right...\\\". Well, that lane can't turn right, or that lane doesn't exist. It's unsafe at best. Worst, I've submitted multiple corrections over the past year and not one has been corrected. Other than that, the app works great and is easy to use. Just don't blindly follow it like so many do.\",[1762349657,300000000],579,[\"Google LLC\",\"We understand your concern, Andrew. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1762351331,968000000]],null,[\"109316015578503856443\",\"Andrew Watson\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKheQT7WtNjeNThQMySaDnBc2n-EMaexUf0Qxr07BWvKXUhsQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.43.03.821671396.W\",null,[[[\"vaf_never_display_ads_experience\",null,[5]],[\"vaf_never_display_ease_of_use\",null,[5]]]],null,null,null,1],[\"95b7e32d-81d2-4440-b28f-3452080146e4\",[\"David Sherman\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUf9KivnD8ax1au2wDfaUFtTuFJ4SR9JPu_WTDcgtsB1Lt0HS-5\"]]],1,null,\"Timeline is completely broken. History appears to be gone, and refuses to show my backups to import back in. No support available, despite many people reporting similar problems on the forums. Chat support has been no help. Frustrating when this was such a valuable tool. Also note: An error message sometimes comes up now saying tineline doesn't work on Android Go devices, but S24 Ultra is not an Android Go device.\",[1744688458,878000000],189,null,null,[\"100135444255064016682\",\"David Sherman\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUf9KivnD8ax1au2wDfaUFtTuFJ4SR9JPu_WTDcgtsB1Lt0HS-5\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.15.01.744474145\",null,null,null,[true,false],null,1],[\"8fb4a5aa-e01d-4bb3-b10c-6e95a9bb4811\",[\"A Google user\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],1,null,\"the recent update is not just causing issues with iOS. now Android users are not getting options for vehicles when starting navigation. it's defaulting to foot only and not providing options for switching to vehicle. I've tried this on an S24 Ultra with ONE UI7 and an X Cover 7 also with same OS. additionally the navigation ends on the other side of a block and requires one to walk to the other side when there are navigatible streets available right to the address. Not helpful.\",[1751961253,690000000],415,[\"Google LLC\",\"That doesn't sound good. If you're running into issues with Google Maps, make sure you are on the latest version of Google Maps: https://goo.gle/43EOVsN. If you continue to experience the issue, send us feedback here: goo.gle/43OR0Ce. Appreciate it.\",[1751986211,396000000]],null,[\"113943004123963956614\",\"A Google user\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.27.04.777251107\",null,null,null,null,null,1],[\"63eeecb5-298b-4134-a9bd-97a24fd58ddd\",[\"Brad Z\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKKv3kHrEWgvAr5eyu7P2NBKeKoahtPWK-807evZPMMJ7D7I30\\u003dmo\"]]],1,null,\"It's amazing what maps is capable of doing. Its disappointing that it only works sometimes. When I think I can depend on this app (Company) I an reminded, I am not the customer, I am the product. They don't serve me, I serve them. Timeline is completely unreliable. If you're going to include it as a feature, why not make sure it works reliably? Yes, I do understand why. Make improvements, not just changes! They are not the same.\",[1738776920,30000000],1047,null,null,[\"109901955335951775313\",\"Brad Z\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKKv3kHrEWgvAr5eyu7P2NBKeKoahtPWK-807evZPMMJ7D7I30\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.04.01.717552416.W\",null,[[[\"vaf_phase1_calling_businesses\",[3]],[\"vaf_estimating_arrival_time\",[3]],[\"vaf_rerouting_trips\",[3]]]],null,[true,false],null,1],[\"af18c769-2eee-4ee0-89a2-de864301de1b\",[\"Kailen Fitzgerald\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKQKoPNxRczF33Yd1-RlUpzV8068FzfJYruUT0pYobCShezxMF5\\u003dmo\"]]],4,null,\"The app itself works great, I've tried this and apple maps, this is definitely better. The only reason I didn't give it 5 stars is due to not being able to get away from the annoying Google voice. Soo many apps these days have a variety of voice and accent options, this has accent options but its essentially the same voice. The app's functionality is great otherwise except when it wants to take me down a gravel road when there is a paved option with basically the same drive time.\",[1752789251,535000000],520,null,null,[\"108278240759608848407\",\"Kailen Fitzgerald\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKQKoPNxRczF33Yd1-RlUpzV8068FzfJYruUT0pYobCShezxMF5\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.28.03.779859351\",null,[[[\"vaf_apps_category_restaurant_v1\",[1]],[\"vaf_apps_category_food_and_drink_v2\",[2]]]],null,null,null,1],[\"6e41bc45-c85e-48b4-beba-816479607999\",[\"Robert MacGregor\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKBBnupsf76czDA43ATh5_TeNji-zHfgFhafWOnj1p2hf1H\\u003dmo\"]]],2,null,\"Yes it generally works. Except when it doesn't. It frequently has you go a weird way around the block instead of just turning left. I've had it take me through a school campus service road instead of proper roads. It bothers you with notifications about lane closures, which is totally useless information. Yet if you come across a completely closed road, you cannot report it. The only things it should be asking is for cops and actual hazards like objects or flooding.\",[1760366201,90000000],325,[\"Google LLC\",\"Hi Robert, we would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of product experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1760398596,584000000]],null,[\"105324372300661470897\",\"Robert MacGregor\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKBBnupsf76czDA43ATh5_TeNji-zHfgFhafWOnj1p2hf1H\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.41.03.815390258\",null,null,null,null,null,1],[\"31b1f2c0-d8fc-4ab0-bf84-bc320fb1a182\",[\"IrishMash\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUWKYl-u6EO4vDsgtk6XpB9XO38VBIlv7TMHrxck79A4YNOYdE\"]]],2,null,\"Directions aren't always accurate. Map sometimes breaks and shows another area while navigating and will focus back on that area when the recenter button is hit. Also, where did street view go? pretty cool aerial view, but I work in utilities and sometimes need to see what is on the easement next to street but cannot seem to anymore.\",[1753385799,457000000],229,[\"Google LLC\",\"Hi there, we would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you https://goo.gle/3vosTcH. Hope this helps.\",[1753423183,918000000]],null,[\"112883186294161537235\",\"IrishMash\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUWKYl-u6EO4vDsgtk6XpB9XO38VBIlv7TMHrxck79A4YNOYdE\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.29.00.782600971\",null,null,null,null,null,1],[\"45f46c5a-da35-46ca-a308-fbe095823c38\",[\"Arielle Masters\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUkeju6i81CZxqYUUuYvZ5f_uUfS3oFkAdrt5O4tN6hU0Jf01o9NA\"]]],1,null,\"Despise Timeline being moved to devices. I have more than one account and more than one device. Do not want my data lost. Want it in one place. Want to be able to look back on my timeline to the beginning of my account. Directions: often bizarrely poor, as in: go 1+ exits past, turn around \\u0026 go back, then another u-turn. Or: get off at an exit ramp \\u0026 immediately back on. Or: square wave i/o straight drive. Won't let me tap on other roads I want to take. Doesn't remember my preferred routes.\",[1734255282,683000000],808,null,null,[\"105918208312701285697\",\"Arielle Masters\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUkeju6i81CZxqYUUuYvZ5f_uUfS3oFkAdrt5O4tN6hU0Jf01o9NA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.49.06.703287473\",null,null,null,[true,false],null,1],[\"b49f62e8-fa85-49cc-adc1-94a7091f4686\",[\"Stephen Matthews\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocItln_OZRjjSMpYGGljeOWvFS2iLI2GFTfnGEDT_Xs4MG-Ubg\\u003dmo\"]]],3,null,\"The app is way too needy, always wanting you to touch it, which is dangerous for bikers. It needs Way Points rather than destinations and an easy access pause button to stop it telling you GPS lost whilst you have a wee! And their response - not a single bit on the points I mentioned.......and there's your problem, developers who think they know better and don't listen!\",[1749531062,936000000],162,[\"Google LLC\",\"That doesn't sound good, Stephen. This article has some great tips on getting the most out of your location on Maps: https://goo.gle/3Q2acbB. Hope this helps.\",[1749527767,258000000]],null,[\"104497575100604517319\",\"Stephen Matthews\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocItln_OZRjjSMpYGGljeOWvFS2iLI2GFTfnGEDT_Xs4MG-Ubg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.23.04.765881323\",null,[[[\"vaf_apps_category_food_and_drink_v2\",[2]],[\"vaf_apps_category_restaurant_v1\",[1]]]],null,[true,false],null,1],[\"50cc4ae3-0175-4995-a7bb-2f0333d09fe8\",[\"Maurice Caler\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIW0k-ydvhGgDkaH-NSlUdz2E9SgquycLGYAUbhOqGdMu3cnV8\\u003dmo\"]]],2,null,\"It has become problematic and even dangerous. There are times when it tells me to turn now when I actually need to turn on the second street. Sometimes, it tells me to use any lane for a turn when I have to be in the left lane. It sometimes confuses deadend streets with through streets. The app sometimes has to be force quit to be reset. I am now testing alternatives.\",[1724539064,694000000],113,null,null,[\"113309938253696017573\",\"Maurice Caler\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIW0k-ydvhGgDkaH-NSlUdz2E9SgquycLGYAUbhOqGdMu3cnV8\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.142.0100\",null,null,null,null,null,1],[\"42db4933-5473-4edc-8870-b11b382980b4\",[\"Lady Lauki\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXWpVO-QJIaAFcSn9g6KwFyprD91nUhS640duTNYpyRBzuatISX\"]]],1,null,\"this app has really gone downhill over the last few weeks I constantly have issues where it's lagging behind or it tells me to do something I do it and then it tries to recalculate because that's not what it meant to tell me to do not to mention the fact that now the hands-free drive not to mention the fact that now the drive mode settings for Spotify / YouTube or voice commands no longer exist at the bottom of my screen. good job making this app less safe\",[1749430542,167000000],830,null,null,[\"117498689949164208470\",\"Lady Lauki\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXWpVO-QJIaAFcSn9g6KwFyprD91nUhS640duTNYpyRBzuatISX\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.22.00.763125252\",null,null,null,null,null,1],[\"6974b4de-82b6-4887-b1ea-be9880a9e0dc\",[\"Edward Wang\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWduf09izk8cOx8cwgtf8HMTo5av33d1SXzslDQDy75jfA5tf8_\"]]],3,null,\"Not a fan of the way the watch syncs offline maps with the phone. What ends up happening 99% of the time is that the watch takes forever to download the offline maps, continues to download the map even after disconnecting from the charger, and ends up draining an insane amount of battery as a result. I have to manually kill the app on the watch to stop the download.\",[1732153982,154000000],67,null,null,[\"114862135290132415165\",\"Edward Wang\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWduf09izk8cOx8cwgtf8HMTo5av33d1SXzslDQDy75jfA5tf8_\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.155.0101\",null,null,null,null,null,3],[\"4dc6b3b3-51a8-464f-a9ed-5fac45c39f5e\",[\"Tracey Wallace\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXUx7cusoM6jSGoTpEU74O1PAEws5PczruuFUSxCLkf2s0Y7iQepQ\"]]],2,null,\"Music while driving went away :( Please bring it back!! First it was radio apps that were removed earlier this year, and now the Spotify button is gone. Also, picture-in-a-picture is turned on in my settings, but that's not working either. Please fix these things!!\",[1753287391,405000000],203,null,null,[\"100241334753577408693\",\"Tracey Wallace\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXUx7cusoM6jSGoTpEU74O1PAEws5PczruuFUSxCLkf2s0Y7iQepQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.29.00.782600971\",null,null,null,null,null,1],[\"cce90083-20d8-49b3-807e-3f6bce3f3dc5\",[\"Grace McCarter\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX8S438KIKLmlFucdl-19Iq1pdJoXJqj6J77Jc67pVGWXsViCkN\"]]],1,null,\"Most of the time when I open it it doesn't load, it's just a plain blank screen and hangs there for as long as it takes for me to get frustrated and close and relaunch. If there's not an update soon I'll be forced to try different apps. It's a shame as this is what I'll open first to find places to eat.\",[1725803004,704000000],104,null,null,[\"115080186614807645069\",\"Grace McCarter\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX8S438KIKLmlFucdl-19Iq1pdJoXJqj6J77Jc67pVGWXsViCkN\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.144.0105\",null,null,null,null,null,1],[\"e39ee07e-a15c-40a9-8c3c-58c5e17fa42c\",[\"Daniel Wood\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIAJIQ9BhNt1PkOZHZveMtD9v9K2eFTrPIlJGtIHUuzihsVPg\\u003dmo\"]]],1,null,\"keeps freezing and becoming unresponsive. I've had to pull over to restart the app whilst driving. Keeps running even once you've reached your destination. And some idiot thought it would be a good idea to ask you if you want to change the arrow icon to a toy car, while you're driving through a busy city?!\",[1724058662,399000000],124,null,null,[\"116718143406049007753\",\"Daniel Wood\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIAJIQ9BhNt1PkOZHZveMtD9v9K2eFTrPIlJGtIHUuzihsVPg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.141.0102\",null,null,null,null,null,1],[\"5f89968f-ba33-4508-9162-f756480df26c\",[\"Ethan Ryans\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUWm3Iu5mF_nR2NYh1r7q3xFHf99hvgH_2Jis4TEGBLMKN7OmEu\"]]],1,null,\"Trash! App won't start right away 100% of the time. I've to literally force close the app up to 10 times, sometimes more just for maps to load! Makes this completely unreliable for navigation when I have to pull over, sit there and wait to figure out exactly where I'm going.\",[1728647003,920000000],109,null,null,[\"117554051537434906692\",\"Ethan Ryans\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUWm3Iu5mF_nR2NYh1r7q3xFHf99hvgH_2Jis4TEGBLMKN7OmEu\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.149.0101\",null,null,null,null,null,1],[\"b67de42a-37cb-4afb-9923-872bb2c11e3b\",[\"James Hawthorne\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLmlShLdBSBaBbUjX0ZcYunWTNaB1iIPryDxj2RLQf3cFh5LQ\\u003dmo\"]]],3,null,\"updated 21 May 2025 routes still using off ramps on ramps to by pass traffic. the still not showing alternative routes while driving. We used to use that feature a lot. when driving see alternate route was great, if it showed route going through town and another that does not but the route not through town is 4min slower I would take the slower out of town because through town generally is slower in the end. also not sure why traffic alerts shows speed/stop cameras as police instead of camera\",[1748053930,245000000],143,[\"Google LLC\",\"That doesn't sound good, James. Thanks for the feedback, we really appreciate it! We will pass it on to the right team.\",[1745576150,184000000]],null,[\"111809215383291616551\",\"James Hawthorne\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLmlShLdBSBaBbUjX0ZcYunWTNaB1iIPryDxj2RLQf3cFh5LQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.20.03.757436837\",null,null,null,[true,false],null,1],[\"3ea3f9cc-0888-402a-b4ea-c094e155e3f1\",[\"Raven Anne\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJO992Ts9yDJBd2kuXEM0DIu5pb1EK0V2oWMVJhNwmGZPHjJA\\u003dmo\"]]],1,null,\"Updated to add \\\"features\\\" it already had and removed others. You now can't view another route while on a \\\"trip\\\". It no longer vibrates to warn you of your stop when bussing. The priority feature is non functional. Menus clip where the didn't before. You get a huge \\\"trip started\\\" notification that doesn't go away for soooo long and blocks things. Notifications are blank 2/3 of the time. Notifications that do work show the wrong bus time. Why? (8/08/24-23/0/7/25) Nearly a year later, no fixes.\",[1753254218,688000000],326,null,null,[\"102224328391281693634\",\"Raven Anne\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJO992Ts9yDJBd2kuXEM0DIu5pb1EK0V2oWMVJhNwmGZPHjJA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.29.00.782600971\",null,null,null,[true,false],null,1],[\"1b894f4b-b742-4776-826f-286551370f11\",[\"Alicia Perez\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLAqiSjKuVAJHcUdehltJXs0vfqwhyfXiJ1hn35phe3ZbhD\\u003dmo\"]]],1,null,\"Since the recent Google Maps update, when I have toggled on the media playback controls the overlay is partially covering the Report Button. The new media playback UI has smaller text and I struggle to read the name and artist text when my phone is mounted on my car dashboard. The previous media playback UI had bigger text that was easy to read at a glance. Please consider making the text bigger.\",[1744844053,808000000],161,null,null,[\"112423412396634594025\",\"Alicia Perez\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLAqiSjKuVAJHcUdehltJXs0vfqwhyfXiJ1hn35phe3ZbhD\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.15.01.744474145\",null,null,null,[true,false],null,1],[\"590f8cf1-ba17-4d13-bf24-341e5980a27a\",[\"Gage Hvarre\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWVL5H8dz3KUec5F5I1RL3AMRkFRIQg5e-6htensdGFBeGDxSU\"]]],1,null,\"terrible, I spent so long to figure out how to set it to \\\"walk\\\" instead of \\\"drive\\\". You used to be able to change that when you already started your navigation, and now it's only available to be switched when you're only in the direction fase. why???? it just makes it harder to use for no reason. I'm tired of this monopoly that Google is. maybe if they had real competition, they'd put in the work to make their platforms enjoyable to use.\",[1746220970,119000000],270,null,null,[\"108008079184044911268\",\"Gage Hvarre\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWVL5H8dz3KUec5F5I1RL3AMRkFRIQg5e-6htensdGFBeGDxSU\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.14.00.742022593\",null,[[[\"vaf_apps_category_restaurant_v2\",[2]]]],null,null,null,1],[\"0f8bf870-ecc2-47da-bf42-d1d0bce83acd\",[\"CAPTAIN SLACKBEARD\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVU24L-qClifI8lizraLPh0CpFyBsmEIqGO8YZEQwA-DnMaV8k\"]]],1,null,\"This is supposed to be Google MAPS not Google Reviews. I don't need to know about reviews I've left for businesses that I have visited when I'm trying to find the closest hospital in an emergency situation. That should be an entirely different app, or a secondary option AFTER the maps option. Also, that notice upon opening the app about how posts appear needs to go away. Just another step to have to go through that takes time from a possible life threatening situation.\",[1740512467,268000000],229,null,null,[\"107414625870759293495\",\"CAPTAIN SLACKBEARD\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVU24L-qClifI8lizraLPh0CpFyBsmEIqGO8YZEQwA-DnMaV8k\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.08.01.727565367\",null,null,null,null,null,1],[\"858d8596-d293-487e-b507-696b9b32a828\",[\"Binny Rose\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI5VICUuJWqBdiD1EhsDdgHOwQo3_dZ10HJsD0S1E2ka39J\\u003dmo\"]]],3,null,\"Usually gets me where I need but has the same issues, even after updates: 1. Voice guidance frequently not early enough to make turns in time 2. Directs drivers wrong way down one-ways and through dead ends that aren't recent changes 3. Can't report road hazards/closures unless actively driving, which is impossible in a hands-free state 4. Lowers volume of music from other apps during voice guidance and gets it stuck low until after 2nd song (experienced with different phones and music apps)\",[1750854066,37000000],194,[\"Google LLC\",\"That doesn't sound good, Binny. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you https://goo.gle/3vosTcH. Hope this helps.\",[1750880544,692000000]],null,[\"102035799405906088245\",\"Binny Rose\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI5VICUuJWqBdiD1EhsDdgHOwQo3_dZ10HJsD0S1E2ka39J\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.25.00.771187166\",null,[[[\"vaf_apps_category_food_and_drink_v1\",[2]],[\"vaf_apps_category_restaurant_v1\",[1]]]],null,null,null,1],[\"9ffb1a0e-3124-4cd6-b9e6-1920174269ec\",[\"Dennis Hoage\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIFo7UWhWZdNavNSrz8AhFFfvuixx26242ma2L8v3V9bOOR4A\\u003dmo\"]]],1,null,\"2 new problems. Report popups (police,disabled vehicle,congestion) are dangerous-a huge banner now blocks the next step in navigation \\u0026 trying to dismiss them while driving is just asking for an accident. Then removing Timeline from web-this was a great way to track my time at jobs. Now it's gone. Seriously Google, what are you thinking? Previously my gripe was not having the option to indicate whether you drive a commercial vehicle/truck as some states restrict access on certain roads/hwys. 👎\",[1734926436,7000000],699,[\"Google LLC\",\"Thanks for the review, Dennis! Submitting this as a feedback report: Open Maps - Side menu - Send feedback - Your opinions about Maps - Submit, will help us ensure that this gets reviewed by the right team.\",[1539230480,341000000]],null,[\"111658703550329801266\",\"Dennis Hoage\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIFo7UWhWZdNavNSrz8AhFFfvuixx26242ma2L8v3V9bOOR4A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.49.01.704458091.W\",null,[[[\"vaf_automatic_re_routing\",[2]],[\"vaf_phase1_commute_alerts\",[1]],[\"vaf_seeing_photos_of_places\",[1]]]],null,null,null,1]],[null,\"Cr0BIrQBAXtFU-sqzIysg7I73N89aVipbzuYEekmEgCRSE3SbMeK0I9fBCWyyzoLSJWwdKMyldJJ5lIxDnXCYUQd51QG091vyQz_aIt6PkeFeySf7JAqkowwqQ0pCdp-qlealIsLjr9HyhWO27gUPyRxzQS4GShAFNKVHYbv1jsxQZXQ0Ah8-BGOfYM7m2ItvoxVNnRWffsQoscle-_B_Sn1UcrSl5cNTmgfeIWYWNe-TXJe_4YE2NjhKNKUvdQG\"],[[null,[[1800],null,[72000]]]]]",null,null,null,"generic"],["di",131],["af.httprm",130,"-8718533897520642360",19]]