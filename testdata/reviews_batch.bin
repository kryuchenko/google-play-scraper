)]}'

[["wrb.fr","oCPfdb","[[[\"21360732-d8b6-40bf-bb27-06be083512e5\",[\"Spencer Cashdollar\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVf1rTQ-rxyWFyO15cU9UXDYMNnnD3RwCaSnJRmVDLqZua4JV4IYw\"]]],1,null,\"i don't know how an app like this manages to become worse with every update. nearly useless at this point, you're better off with a paper map. Today it routed me to the middle of an interstate, nowhere near an exit, and said I'd arrived at my destination. A few days ago it only offered one route through backroads no matter how many times i tried to hit the alternate route button. I took the highway route i already knew, and unsurprisingly got there in less time and distance. Absolute Trash 0/5 ⭐\",[1776805245,167000000],16,null,null,[\"109430057684136752920\",\"Spencer Cashdollar\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVf1rTQ-rxyWFyO15cU9UXDYMNnnD3RwCaSnJRmVDLqZua4JV4IYw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.15.01.894202351\",null,[[[\"vaf_never_display_disruptive_ads\",[2]]]],null,[true,false],null,1],[\"da379234-c054-4688-9880-7c00374f5085\",[\"Nikola Stojanovic\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL_irsjMd2UaJuRNw13pNcnelv52XK1wIBtNAhsaRvFs615gQ\\u003dmo\"]]],2,null,\"I just got the new android update, and notification no longer shows total miles left, nor the time of an arrival, and it doesn't pop up when you're approaching a turn anymore! Please bring it back!! Edit: More than 2 months later, still no fix. I depended on this feature for almost a decade for my work. It impacted my work life a lot.\",[1751301539,130000000],1524,[\"Google LLC\",\"Hi Nikola, thank you for your suggestion. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1744664235,683000000]],null,[\"114723512165439872185\",\"Nikola Stojanovic\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL_irsjMd2UaJuRNw13pNcnelv52XK1wIBtNAhsaRvFs615gQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.26.04.774458481\",null,[[[\"vaf_phase1_in_app_rewards\",[1]],[\"vaf_points_of_interest\",[1]],[\"vaf_turn_by_turn_navigation\",[1]]]],null,[true,false],null,1],[\"4dd5ed4c-0ba6-4721-90f4-001138770bda\",[\"Kris McQ\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVctNZE5K4TkRlu57SMPbrORY9NI6_upCg46PDY32lIgNx6kEAj\"]]],1,null,\"I work out a map on my laptop because my phone won't let me edit it to the specific roads I want to take, and then my phone changes it anyway? Even if sent directly from the laptop? Also, even if I do set it how I want, sometimes the AI decides to change it while driving because it's \\\"faster and more efficient\\\" and it forces you to click to keep it how you want, but I can't exactly do that while flying down the highway. Like I didn't have my route set a specific way intentionally. Awful app.\",[1731689210,34000000],1626,[\"Google LLC\",\"That doesn't sound good, Kris. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: https://goo.gle/3vosTcH. Hope this helps.\",[1731693258,816000000]],null,[\"112962053705447738664\",\"Kris McQ\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVctNZE5K4TkRlu57SMPbrORY9NI6_upCg46PDY32lIgNx6kEAj\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.154.0104\",null,null,null,null,null,1],[\"eb84e0fe-3520-4344-9329-38672ee40854\",[\"Rachel Patrick\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV23e3Qa_4RWaN9_YfyFV0NlHrTE_GtAvIi0sK0BU-Tovg1LoDj\"]]],2,null,\"The app is unusable. No matter where I'm going it will take me the most backward, long way to get me there. Sometimes even the wrong way altogether. Even right here in town it's has 3 specific streets it dictates you to take no matter where you're going, which are nowhere Near where you're trying to get. There's no way to select a 'shortest' vs 'quickest' route. I've done everything I can. Turned off all the gas saving, toll settings, avoid highways, hob settings, cleared maps cache.\",[1762203943,100000000],2006,[\"Google LLC\",\"Hi Rachel, we would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of product experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1762216180,726000000]],null,[\"112582932550993368162\",\"Rachel Patrick\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV23e3Qa_4RWaN9_YfyFV0NlHrTE_GtAvIi0sK0BU-Tovg1LoDj\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.43.04.821534312\",null,[[[\"vaf_never_display_ease_of_use\",null,[2]]]],null,null,null,1],[\"3e8d43fa-5d70-478d-a36a-c4e97532f29c\",[\"Millwood Naturals and Organics\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUw8IX33ESzL4U7FtbO-PHcNBk2SyBXc3TpIJgEu6dIGQq7OeVZ\"]]],1,null,\"Keep rerouting without notifications. I've had so much anxiety associated with this app that I've cried. Wasted so much gas going in circles, outdated routes, unpaved roads, long routes despite making preferences. Have to run three different apps just to make sure I'm not rerouted. Just use an Atlas. These apps are full of ads and won't allow usage of the Internet to drive as it consumes so much data. Not worth the headache\",[1734881208,90000000],592,null,null,[\"102502574718517594899\",\"Millwood Naturals and Organics\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUw8IX33ESzL4U7FtbO-PHcNBk2SyBXc3TpIJgEu6dIGQq7OeVZ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.49.06.703287473\",null,null,null,[true,false],null,1],[\"59c1ade9-6cdb-4584-a3a9-a93250995a0c\",[\"Jenica Pitts\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXGPAWvFoC9xD438aAn3qthqS19aG-TQGKt8bJ0KmEqjIfJisjd\"]]],4,null,\"I use this all the time, and it works pretty well. occasionally it crashes my phone, but so do a lot of apps on my phone (it's old). My only complaint is that they removed the ability to have the Maps voice synced to your assistant voice. I personally use the Green voice, and when I went to navigate, I was greeted by the regular Google voice(which I don't like quite as much as Green). please bring back the ability to use the different voices for Maps, I don't like the regular English one\",[1750117847,563000000],2575,null,null,[\"118087977187191656102\",\"Jenica Pitts\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXGPAWvFoC9xD438aAn3qthqS19aG-TQGKt8bJ0KmEqjIfJisjd\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.24.01.768809388\",null,[[[\"vaf_apps_category_food_and_drink_v1\",[3]]]],null,null,null,1],[\"f66b94d1-bee5-422d-b1f4-a8dbd995909f\",[\"Janette Stevens\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLXKEyEPYhMtMpGGHW-P_wxN4NS0Ni-TBaT0fmj6OYGswPXDg\\u003dmo\"]]],1,null,\"This app is not as good as it has been in the past. It will avoid a red light and take you down back roads where you have to cross a four lane road during rush hour to continue to your destination. The speed limit option is way off. Clarksville TN lowered some of the speed limits months ago, and google maps still hasn't been updated. Also, it will have you going thru a subdivision where the speed limit is definitely 30, and the app states 55! Sometimes, it takes you the most roundabout way.\",[1747742975,140000000],1691,[\"Google LLC\",\"We understand your concern, Janette. Thank you for your feedback. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1750414910,955000000]],null,[\"113460937198779718017\",\"Janette Stevens\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLXKEyEPYhMtMpGGHW-P_wxN4NS0Ni-TBaT0fmj6OYGswPXDg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.20.01.757436837\",null,null,null,null,null,1],[\"92227abd-bb85-4568-804f-1e44bf733e86\",[\"Jacqueline Jarrett\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVQPYojzpvH-RujCxCRILVb6exRX7NdSCp_kZF4RRv4zJphXLTG\"]]],2,null,\"I always use Maps and it usually works just fine, but with the new updates, it's removed my Spotify entirely and when I go to settings with the Night color scheme, the text is unreadable. When I roll back the updates, Spotify works like normal, but trying to get it to work with the jew version is impossible, despite following advice on how to fix it. Edited to add that now it won't switch back to the voice I use for my assistant, instead using the generic default voice.\",[1742059229,893000000],642,[\"Google LLC\",\"Hi Jacqueline. Let's try these steps: Settings \\u003e Navigation settings \\u003e Assistant default media provider \\u003e Select/Link Spotify music player. If that doesn't help, please create a post in our Google Maps forum so that our community of product experts can assist you goo.gle/3vosTcH. Hope this helps.\",[1742082706,572000000]],null,[\"110037317064494430594\",\"Jacqueline Jarrett\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVQPYojzpvH-RujCxCRILVb6exRX7NdSCp_kZF4RRv4zJphXLTG\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.10.04.732665141\",null,null,null,[true,false],null,1],[\"6310ee45-a746-43b1-a719-a473782b170b\",[\"William Neu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX8RRbzBoUA62Dzr7tSIxSioAr8NLDEG_diAvFVJcGDpWI6ulI\"]]],1,null,\"Honestly it feels like I'm fighting with phone anytime I try to use my phone while trying to find an address, whether it's typing in addresses only for it to suggest someplace 30-40 miles away when it's only a mile away. The suggested places are irritating because I'm looking for a specific business. Or you try to change the route and accidentally tap to close to a town name so it's gotta bring up info on that. Now the screen stays on and follows you after you've gotten to the place you were goi\",[1743946586,531000000],797,null,null,[\"103555249895500214178\",\"William Neu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX8RRbzBoUA62Dzr7tSIxSioAr8NLDEG_diAvFVJcGDpWI6ulI\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.13.06.739783266\",null,null,null,null,null,1],[\"fbb33332-a40b-4e87-aa63-ae3d6472ffa9\",[\"Milan Puscas\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLjwq5Gyyh8okR-HY-FvJmCSYp8jA9RorlcgYNvIDt8C_HoWA_t\\u003dmo\"]]],1,null,\"Sometimes the calibration is off and shows that I am going a completely different direction from the direction I am actually traveling. If I am in an unfamiliar area, it is extremely stressful having the map lag and not orient itself to reflect the path I am actually traveling. This doesn't happen all the time, but it is significant enough for me to consider using a different app that is more reliable.\",[1728398360,235000000],389,[\"Google LLC\",\"We understand your concern. This article has some great tips on getting the most out of your location on Maps: https://goo.gle/3Q2acbB. Hope this helps.\",[1728411479,197000000]],null,[\"102103845362968635772\",\"Milan Puscas\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLjwq5Gyyh8okR-HY-FvJmCSYp8jA9RorlcgYNvIDt8C_HoWA_t\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.148.0700.W\",null,null,null,[true,false],null,1],[\"5a6edbd9-9ab5-45a5-8496-784df1de5124\",[\"Suzy Spurgeon\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLZSifIVS4YBnyMaOwRxFeB3fKkAdCnNAH8dnX4YknlWEhzSg\\u003dmo\"]]],1,null,\"It just keeps getting worse. The app keeps turning on my Do Not Disturb. Not bad when im driving but it dose it when I'm the passenger. Ugh! They need to fix what they broke during the last update. Maps not turning off, keyboard not being displayed, and several other issues. I'm not the only one. Several friends with different phones are experiencing the same issues. Never had these issues till the update they did around the end of June.\",[1737490141,407000000],1090,null,null,[\"114916202470486663729\",\"Suzy Spurgeon\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLZSifIVS4YBnyMaOwRxFeB3fKkAdCnNAH8dnX4YknlWEhzSg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.02.04.714794535\",null,null,null,[true,false],null,1],[\"925ca99e-986d-4d1a-9af9-68749626b739\",[\"Chris Moeller\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVQJmrFKtIszTEBcburA23ccPvDGzeAMdK_21UIOldZt2BbcyJM\"]]],2,null,\"Very buggy lately, changes directions while driving. Just recently it'll tell me to take a right, then switch to a left when I get in the right lane at a stop light. it's re-routed a straight line 2 miles to going in a square to get to the same destination, only after being on the road. getting dangerous to use it, shouldn't change directions without confirming mid drive. pixel 8 pro\",[1754498078,304000000],1085,[\"Google LLC\",\"That doesn't sound good, Chris. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: https://goo.gle/3vosTcH. Hope this helps.\",[1754501140,957000000]],null,[\"106737729035725301803\",\"Chris Moeller\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVQJmrFKtIszTEBcburA23ccPvDGzeAMdK_21UIOldZt2BbcyJM\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.30.03.785163646\",null,null,null,[true,false],null,1],[\"8990a3ec-ffbd-451a-a0f0-93d0e985fa77\",[\"Alexis Winters\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUyH56V8SftwAdnLGVASA0hywkQn84CpEQhL-S86iXtTlbVa29CIA\"]]],1,null,\"Once I find another navigation app to use, I'm switching to it. Google Maps has a horrible \\\"feature\\\" that changes your route mid-trip and you won't even know it. Just to \\\"save\\\" you 1 minute of driving time, and it usually ends up being about 10 extra minutes of driving time. There used to be a feature where they'd ask if you'd like the alternate route and now it's simply automatic, no asking at all. Which of course, allows for people to get lost or stopped by a train on a side road.\",[1779904994,367000000],4,[\"Google LLC\",\"Hi Alexis, thank you for your suggestion. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look. Appreciate it.\",[1779928934,197000000]],null,[\"106945678577506459455\",\"Alexis Winters\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUyH56V8SftwAdnLGVASA0hywkQn84CpEQhL-S86iXtTlbVa29CIA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.01.916832833\",null,[[[\"vaf_app_quality_ads_frequency\",[2]],[\"vaf_app_quality_visual_appeal\",[1]],[\"vaf_app_quality_ads_intrusiveness\",[2]]]],null,null,null,1],[\"1cb37e10-f9f3-474d-9607-b5b2dd93060f\",[\"Doug Simpkins\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUBiU6ynrIZc1525qa3wkHcJwS-lCwlNBxB6B8SrtsRdk5JR9xV\"]]],2,null,\"If you don't have any other gps apps on your phone, this can suffice, but it's extremely problematic. It'll change your route without your knowledge or consent. It's lied to me (traffic jam backup for miles, told me the road was closed and tried to reroute me, kept going and turns out it was just a traffic jam). Tried to take me onto a private road (complete with fence), all sorts of stupid stuff. You can use it but watch out for any number of technical deficiencies.\",[1780173943,815000000],3,[\"Google LLC\",\"We understand your concern, Doug. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1780187049,275000000]],null,[\"100688204580947495144\",\"Doug Simpkins\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUBiU6ynrIZc1525qa3wkHcJwS-lCwlNBxB6B8SrtsRdk5JR9xV\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.01.916832833\",null,[[[\"vaf_app_quality_ads_presence\",[2]]]],null,null,null,1],[\"c8c8deb1-8835-4c9b-b79d-3e061245f1b2\",[\"Add A\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKCeE9aRimLnLbQ4kL4ortjnG-vUqv4ZtSE6blA5W_EvC0jew\\u003dmo\"]]],2,null,\"Decent for travel, not for dining. The traveling assistance is good. The dining information provided by the AI is terrible. One minute a restaurant is not too busy, the next it's the busiest it's ever been! I few places have even been marked \\\"open\\\" but are on fact closed or even closed down and the reverse is the same. I don't need Gemini also taking the initiative when in having a conversation with my wife while driving. I wish I could turn the AI off. I just want directions.\",[1779743501,884000000],2,null,null,[\"114331741148104338529\",\"Add A\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKCeE9aRimLnLbQ4kL4ortjnG-vUqv4ZtSE6blA5W_EvC0jew\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.19.06.908805368\",null,[[[\"vaf_app_quality_battery_efficiency\",[1]],[\"vaf_app_quality_ads_frequency\",[1]],[\"vaf_app_quality_ads_presence\",[3]]]],null,null,null,1],[\"4debebfd-9b52-4a14-b8c1-15bdab0c0a82\",[\"David Missey Jr\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU_ORw4cjIqWO6-fuJYagOSb-WHVXdpye50g0Gtmf-i60zSYbG50A\"]]],2,null,\"the location tracking sucks and the chick telling me where to go needs to tell me sooner and stop telling me to turn \\\"right now\\\".. (into the woods, oncoming traffic etc), the rerouting is ridiculous! instead of telling us to turn around if we miss a road, Google maps tries to take us around the city instead of going 1000ft or whatever back to turn at the correct place. maps used to be tha bomb, I'm not impressed anymore. Especially with the advancement of technology... it went backwards🤷\",[1780191593,552000000],3,[\"Google LLC\",\"That doesn't sound good, David. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1780219798,525000000]],null,[\"108467411053112900542\",\"David Missey Jr\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU_ORw4cjIqWO6-fuJYagOSb-WHVXdpye50g0Gtmf-i60zSYbG50A\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.02.916832833\",null,[[[\"vaf_app_quality_ads_frequency\",[2]],[\"vaf_app_quality_battery_efficiency\",[3]],[\"vaf_app_quality_performance\",[2]]]],null,[true,false],null,1],[\"a793d3c7-2ee6-4379-b293-b12a42828333\",[\"Jack Hallveld\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ6VVRmlbb6HEic2MTb3pqFad-EU9QU-myQplEFXGG11GSpLQAK\\u003dmo\"]]],3,null,\"It goes without saying that I use Google Maps all the time, but there are several ways I wish it were better: *Higher contrast color schemes. *Better labeling so you don't have to scroll all over the map to figure out what a street / trail is named - including during navigation. *A setting to avoid crossing international borders.\",[1779562801,444000000],6,[\"Google LLC\",\"Hi Jack. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look. Appreciate it.\",[1779586892,980000000]],null,[\"107539035667151531020\",\"Jack Hallveld\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ6VVRmlbb6HEic2MTb3pqFad-EU9QU-myQplEFXGG11GSpLQAK\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.20.01.913318892\",null,null,null,null,null,1],[\"138adef9-628e-405d-a1e0-6dfad2457c77\",[\"Eli\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK_7P5dfVVyGIlmhCdqhdcZ6u20YTPbQIJEVGT8gtt-LKXd\\u003dmo\"]]],1,null,\"I often use the app to look up times that a business is open. There's no option to turn off the new \\\"Know before you go\\\" AI feature, which seems to have replaced the list of hours a business is open. The Popular Times widget is still there, but after trying to select any other day it just snaps back to today. It's finally time to find an alternative.\",[1779635294,942000000],4,null,null,[\"103846093267401593638\",\"Eli\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK_7P5dfVVyGIlmhCdqhdcZ6u20YTPbQIJEVGT8gtt-LKXd\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.20.01.913318892\",null,null,null,null,null,1],[\"c13f9d96-56e7-496c-9789-e080e95cc096\",[\"Katrina Steele\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVB6Uty32XRbQWkV1UQNoF3daBKrKgzjvjyW8XrFyGB6OcfVj0\"]]],1,null,\"This was my favorite map app. Now, since the \\\"update\\\" I guess, ariel and street view, no longer work. What used to show me actual buildings and landmarks is no longer there. It just looks like a plain, old fashioned, paper map...if I wanted to still use those, I wouldn't need google maps. Oddly though, the 'lite' version, \\\"Google Maps Go\\\" still displays street view.....\",[1780281452,16000000],3,[\"Google LLC\",\"That doesn't sound good, Katrina. Let's give these steps a try, clear cache and uninstall the updates: https://goo.gle/3rF6Ewz. If you continue to experience the issue, send us feedback here: goo.gle/43OR0Ce. Appreciate it.\",[1780306575,759000000]],null,[\"108292984876910341488\",\"Katrina Steele\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVB6Uty32XRbQWkV1UQNoF3daBKrKgzjvjyW8XrFyGB6OcfVj0\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.01.916832833\",null,[[[\"vaf_app_quality_battery_heat\",[2]],[\"vaf_app_quality_ads_intrusiveness\",[2]]]],null,[true,false],null,1],[\"3d323612-acbd-4889-b9c4-01298a7efd11\",[\"Duy Do\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK2iyASQdpQdmO9t1tD73nhXoFIk5FbopAFYxD0aOdD4pN0fw\\u003dmo\"]]],1,null,\"This app's search results include deceptive sponsored results. They cleverly place ads at the top, varying when they appear so you don't build a habit of skipping them. They rely on you being in a hurry and not paying attention. This predatory design wastes your time, gas, and money. For example, a quick search for Costco pulls up Sam’s and Walmart first. Clicking the top result thinking it's the closest Costco but instead routes you to a competitor 20 miles and 15 minutes away.\",[1779513331,667000000],6,null,null,[\"118017451454996178276\",\"Duy Do\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK2iyASQdpQdmO9t1tD73nhXoFIk5FbopAFYxD0aOdD4pN0fw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.20.01.913318892\",null,null,null,[true,false],null,1],[\"305ffe5b-b8bf-4e3e-a2f1-7e9922d420d0\",[\"akumarie K\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUt2u1p51z9mFCBmEeU-DvkW_0cRZM0vLMZni1u_lEuKeUZWfBIgQ\"]]],1,null,\"This app in 2 years is broken in every way possible. It takes you through long-winded paths when the destination could be right in front of you, glitches constantly and takes you to opposite direction, the map drifts off from your location so you can't even see where your at, autocorrects to the wrong destination when you put it in the search bar (took me to a completley different store on the other side of town), and shuts down randomly while driving. It's like they're trying to cause accidents\",[1779980160,695000000],7,[\"Google LLC\",\"Hi there. Let's give these steps a try, clear cache and uninstall the updates: https://goo.gle/3oW0tVa. Also, please create a post in our Google Maps forum so that our community of experts can assist you https://goo.gle/3vosTcH. Hope this helps.\",[1710311986,624000000]],null,[\"108770195767187265554\",\"akumarie K\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUt2u1p51z9mFCBmEeU-DvkW_0cRZM0vLMZni1u_lEuKeUZWfBIgQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.20.01.913318892\",null,null,null,[true,false],null,1],[\"75a5318a-c58e-42c8-aea4-61207bff37a7\",[\"S D\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLeSgsDrsd2-UxFio8uk2JwFfcfox0eQOvEdO5_lpbAh8MtnA\\u003dmo\"]]],1,null,\"The directions provided by this app are inaccurate and difficult to follow. Additionally, it frequently reverts to the original route, making it unreliable for navigation. I would strongly recommend using an alternative navigation app, such as Apple Maps. They also take me to locations that are closed, saying they're open, then when I report them as closed, you're telling me it's closed? Excuse me?\",[1780160014,818000000],4,[\"Google LLC\",\"That doesn't sound good. If you're running into issues with Google Maps, try the troubleshooting steps here: https://goo.gle/43EOVsN. If you continue to experience the issue, send us feedback here: https://goo.gle/43OR0Ce. Appreciate it.\",[1779895082,556000000]],null,[\"114705867102009813035\",\"S D\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLeSgsDrsd2-UxFio8uk2JwFfcfox0eQOvEdO5_lpbAh8MtnA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.01.916832833\",null,[[[\"vaf_app_quality_performance\",[2]],[\"vaf_app_quality_ads_presence\",[2]],[\"vaf_app_quality_battery_efficiency\",[1]]]],null,[true,false],null,1],[\"539ebc3b-79d0-4e52-979c-cd0bb101be64\",[\"Justin White\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV1FO6YfQMe68r-D-wSW6xbh4GnSTHlkOkwe7g8Dyb2FUnPqR_W\"]]],1,null,\"this app used to be so great and I don't know what happened to it but recently it's been saying I'm an offline mode even though I'm connected to Wi-Fi. It seems like once you run out of cellular data from your carrier and a throttle you the maps app totally flops on its face and even with Wi-Fi it remains an offline mode. hopefully there's a fix for this soon but I suggest other people look in the other maps apps in the meantime. if you run out of cellular data like I did you will get stranded.\",[1780533690,333000000],2,null,null,[\"109848307022022037545\",\"Justin White\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV1FO6YfQMe68r-D-wSW6xbh4GnSTHlkOkwe7g8Dyb2FUnPqR_W\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.01.916832833\",null,[[[\"vaf_app_quality_ads_frequency\",[2]],[\"vaf_app_quality_ads_intrusiveness\",[2]],[\"vaf_app_quality_ads_presence\",[2]]]],null,null,null,1],[\"12e3e05e-dfe2-4d28-8865-f43db5c81e35\",[\"Michael Lehmann\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVArgLtYvzoiWeEoD8ur70m4SYpzCaA7xKBZ7BE_FnG6hdxUNrt\"]]],3,null,\"Most of the time it is great, but it really sucks for driving on base sometimes directing you to hazardous offroad trails when there is a safe road nearby. A lot of the unrestricted roads for on base are missing or chopped up. I often have to use the Iphone program through my browser because of these issues. I've tried logging them into the system or make corrections but they have mostly been dismissed.\",[1780269968,266000000],3,null,null,[\"112765338983255008687\",\"Michael Lehmann\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVArgLtYvzoiWeEoD8ur70m4SYpzCaA7xKBZ7BE_FnG6hdxUNrt\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.22.04.920688788\",null,[[[\"vaf_app_quality_ads_frequency\",[3]],[\"vaf_app_quality_usability\",[3]],[\"vaf_app_quality_performance\",[2]]]],null,null,null,1],[\"aac18786-c7de-477d-a065-f04e9e4f30eb\",[\"Melissa D\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUoxL8tOWPXVdjnnqwYvfU37h8ZsC4Rg0dGtaI002bOLR187Jkh1Q\"]]],2,null,\"Never thought I'd be hating on Google Maps. Been using it exclusively for YEARS. Within the last month, it has taken a turn from being the unsung hero to being a villain. Over the course of a week-long vacation, it has taken us through unnecessary loops on foot and while driving. Additionally, it told us to turn at very nondescript businesses (turn at the Longhorn Steakhouse - which is situated behind trees and has no sign). What the heck is happening to this app???\",[1780518814,727000000],1,[\"Google LLC\",\"We understand your concern, Melissa. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1780531610,451000000]],null,[\"113935433837785958375\",\"Melissa D\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUoxL8tOWPXVdjnnqwYvfU37h8ZsC4Rg0dGtaI002bOLR187Jkh1Q\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.22.04.920688788\",null,null,null,null,null,1],[\"c383c85f-6d49-4093-ac3e-6f9dfa644182\",[\"Jontyler\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUDdSvJxmnUKX4eY7QAHMiUhl8T_MioXW_VDXNj1B1E3PKfgKyVtg\"]]],5,null,\"I am enjoying Google maps. However it makes mistakes quite a bit. I drive to Freehold Mall 5 days a week and when I get close to the last signal light, it tells me to turn left and not right. cannot seem to correct it. very annoying. But I still use it. Been thinking of exploring other programs that have more 3D and color.\",[1780376872,826000000],2,null,null,[\"101119156256244143437\",\"Jontyler\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUDdSvJxmnUKX4eY7QAHMiUhl8T_MioXW_VDXNj1B1E3PKfgKyVtg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.01.916832833\",null,[[[\"vaf_app_quality_usability\",[1]],[\"vaf_app_quality_ads_frequency\",[1]],[\"vaf_app_quality_battery_heat\",[1]]]],null,null,null,1],[\"b4e9ec73-616e-41c9-b2cf-eb79f8948cae\",[\"Ruibing Wang\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVKFWo0Yunp5FxizG5otMXwM3lpd3LZ0cKApC94GDbuWcC4zlc8\"]]],2,null,\"As the updates focuses on Gemini integration and new features, it has lost sight of the forest for the trees. There are numerous bugs and now dangerously crashing in Android auto (~1 per 10 mins). I've sent bug reports, cleared the app data completely, and tried switching to wired connection but nothing works. This has been happening over about 2 months now. I cannot recommend Google maps or even the pixel phone at this point anymore.\",[1779195036,705000000],6,[\"Google LLC\",\"We understand your concern, Ruibing. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1778472405,315000000]],null,[\"113743890742989201243\",\"Ruibing Wang\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVKFWo0Yunp5FxizG5otMXwM3lpd3LZ0cKApC94GDbuWcC4zlc8\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.20.01.913318892\",null,null,null,[true,false],null,1],[\"8f528d9b-3e09-4b6d-b366-4f093bbf3507\",[\"Trinity Gahagen\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXM2JB0Jb4kVrlK-OIcIoK5zgcfBCMCw2GjZPxBHBtBntkQLFXFDw\"]]],4,null,\"Good navigation app, I use it every day for navigation and monitoring traffic, but I wanted to post a suggestion. In the options for \\\"Add a report\\\" there should be an option for a train crossing. I live in an area where that's a frequent occurrence and it adds so much commute time sitting at a standstill. Please add this so that it can help drivers avoid congested and backed up routes.\",[1779237115,740000000],6,null,null,[\"101321097615409285323\",\"Trinity Gahagen\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXM2JB0Jb4kVrlK-OIcIoK5zgcfBCMCw2GjZPxBHBtBntkQLFXFDw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.20.01.913318892\",null,null,null,null,null,1],[\"ede54c9e-43c5-4191-ad8b-515f90a327ab\",[\"Matt Tucker\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVLnqLuBW3DxyPPWyRlDTjKFR7l2FqkRavV1EV4_hpRqoomshYtEQ\"]]],1,null,\"For the past couple years, Google Maps has been getting worse and worse, to the point where I feel like any other alternative is becoming preferable. It tells me long winding routes that are significantly less efficient, it routes me directly into construction or other roadblocks often, it can't recalculate if I skip a turn for one slightly later instead it will route me an extra 20 minutes around just to get back on its original track. The whole experience has become frustrating and misleading\",[1779148823,248000000],8,[\"Google LLC\",\"That's not the experience we want you to have, Matt. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1779184461,73000000]],null,[\"117853115728249210484\",\"Matt Tucker\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVLnqLuBW3DxyPPWyRlDTjKFR7l2FqkRavV1EV4_hpRqoomshYtEQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.20.01.913318892\",null,null,null,null,null,1],[\"08072e5d-15ab-4707-ba61-823c6ee3a5cf\",[\"Julian Picardo\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVFePivMAP1LQ45VnGJvbv3gokFIFDzLtuHPYMFH3cNym6rGTim\"]]],1,null,\"Continuous Platform Decay. There was a time, Google stole your private information, in exchange for a map service. These days it's just theft. Maps guides you through LONGER routes, randomly changes the map scale, takes you through unpaved roads, etc. I am back to doing things the old fashioned way of following street navigation. Maybe need to buy a book of street maps next.\",[1780453129,819000000],2,null,null,[\"116946725728559649539\",\"Julian Picardo\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVFePivMAP1LQ45VnGJvbv3gokFIFDzLtuHPYMFH3cNym6rGTim\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.22.04.920688788\",null,[[[\"vaf_app_quality_performance\",[3]],[\"vaf_app_quality_visual_appeal\",[2]],[\"vaf_app_quality_usability\",[2]]]],null,[true,false],null,1],[\"8b04ebda-4c6a-4667-904c-8b957dc6c050\",[\"jess i\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW5GlhT7ibw9xfsjcVZKRjk3USewHATiPK0DFHyFGf_XFiPmxKD\"]]],1,null,\"AI is seemingly involved with giving directions now, cuz Maps is becoming unusable (like Google Search). \\\"go thru this light, then turn at the next light\\\" is wrong most of the time (one of the lights doesn't exist/the turn is a diff light). Maps did not refer to traffic lights at all in the past. I miss \\\"in 400ft, turn left\\\" 😭 I deleted my 4 star review from Jan 2012 to make this one. this is the only maps app I've ever used, but I'm going to find an alternative, just like I did for Search.\",[1779491375,814000000],6,[\"Google LLC\",\"We understand your concern, Jess. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1779501246,724000000]],null,[\"101506640298564351604\",\"jess i\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW5GlhT7ibw9xfsjcVZKRjk3USewHATiPK0DFHyFGf_XFiPmxKD\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.20.01.913318892\",null,[[[\"vaf_app_quality_stability\",[2]],[\"vaf_app_quality_battery_efficiency\",[3]],[\"vaf_app_quality_ads_presence\",[1]]]],null,null,null,1],[\"0bc5ad00-f1cf-440a-9fc5-27792f14ff4e\",[\"Yvette Embry\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXhHUhN2eJg_ZSkeXHz-6L_hPOaZEwpVzG2DanadOqQwfW_Mji9\"]]],1,null,\"Idk what is wrong with my Maps in this particular phone but this one is USELESS!!! Every time I try to use it it will literally work for 2 minutes or less when I hear, \\\"GPS system lost\\\" or it will take me COMPLETELY out of my way, the WRONG WAY (almost 10 miles roundtrip 1 x), or constantly U-Turns me. It gets me lost more than if I just tried to wing it myself, and I'M BLONDE! I've tried everything I can to fix the issue, including uninstalling and reinstalling the App to NO AVAIL!!! HELP!!!!!\",[1779005174,636000000],8,[\"Google LLC\",\"That doesn't sound good, Yvette. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1779008458,509000000]],null,[\"109242085742889752199\",\"Yvette Embry\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXhHUhN2eJg_ZSkeXHz-6L_hPOaZEwpVzG2DanadOqQwfW_Mji9\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.18.01.905972481\",null,null,null,null,null,1],[\"f3882b89-b0c7-4166-b3b9-fda133ead485\",[\"Brian Zimmerman\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL-zi2NA7EE9c0RZ9tXVNze0Oc6bQIhPZ8nATxcINLNFneU0A\\u003dmo\"]]],3,null,\"5 stars for general navigation. 0 stars for how timeline was screwed up. I wish I could have a way to give \\\"natural\\\" commands during navigation, like \\\"navigate to the nearest gas station along my route that's less than a mile from the nearest exit\\\" rather than how it currently shows me gas stations a few miles back. I don't want to see a list or a map with dots, I just want it to navigate me to the place for which I asked.\",[1774359837,695000000],490,[\"Google LLC\",\"Hi Brian, thank you for your feedback. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look. Appreciate it.\",[1774400499,817000000]],null,[\"103094957891056619309\",\"Brian Zimmerman\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL-zi2NA7EE9c0RZ9tXVNze0Oc6bQIhPZ8nATxcINLNFneU0A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.12.05.884026066\",null,null,null,null,null,1],[\"5c3a5499-a6ca-46da-9c56-7171f4e5ead1\",[\"_Allison_ Bailey (Alli)\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUeoelO5r1t_xbL53HA6vGzrSdFUHBucx4G_A68-1UTgS_0d6TZ\"]]],2,null,\"I have always used this app for every trip....until yesterday. The reverse trip option is completely useless. The trip in one direction is fine. Exactly where I needed to go. However, the reverse trip would not take me back the same route. Instead, it was only offering the fastest route, which involves a bridge that is closed. It recognized the closure one way but not the other. I will be using another app for navigation from now on.\",[1777420584,711000000],7,[\"Google LLC\",\"That doesn't sound good, we would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: https://goo.gle/3vosTcH. Hope this helps.\",[1777454833,16000000]],null,[\"117258134848176587420\",\"_Allison_ Bailey (Alli)\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUeoelO5r1t_xbL53HA6vGzrSdFUHBucx4G_A68-1UTgS_0d6TZ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.17.05.901412876\",null,null,null,null,null,2],[\"f740bd3d-7431-4723-bdee-f78d7260d329\",[\"Curtis Holden\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXROv9G7hF5ijqzTOXdeO90Z2mLvw_4ZBq44QIp5TRnDjF5-0E\"]]],1,null,\"GARBAGE! Used to be the best, but now they prioritize ads over wherever you actually want to go. I can understand some strategic add placement to try and sell products, but now it's just packed full of clickbait. Good luck. Never thought I'd say it, but I'd choose Apple Maps over this worthless POS. We all know they're not hurting for money, so it's just a huge middle finger to their customers saying \\\"you mean absolutely nothing to us\\\" DO NOT GIVE THEM MORE MONEY! Use literally anything else!\",[1776303863,600000000],15,null,null,[\"104863235502037736531\",\"Curtis Holden\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXROv9G7hF5ijqzTOXdeO90Z2mLvw_4ZBq44QIp5TRnDjF5-0E\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.15.01.894202351\",null,null,null,null,null,1],[\"f60f4544-6220-4dbb-a422-2fc54492f2af\",[\"Chelsea Anschutz\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUgnxM8EFstOlNcuCUJHdEpd-5bKHcjWAYzg6UMF6xUVD9DeN_BXQ\"]]],1,null,\"Maps is normally my go to navigation app, but this last update is awful. Missed turns no longer prompt a u-turn. Instead now it recalculates without telling you to let you go the wrong way, sometimes adding up to 1 hour to the ETA. The only way to fix it is to exit navigation and restart it. It made me 25 minutes late to an appointment. Also, my husband hasn't been able to see my location even though I've given all the permissions. This is a safety issue for me.\",[1777267593,243000000],15,[\"Google LLC\",\"That doesn't sound good, Chelsea. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: https://goo.gle/3vosTcH. Hope this helps.\",[1777282364,703000000]],null,[\"102456217361970834546\",\"Chelsea Anschutz\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUgnxM8EFstOlNcuCUJHdEpd-5bKHcjWAYzg6UMF6xUVD9DeN_BXQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.16.12.898594237\",null,null,null,null,null,1],[\"eb14c0bc-cf42-49d9-a460-6a7d756dc8c6\",[\"Drew Proctor\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX5oIltcFqxjojZ6UDK1Wq6RgCALc5mLGBm_AYJav54gb0rfre-LA\"]]],2,null,\"So the most recent update is not showing slowdowns, crashes, lane closures, or construction while navigating. The different colors like green, yellow, orange, and red show up while looking at the map but not while navigating somewhere. very frustrating as I got stuck in some bad traffic because Maps wasn't showing me there was bad traffic up ahead. I couldn't avoided it. please update and go back to the way it was. thanks\",[1776297497,133000000],20,[\"Google LLC\",\"We understand your concern, Drew. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1776300384,461000000]],null,[\"114768337130431136065\",\"Drew Proctor\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX5oIltcFqxjojZ6UDK1Wq6RgCALc5mLGBm_AYJav54gb0rfre-LA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.15.01.894202351\",null,null,null,null,null,1],[\"02b43b70-b320-4151-9e26-bd2d865e53e7\",[\"Christopher Tucker\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXAmgJOwhstqmGxd_wupr3NXXqurnZoUbxpB8eo79CZCZhz6kte\"]]],1,null,\"used it for years, the literal go-to app for travel. the latest change removed the highlighted path in exchange for an arrow that is impossible to decipher when there is more than one possible turn. massive fumble. also, they unnecessarily shoved AI into it. I'm appalled at how dumb the UI change choice is, immediately uninstall. go to waze. its still Google, but it doesn't have a new and terrible interface.\",[1779580392,866000000],3,[\"Google LLC\",\"We understand your concern, Christopher. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1779638590,171000000]],null,[\"117341101979325274688\",\"Christopher Tucker\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXAmgJOwhstqmGxd_wupr3NXXqurnZoUbxpB8eo79CZCZhz6kte\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.20.01.913318892\",null,null,null,[true,false],null,1],[\"3f329943-bf31-4367-8fff-6f560d74161a\",[\"B Lee\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjValBqS4VeNy2gHwQeU36CJfHKotdJcwBMZcMD_tlsaax2dHVQ\"]]],5,null,\"Google Maps is great and I use it daily both home and abroad. Not every country is well mapped by Google Maps, but many are. Very helpful when traveling abroad and using public transportation or needing information or reviews on businesses. The only minor suggestion would be to be able to clear all your saved places with a clean map and be able to toggle back and forth easily. I have so many saved places that it clutters up the map sometimes.\",[1778310351,14000000],14,null,null,[\"109682731304374899378\",\"B Lee\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjValBqS4VeNy2gHwQeU36CJfHKotdJcwBMZcMD_tlsaax2dHVQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.18.01.905972481\",null,null,null,null,null,1],[\"3fada17f-2a7c-4659-9091-bce4529f34d7\",[\"Steven Schilke\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLduzLiCoPESk2zUK9I9GNFuvXhZvlpXCqI9wU3Mh8ugLjQaA\\u003dmo\"]]],2,null,\"In the USA, this map has always been great. However since COVID, and changing to AI, it is no longer an efficient map routing your trips during rush hour drive but still great for everything else. The issue comes when travel overseas. Overseas: driving 1, not able to navigate or direct well enough to get you to your destination and sometimes putting you life at risk. 5 walking great, mass transit 3. would be better going back to a paper map, than using Google maps for travel by car overseas.\",[1778874544,446000000],4,[\"Google LLC\",\"We understand your concern, Steven. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1778925819,27000000]],null,[\"106607401391618486544\",\"Steven Schilke\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLduzLiCoPESk2zUK9I9GNFuvXhZvlpXCqI9wU3Mh8ugLjQaA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.18.01.905972481\",null,null,null,null,null,1],[\"1b0ef45d-dd96-43a1-abbd-80f6f1532199\",[\"Brian Pinzon\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIdzR0N_DxY_xaztnTLaei9g-494B8a8VeBZ4QFF_COCJX7Tw\\u003dmo\"]]],1,null,\"I'm sorry for complaining, but the set up on the section when searching for a destination. A list comes up to choose from. That's good and all. Except the most important info is the Address and it doesn't show up unless you randomly pick one then it goes onto only that destination and if that's not the one. Then I have to click on the next one. Or if the Address can't be put on the list. what about the number of miles.\",[1778619887,740000000],11,[\"Google LLC\",\"Thanks for your review, Eugene! We'd like to help you. Can you please tell us a little bit more about what you're experiencing so we can investigate further? Alternatively, if you continue to experience issues with this please create a post in our Google Maps Forum for our community of experts to assist: https://goo.gl/tEyBk\",[1585733227,754000000]],null,[\"102818517288737513862\",\"Brian Pinzon\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIdzR0N_DxY_xaztnTLaei9g-494B8a8VeBZ4QFF_COCJX7Tw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.18.01.905972481\",null,[[[\"vaf_user_reviews\",[2]],[\"vaf_phase1_calling_businesses\",[1]],[\"vaf_never_display_content_language\",[1]]]],null,[true,false],null,1],[\"56630fa1-305d-4843-84ae-2a66a7acf1ff\",[\"A.C. Moore\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVLKkuNn4PT7hqdG5n0VMayL8f-rr4ajvmkbwKV-t48uC0tECQ\"]]],1,null,\"I'm editing my review a third time. I don't know what they done to this app but they completely effed it up. it will take you the longest way possible. I'm a delivery driver that depends on maps and I'm going to have to switch to Waze. I have used this map for years and have always loved it but I am changing my star rating because for some reason the maps only give me walking mode now. I depend on my map for work but 80% of my deliveries are in Walking mode making it extremely difficult to use.\",[1779574109,611000000],5,[\"Google LLC\",\"Hi there. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look. Appreciate it.\",[1779587766,520000000]],null,[\"112295879096030676591\",\"A.C. Moore\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVLKkuNn4PT7hqdG5n0VMayL8f-rr4ajvmkbwKV-t48uC0tECQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.20.01.913318892\",null,null,null,[true,false],null,1],[\"62e4991b-6306-4bae-860b-c0ac456ecd71\",[\"Michael\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJggdSZBH7ZZMxHjAuN7DdHxbZuwa5RKrpbLC5CxPkvHU0dtBg\\u003dmo\"]]],2,null,\"For the love of God Google, fix maps so when I search for a place it doesn't zoom way out. I zoom in to check something in an area and the map zooms out and shows stuff all over. That's just stupid. So is all the favorites and starred places I have disappearing when I've searched. You don't think people want to see places that are important to them while searching? And why is this the only app that when I pinch zoom, it zooms into the center of the screen not where my fingers are?!\",[1773858124,246000000],12,null,null,[\"104107787510346124142\",\"Michael\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJggdSZBH7ZZMxHjAuN7DdHxbZuwa5RKrpbLC5CxPkvHU0dtBg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.11.06.880475071\",null,null,null,[true,false],null,1],[\"751dd852-608a-4fc7-8177-432843799a7f\",[\"Stoo S.\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXBr6fkXrZTBSeMtLTdx-sGwwV_chKFoUQ-umLS3eTG183lqDkoJQ\"]]],2,null,\"I wish the web version had a review thing. You open maps. you click and start typing into the search box but at the same time as the page finishes loading (apparently) there's a pop up but as you typed the popup stole focus from you and as you hit space the popup closes and you don't know what it said or what you just agreed to and you didn't even type what you wanted to type in the box. Back to square one after Google punks you with who knows what.\",[1780195307,243000000],0,null,null,[\"116963940716308391971\",\"Stoo S.\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXBr6fkXrZTBSeMtLTdx-sGwwV_chKFoUQ-umLS3eTG183lqDkoJQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.15.01.894202351\",null,null,null,[true,false],null,1],[\"5cd212ca-7650-446a-97a2-1903df3755c0\",[\"Camille Lagunzad\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKMxV6XX-bML4uwgYIFuqArW7U37G3p-Xq5PywlW2rDBiiKcQ\\u003dmo\"]]],1,null,\"I'm pretty sure this app used to be better. Unfortunately, some of the recent updates have me heavily considering switching to Apple again just for maps. The most egregious incident was when it made me drive around in circles, rerouting again and again for no reason. At one point, I watched it tell me to U-turn. Then reroute to go straight. All while I was waiting to make the left turn it ORIGINALLY told me to do. Maybe traffic was just that bad, but that's so unsafe.\",[1780451289,732000000],2,[\"Google LLC\",\"That's not the experience we want you to have, Camille. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1780457198,422000000]],null,[\"100332689168547067349\",\"Camille Lagunzad\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKMxV6XX-bML4uwgYIFuqArW7U37G3p-Xq5PywlW2rDBiiKcQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.01.916832833\",null,[[[\"vaf_app_quality_battery_heat\",[1]],[\"vaf_app_quality_battery_efficiency\",[1]],[\"vaf_app_quality_performance\",[2]]]],null,[true,false],null,1],[\"11bf7c91-c2b6-4737-b8ee-e4d384f9519a\",[\"Stealthpaw\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjULfpuNiFF-uXbv0yUTWwKWCe9yJoIDvhoh3Emz8F6DtQp8SONvGg\"]]],1,null,\"This app no longer works right and is very buggy since last update. It wouldn't even load on my car yesterday. So it's getting worse. The buttons are basically frozen, you pick your destination before plugging it into the car and verify it's correct and then when you plug it in it picks a different destination and then you can't X out of it because the buttons are frozen. It's basically useless. My car, which is a 2024, does not have its own navigation system, so this was important to have.\",[1775322449,842000000],11,[\"Google LLC\",\"Hi there, we would love to learn more about the issue and help. Please create a post in our Android Auto forum so that our community of experts can assist you: https://goo.gle/2TJzeS7. Hope this helps.\",[1775345100,544000000]],null,[\"115268652623201301697\",\"Stealthpaw\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjULfpuNiFF-uXbv0yUTWwKWCe9yJoIDvhoh3Emz8F6DtQp8SONvGg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.14.02.891313448\",null,null,null,null,null,1],[\"b45b280b-8072-40fc-9ed9-be0d36eca490\",[\"Phyllis M\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL0ZOjEFVqILx1dLL56j1AfacEcNTccFirNgyK2veogXJ1-4Q\\u003dmo\"]]],2,null,\"This app used to be good. Used it this morning and a few other times and it constantly wanted me to turn left on blocks that were no left turn permitted. Then it wanted me to go off the regular route that there was no traffic on to move to congested and streets being worked on with construction. I am disappointed that it has gotten this bad.\",[1780330049,985000000],0,[\"Google LLC\",\"We understand your concern, Phyllis. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1780359629,981000000]],null,[\"106950325845659615276\",\"Phyllis M\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL0ZOjEFVqILx1dLL56j1AfacEcNTccFirNgyK2veogXJ1-4Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.01.916832833\",null,null,null,null,null,1],[\"efb92cb0-094d-4fe6-99b1-155616135261\",[\"E\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVso2pcbvARx9iceIVZ_lqa-GmjLSzHaucVqnHPm9phREBsPp7u\"]]],1,null,\"I have to use Google Maps to drive to various locations for work. Recently the app has become infuriating to work with, such as the gps voice not telling me to make a turn until it's too late to stop or I already passed it. You had something that worked perfectly fine before you decided to force AI into everything but now this is causing major issues and is borderline dangerous for drivers. It'd be safer and easier to use a paper map at this point.\",[1778801041,382000000],9,[\"Google LLC\",\"That's not the experience we want you to have, we would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1778823110,228000000]],null,[\"106957998817448633031\",\"E\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVso2pcbvARx9iceIVZ_lqa-GmjLSzHaucVqnHPm9phREBsPp7u\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.18.01.905972481\",null,null,null,null,null,1],[\"1945fab3-13da-4045-b793-16435fa99664\",[\"Debbie Perri\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVEPSwiqeu0y2yNxUS-KfLM2IxC2GThkCN9WNjLbr9-jI79QLek3Q\"]]],1,null,\"Google Maps was always my go to APP. Not anymore. Something changed \\u0026 it no longer gives precise directions. Now it tells you to \\\"turn right in 800 feet\\\", or \\\"take the exit on the right\\\", or my favorite \\\"take the ramp\\\"! This means you need to constantly LOOK at the screen which is dangerous! I'll be switching to WAZE where directions are accurate \\u0026 user friendly.\",[1775330792,311000000],15,[\"Google LLC\",\"Hi there, thank you for your feedback. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look. Appreciate it.\",[1775346860,9000000]],null,[\"113661958924824760163\",\"Debbie Perri\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVEPSwiqeu0y2yNxUS-KfLM2IxC2GThkCN9WNjLbr9-jI79QLek3Q\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.13.06.887680004\",null,null,null,null,null,1],[\"7b741b2a-545b-46aa-b338-ac6e4e276ab7\",[\"Courtney Clayton\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVfdUUpctICS69fUB7ZKLWMeHEjGYy0a9QP-fSBUFmG0kQT62f9\"]]],1,null,\"“You need to do a better job clearly distinguishing whether the Starbucks is a standalone location with a drive-thru or a Starbucks located inside another store. I went to the features section three different times looking specifically for a drive-thru, and each time it showed that the location had one — but it didn’t, because the Starbucks was actually inside a Target, Albertsons, or City Market. That distinction needs to be much clearer in the description and features.”\",[1778175347,317000000],7,[\"Google LLC\",\"Hi Courtney, thank you for your suggestion. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look. Appreciate it.\",[1778196574,855000000]],null,[\"108312575694232929328\",\"Courtney Clayton\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVfdUUpctICS69fUB7ZKLWMeHEjGYy0a9QP-fSBUFmG0kQT62f9\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.18.01.905972481\",null,null,null,null,null,1],[\"25486df0-1b12-4b0f-a4f2-0bdbae770be3\",[\"Jay J\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIPvXNq_G15icZWjp8VeFA161iQIMfXH-Zb3zOINvGk-7U17A\\u003dmo\"]]],1,null,\"I don't know what has happened in the past year but this app has gone down the tubes. Like many on here, it keeps taking you on wonky parking lots instead of main roads. It won't switch to your chosen route. it will always force the best route anyway. I specifically told it to avoid tunnels and chose the longer way around them and it still directed me to the original route. It did this 4 times. I'm done with this app. It's too busy overriding the user for whatever the algorithm is running it.\",[1776297453,1000000],15,[\"Google LLC\",\"We understand your concern, Jay. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1776300483,884000000]],null,[\"113450679102393391244\",\"Jay J\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIPvXNq_G15icZWjp8VeFA161iQIMfXH-Zb3zOINvGk-7U17A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.15.01.894202351\",null,null,null,null,null,1],[\"0fe85a01-67a2-4b01-9bd3-0ed1f33de8c3\",[\"laurie kir\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWjzjTVE7RGLaPg1M99jETpPKUI5VNIj5n5zpGh9Xb1VaevvuA2\"]]],1,null,\"\\\"Updates\\\" route on its own during live navigation. It's fickle and has pointed me in the wrong direction on several occasions. Live nav just isn't reliable anymore, so I write directions on sticky notes and stick em on the dash. That being said, I wish road names and exit numbers were more visible in the app - business ads often get in the way. Overall, maps is quickly losing relevancy. And you can't uninstall anymore.\",[1775537736,427000000],16,[\"Google LLC\",\"We understand your concern, Laurie. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1775566930,412000000]],null,[\"110369234416660079541\",\"laurie kir\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWjzjTVE7RGLaPg1M99jETpPKUI5VNIj5n5zpGh9Xb1VaevvuA2\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.13.06.887680004\",null,null,null,[true,false],null,1],[\"7703e430-416e-4f47-9b8e-b540dde9db04\",[\"Ben Leonheart\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUAyK7zrjcOvvxjAB0f29dudANVOA8MlqsFYx51s5EMqcH0jYx4YQ\"]]],1,null,\"the inaccuracy of the timeline for the past two years has made this unusable. I have all the permissions enabled, background always on location, battery is not restricted either by adaptive battery. I have to manually fill up my day because Google maps is unable to anymore, and while you edit, you get \\\"an error has occurred\\\" each time you're editing the timeline on the app. 1 star. #pixelsuperfans\",[1778305247,752000000],8,null,null,[\"102606705137670900233\",\"Ben Leonheart\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUAyK7zrjcOvvxjAB0f29dudANVOA8MlqsFYx51s5EMqcH0jYx4YQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.18.01.905972481\",null,null,null,null,null,1],[\"1fe0aa5c-32b0-4139-9509-b1ad6f65f736\",[\"Kaden Frisk\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWYY1wdtFqgzkYbLnYCAHftAN239exFSBQUCOMeIbi4CuIw9qx_XQ\"]]],1,null,\"Leaving a 1 star review until this is fixed. No app should prioritize the device over driver safety in any situation, and the issue happens incorrectly regardless. It automatically switches to dark mode to help the device cool off, and it triggers randomly for me. I can be in a cool room, not being using my phone, then this happen when I go to use the map. Even if this was happening when the phone is actually hot, it shouldn't. This is dangerous and forces me to look at the device way longer.\",[1777238697,269000000],8,[\"Google LLC\",\"We understand your concern, Kaden. If you're running into issues with Google Maps, make sure you are on the latest version of Google Maps: https://goo.gle/43EOVsN. If you continue to experience the issue, send us feedback here: goo.gle/43OR0Ce. Appreciate it.\",[1777281172,995000000]],null,[\"116345269125086838755\",\"Kaden Frisk\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWYY1wdtFqgzkYbLnYCAHftAN239exFSBQUCOMeIbi4CuIw9qx_XQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.16.00.898954215.W\",null,null,null,null,null,1],[\"45a8f716-4fad-4704-8cbc-a8ae2106a523\",[\"Jenn Dozier\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUIRQEo7i5IumUzmRXSssA1vpvoVl6PON39UbRVRa3N-d0yVi-g\"]]],2,null,\"When I select a route, that's the route I want, that's why I selected it. Having the app force redirects to other routes is more than frustrating, it's dangerous. I declined the hints to be shifted to another route \\u0026 both times the app ignored my decision \\u0026 shifted me anyway. I ended up having to navigate a bad part of DC to get back to MY SELECTED ROUTE. Google isn't always as smart as it thinks it is...This feature needs to be reevaluated. Give an option to select to opt out of redirects.\",[1780239359,751000000],1,[\"Google LLC\",\"That doesn't sound good, Jenn. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1780272350,122000000]],null,[\"107304804719104276369\",\"Jenn Dozier\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUIRQEo7i5IumUzmRXSssA1vpvoVl6PON39UbRVRa3N-d0yVi-g\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.18.01.905972481\",null,null,null,null,null,1],[\"cb52956c-d70f-4c37-ac27-39eb3c2a4658\",[\"Andrej Tomić\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJsbKW_eaxNoVL03x5ArKUzJ-mM-9py0ZHbOZe8G9xjcZt0vA\\u003dmo\"]]],1,null,\"Most times I can't even put I'm in some place, although I've been there for a while and haven't moved. Also can't leave review as I used to, now it's much more complicated then it used to, and I should know, since I'm local guide level 7. Horrible changes, whatever they are. Keep removing my reviews for no particular reason, although I was there and added photos and all. Ridiculous! Also half of the stuff no matter how relevant it is, can't be put, and they remove it because they feel like it.\",[1776152879,477000000],62,null,null,[\"101171041777256282903\",\"Andrej Tomić\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJsbKW_eaxNoVL03x5ArKUzJ-mM-9py0ZHbOZe8G9xjcZt0vA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.14.09.891313448\",null,[[[\"vaf_never_display_ease_of_use\",null,[1]]]],null,[true,false],null,1],[\"f69b2202-0e22-42a4-860b-8bbf95a4a36e\",[\"Michael Dunbar\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVw_jP0p53SjGpArdS0sgGtOYzstvKvVgvcvJ8A4kj7tgoQwb2iIw\"]]],1,null,\"It's been good, but a recent update messed with the location details and now all the relevant important information is spread out through the page instead of being clustered in one section immediately when you look at a location. It's incredibly frustrating when I can't find the address or phone number of a location without spending a full minute to find it.\",[1774468578,259000000],10,[\"Google LLC\",\"That doesn't sound good, Michael. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: https://goo.gle/3vosTcH. Hope this helps.\",[1774512276,939000000]],null,[\"116044815009273269365\",\"Michael Dunbar\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVw_jP0p53SjGpArdS0sgGtOYzstvKvVgvcvJ8A4kj7tgoQwb2iIw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.12.05.884026066\",null,null,null,null,null,1],[\"a4f2a6f1-d433-4541-8675-1e7b0fdc8910\",[\"Lee Nicholson\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVUAyyOi4J6c4TtMbmi2WzIeBBqQHwVZhZ_si33bp7mwRE0ZMTOYw\"]]],1,null,\"After being reliable for so long, the app recently has become unusable on several occasions. It seems to think there is a limited/poor connection, even when on strong WiFi or 5G. No other apps have had the same issue. This means it won't search for destinations or plot routes, rendering it useless. Restarting or reinstalling the app makes no difference, but it seems to update regularly.\",[1776773735,787000000],20,[\"Google LLC\",\"We understand your concern, Lee. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1776819752,604000000]],null,[\"104071863303863601853\",\"Lee Nicholson\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVUAyyOi4J6c4TtMbmi2WzIeBBqQHwVZhZ_si33bp7mwRE0ZMTOYw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.16.05.898594237\",null,null,null,null,null,1],[\"508e25ef-331f-4455-9009-e62eb2d06318\",[\"Matt Archibald\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWgStrC6ANtW06xNzmPO-BLqcbKDXIDBCQ6qkOTapuUfxHyTkMY\"]]],1,null,\"Please give an option to remove the new \\\"ask maps\\\" bubble that bumped the Home quick navigation bubble out of its place! I have to live with AI being added everywhere these days, but you can't mess with muscle memory, especially given I'll never use \\\"ask maps\\\". I would also love the option to have home and work quick options always present. There are plenty of times I want to navigate to work when I'm not at home. Navigation itself is great. Would be 4 stars if not for forced AI.\",[1774459610,841000000],22,[\"Google LLC\",\"Thanks for the review, Matt. Let's give these steps a try: clear cache and uninstall the updates https://goo.gl/GW6uOo.\\nIf you continue to experience issues with this, please create a post in our Google Maps Forum for our community of experts to assist: https://goo.gl/tEyBk.\",[1566145737,757000000]],null,[\"112727172119942031762\",\"Matt Archibald\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWgStrC6ANtW06xNzmPO-BLqcbKDXIDBCQ6qkOTapuUfxHyTkMY\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.12.05.884026066\",null,null,null,[true,false],null,1],[\"29e2b37d-2d80-4a29-922a-8bbbe23449a8\",[\"Leigh McGill\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJmRCHMF-z9Nv8ZgIVRiSa8t53E0wEfQvQ5CMriEcMS_sBYhA0\\u003dmo\"]]],2,null,\"This app is becoming worse to use as time goes on. You used to be able to zoom in on an area where you knew a business is and it would (once zoomed in enough) show the listing of you forgot the name. Now if you don't remember the name, good luck - if they aren't paying to advertise on Google, you won't see it unless you already know what and where it is. Also, when searching for something really specific, it's useless. You wanted Peruvian food? Too bad, here's Mexican and Thai.\",[1775960646,773000000],16,[\"Google LLC\",\"Hi Leigh, thank you for your feedback. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1775977855,894000000]],null,[\"105223752164577427965\",\"Leigh McGill\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJmRCHMF-z9Nv8ZgIVRiSa8t53E0wEfQvQ5CMriEcMS_sBYhA0\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.13.09.887680004\",null,null,null,null,null,1],[\"185bfc7f-1ad3-4faa-8936-8a8000d5b975\",[\"Adam Harrison\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKwFsQKk0Q8uBwgDB32meAcKvoTZ-Eu3OwWONIUijmvV1T4crs\\u003dmo\"]]],1,null,\"Two complaints. 1. If I choose walking as a navigation mode then hop in a car, the navigation mode is stuck in walking. Nobody can walk as fast as a car so that should automatically change to a vehicle navigation mode based on speed. That's common sense. 2. If I select a destination, there's an obnoxious loading bar that takes a good 5 seconds before navigation starts. I could easily miss an exit or a more efficient route in that time. Get rid of the unnecessary loading bar.\",[1773491434,937000000],11,[\"Google LLC\",\"We understand your concern, Adam. If you're running into issues with Google Maps, make sure you are on the latest version of Google Maps: https://goo.gle/43EOVsN. If you continue to experience the issue, send us feedback here: goo.gle/43OR0Ce. Appreciate it.\",[1773727581,438000000]],null,[\"104959010550633999175\",\"Adam Harrison\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKwFsQKk0Q8uBwgDB32meAcKvoTZ-Eu3OwWONIUijmvV1T4crs\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.11.06.880475071\",null,null,null,null,null,1],[\"b2ce927a-957d-4b68-9ff5-d71da09da33a\",[\"Preston Pilkerton\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWV9Vd589lHd8XNrvdguNTdAt7ffF7Q0PJVk67LrJ7uPa4yTiTv\"]]],1,null,\"Honestly it used to be quite good, I still use it but here recently (like maybe the past month or so) when I search a location and get directions to it I'll end up at a different place than where I wanted. like if I try to get directions to the nearest dollar store/small outlet store/local business/etc., It'll instead give me directions to Walmart even if I select specifically where i want in the list of places. like it changes my result from the local small business to a large retail chain.\",[1776440565,390000000],10,[\"Google LLC\",\"We understand your concern, Preston. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1776471040,188000000]],null,[\"114534483866546797983\",\"Preston Pilkerton\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWV9Vd589lHd8XNrvdguNTdAt7ffF7Q0PJVk67LrJ7uPa4yTiTv\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.14.09.891313448\",null,null,null,null,null,1],[\"cc43a016-561f-4f80-81f8-777a963ea303\",[\"Quentin Swedenhjelm\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUw6KjPa-oHuvWROj1UQd9v1S23E2cOSU05hMudlVkLgHJMVYQe\"]]],1,null,\"Specifically chose a route that was beneficial to where I wanted to be at the end of the day. While driving on a 27 mile stretch, I put the phone down and somewhere it must have rerouted me to a faster route and I didn't notice until it was too late causing me to drive and extra 45 minutes overall that day. Uninstalling this thing and reinstalling an app that stays on the route that I take the extra time to choose.\",[1777838454,436000000],8,[\"Google LLC\",\"That doesn't sound good, Quentin. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1777887488,333000000]],null,[\"105795702159106444643\",\"Quentin Swedenhjelm\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUw6KjPa-oHuvWROj1UQd9v1S23E2cOSU05hMudlVkLgHJMVYQe\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.17.05.901412876\",null,null,null,null,null,1],[\"2a2cc64f-381b-41bd-b93c-aa3dde44a0cf\",[\"Steve Lawrence\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW0kLUrkF28PdR6CXFebL-TTXjL7H7TGVIpZDC1gVfxCkCk_Jsaaw\"]]],1,null,\"VERY disappointed with this app. I've been a Waze user for years, but decided to give this a try. The first trip of 50 miles it made three egregious errors. One was to turn right as we passed the turn at 50 mph, another was when the box in the upper left corner said to go straight while the blue line on the map said to turn right. Unacceptable!\",[1776621239,639000000],13,[\"Google LLC\",\"We understand your concern, Steve. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1776662305,721000000]],null,[\"101982498662279099187\",\"Steve Lawrence\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW0kLUrkF28PdR6CXFebL-TTXjL7H7TGVIpZDC1gVfxCkCk_Jsaaw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.15.02.894202351\",null,null,null,null,null,1],[\"7fe9a050-5dda-41db-88f9-c87d1f7bed41\",[\"Penny Hartlaub\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWAE-kAXaUzLhGYUriwU5UGXccnscvspB9zQUM2PHYdXEohC6C-FQ\"]]],4,null,\"I had use this app for many years. It still great to use, but one flaw. When I set my route to go, somehow it changes as I'm driving to shorter way. I hate this! I choose the way, the app needs to stay as I choose. I do like how it void tolls. it world be nice if it could be set up as a trucker route, especially for big campers. That would be a grand change. If don't stop citing my chosen route. I'm going find another gps app.\",[1778086713,64000000],8,null,null,[\"101181907390080104331\",\"Penny Hartlaub\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWAE-kAXaUzLhGYUriwU5UGXccnscvspB9zQUM2PHYdXEohC6C-FQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.18.01.905972481\",null,null,null,null,null,1],[\"7b17fbce-589b-424c-992d-5f99d70f35fa\",[\"James\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXlhsMaVwuo_mtiH18YR0L8v7eA_yBLoroLJrHyq8ktLgCoDXI\"]]],1,null,\"This app constantly fails to update traffic information correctly. I will be driving. I'm totally normal doing well, no problem. And then out of nowhere a 10 minute delay that I have no option to get away from because it didn't update until I passed the final exit before the traffic jam. It is infuriating and inferior to other apps.\",[1777502267,3000000],6,null,null,[\"117237588205856300840\",\"James\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXlhsMaVwuo_mtiH18YR0L8v7eA_yBLoroLJrHyq8ktLgCoDXI\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.17.05.901412876\",null,null,null,null,null,1],[\"2445840b-f95e-47d1-870c-69fcfe437a0f\",[\"Aaron\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU1nROxLr1PUfNv4G41rv14gh3htPynetU-QbJCx_2ZeXLy2lbshw\"]]],1,null,\"My original review was: \\\"The update won't let me share my live location anymore.\\\" However, now I can add that I cleared cache, cleared data, uninstalled app, reinstalled app, deleted and then added back person to share location, etc. I ran virus checks, turned off and restarted the phone. The actual location gets stuck in one place, often, for hours now. One day it may send notification that I arrived at a certain location, the next day it won't. There's lots of memory available also....\",[1776812163,818000000],12,[\"Google LLC\",\"Hi Aaron. Let's give these steps a try, clear cache and uninstall the updates: https://goo.gle/3rF6Ewz. If you continue to experience the issue, send us feedback here: goo.gle/43OR0Ce. Appreciate it.\",[1776125498,851000000]],null,[\"103378429570562674052\",\"Aaron\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU1nROxLr1PUfNv4G41rv14gh3htPynetU-QbJCx_2ZeXLy2lbshw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.15.01.894202351\",null,null,null,[true,false],null,1],[\"8b0d0942-d59f-4f92-ba29-e252f2f53ccb\",[\"Jared Brown\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKi5Rc7qWy1xFXriNQcl3vW8Tnp4A5IoetRAP4r3SENzPMfxxBC\\u003dmo\"]]],1,null,\"It used nearly a gigabyte of data for a 15 minute drive, and now my phone carrier, Google Fi, is charging me for that... Looks like some idiot developer at Google decided to not check their vibe code and now I'm having to pay more money because of it. The app is having other issues lately with just working in general, so I won't be using it again.\",[1778192759,775000000],3,null,null,[\"102802176771570142105\",\"Jared Brown\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKi5Rc7qWy1xFXriNQcl3vW8Tnp4A5IoetRAP4r3SENzPMfxxBC\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.18.01.905972481\",null,null,null,null,null,1],[\"fddf674b-8937-4637-9dd8-1cc9b7257792\",[\"Daniel Murray\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVJ7G1eraJ-glFuKgLdK7uif9LREfsVXYr6xS9WQ5dPR6jQpX8h\"]]],1,null,\"Getting worse and worse. The newest update has not delivered me to a destination without an error a single time. Directions are just wrong now with the AI update. Every turn is a 'slight' turn, even 90° ones. It will tell you to turn. \\\"at the light\\\" on a street full of streetlights but never mention the street name. it constantly forgets to tell me to turn until I'm mid intersection or even after the intersection. the update has been a net negative\",[1774377424,693000000],17,[\"Google LLC\",\"That doesn't sound good, Daniel. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: https://goo.gle/3vosTcH. Hope this helps.\",[1774419527,501000000]],null,[\"103156714237688458646\",\"Daniel Murray\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVJ7G1eraJ-glFuKgLdK7uif9LREfsVXYr6xS9WQ5dPR6jQpX8h\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.12.05.884026066\",null,null,null,null,null,1],[\"48e3f552-7fcb-4cb5-9616-416280feaf06\",[\"Kristina Pratt\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK3tnUQWmV6iwdB9nA9tEeRUgl8PLphtW4tkJ2ubNzZB-0jRQ\\u003dmo\"]]],1,null,\"For at least the last year, Google Maps has been getting worse. I question if they've inserted a poor quality AI somewhere. Regularly spams me with rerouting prompts, even after I've rejected the new route. Its less accurate in pinpointing my location/orientation. Recently it verbally told me to turn left when the written instruction was a right. When routing to my home, it sends people to a stop sign to cross straight across a 5 lane highway, despite multiple options to cross at a light.\",[1776953624,64000000],11,[\"Google LLC\",\"That doesn't sound good, Kristina. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1777008255,454000000]],null,[\"103626400672980550816\",\"Kristina Pratt\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK3tnUQWmV6iwdB9nA9tEeRUgl8PLphtW4tkJ2ubNzZB-0jRQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.15.01.894202351\",null,null,null,null,null,1],[\"e6b3d2c5-19f0-4508-851e-08afd33d1ead\",[\"Nick Bennyhoff\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV1bHWaT5WJi5Xg_VjZ7e7HV43bYMsygin2gVsw01qLGS0Db2B0\"]]],3,null,\"It'll get you there, it does ok with traffic, but it no longer gives good alternate routes. Sometimes I want the shortest or fastest route, but I sometimes want to take back roads or side roads to avoid traffic or just to have a more pleasant drive. Unless you select Avoid Highways, it doesn't even recognize that non-highway paths exist. That isn't good enough.\",[1774399652,975000000],15,null,null,[\"111060052628445787494\",\"Nick Bennyhoff\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV1bHWaT5WJi5Xg_VjZ7e7HV43bYMsygin2gVsw01qLGS0Db2B0\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.12.05.884026066\",null,null,null,null,null,1],[\"2a2f77e9-3fd9-44d8-8545-d51ab9d8d2b0\",[\"Jess\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVBeOjnKYNX3f53FKdolA8j6qFu15ZMQyWkP7nIevueMw5tgScq\"]]],1,null,\"I'm not sure if Google Maps is not updating or what. It is like the app purposely chooses the routes where I get there slower to burn gas more. On the way to one location, it tells me to go an extra 6 miles to get to the same destination. Maps continues to redirect me despite going on a quicker route with no warnings of crashes or traffic. It tells me to choose either lane to turn and then 3 seconds after the turn it tells me to get in the left lane to keep straight despite choosing either lane\",[1776545092,747000000],11,[\"Google LLC\",\"Hi Jess, thank you for your suggestion. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1776554267,115000000]],null,[\"117016284928742430899\",\"Jess\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVBeOjnKYNX3f53FKdolA8j6qFu15ZMQyWkP7nIevueMw5tgScq\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.15.01.894202351\",null,null,null,null,null,1],[\"dddc72e0-6cbb-4c5f-9b61-57a9d48ba28c\",[\"Trisha Rupp\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXBElybUKTOfvY9tCgtJ4VEZsCk3DWwIDUVPvAHvqTCPxWEjX8BWg\"]]],1,null,\"The app has recently changed and is a huge downgrade! The GPS will now say 'in 1 mile take the exit on the right' with no exit name or number like it did previously. It will also say 'take the interchange on the right' if a highway is a merge point but also has an exit. It's pretty useless except for alerts in areas I'm familiar with. It is not helpful for navigating to new areas.\",[1774290245,158000000],17,[\"Google LLC\",\"We understand your concern, Trisha. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1774309073,494000000]],null,[\"118344689871945308823\",\"Trisha Rupp\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXBElybUKTOfvY9tCgtJ4VEZsCk3DWwIDUVPvAHvqTCPxWEjX8BWg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.12.05.884026066\",null,null,null,null,null,1],[\"9013e00d-97f3-4e8d-9343-877a5e7ce7eb\",[\"Lisa F\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVoMwapqbb0ocV55Iqq120IGpAj3bsujTTrgUg2IFqDRJFFZR0\"]]],4,null,\"There's a lot of things I like about the app but there are a few that I think need improvement. When I expand a street, I would hope that the name of the street shows up. sometimes I have to scroll left or right to find the name of the street. Also sometimes the street name is really small and I would like to make it bigger, but it keeps downsizing to the same size font. BIG ISSUE: was driving on more than one rural road and a new stop sign was put in at an intersection. no way to indicate that\",[1777686280,531000000],7,null,null,[\"107990094897081937429\",\"Lisa F\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVoMwapqbb0ocV55Iqq120IGpAj3bsujTTrgUg2IFqDRJFFZR0\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.15.01.894202351\",null,null,null,null,null,1],[\"7d025851-dd4d-4c00-bb64-834fabcc4183\",[\"Terry\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUitHJg2fdi3gZVA25o2vosvb-VjzQiZt9yGhaZjyusyIb94ETd\"]]],3,null,\"Navigation has improved quite a bit and is usually pretty good, although the voice prompts are often slow, if not late, in coming. You really have to watch your position on the map display. The map stays zoomed out too far when you have several turns close to each other. Often you will find the next several turns aren't visible. User-made labels for saved locations don't show up in saved lists. Only the address or coordinates are shown. You must select a saved location to see its label.\",[1779367764,290000000],2,[\"Google LLC\",\"Hi Terry. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1779379459,785000000]],null,[\"113772670005196448173\",\"Terry\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUitHJg2fdi3gZVA25o2vosvb-VjzQiZt9yGhaZjyusyIb94ETd\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.04.01.857847151\",null,[[[\"vaf_app_quality_ads_frequency\",[2]]]],null,null,null,1],[\"b5f1540b-95be-4065-aa35-cd46506ebd6c\",[\"Roddy Graham\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKS_eePHBaWR7rxTh9Zf3FCAq5hG9tN88mg9tStw4aSwTMjUQ\\u003dmo\"]]],1,null,\"it used to turn the route red or yellow depending on traffic. now it only shows blue. we have always relied on those colors to help us change routes. also, the alternative route button doesn't give options that are helpful. it keeps trying to bring us through DC, which, is never a fast route. I can change it.\",[1776096051,502000000],19,[\"Google LLC\",\"We understand your concern, Roddy. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1776126347,389000000]],null,[\"108244722176461854863\",\"Roddy Graham\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKS_eePHBaWR7rxTh9Zf3FCAq5hG9tN88mg9tStw4aSwTMjUQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.14.09.891313448\",null,null,null,null,null,1],[\"36514adc-26df-4179-849d-211f23c35998\",[\"Tocs Yelrom\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUg2MMSMwvWMrKCFTZnUnUM9e2Z_FKihCV3AKO5TmEceOkJc_vS\"]]],1,null,\"Gets worse and worse. Used to be a great app you could always count on. The amount of times it's sent me the wrong way lately, or put me in the wrong lane at an island.. Just annoyances that put a lot of time on to your journey. Just feels they've taken a massive backwards step to me. Hopefully they fix these issues and it goes back to how it was.\",[1777485943,255000000],12,[\"Google LLC\",\"We understand your concern. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1777507922,967000000]],null,[\"118277260936580061256\",\"Tocs Yelrom\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUg2MMSMwvWMrKCFTZnUnUM9e2Z_FKihCV3AKO5TmEceOkJc_vS\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.17.05.901412876\",null,null,null,null,null,1],[\"ad5acb1c-3e40-47cb-b84c-f1ed25dcfd58\",[\"Vivek Hegde\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXEkBRaTyfGL61UpxGd7bYJoSAES2nIX1DuW7pXJbcIbxETxczX\"]]],2,null,\"Does not save my navigation settings between device upgrades, when you switch phones - The settings to turn off fuel efficient routes do not get saved between device upgrades. It used to remember my destination patterns - Monday evening karate place, Tuesday evening gym etc. It doesn't do that anymore. When you search for a chain business (say Starbucks), it doesn't list the location options in order of distance.\",[1777344174,137000000],13,[\"Google LLC\",\"Hi Vivek. Let's give these steps a try, clear cache and uninstall the updates: https://goo.gle/3oW0tVa. Hope this helps.\",[1677440969,827000000]],null,[\"104972003593085233705\",\"Vivek Hegde\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXEkBRaTyfGL61UpxGd7bYJoSAES2nIX1DuW7pXJbcIbxETxczX\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.17.05.901412876\",null,null,null,[true,false],null,1],[\"f78cbe57-d166-4440-8f75-20150cced95e\",[\"T\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLr0MAtvc8BIwhQNWInDE1eFt4yE9O5_riC3E9KqNtu6It9eqN8\\u003dmo\"]]],2,null,\"ok for finding, saving and reviewing places but sometimes nav instructions are bad. It took me off the highway to drive me around in bumper to bumper traffic for 20 minutes just to put me back onto the same highway?? always review the directions and not blindly trust. Android auto app is super annoying getting you to dismiss route warnings. The alerts are present for a long time and overlay important parts of the map. Dates in reviews should also display the whole date not relative time.\",[1773591329,765000000],196,null,null,[\"102930328425469859984\",\"T\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLr0MAtvc8BIwhQNWInDE1eFt4yE9O5_riC3E9KqNtu6It9eqN8\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.10.01.877073638\",null,null,null,[true,false],null,1],[\"38feff7a-d4d6-40c0-b966-bebc97189de7\",[\"Crystal H.\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWe9yRVHpCHBZA-kWbJqHEZ0a6CA9hYFR1xeIy4OLdp2zRdcXyI\"]]],3,null,\"Update: Sometime around January 2026, the starting location in my Google Maps (GM) app has been wrong. For example, when starting from my \\\"Home\\\", some random address nearby comes up, instead of my correct home address. This never used to happen. I've cleared the app cache, verified that my location features are accurate \\u0026 turned on in the GM app, etc. Nothing seems to fix the issue.\",[1771184925,762000000],173,[\"Google LLC\",\"We understand your concern, Crystal. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1771200103,868000000]],null,[\"100761443677006162732\",\"Crystal H.\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWe9yRVHpCHBZA-kWbJqHEZ0a6CA9hYFR1xeIy4OLdp2zRdcXyI\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.06.01.863982022\",null,[[[\"vaf_real_time_traffic_data\",[1]],[\"vaf_estimating_arrival_time\",[1]],[\"vaf_reduced_sized_maps\",[1]]]],null,null,null,1],[\"8079a127-2754-4150-a54b-8f40c02a06f1\",[\"Paweł Szymański\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWokerujuQNPPCytcaeXqKvvUWl2nTFdh_J1jFLCgzsAFBb5Qv1\"]]],1,null,\"I like Maps. I think they are an infinitely useful app. However, when I search for a CONTACT'S ADDRESS in a hurry, and I'm shown two sponsored locations instead, and I mistakenly click the \\\"route to\\\" button on one of them cause, again, I'm in a hurry, and I find myself being dragged through the city center traffic, adding 30 odd minutes to my travel time and inevitably extending the \\\"I really need to use the bathroom\\\" state by the same amount, I cannot, in good conscience, give it more than 1 ⭐\",[1746377756,476000000],392,null,null,[\"115727244825440042332\",\"Paweł Szymański\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWokerujuQNPPCytcaeXqKvvUWl2nTFdh_J1jFLCgzsAFBb5Qv1\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.17.00.749564752\",null,null,null,null,null,1],[\"440b994c-388a-4c1e-9bbf-f0aaca327f27\",[\"Roy Frost\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKnWCkYyJZsZRdZ8XUTclPFKepEGOsHrvfBT9iiTgsUpRVgaQ\\u003dmo\"]]],4,null,\"it's a very good navigation app, probably the best. I'm amazed tho that you only get a small audio bleep to warn you of speed cameras instead of a voice warning. Almost all other navigation apps provide thus. surely it's not beyond your technical knowledge to do this. Makes it so much easier to hear a voice than a little bleep that you may miss whilst driving. I'm sure your ratings would go up 5 fold .\",[1759387695,591000000],3556,null,null,[\"104865427955838608187\",\"Roy Frost\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKnWCkYyJZsZRdZ8XUTclPFKepEGOsHrvfBT9iiTgsUpRVgaQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.39.07.809715466\",null,[[[\"vaf_never_display_disruptive_ads\",[2]],[\"vaf_never_display_spend_more_time\",[2]],[\"vaf_never_display_easy_to_use\",[1]]]],null,null,null,1],[\"3f323607-e1b5-45ee-9fed-ebf9a2d49476\",[\"Daniel\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJOE0Gn2EYJCUJrM_fMI1wFiQiEaX3_nO6BZcHpzQAIoLA9_Q\\u003dmo\"]]],1,null,\"I choose a journey out the options, and then it just sends me down the one it had first suggested rather than the one I chose. It happens all the time. I also wish I could edit the journey like you can on the Google maps site, pulling and dragging the line to the paths I want to go by. I also wish it could save certain paths, because the options of path sometimes are different and doesn't let me pick the one I want. I don't care if there's traffic, let me create my journey.\",[1729781414,656000000],359,[\"Google LLC\",\"That doesn't sound good, Daniel. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: https://goo.gle/3vosTcH. Hope this helps.\",[1729789635,808000000]],null,[\"111326283940767208306\",\"Daniel\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJOE0Gn2EYJCUJrM_fMI1wFiQiEaX3_nO6BZcHpzQAIoLA9_Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.151.0901\",null,null,null,[true,false],null,1],[\"d5009a13-bb73-4bf0-b6d9-5bd10e7eff9c\",[\"Richard Bacon\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL_B238R3x58yzDFsgZlGm4fWbG-GW0St0vxt2zDyjTJ-rRJQ\\u003dmo\"]]],4,null,\"Okay, so as a navigation tool, it is pretty good for driving, really good for public transport, but in walking mode, especially in built-up areas, it is all over the place. After a recent update, it started asking road status questions. These are distracting and so dangerous and can't be switched off. The issue of the app stopping in the car is an issue with Android Auto, not with Maps and relates to USB cable length, keep the cable very short. Overall, pretty good but could be better.\",[1731863811,863000000],787,[\"Google LLC\",\"That doesn't sound good, Richard. Let's give these steps a try, clear cache and uninstall the updates: https://goo.gle/3rF6Ewz. Also, please create a post in our Android Auto forum so that our community of experts can assist you: https://goo.gle/2TJzeS7. Hope this helps.\",[1718319294,753000000]],null,[\"102210244717486370703\",\"Richard Bacon\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL_B238R3x58yzDFsgZlGm4fWbG-GW0St0vxt2zDyjTJ-rRJQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.154.0103\",null,null,null,[true,false],null,1],[\"f0a2d86b-00f1-4859-a17b-f0fc5447fec5\",[\"Sylvain Boissé\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX8ZaAA0k9DSzRE6C0YTNmEy4WI98NlQdvoVrFnW7X3B5d41di8\"]]],1,null,\"Since a few says the app keeps failing connecting to the internet. But there is internet access on the phone and can use it normally with all the other apps. The same problem happens both using WiFi and using mobile data. I have to close the app, restart it a few times, then it ends up working. And the a few minutes later, the problem is back again and I have to kill it a few times until it succeeds connecting. Super frustrating. Please fix this asap.\",[1760300489,445000000],6700,[\"Google LLC\",\"Hi there. The issue is now resolved. If you continue experiencing issues, please submit a feedback report: Open Google Maps App \\u003e tap top right profile picture or initial \\u003e Help \\u0026 feedback \\u003e Send product feedback. Appreciate it!\",[1761186046,678000000]],null,[\"114784589183561004826\",\"Sylvain Boissé\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX8ZaAA0k9DSzRE6C0YTNmEy4WI98NlQdvoVrFnW7X3B5d41di8\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.40.11.812611599\",null,null,null,null,null,1],[\"430bf610-ed2f-4fde-b5bf-fd43bfa3baa1\",[\"Harsh Dave\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUyHOGeQedVC_OHvZw3cuxacMBsNiS6tezNdpXMTqfbEIKpxS0Q\"]]],2,null,\"There are many times when it keeps getting stuck on the \\\"Starting Navigation\\\" step. It appears to be an issue with the destination address. It looks like when the route has Highway included, the maps do not work. But if I disable highway (avoid highway) the maps work normally. And this is only happening to certain locations as other destinations with same highway work fine.\",[1734472820,294000000],343,[\"Google LLC\",\"Hi Harsh. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: https://goo.gle/3vosTcH. Hope this helps.\",[1734399265,256000000]],null,[\"105792596093610703314\",\"Harsh Dave\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUyHOGeQedVC_OHvZw3cuxacMBsNiS6tezNdpXMTqfbEIKpxS0Q\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.49.06.703287473\",null,null,null,[true,false],null,1],[\"12b9328f-f376-4c32-83be-a062a2a9bbc8\",[\"Peter Glynn\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUH-JDkHe6o8ivwatpYHb_W1ApB9XHKRdCbKYyLdG3vF7faIvVS_w\"]]],2,null,\"Not as good as it used to be. I gave up using it as a satnav when out on my motorbike as it kept giving up and saying it had no connection, whereas it could travel exactly the same route in the car without any issue. Now it's not properly recording the journeys I've taken, just putting best guess straight lines to where it thinks I went, often inaccurately, and requesting manual confirmation when I review. Do we have to have the map crowded with adverts of fast food outlets and similar?\",[1735570120,800000000],275,null,null,[\"107740050134584381958\",\"Peter Glynn\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUH-JDkHe6o8ivwatpYHb_W1ApB9XHKRdCbKYyLdG3vF7faIvVS_w\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.50.04.705335264\",null,null,null,null,null,1],[\"716909d4-5712-44fd-ab29-ef2edaf74cbb\",[\"Meredith Navin\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUgg3vybuJjtcoupygal6yQeOojevGRczB67VUdg4U10kkJqjA\"]]],3,null,\"Not sure why the popup window is constantly disappearing when changing app. I listen to a podcast on YouTube and whenever I try to play it, the popup window (which, frankly, needs to be bigger) keeps disappearing. It's very frustrating, as YouTube will stop playing if it's not the main window open. And before you ask, no, I'm not watching YouTube, I'm just listening to it. Also, please make it easier to change from driving to walking.\",[1734244028,714000000],636,null,null,[\"110800972149993912177\",\"Meredith Navin\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUgg3vybuJjtcoupygal6yQeOojevGRczB67VUdg4U10kkJqjA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.49.06.703287473\",null,null,null,null,null,1],[\"97942161-b95e-4e4e-9dce-1a4d9224d383\",[\"G S\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU36hF4S_g_CnmaPiNPKHfA5RM1E-BBUgtOe50N_WEC3aUPrgvu0Q\"]]],1,null,\"I used to love this app - I could switch between routes without having to manually add waypoints to force the AI to go specific ways. Recently it's also been ignoring random junctions that split the route, both on and off the motorway, rurally and in cities, leaving you having to make last minute decisions. Sudden lane changes are also its forte - especially fun in city traffic in the last possible 5m before a turn! Traffic estimations are also way off. As it is, it's pretty much pointless.\",[1754917719,793000000],2069,[\"Google LLC\",\"That doesn't sound good. Thanks for the feedback, we really appreciate it! We will pass it on to the right team.\",[1754952943,192000000]],null,[\"100939535473089665238\",\"G S\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU36hF4S_g_CnmaPiNPKHfA5RM1E-BBUgtOe50N_WEC3aUPrgvu0Q\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.32.00.790560726\",null,null,null,null,null,1],[\"cf044c88-9af7-44ec-8a09-d3850331285f\",[\"Paul Seligman\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXt1hJaRNA0KV2O6tOoZDVHjEJjrlSxHAcSOQKCx4BGMy3jPPGc\"]]],4,null,\"Great app, which I've used for many years with only occasional problems. I can't find a way to report a bug without posting a review. And I can't post a screenshot here, which would make a problem easier to understand. Here's a bug: If you use it for public transport, it shows how busy a particular station or stop is, based on the approx. current time of your phone. It should use the predicted time and day, which may be very different, and is based on selected day \\u0026 time for travel.\",[1733591350,47000000],1304,null,null,[\"104314927961408370632\",\"Paul Seligman\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXt1hJaRNA0KV2O6tOoZDVHjEJjrlSxHAcSOQKCx4BGMy3jPPGc\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.48.05.700553417\",null,null,null,null,null,1],[\"6c66a8ea-c196-4569-93b8-6b8942e4655f\",[\"BabyGrandma\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVif0JHs8U01uctkGlAg3LH3FGnKLZOCBI_gSseS3XslfPTDaWk\"]]],1,null,\"It's worse than than useless. It literally changes direction in the middle of driving, tells me to take a right then changes to left. Can't figure out what way I'm driving and just goes all over the place. The orientation goes off and it's like trying to drive upside down and it's nothing to do with my phone. It stopped even giving me the recenter option and won't zoom in to the immediate area Im driving in. This is crazy DO BETTER. maps req for my job!!\",[1759451413,78000000],1144,[\"Google LLC\",\"That doesn't sound good. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1759479153,167000000]],null,[\"113031709412643948120\",\"BabyGrandma\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVif0JHs8U01uctkGlAg3LH3FGnKLZOCBI_gSseS3XslfPTDaWk\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.39.07.809715466\",null,[[[\"vaf_never_display_make_you_happy\",[2]],[\"vaf_never_display_negative_ads_impact\",[2]],[\"vaf_never_display_app_description\",[2]]]],null,null,null,1],[\"0ac8d9e5-b299-4d6e-9f19-353514eba0a8\",[\"Alexandru Lipan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX3vwcqjg9GFTuItkBHodRwN5ALgK-EsZHtuN2qHJrt1wVkLdSS\"]]],1,null,\"This a reloaded update. Navigation broken to the point that I can't select what mode I have (especially public transport navigation that seems to have disappeared). On top of it, now suddenly I find that \\\"because policies\\\" 80% of my reviews are deleted, together with pinned places and favourites. Maps is also cluttered with square pins (basically ads) of sport betting offices and high profile shops, that I don't need at all in a navigation app.\",[1738680909,499000000],398,null,null,[\"107513826796258425840\",\"Alexandru Lipan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX3vwcqjg9GFTuItkBHodRwN5ALgK-EsZHtuN2qHJrt1wVkLdSS\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.05.02.719889437\",null,null,null,null,null,1],[\"a1d7c9ea-1e73-413e-992b-5f5dfe4995a3\",[\"Humarno Schoonwinkel\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUftjTmN4kTiGk88W5u4BKVCrdN3RDadsj_mG4tzS0uTakol64\"]]],4,null,\"Greetings, App works amazingly. Can I request that a speed warning/alert option be added to the app to help stay under the speed limit. (this can be toggled on/off) Reason being, in my country the signs are often not there anymore and then one speeds without knowing it. Such a useful feature and if the speedometer can also show in android auto please.\",[1732824742,527000000],937,null,null,[\"106366260863632192377\",\"Humarno Schoonwinkel\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUftjTmN4kTiGk88W5u4BKVCrdN3RDadsj_mG4tzS0uTakol64\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.47.04.699095382\",null,null,null,null,null,1],[\"bd8253da-ac1b-4601-8a96-a31054c46d0c\",[\"Praveen Kandukuri\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWpjLN2citK5YRRew1Otrrzyi1zby_jepIuzGYVRPgg6j2U8k8\"]]],1,null,\"why the heck you have to reroute always and expect us to click \\\"no\\\" when the phone is in the pocket, while we are driving. You are forcing us to take a shorter route as we bikers cannot click no when you are rerouting, because our phones will be in our pockets and we cannot stop suddenly just so we have to click \\\"No\\\". Sometimes we don't want a shorter route due to safety concerns (that road is famous for robbery) and bad road conditions..etc So provide an option to pause \\u0026 resume rerouting.\",[1752760240,668000000],491,[\"Google LLC\",\"We understand your concern, Praveen. Thanks for flagging this. We will pass this to the right team.\",[1752758523,884000000]],null,[\"103095144030920345151\",\"Praveen Kandukuri\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWpjLN2citK5YRRew1Otrrzyi1zby_jepIuzGYVRPgg6j2U8k8\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.21.01.760306150\",null,null,null,[true,false],null,1],[\"d4ea73fb-463d-40d2-a58a-1fef22cc076a\",[\"Alan Dollery\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXLo-Rlzz5iiIzKOsYh1th7doZ1-T4yoI_gaxJJzV7oLTe_sFtU\"]]],1,null,\"Still no speed cameras icons position's on the map or the option to turn them on in Settings, Navigation, Driving Options, Speed Limits option. Just Speedometer, driving notifications and Bluetooth tunnel beacons. There seems to be an update every week for years and still nothing. I've tried uninstalling it clear cache, data all suggestions I can find, and on multiple phones and tablets and a laptop. But nothing is displayed I thought the UK was one of the areas all set up for it.\",[1754386017,158000000],240,[\"Google LLC\",\"Hi Alan. Thanks for the feedback, we really appreciate it! We will pass it on to the right team.\",[1754406531,239000000]],null,[\"112264386035149037230\",\"Alan Dollery\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXLo-Rlzz5iiIzKOsYh1th7doZ1-T4yoI_gaxJJzV7oLTe_sFtU\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.31.02.787720732\",null,null,null,null,null,2],[\"e5db3110-a1e7-4b1b-818c-5efc22762814\",[\"Georja Johnston\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJd8Wabn4SVnp5UebJ4RbqqI6GHUcP6RH4znOs3ecgxzpJavQ\\u003dmo\"]]],1,null,\"I've been having an awful time with this app lately! Tried updating, deleting and redownloading, powering my phone off and back on. It will work for a few minutes and then says \\\"searching for gps\\\" and times out on directions. Or shows me in a completely different area no where near my current location or destination. It doesn't matter where I'm at or where I'm trying to go, this happens every time I use the app now\",[1758045322,885000000],1353,[\"Google LLC\",\"That doesn't sound good, Georja. This article has some great tips on getting the most out of your location on Maps: https://goo.gle/3Q2acbB. Also, please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1758082811,884000000]],null,[\"106668054241923666966\",\"Georja Johnston\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJd8Wabn4SVnp5UebJ4RbqqI6GHUcP6RH4znOs3ecgxzpJavQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.37.00.805077116\",null,null,null,null,null,1],[\"03241a52-a2e3-4432-b35f-b1a91c16cdfe\",[\"Cassi\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVpgEzCFOwhx1dxfHdkfUm28HNaHqAqacHtFU1QAX_Tfu4FexR9xQ\"]]],1,null,\"No idea what has changed with Google, but this GPS is absolutely trash now. The directions are awful. It's happened multiple times where the route it says is the fastest takes at least 20 minutes longer than the usual more direct route. I usually use it to check traffic on my way to and from work, and at this point it's completely useless.\",[1740801629,680000000],437,[\"Google LLC\",\"We understand your concern, Cassi. Thanks for the feedback, we really appreciate it! We will pass it on to the right team.\",[1740809232,531000000]],null,[\"104131783490875458776\",\"Cassi\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVpgEzCFOwhx1dxfHdkfUm28HNaHqAqacHtFU1QAX_Tfu4FexR9xQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.08.01.727565367\",null,null,null,null,null,1],[\"664f343a-c343-4836-8ecc-87e84d47193c\",[\"Erin Schwenke\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLkcg0BppZ7C3vV7aQzlRueix9tOxJLL9txgCKXVmR4wLAtew\\u003dmo\"]]],4,null,\"Use it daily and was great. But hate the new pop up for speed cameras, it blocks half the screen so can't see the direction bit and stays up for ages. It also says it's a mobile speed camera but it's not, it's permanent. I tap the no longer there button but still pops up everytime. Can't seem to turn off in settings? Much preferred the old speed camera notifications.\",[1738889434,436000000],441,null,null,[\"107528035820287379841\",\"Erin Schwenke\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLkcg0BppZ7C3vV7aQzlRueix9tOxJLL9txgCKXVmR4wLAtew\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.05.02.719889437\",null,null,null,null,null,1],[\"b397730d-f1c5-41e8-9890-d42fdeb05af4\",[\"Dawn Koch\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWP4aL4ZOwHjlp3XmcIZvZVxLLP349KR9y2PLXrkOvgLEUhc1Y\"]]],1,null,\"When starting the directions, it gives the first verbal command but then that's it. No more audio instruction. Also, there's no longer a way to have it not come across Bluetooth in my car without disconnecting my phone from my car. Everything used to work fine until the last 2 months or so. Very frustrating.\",[1750444880,977000000],218,[\"Google LLC\",\"That doesn't sound good, Dawn. Try the steps in this guide to fix voice navigation problems: https://goo.gle/3PB32ZH. Hope this helps.\",[1750521123,859000000]],null,[\"117757609535460145235\",\"Dawn Koch\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWP4aL4ZOwHjlp3XmcIZvZVxLLP349KR9y2PLXrkOvgLEUhc1Y\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.24.01.768809388\",null,null,null,[true,false],null,1],[\"7136ec4c-da41-4f3d-8f5f-1f7daf3aed50\",[\"John E. Quick III\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXrVTqfjwdESlFH82XSRuREnlCyH6RznN5oNGVWnVcfoZyRytKP\"]]],3,null,\"Why on earth is the \\\"Your visits and Maps activity\\\" section on the very very bottom of any listing on the map? That should be up near the top, where it used to be, not hidden under literally everything else. Some of us use this feature to tell whether we've been somewhere before and when, and shouldn't be hidden. I just recently found it again. Please put this back in the expanded information for locations, where it used to be, so those of us that use it can find it.\",[1750555129,713000000],183,[\"Google LLC\",\"Hi John, thank you for your suggestion. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1750585875,685000000]],null,[\"107765933022054470729\",\"John E. Quick III\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXrVTqfjwdESlFH82XSRuREnlCyH6RznN5oNGVWnVcfoZyRytKP\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.24.02.768809388\",null,[[[\"vaf_never_display_ease_of_use\",null,[5]],[\"vaf_never_display_ads_experience\",null,[5]]]],null,[true,false],null,1],[\"1e22767a-1218-404b-ab4b-0cb6a3c3825d\",[\"Raf Bini\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVt9O6BIaPrS_pkxDWiydT9n8FTqdTt0JDGkeCnRK7EmqtCDYY2\"]]],4,null,\"2 very annoying things with reviews: 1. when you use the separate ratings for \\\"rooms\\\" or \\\"food\\\" or whatever, then go back and edit the review, Maps deletes all the text that was in those boxes! 2. when you try to scroll down and click \\\"see all reviews,\\\" you can't because the nav buttons are covering the link. this is on a pixel 7, Google's own phone!\",[1752414663,25000000],370,null,null,[\"108601635299935409420\",\"Raf Bini\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVt9O6BIaPrS_pkxDWiydT9n8FTqdTt0JDGkeCnRK7EmqtCDYY2\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.28.03.779859351\",null,[[[\"vaf_apps_category_restaurant_v1\",[1]],[\"vaf_apps_category_food_and_drink_v1\",[2]]]],null,null,null,1],[\"d742a8e6-61bb-4942-aed8-fa3c59897d16\",[\"Andrew Watson\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKheQT7WtNjeNThQMySaDnBc2n-EMaexUf0Qxr07BWvKXUhsQ\\u003dmo\"]]],3,null,\"I don't know what happened, but Maps has been giving bad directions a lot more frequently in the past year than it did before. Often, the app will say something like \\\"use the second from the right lane to turn right...\\\". Well, that lane can't turn right, or that lane doesn't exist. It's unsafe at best. Worst, I've submitted multiple corrections over the past year and not one has been corrected. Other than that, the app works great and is easy to use. Just don't blindly follow it like so many do.\",[1762349657,300000000],567,[\"Google LLC\",\"We understand your concern, Andrew. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1762351331,968000000]],null,[\"109316015578503856443\",\"Andrew Watson\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKheQT7WtNjeNThQMySaDnBc2n-EMaexUf0Qxr07BWvKXUhsQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.43.03.821671396.W\",null,[[[\"vaf_never_display_ads_experience\",null,[5]],[\"vaf_never_display_ease_of_use\",null,[5]]]],null,null,null,1],[\"95b7e32d-81d2-4440-b28f-3452080146e4\",[\"David Sherman\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUf9KivnD8ax1au2wDfaUFtTuFJ4SR9JPu_WTDcgtsB1Lt0HS-5\"]]],1,null,\"Timeline is completely broken. History appears to be gone, and refuses to show my backups to import back in. No support available, despite many people reporting similar problems on the forums. Chat support has been no help. Frustrating when this was such a valuable tool. Also note: An error message sometimes comes up now saying tineline doesn't work on Android Go devices, but S24 Ultra is not an Android Go device.\",[1744688458,878000000],173,null,null,[\"100135444255064016682\",\"David Sherman\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUf9KivnD8ax1au2wDfaUFtTuFJ4SR9JPu_WTDcgtsB1Lt0HS-5\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.15.01.744474145\",null,null,null,[true,false],null,1],[\"8fb4a5aa-e01d-4bb3-b10c-6e95a9bb4811\",[\"A Google user\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],1,null,\"the recent update is not just causing issues with iOS. now Android users are not getting options for vehicles when starting navigation. it's defaulting to foot only and not providing options for switching to vehicle. I've tried this on an S24 Ultra with ONE UI7 and an X Cover 7 also with same OS. additionally the navigation ends on the other side of a block and requires one to walk to the other side when there are navigatible streets available right to the address. Not helpful.\",[1751961253,690000000],402,[\"Google LLC\",\"That doesn't sound good. If you're running into issues with Google Maps, make sure you are on the latest version of Google Maps: https://goo.gle/43EOVsN. If you continue to experience the issue, send us feedback here: goo.gle/43OR0Ce. Appreciate it.\",[1751986211,396000000]],null,[\"113943004123963956614\",\"A Google user\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.27.04.777251107\",null,null,null,null,null,1],[\"63eeecb5-298b-4134-a9bd-97a24fd58ddd\",[\"Brad Z\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKKv3kHrEWgvAr5eyu7P2NBKeKoahtPWK-807evZPMMJ7D7I30\\u003dmo\"]]],1,null,\"It's amazing what maps is capable of doing. Its disappointing that it only works sometimes. When I think I can depend on this app (Company) I an reminded, I am not the customer, I am the product. They don't serve me, I serve them. Timeline is completely unreliable. If you're going to include it as a feature, why not make sure it works reliably? Yes, I do understand why. Make improvements, not just changes! They are not the same.\",[1738776920,30000000],1036,null,null,[\"109901955335951775313\",\"Brad Z\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKKv3kHrEWgvAr5eyu7P2NBKeKoahtPWK-807evZPMMJ7D7I30\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.04.01.717552416.W\",null,[[[\"vaf_phase1_calling_businesses\",[3]],[\"vaf_estimating_arrival_time\",[3]],[\"vaf_rerouting_trips\",[3]]]],null,[true,false],null,1],[\"af18c769-2eee-4ee0-89a2-de864301de1b\",[\"Kailen Fitzgerald\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKQKoPNxRczF33Yd1-RlUpzV8068FzfJYruUT0pYobCShezxMF5\\u003dmo\"]]],4,null,\"The app itself works great, I've tried this and apple maps, this is definitely better. The only reason I didn't give it 5 stars is due to not being able to get away from the annoying Google voice. Soo many apps these days have a variety of voice and accent options, this has accent options but its essentially the same voice. The app's functionality is great otherwise except when it wants to take me down a gravel road when there is a paved option with basically the same drive time.\",[1752789251,535000000],506,null,null,[\"108278240759608848407\",\"Kailen Fitzgerald\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKQKoPNxRczF33Yd1-RlUpzV8068FzfJYruUT0pYobCShezxMF5\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.28.03.779859351\",null,[[[\"vaf_apps_category_restaurant_v1\",[1]],[\"vaf_apps_category_food_and_drink_v2\",[2]]]],null,null,null,1],[\"6e41bc45-c85e-48b4-beba-816479607999\",[\"Robert MacGregor\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKBBnupsf76czDA43ATh5_TeNji-zHfgFhafWOnj1p2hf1H\\u003dmo\"]]],2,null,\"Yes it generally works. Except when it doesn't. It frequently has you go a weird way around the block instead of just turning left. I've had it take me through a school campus service road instead of proper roads. It bothers you with notifications about lane closures, which is totally useless information. Yet if you come across a completely closed road, you cannot report it. The only things it should be asking is for cops and actual hazards like objects or flooding.\",[1760366201,90000000],316,[\"Google LLC\",\"Hi Robert, we would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of product experts can assist you: goo.gle/3vosTcH. Hope this helps.\",[1760398596,584000000]],null,[\"105324372300661470897\",\"Robert MacGregor\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKBBnupsf76czDA43ATh5_TeNji-zHfgFhafWOnj1p2hf1H\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.41.03.815390258\",null,null,null,null,null,1],[\"31b1f2c0-d8fc-4ab0-bf84-bc320fb1a182\",[\"IrishMash\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUWKYl-u6EO4vDsgtk6XpB9XO38VBIlv7TMHrxck79A4YNOYdE\"]]],2,null,\"Directions aren't always accurate. Map sometimes breaks and shows another area while navigating and will focus back on that area when the recenter button is hit. Also, where did street view go? pretty cool aerial view, but I work in utilities and sometimes need to see what is on the easement next to street but cannot seem to anymore.\",[1753385799,457000000],215,[\"Google LLC\",\"Hi there, we would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you https://goo.gle/3vosTcH. Hope this helps.\",[1753423183,918000000]],null,[\"112883186294161537235\",\"IrishMash\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUWKYl-u6EO4vDsgtk6XpB9XO38VBIlv7TMHrxck79A4YNOYdE\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.29.00.782600971\",null,null,null,null,null,1],[\"45f46c5a-da35-46ca-a308-fbe095823c38\",[\"Arielle Masters\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUkeju6i81CZxqYUUuYvZ5f_uUfS3oFkAdrt5O4tN6hU0Jf01o9NA\"]]],1,null,\"Despise Timeline being moved to devices. I have more than one account and more than one device. Do not want my data lost. Want it in one place. Want to be able to look back on my timeline to the beginning of my account. Directions: often bizarrely poor, as in: go 1+ exits past, turn around \\u0026 go back, then another u-turn. Or: get off at an exit ramp \\u0026 immediately back on. Or: square wave i/o straight drive. Won't let me tap on other roads I want to take. Doesn't remember my preferred routes.\",[1734255282,683000000],796,null,null,[\"105918208312701285697\",\"Arielle Masters\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUkeju6i81CZxqYUUuYvZ5f_uUfS3oFkAdrt5O4tN6hU0Jf01o9NA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.49.06.703287473\",null,null,null,[true,false],null,1],[\"b49f62e8-fa85-49cc-adc1-94a7091f4686\",[\"Stephen Matthews\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocItln_OZRjjSMpYGGljeOWvFS2iLI2GFTfnGEDT_Xs4MG-Ubg\\u003dmo\"]]],3,null,\"The app is way too needy, always wanting you to touch it, which is dangerous for bikers. It needs Way Points rather than destinations and an easy access pause button to stop it telling you GPS lost whilst you have a wee! And their response - not a single bit on the points I mentioned.......and there's your problem, developers who think they know better and don't listen!\",[1749531062,936000000],149,[\"Google LLC\",\"That doesn't sound good, Stephen. This article has some great tips on getting the most out of your location on Maps: https://goo.gle/3Q2acbB. Hope this helps.\",[1749527767,258000000]],null,[\"104497575100604517319\",\"Stephen Matthews\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocItln_OZRjjSMpYGGljeOWvFS2iLI2GFTfnGEDT_Xs4MG-Ubg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.23.04.765881323\",null,[[[\"vaf_apps_category_food_and_drink_v2\",[2]],[\"vaf_apps_category_restaurant_v1\",[1]]]],null,[true,false],null,1],[\"50cc4ae3-0175-4995-a7bb-2f0333d09fe8\",[\"Maurice Caler\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIW0k-ydvhGgDkaH-NSlUdz2E9SgquycLGYAUbhOqGdMu3cnV8\\u003dmo\"]]],2,null,\"It has become problematic and even dangerous. There are times when it tells me to turn now when I actually need to turn on the second street. Sometimes, it tells me to use any lane for a turn when I have to be in the left lane. It sometimes confuses deadend streets with through streets. The app sometimes has to be force quit to be reset. I am now testing alternatives.\",[1724539064,694000000],100,null,null,[\"113309938253696017573\",\"Maurice Caler\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIW0k-ydvhGgDkaH-NSlUdz2E9SgquycLGYAUbhOqGdMu3cnV8\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.142.0100\",null,null,null,null,null,1],[\"42db4933-5473-4edc-8870-b11b382980b4\",[\"Lady Lauki\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXWpVO-QJIaAFcSn9g6KwFyprD91nUhS640duTNYpyRBzuatISX\"]]],1,null,\"this app has really gone downhill over the last few weeks I constantly have issues where it's lagging behind or it tells me to do something I do it and then it tries to recalculate because that's not what it meant to tell me to do not to mention the fact that now the hands-free drive not to mention the fact that now the drive mode settings for Spotify / YouTube or voice commands no longer exist at the bottom of my screen. good job making this app less safe\",[1749430542,167000000],820,null,null,[\"117498689949164208470\",\"Lady Lauki\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXWpVO-QJIaAFcSn9g6KwFyprD91nUhS640duTNYpyRBzuatISX\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.22.00.763125252\",null,null,null,null,null,1],[\"6974b4de-82b6-4887-b1ea-be9880a9e0dc\",[\"Edward Wang\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWduf09izk8cOx8cwgtf8HMTo5av33d1SXzslDQDy75jfA5tf8_\"]]],3,null,\"Not a fan of the way the watch syncs offline maps with the phone. What ends up happening 99% of the time is that the watch takes forever to download the offline maps, continues to download the map even after disconnecting from the charger, and ends up draining an insane amount of battery as a result. I have to manually kill the app on the watch to stop the download.\",[1732153982,154000000],63,null,null,[\"114862135290132415165\",\"Edward Wang\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWduf09izk8cOx8cwgtf8HMTo5av33d1SXzslDQDy75jfA5tf8_\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.155.0101\",null,null,null,null,null,3],[\"590f8cf1-ba17-4d13-bf24-341e5980a27a\",[\"Gage Hvarre\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWVL5H8dz3KUec5F5I1RL3AMRkFRIQg5e-6htensdGFBeGDxSU\"]]],1,null,\"terrible, I spent so long to figure out how to set it to \\\"walk\\\" instead of \\\"drive\\\". You used to be able to change that when you already started your navigation, and now it's only available to be switched when you're only in the direction fase. why???? it just makes it harder to use for no reason. I'm tired of this monopoly that Google is. maybe if they had real competition, they'd put in the work to make their platforms enjoyable to use.\",[1746220970,119000000],255,null,null,[\"108008079184044911268\",\"Gage Hvarre\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWVL5H8dz3KUec5F5I1RL3AMRkFRIQg5e-6htensdGFBeGDxSU\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.14.00.742022593\",null,[[[\"vaf_apps_category_restaurant_v2\",[2]]]],null,null,null,1],[\"858d8596-d293-487e-b507-696b9b32a828\",[\"Binny Rose\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI5VICUuJWqBdiD1EhsDdgHOwQo3_dZ10HJsD0S1E2ka39J\\u003dmo\"]]],3,null,\"Usually gets me where I need but has the same issues, even after updates: 1. Voice guidance frequently not early enough to make turns in time 2. Directs drivers wrong way down one-ways and through dead ends that aren't recent changes 3. Can't report road hazards/closures unless actively driving, which is impossible in a hands-free state 4. Lowers volume of music from other apps during voice guidance and gets it stuck low until after 2nd song (experienced with different phones and music apps)\",[1750854066,37000000],184,[\"Google LLC\",\"That doesn't sound good, Binny. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you https://goo.gle/3vosTcH. Hope this helps.\",[1750880544,692000000]],null,[\"102035799405906088245\",\"Binny Rose\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI5VICUuJWqBdiD1EhsDdgHOwQo3_dZ10HJsD0S1E2ka39J\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.25.00.771187166\",null,[[[\"vaf_apps_category_food_and_drink_v1\",[2]],[\"vaf_apps_category_restaurant_v1\",[1]]]],null,null,null,1],[\"4dc6b3b3-51a8-464f-a9ed-5fac45c39f5e\",[\"Tracey Wallace\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXUx7cusoM6jSGoTpEU74O1PAEws5PczruuFUSxCLkf2s0Y7iQepQ\"]]],2,null,\"Music while driving went away :( Please bring it back!! First it was radio apps that were removed earlier this year, and now the Spotify button is gone. Also, picture-in-a-picture is turned on in my settings, but that's not working either. Please fix these things!!\",[1753287391,405000000],190,null,null,[\"100241334753577408693\",\"Tracey Wallace\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXUx7cusoM6jSGoTpEU74O1PAEws5PczruuFUSxCLkf2s0Y7iQepQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.29.00.782600971\",null,null,null,null,null,1],[\"cce90083-20d8-49b3-807e-3f6bce3f3dc5\",[\"Grace McCarter\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX8S438KIKLmlFucdl-19Iq1pdJoXJqj6J77Jc67pVGWXsViCkN\"]]],1,null,\"Most of the time when I open it it doesn't load, it's just a plain blank screen and hangs there for as long as it takes for me to get frustrated and close and relaunch. If there's not an update soon I'll be forced to try different apps. It's a shame as this is what I'll open first to find places to eat.\",[1725803004,704000000],91,null,null,[\"115080186614807645069\",\"Grace McCarter\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX8S438KIKLmlFucdl-19Iq1pdJoXJqj6J77Jc67pVGWXsViCkN\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.144.0105\",null,null,null,null,null,1],[\"59bbc5e4-2f96-4768-82f5-895a2913c248\",[\"Helen Back\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVqHV1iMJivnn9PYcPvopzJguObV9suSlok0ZU1y9LQboOmNKXMcg\"]]],1,null,\"This app is indispensable to me. HOWEVER - when the sat nav is running and I'm driving, a box will regularly pop up covering most of the route I'm trying to follow with questions such as, is the lane still closed? In the UK, it is illegal to interact with a mobile phone while driving. Not only that, when I'm driving at 70mph on the motorway, I don't want to be touching my phone's screen. Google, you really need to do something about this coz it's very dangerous.\",[1748697140,230000000],263,null,null,[\"103551816085490553259\",\"Helen Back\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVqHV1iMJivnn9PYcPvopzJguObV9suSlok0ZU1y9LQboOmNKXMcg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.21.01.760306150\",null,null,null,null,null,1],[\"3ea3f9cc-0888-402a-b4ea-c094e155e3f1\",[\"Raven Anne\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJO992Ts9yDJBd2kuXEM0DIu5pb1EK0V2oWMVJhNwmGZPHjJA\\u003dmo\"]]],1,null,\"Updated to add \\\"features\\\" it already had and removed others. You now can't view another route while on a \\\"trip\\\". It no longer vibrates to warn you of your stop when bussing. The priority feature is non functional. Menus clip where the didn't before. You get a huge \\\"trip started\\\" notification that doesn't go away for soooo long and blocks things. Notifications are blank 2/3 of the time. Notifications that do work show the wrong bus time. Why? (8/08/24-23/0/7/25) Nearly a year later, no fixes.\",[1753254218,688000000],313,null,null,[\"102224328391281693634\",\"Raven Anne\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJO992Ts9yDJBd2kuXEM0DIu5pb1EK0V2oWMVJhNwmGZPHjJA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.29.00.782600971\",null,null,null,[true,false],null,1],[\"e39ee07e-a15c-40a9-8c3c-58c5e17fa42c\",[\"Daniel Wood\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIAJIQ9BhNt1PkOZHZveMtD9v9K2eFTrPIlJGtIHUuzihsVPg\\u003dmo\"]]],1,null,\"keeps freezing and becoming unresponsive. I've had to pull over to restart the app whilst driving. Keeps running even once you've reached your destination. And some idiot thought it would be a good idea to ask you if you want to change the arrow icon to a toy car, while you're driving through a busy city?!\",[1724058662,399000000],111,null,null,[\"116718143406049007753\",\"Daniel Wood\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIAJIQ9BhNt1PkOZHZveMtD9v9K2eFTrPIlJGtIHUuzihsVPg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.141.0102\",null,null,null,null,null,1],[\"0e562317-096b-4322-99b3-6b993ee378a8\",[\"Frederickthe Photographer\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXV0HT7ZsWa9X_XSxbqzjg7PZOOPh5sYWTeUI5E27imdKID_xk9ng\"]]],1,null,\"Was a great app. Recently, all of my timeline history from over 10 years has been erased. I checked all of the settings and made sure my app was updated to the latest version. Everything was set to how google said that it should be if you wanted to keep your history. I'm not happy at all. The Mrs has lost all of her history as well. Hopefully, they can fix this. If not, we have to start using something that's reliable.\",[1742756043,192000000],1855,null,null,[\"110151722416664292676\",\"Frederickthe Photographer\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXV0HT7ZsWa9X_XSxbqzjg7PZOOPh5sYWTeUI5E27imdKID_xk9ng\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.12.01.737373685\",null,null,null,null,null,1],[\"5f89968f-ba33-4508-9162-f756480df26c\",[\"Ethan Ryans\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUWm3Iu5mF_nR2NYh1r7q3xFHf99hvgH_2Jis4TEGBLMKN7OmEu\"]]],1,null,\"Trash! App won't start right away 100% of the time. I've to literally force close the app up to 10 times, sometimes more just for maps to load! Makes this completely unreliable for navigation when I have to pull over, sit there and wait to figure out exactly where I'm going.\",[1728647003,920000000],95,null,null,[\"117554051537434906692\",\"Ethan Ryans\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUWm3Iu5mF_nR2NYh1r7q3xFHf99hvgH_2Jis4TEGBLMKN7OmEu\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.149.0101\",null,null,null,null,null,1],[\"1b894f4b-b742-4776-826f-286551370f11\",[\"Alicia Perez\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLAqiSjKuVAJHcUdehltJXs0vfqwhyfXiJ1hn35phe3ZbhD\\u003dmo\"]]],1,null,\"Since the recent Google Maps update, when I have toggled on the media playback controls the overlay is partially covering the Report Button. The new media playback UI has smaller text and I struggle to read the name and artist text when my phone is mounted on my car dashboard. The previous media playback UI had bigger text that was easy to read at a glance. Please consider making the text bigger.\",[1744844053,808000000],148,null,null,[\"112423412396634594025\",\"Alicia Perez\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLAqiSjKuVAJHcUdehltJXs0vfqwhyfXiJ1hn35phe3ZbhD\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.15.01.744474145\",null,null,null,[true,false],null,1],[\"0f8bf870-ecc2-47da-bf42-d1d0bce83acd\",[\"CAPTAIN SLACKBEARD\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVU24L-qClifI8lizraLPh0CpFyBsmEIqGO8YZEQwA-DnMaV8k\"]]],1,null,\"This is supposed to be Google MAPS not Google Reviews. I don't need to know about reviews I've left for businesses that I have visited when I'm trying to find the closest hospital in an emergency situation. That should be an entirely different app, or a secondary option AFTER the maps option. Also, that notice upon opening the app about how posts appear needs to go away. Just another step to have to go through that takes time from a possible life threatening situation.\",[1740512467,268000000],220,null,null,[\"107414625870759293495\",\"CAPTAIN SLACKBEARD\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVU24L-qClifI8lizraLPh0CpFyBsmEIqGO8YZEQwA-DnMaV8k\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.08.01.727565367\",null,null,null,null,null,1],[\"b67de42a-37cb-4afb-9923-872bb2c11e3b\",[\"James Hawthorne\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLmlShLdBSBaBbUjX0ZcYunWTNaB1iIPryDxj2RLQf3cFh5LQ\\u003dmo\"]]],3,null,\"updated 21 May 2025 routes still using off ramps on ramps to by pass traffic. the still not showing alternative routes while driving. We used to use that feature a lot. when driving see alternate route was great, if it showed route going through town and another that does not but the route not through town is 4min slower I would take the slower out of town because through town generally is slower in the end. also not sure why traffic alerts shows speed/stop cameras as police instead of camera\",[1748053930,245000000],130,[\"Google LLC\",\"That doesn't sound good, James. Thanks for the feedback, we really appreciate it! We will pass it on to the right team.\",[1745576150,184000000]],null,[\"111809215383291616551\",\"James Hawthorne\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLmlShLdBSBaBbUjX0ZcYunWTNaB1iIPryDxj2RLQf3cFh5LQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.20.03.757436837\",null,null,null,[true,false],null,1],[\"9ffb1a0e-3124-4cd6-b9e6-1920174269ec\",[\"Dennis Hoage\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIFo7UWhWZdNavNSrz8AhFFfvuixx26242ma2L8v3V9bOOR4A\\u003dmo\"]]],1,null,\"2 new problems. Report popups (police,disabled vehicle,congestion) are dangerous-a huge banner now blocks the next step in navigation \\u0026 trying to dismiss them while driving is just asking for an accident. Then removing Timeline from web-this was a great way to track my time at jobs. Now it's gone. Seriously Google, what are you thinking? Previously my gripe was not having the option to indicate whether you drive a commercial vehicle/truck as some states restrict access on certain roads/hwys. 👎\",[1734926436,7000000],692,[\"Google LLC\",\"Thanks for the review, Dennis! Submitting this as a feedback report: Open Maps - Side menu - Send feedback - Your opinions about Maps - Submit, will help us ensure that this gets reviewed by the right team.\",[1539230480,341000000]],null,[\"111658703550329801266\",\"Dennis Hoage\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIFo7UWhWZdNavNSrz8AhFFfvuixx26242ma2L8v3V9bOOR4A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.49.01.704458091.W\",null,[[[\"vaf_automatic_re_routing\",[2]],[\"vaf_phase1_commute_alerts\",[1]],[\"vaf_seeing_photos_of_places\",[1]]]],null,null,null,1],[\"449ebf60-effc-4b3a-8593-edd529eccbfe\",[\"Samantha Michalowski\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKW-a61uTCO3b8d_uDBfQoGlid8wjcox1mT1RD1IZGq5qVE4g\\u003dmo\"]]],4,null,\"Gets me where I need to with minimal issues. However as someone who drives a lot, the microphone icon, compass and other static features on the screen are permanently burnt into my screen. A periodic screen refresh might be good to implement, even if it's just refreshing the static elements only.\",[1748997058,945000000],297,null,null,[\"110632566947269018324\",\"Samantha Michalowski\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKW-a61uTCO3b8d_uDBfQoGlid8wjcox1mT1RD1IZGq5qVE4g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.22.00.763125252\",null,null,null,null,null,1],[\"eda7a2d0-cbd4-4e2a-965a-7338e3cc8ea6\",[\"Edward Wang\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWduf09izk8cOx8cwgtf8HMTo5av33d1SXzslDQDy75jfA5tf8_\"]]],2,null,\"I'm always amazed by Google's ability to take an app that was working perfectly fine and then proceed to make it worse so they can implement a subpar AI assistant. Google taking away the ability to control music playback during navigation via the bottom bar has been pretty annoying. The compass not working half the time, even though other apps have no issues, is a joke. And, the map not responding to touch inputs for a bit when you have poor data is also annoying. Google, do better.\",[1753064956,141000000],231,null,null,[\"114862135290132415165\",\"Edward Wang\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWduf09izk8cOx8cwgtf8HMTo5av33d1SXzslDQDy75jfA5tf8_\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.28.03.779859351\",null,null,null,null,null,1],[\"8f6b1333-f954-4fbd-b160-dd80523af163\",[\"Albert T\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK__FZJeUWsGBPIVI5oJj9XrDIX3uOCVRebRjz0Ea9XXwlpjw\\u003dmo\"]]],1,null,\"Google maps and the staff that is assigned to Google maps is just garbage 🗑. The timeline feature just doesn't accurately record how and when I traveled. and when I tried fixing it, it always said, \\\"something went wrong.\\\" I sent numerous feedback/reports to fix the issue. And no response from Google and timeline display serious flaws. What's the point of having timeline if the user can't fix issues?\",[1749680211,413000000],1215,null,null,[\"103521433723781100665\",\"Albert T\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK__FZJeUWsGBPIVI5oJj9XrDIX3uOCVRebRjz0Ea9XXwlpjw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.23.04.765881323\",null,null,null,[true,false],null,1],[\"26c4dce0-56a7-49c0-8d43-7f4178f0b479\",[\"Samantha Davenport\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLKVzBSXc5pOJgP89dolYd43mmxuXfmJ-LrPLOOP5OoFo7hJg\\u003dmo\"]]],1,null,\"Google Maps has become unreliable lately. GPS is often half a mile off, and highway splits lack clear directions. The app removed the stalled vehicle report feature and made incident reporting harder, which is unsafe. I live in DFW, TX and need to avoid express lanes but still use toll roads—yet the app groups all tolls together. I used to love this app, but now it’s a frustrating and unsafe tool while driving.\",[1749430554,428000000],166,[\"Google LLC\",\"That doesn’t sound good, Samantha. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of product experts can assist you: goo.gle/3vosTcH. Thanks.\",[1749513474,941000000]],null,[\"110257186600444553368\",\"Samantha Davenport\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLKVzBSXc5pOJgP89dolYd43mmxuXfmJ-LrPLOOP5OoFo7hJg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.22.00.763125252\",null,null,null,[true,false],null,1],[\"3234421b-222d-4c9b-b047-ddb47ba40e0c\",[\"Shauna Kreider\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIUZq-LnRWVArkQvIFbXL9ev3KJj8WySiyenLpGhAwU2_6xzw\\u003dmo\"]]],4,null,\"I recently got a new phone and there is one change to the newer version of google maps I don't like. I miss the \\\"Steps\\\" button that was on the older version. Locally, I use Maps to determine the best route, especially if there are multiple possible ways to go. All I need to see are the recommended STEPS, and I'm off. I used that functionality so often, I truly miss it in the newer version. Instead, I have a Share function - I've never shared my route, that's has fast less usefulness.\",[1725033054,720000000],197,null,null,[\"110237818241118921222\",\"Shauna Kreider\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIUZq-LnRWVArkQvIFbXL9ev3KJj8WySiyenLpGhAwU2_6xzw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.143.0305\",null,null,null,null,null,1],[\"ecfe23a7-8799-4b55-ae61-6475d4e36ba5\",[\"Jayne de Catte\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX0RbV8UKs7-TL1Li-XlXtzj6D8y84AAjCQp2FOwFHYxODSCB-i\"]]],3,null,\"I hate the recent update where the directions are automatically shown when you click on a location. It always says \\\"click to improve accuracy\\\" but the location is as accurate as it could be. I do really like the dark mode and am very happy that it is now available on my tablet\",[1724263592,447000000],67,null,null,[\"107623598255450682928\",\"Jayne de Catte\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX0RbV8UKs7-TL1Li-XlXtzj6D8y84AAjCQp2FOwFHYxODSCB-i\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.141.0102\",null,null,null,null,null,1],[\"5528d585-6894-4a02-a96e-eb3540a5e519\",[\"Jessica Spratt\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWl2Ygek2mfCWy8JAbIl_RWevzZtxKn8U07NXTMePwRHRXB3nlp5w\"]]],2,null,\"It was a pretty sound navigation app until this most recent update when the ability to access Google assistant from the driving navigation screen is gone as well as it not automatically putting your phone into do not disturb mode anymore to prevent distraction from notifications. Very disappointed and hope this is going to be fixed quickly.\",[1746312619,446000000],118,[\"Google LLC\",\"Hi Jessica, if you're running into issues with Google Maps, make sure you are on the latest version of Google Maps: https://goo.gle/43EOVsN. If you continue to experience the issue, send us feedback here: goo.gle/43OR0Ce. Appreciate it.\",[1746392755,481000000]],null,[\"114145794367665915463\",\"Jessica Spratt\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWl2Ygek2mfCWy8JAbIl_RWevzZtxKn8U07NXTMePwRHRXB3nlp5w\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.17.00.749564752\",null,[[[\"vaf_apps_category_restaurant_v2\",[2]],[\"vaf_apps_category_food_and_drink_v1\",[2]]]],null,null,null,1],[\"2fc380da-f1a4-4b61-99d5-9a2b3a01ecd5\",[\"Luke Porterfield\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW99QuGEBSYX_KPcJzAZJs_KBNZwJ6nl78RCcuC32CUz6XXtb8f\"]]],1,null,\"I don't know what's going on lately, but every update makes the app worse and worse. first a bad UI update, then progressively worse issues with navigation, and now media controls are fully removed??? Like, are they actively trying to force users away, I don't get it. Need a viable alternative ASAP, because this is junk at this point\",[1752867358,783000000],155,null,null,[\"114997942798775553916\",\"Luke Porterfield\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW99QuGEBSYX_KPcJzAZJs_KBNZwJ6nl78RCcuC32CUz6XXtb8f\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.28.03.779859351\",null,null,null,null,null,1],[\"c38475ac-f5d9-4343-aaf0-19e2bbcb57c2\",[\"Michael C\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWBjJF7NfZgewp8mB_m4PM7ZGGZ-20UbnToJBYi8Sir7lieu1kC\"]]],1,null,\"Save button / submit button covered by 3 button navigation, making updating work address, etc, impossible! Absolutely ridiculous, like they don't even use their own app! I find gesture navigation to be absolutely cancer, but Google seems to insist on forcing that garbage on to people! Stop forcing garbage gesture navigation on people and make your apps work with normal easy-to-use 3 button navigation! Just updated to latest, still not fixed!\",[1751058678,354000000],189,[\"Google LLC\",\"That doesn't sound good, Michael. Thanks for flagging this. We will pass this to the right team.\",[1751132426,423000000]],null,[\"114292724008388514920\",\"Michael C\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWBjJF7NfZgewp8mB_m4PM7ZGGZ-20UbnToJBYi8Sir7lieu1kC\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.25.02.771187166\",null,[[[\"vaf_commute_alerts\",[2]],[\"vaf_never_display_useful_notifications\",[2]],[\"vaf_phase1_calling_businesses\",[1]]]],null,[true,false],null,1],[\"54cef3da-1653-42e7-b1bc-857b7c5ce037\",[\"MaryAnne Pena\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXBO8_rxzQXYGitjlVRnY7m9_cAXbKy6hylPC52V_7-SvdtCS65\"]]],1,null,\"Recently the app stopped showing me real traffic times and keeps directing me into express lanes even with tolls turned off. UPDATE This app had just gotten worse. It finally discovered the express lanes, but when I turn on tolls it won't show the different travel times side by side to determine if it's worth paying. And what's with the stupid pop up screens asking me to report if a cop is still there? It's really distracting and not safe.\",[1733248117,8000000],114,[\"Google LLC\",\"Hi MaryAnne, we would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of product experts can assist you goo.gle/3vosTcH. Hope this helps.\",[1714144504,286000000]],null,[\"112511333314630079919\",\"MaryAnne Pena\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXBO8_rxzQXYGitjlVRnY7m9_cAXbKy6hylPC52V_7-SvdtCS65\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"24.47.04.699095382\",null,null,null,[true,false],null,1],[\"71aa0d68-d85b-4670-bb9e-d12e212f17be\",[\"Thomas Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXuc-oWEJ74o7NX4w_Nogz3R7neprIB4eIm2TGIHSjN663jw4M\"]]],2,null,\"The main app works well. However, I have had a persistent problem with the notifications at a time that I need minimal distraction from my phone. Despite turning off all appropriate notification permissions, for months I keep getting get asked if I took a different route than suggested by Google. Apparently asking to not receive notifications about quality improvement means nothing to the dev team.\",[1726164395,701000000],57,null,null,[\"115716401422470100061\",\"Thomas Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXuc-oWEJ74o7NX4w_Nogz3R7neprIB4eIm2TGIHSjN663jw4M\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.145.0101\",null,null,null,null,null,1],[\"a352551e-b136-4d57-b7d5-2148141647c6\",[\"Jess\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXEHoH6CFBxoUjspc2gixlAhEl4RRg6uwNVcLTnlVPdqm64lilK\"]]],1,null,\"I used to love Google Maps when it first came out, it had everything you needed and everything was very simple and intuitive. Slowly over time they have made it worse and worse and worse so now it is barely usable. Simple things like viewing your route, like the text description of your route they either don't show you anymore or make it very hard to find it. It is so unusable how all these things they say are improvements just make the app worse and worse.\",[1728913609,692000000],201,null,null,[\"108464983515386611614\",\"Jess\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXEHoH6CFBxoUjspc2gixlAhEl4RRg6uwNVcLTnlVPdqm64lilK\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"11.150.0100\",null,null,null,null,null,1],[\"ac14c3f5-d716-4098-9895-f70c2c46f1c7\",[\"Lauren Johnson\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWl5g2uJF_fq5fpRYCdN6LFlb7kzWvq6II5BxdWRvnraFdezOo\"]]],1,null,\"This app functionality has nosedived in 2025. How about y'all stop releasing updates that remove functionality from the app. I can no longer control Spotify from the Maps nav screen (in Driving Mode) because Media Playback Controls is missing from the Navigation Settings menu. Spotify is connected to Maps but the menu to select a default audio player is simply missing from the Settings. Assistant also stopped notifying me of messages and offering to read them and respond when in Driving Mode.\",[1752705025,570000000],335,null,null,[\"114562281145701911583\",\"Lauren Johnson\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWl5g2uJF_fq5fpRYCdN6LFlb7kzWvq6II5BxdWRvnraFdezOo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"25.28.03.779859351\",null,null,null,[true,false],null,1],[\"a1258855-f4e6-4935-b55e-4ace1d4d9292\",[\"AE\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJDgipvSvPtXBolHay5MC-_H3SK_3f7Jbt9mmrTexez7Amugg\\u003dmo\"]]],1,null,\"If you're looking forward to being surprised by changes in roads and bus routes that have been in effect for months, in some cases, an application that zooms out of the portion of the map you're trying to navigate to instead show you the entirety of the continent you're currently on, this is the app for you! For the low, low cost of no privacy and brand duopoly, it will even remind you monthly of all the trips it failed to navigate for you.\",[1779193439,46000000],4,[\"Google LLC\",\"Hi there, we would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1779205351,64000000]],null,[\"102058116756320003159\",\"AE\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJDgipvSvPtXBolHay5MC-_H3SK_3f7Jbt9mmrTexez7Amugg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.19.06.908805368\",null,null,null,null,null,1],[\"bbab7c8c-f3ec-496f-afd4-b7db77d20d58\",[\"M\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLU2WJeRLmdpZX9vo4LKu9V0uN2uLcDP94mwZU9COPNNLx5qW3D\\u003dmo\"]]],1,null,\"Same issue as others have pointed out, the app is so unreliable that it's unusable. It shows as offline most of the time, even when the connection and other apps are fine. Even though I have downloaded offline maps nothing works, it doesn't even show my location! I had to use the Uber app to see my location and which way to go. There shouldn't be a need to have a backup map app!?!! Clearing cache and reinstall doesn't help, at this point I can leave it uninstalled. enshittification\",[1779344943,631000000],2,[\"Google LLC\",\"That doesn't sound good, thank you for your suggestion. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1779348338,906000000]],null,[\"101855041199373582988\",\"M\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLU2WJeRLmdpZX9vo4LKu9V0uN2uLcDP94mwZU9COPNNLx5qW3D\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.20.01.913318892\",null,[[[\"vaf_app_quality_performance\",[2]]]],null,null,null,1],[\"e6ab3549-bcbd-4e4f-9855-3cc6b4754bc7\",[\"Jen Odd\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVPu-5fN_RNM31kQpQtzoqi0KuCrehKHQBMPRIXazIbeV-P8oNZ\"]]],1,null,\"Useless bloated mess that doesn't give you results you search for and no way to toggle saved icons on and off. The new UI and forced AI slop makes finding information for locations more difficult. Sponsored locations constantly get in the way. There's also a bug that causes the app to constantly zoom out. Update: I've installed Yahoo maps and it's AMAZING. I don't get any of the issues I have with Google.\",[1779658394,821000000],4,[\"Google LLC\",\"We understand your concern, Jen. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1779547495,112000000]],null,[\"104714900102227965867\",\"Jen Odd\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVPu-5fN_RNM31kQpQtzoqi0KuCrehKHQBMPRIXazIbeV-P8oNZ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.20.02.913318892\",null,[[[\"vaf_app_quality_ads_intrusiveness\",[1]],[\"vaf_app_quality_stability\",[2]],[\"vaf_app_quality_battery_heat\",[1]]]],null,[true,false],null,1],[\"cb7b6539-8cbf-4eea-8d61-b634035abe98\",[\"Ball of goo\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVpyCm0uwg8o_6qz-0CcoVM9xgOi2nVfJvw8tKg8hAUUzLBUrzQ\"]]],3,null,\"Within the past few months, the functionality of the navigation in this app has exponentially plummeted, and I'm willing to bet a large part of it is that the programming team has been offloading patches to ai. Lately it's been giving nothing but inaccurate estimates and cluttered routes. Just as an example, the other day I was given a 6 minute total trip estimate, despite even the initial bus at the start of the trip not being expected for a solid 15 minutes.\",[1780506124,918000000],2,[\"Google LLC\",\"We understand your concern. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1780528783,296000000]],null,[\"110562220077408752282\",\"Ball of goo\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVpyCm0uwg8o_6qz-0CcoVM9xgOi2nVfJvw8tKg8hAUUzLBUrzQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.22.04.920688788\",null,[[[\"vaf_app_quality_battery_heat\",[2]],[\"vaf_app_quality_ads_presence\",[2]],[\"vaf_app_quality_ads_frequency\",[3]]]],null,null,null,1],[\"9a1504eb-5bf6-4299-a456-f4ce0403a1d4\",[\"Zoe Jobson\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVznkQIVq1WUAIXXyWEo8b19pd_Mwlbl0W3d5GARI8HDmc-cqJk\"]]],2,null,\"it needs an option to stop routing down small country lanes. it's not faster, you have to drop speed to safely use them, and when driving you can't tell what is a lane and what is a regular road. Devon is mostly tiny lanes, it needs to be possible to turn them off. Also, when pre routing, then driving the route the app should stop offering alternative options, it's very confusing visually to see your route map covered in Criss crossing options. I've used this for years it's becoming unusable.\",[1779521848,308000000],4,[\"Google LLC\",\"We understand your concern, Zoe. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look. Appreciate it.\",[1779525260,827000000]],null,[\"112730043987594074167\",\"Zoe Jobson\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVznkQIVq1WUAIXXyWEo8b19pd_Mwlbl0W3d5GARI8HDmc-cqJk\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.20.01.913318892\",null,[[[\"vaf_app_quality_stability\",[1]],[\"vaf_app_quality_ads_intrusiveness\",[2]],[\"vaf_app_quality_ads_frequency\",[2]]]],null,null,null,1],[\"7eece5fc-9d3d-4e12-a51a-de17dfaa3d4a\",[\"P T\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU8D-CpA4TMIw8yjB40UgeSJ5qO2NF3VTndMQsz7Qy7PUQNs-KTLQ\"]]],2,null,\"Used to really like Google Maps, but recent updates have made it unreliable. Most of the time it's correct, but abt 25% of the time it'll either... 1). take me via a ridiculous route (extremely narrow lanes when there's absolutely no need) or, 2). give conflicting voice \\u0026 map guidance (which can be extremely confusing \\u0026 hazardous.) It also rarely retraces the same return route for any given route (with no obvious explanation). Unfortunately, it cannot be trusted.\",[1779831953,91000000],5,[\"Google LLC\",\"That doesn't sound good. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1779877053,869000000]],null,[\"109332781469895467536\",\"P T\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU8D-CpA4TMIw8yjB40UgeSJ5qO2NF3VTndMQsz7Qy7PUQNs-KTLQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.01.916832833\",null,[[[\"vaf_app_quality_ads_frequency\",[2]],[\"vaf_app_quality_battery_efficiency\",[2]],[\"vaf_app_quality_stability\",[1]]]],null,null,null,1],[\"c6ca9112-7fb1-425c-81b4-1808c4b7bba5\",[\"Chris Maddison\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK4RtqkXzBfyt0WP9MrxxAD2eyIufPKxXSXVPzFqlXuvipC_w\\u003dmo\"]]],2,null,\"I am very frustrated! I can't modify a route when I use the app on my phone. do i modify on my laptop and then send the route to my phone. I have been trying to report bad road conditions as well in order to prevent a road from being included in my route. short of saying tje road is closed, there is NO way to identify a road that is not travel worthy!\",[1779970774,209000000],3,[\"Google LLC\",\"We understand your concern, Chris. We would love to learn more about the issue and help. Please create a post in our Google Maps forum so that our community of experts can assist you: goo.gle/3vosTcH. Appreciate it.\",[1779971306,768000000]],null,[\"102016420427598434177\",\"Chris Maddison\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK4RtqkXzBfyt0WP9MrxxAD2eyIufPKxXSXVPzFqlXuvipC_w\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.01.916832833\",null,[[[\"vaf_app_quality_battery_heat\",[2]],[\"vaf_app_quality_ads_frequency\",[2]],[\"vaf_app_quality_stability\",[1]]]],null,null,null,1],[\"fa804684-851b-4b9a-af99-bd91339b9578\",[\"Kaz Lizzard\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXww1mlcPylkdBWKPYLxG5mFGUSBN5XBllanuY4ngQVKMfWKDwLOA\"]]],1,null,\"Google maps voice navigation no longer works. It used to come through my car speakers but not any more. I've checked my mobile phone settings. I've even tried turning bluetooth off to see if the voice navigation works on my phone but it doesn't. Also why has Android auto stopped connecting to my car after update a months ago. I've tried everything to get it connected again. Multiple searches on google, nothing works. If this is app belongs to google please sort them out.\",[1779147663,399000000],4,[\"Google LLC\",\"Hi Kaz. Try the steps in this guide to fix voice navigation problems: https://goo.gle/3PB32ZH. Hope this helps.\",[1779153818,462000000]],null,[\"113537950357486701287\",\"Kaz Lizzard\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXww1mlcPylkdBWKPYLxG5mFGUSBN5XBllanuY4ngQVKMfWKDwLOA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.19.06.908805368\",null,null,null,null,null,1],[\"67b6211e-06ae-4f83-9986-9f81a532ae8e\",[\"Mr Magic man\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjURH4mfrVaRv5aDIGdFFWPfmCYut_UiE1hWwlKTLEUClkr3440\"]]],1,null,\"I have used google maps for years with great success, but lately, It has a mind of its own, probably because of google and microsoft forcing useless AI into every crevasse they can. It takes me on the strangest routes to places, changes the route while driving and has constant popups which I have to click away, Its dangerous to use while driving now, and I will no longer be using it going forward. It served me well for many years, but AI has ruined yet another thing I once used all the time.\",[1780086195,67000000],4,null,null,[\"105732241654931378788\",\"Mr Magic man\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjURH4mfrVaRv5aDIGdFFWPfmCYut_UiE1hWwlKTLEUClkr3440\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.02.916832833\",null,null,null,null,null,1],[\"6859905a-4263-4967-9a0d-52c2175fff35\",[\"Callum Munro\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUq_uzzteolrE2jLRjdet_NR_LoeCF7_9gOM-B1oAYvWMS48tpd\"]]],2,null,\"They've added an AI feature (which can't be turned off), that gives you information (which isn't necessarily correct) about locations that you view which it thinks you might need to know before visiting. Important note, it does this even if you've already visited the location before. However, for every single piece of information, it does stress that it's just what people say, so Google obviously isn't liable if (when) it's wrong, you can't blame them\",[1779573567,138000000],4,null,null,[\"109567500170955811183\",\"Callum Munro\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUq_uzzteolrE2jLRjdet_NR_LoeCF7_9gOM-B1oAYvWMS48tpd\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.20.01.913318892\",null,null,null,null,null,1],[\"6b391fa3-9cd9-4d7d-b52a-03c96493890a\",[\"Luisa Giuliani\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW7mUjK8KsM2GeRYxFuCVL6kOJ3tVcM3a5JySesfneMvds7stKi\"]]],1,null,\"no shortest route preference anymore! It used to be a great app until they removed the possibility to set the shortest route in the preferences. Now the app chooses every time 10 km longer route to save as little as 1 min and forces me back on the longest route right after I select the alternative itinerary over and over again. Inefficient, polluting, and imposing.\",[1779702021,87000000],5,[\"Google LLC\",\"Hi Luisa. Please send us all the details of your issue by following the steps in this article: https://goo.gle/355m3NU and the product team will have a deeper look.\",[1779702863,277000000]],null,[\"111683818621604982623\",\"Luisa Giuliani\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW7mUjK8KsM2GeRYxFuCVL6kOJ3tVcM3a5JySesfneMvds7stKi\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"26.21.01.916832833\",null,null,null,null,null,1]],[null,\"CroBIrEBAU60USc0jm2Ps4haLPoSm2pVhPlkJ8AN9xF3As2f54cBg0rrc3UFNV9VcpwtPl_L2wYiKV747NkbJUDsNIb1J9-TlmtdmeDndrzooc4PlPdzuk8Lpyrnr_dow2Y9bQTVyXBaf-7TTKzASgLnOAVHZlDFNzFw8woNZ1X1CjImwfy6aY59RdP4ilsytX_0jK9TJUR0i6GJt3l1ibyxn_qG3uUjqxcKuyIDPxrst8rHJVs5KJzcptEG\"],[[null,[[1800],null,[72000]]]]]",null,null,null,"generic"],["di",122],["af.httprm",122,"-6695575708513805315",1]]