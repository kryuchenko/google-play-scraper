.googleusercontent.com/TwmJX5J55boD5QrwZx1wn5gd2_wFA8M36SUvHyU45Un0wOFZSrsDg07oruKfT4GrgeuJ8PkHvMrVheDQwi7i\"]],[null,2,[2064,2752],[null,null,\"https://play-lh.googleusercontent.com/pqBauJqQtUJLTGN02HQdhSxgbMYLzuFegSI6wDK8cpb1_-4wS7m3aNuTT4iLrIJrrRDslG_Vk53kz_B4HCx2HxI\"]],[null,2,[2064,2752],[null,null,\"https://play-lh.googleusercontent.com/YPiqpW0H-tnczfbKYa0aYe7hjpQ-52d4Nb9Dtb5jmBkzsq1GJRAoNdX6yVlRomK1kPH-Tkb-ARGvmv2sWpW57Q\"]],[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/g_7WMqHLD-_tnoePx4wnt_BXBb5bZkqQ9gsfd7h4COG8IG2qzjMX4w1jlKYO1K_eDa93rOuaXFC9cTMz1puUoQ\"],null,[96,97,91,255]]],\"Mods \\u0026 Skins for Minecraft PE\",[\"4.6\",4.5831523],\"Entertainment\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.lyxoto.master.forminecraftpe\\u0026rdid\\u003dcom.lyxoto.master.forminecraftpe\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.lyxoto.master.forminecraftpe\"]],[\"qgJWGlQIC0oTCPWMn8vR2pcDFXkHswYdHWoi8PoBDwoNCAASCQoFZW4tVVMQALICKAomCiBjb20ubHl4b3RvLm1hc3Rlci5mb3JtaW5lY3JhZnRwZRABGAM\\u003d\"],[[[null,null,\"d3BNcsPSPoE\",[null,null,\"https://www.youtube.com/embed/d3BNcsPSPoE?vq\\u003dlarge\\u0026rel\\u003d0\\u0026autohide\\u003d1\\u0026showinfo\\u003d0\"],\"yt:movie:d3BNcsPSPoE\",null,null,null,null,\"AXH1ezkG3ku4v84cYsWOfHwoZas5wDfiC6SkNHDWW2oI2vMiGEEJO7kWAx_FWh56x-8efVxcl_z0owZVA1-oq3KJJdA1Y7ORafGY-0FvxC77U_Jr1wsXx18reKf3kTJ6Wm6W3ITPHA-O5_fDj8C5UGODBNl1MKxTwTbhC4ThdScEUnSBDwLLUXagjdSfcd1gcnQE_Y6dbvsl_SvyXCb6k1wxVcEtHIu2OFJUHXTfb815bJRlRAwldk4lT5e2bbDQoPiHx67saHaaqIVyk3ASCVIdlSJWG9lmay4HGBZiRH4SdGMjUQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/d3BNcsPSPoE/hqdefault.jpg\"]]]],[null,\"Mods, addons, skins, maps and more for Minecraft PE (MCPE / Bedrock Edition). Discover MCPE mods, addons and content for Minecraft Bedrock, customize your worlds, and install content directly into the game.\\u003cbr\\u003e\\u003cbr\\u003eFind a large collection of content for Minecraft PE in one app: mods, addons, maps, skins, buildings, textures, shaders and seeds. Browse categories, preview content and quickly add it to your Bedrock worlds.\\u003cbr\\u003e\\u003cbr\\u003eMODS \\u0026amp; ADDONS FOR MINECRAFT PE\\u003cbr\\u003e\\u003cbr\\u003eExplore MCPE mods and addons for Minecraft Bedrock Edition:\\u003cbr\\u003e\\u003cbr\\u003e✅ Furniture and house addons\\u003cbr\\u003e✅ Animals and mobs\\u003cbr\\u003e✅ Weapons and equipment\\u003cbr\\u003e✅ Cars, vehicles and transport\\u003cbr\\u003e✅ Lucky Block addons\\u003cbr\\u003e✅ Survival content\\u003cbr\\u003e✅ Adventure addons\\u003cbr\\u003e✅ Horror and monster mods\\u003cbr\\u003e✅ Dragons and fantasy content\\u003cbr\\u003e✅ Redstone and technology\\u003cbr\\u003e✅ New blocks, items and crafting features\\u003cbr\\u003e\\u003cbr\\u003eInstall a mod for Minecraft PE or explore MCPE addons directly from the app. Find everything from a furniture mod for Minecraft to animals, vehicles, weapons and adventure content.\\u003cbr\\u003e\\u003cbr\\u003eMAPS \\u0026amp; SEEDS\\u003cbr\\u003e\\u003cbr\\u003eExplore Minecraft worlds, maps and seeds for different types of gameplay:\\u003cbr\\u003e\\u003cbr\\u003e✅ Survival maps\\u003cbr\\u003e✅ Adventure worlds\\u003cbr\\u003e✅ Cities and towns\\u003cbr\\u003e✅ Parkour maps\\u003cbr\\u003e✅ PVP arenas\\u003cbr\\u003e✅ Hide and Seek\\u003cbr\\u003e✅ Skyblock worlds\\u003cbr\\u003e✅ Floating islands\\u003cbr\\u003e✅ Villages and structures\\u003cbr\\u003e✅ Multiplayer maps\\u003cbr\\u003e✅ Creative builds\\u003cbr\\u003e\\u003cbr\\u003eBrowse maps for Minecraft and quickly find new worlds to explore.\\u003cbr\\u003e\\u003cbr\\u003eSKINS\\u003cbr\\u003e\\u003cbr\\u003eCustomize your character with a large collection of skins for Minecraft PE:\\u003cbr\\u003e\\u003cbr\\u003e✅ Boys and girls\\u003cbr\\u003e✅ PVP skins\\u003cbr\\u003e✅ Superheroes\\u003cbr\\u003e✅ Anime-inspired skins\\u003cbr\\u003e✅ Military\\u003cbr\\u003e✅ Monsters\\u003cbr\\u003e✅ Robots\\u003cbr\\u003e✅ Fantasy characters\\u003cbr\\u003e✅ Skin packs\\u003cbr\\u003e\\u003cbr\\u003ePreview skins in 3D with 360-degree rotation before using them.\\u003cbr\\u003e\\u003cbr\\u003eBUILDINGS FOR MCPE\\u003cbr\\u003e\\u003cbr\\u003eAdd ready-made buildings and structures to your Bedrock worlds.\\u003cbr\\u003e\\u003cbr\\u003eChoose from:\\u003cbr\\u003e\\u003cbr\\u003e✅ Houses\\u003cbr\\u003e✅ Mansions\\u003cbr\\u003e✅ Castles\\u003cbr\\u003e✅ Modern buildings\\u003cbr\\u003e✅ Medieval structures\\u003cbr\\u003e✅ Furnished houses\\u003cbr\\u003e✅ Aircraft and helicopters\\u003cbr\\u003e✅ Other unique constructions\\u003cbr\\u003e\\u003cbr\\u003ePlace buildings into your world without spending hours constructing everything block by block.\\u003cbr\\u003e\\u003cbr\\u003eTEXTURE PACKS \\u0026amp; SHADERS\\u003cbr\\u003e\\u003cbr\\u003eDiscover texture packs for Minecraft PE, including realistic textures, vanilla-style packs and Minecraft shaders.\\u003cbr\\u003e\\u003cbr\\u003eFind different styles and resolutions:\\u003cbr\\u003e\\u003cbr\\u003e✅ 16x16\\u003cbr\\u003e✅ 32x32\\u003cbr\\u003e✅ 64x64\\u003cbr\\u003e✅ HD textures\\u003cbr\\u003e✅ Vanilla-style packs\\u003cbr\\u003e✅ Realistic textures\\u003cbr\\u003e✅ Lighting and shader packs\\u003cbr\\u003e\\u003cbr\\u003eChange lighting, blocks and the visual style of your Bedrock world with textures and shaders.\\u003cbr\\u003e\\u003cbr\\u003eCONTENT FOR MCPE \\u0026amp; BEDROCK\\u003cbr\\u003e\\u003cbr\\u003eUse one catalog for Minecraft PE / MCPE content:\\u003cbr\\u003e\\u003cbr\\u003e✅ Mods\\u003cbr\\u003e✅ MCPE addons\\u003cbr\\u003e✅ Maps\\u003cbr\\u003e✅ Skins\\u003cbr\\u003e✅ Buildings\\u003cbr\\u003e✅ Texture packs\\u003cbr\\u003e✅ Shaders\\u003cbr\\u003e✅ Seeds\\u003cbr\\u003e\\u003cbr\\u003eNew content is added regularly, so you can keep discovering different ways to customize and expand Minecraft Bedrock Edition.\\u003cbr\\u003e\\u003cbr\\u003eMinecraft Pocket Edition / Bedrock Edition is required to use downloaded content.\\u003cbr\\u003e\\u003cbr\\u003eDISCLAIMER\\u003cbr\\u003e\\u003cbr\\u003eThis is an unofficial application for Minecraft. This application is not affiliated with, approved by, or associated with Mojang or Microsoft.\\u003cbr\\u003e\\u003cbr\\u003eThe Minecraft name, trademark and related assets are the property of their respective owners. All rights are reserved by their respective owners.\\u003cbr\\u003e\\u003cbr\\u003eAll downloadable content provided through the application is distributed according to the terms of its applicable licenses.\\u003cbr\\u003e\\u003cbr\\u003eIf you have any problems with violation of your intellectual property rights, or any other agreement, please contact our support by e-mail: dev.alexche@gmail.com, we will immediately take the necessary measures.\"],\"Lyxoto Studios\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/g_7WMqHLD-_tnoePx4wnt_BXBb5bZkqQ9gsfd7h4COG8IG2qzjMX4w1jlKYO1K_eDa93rOuaXFC9cTMz1puUoQ\"],null,[96,97,91,255]],null,[\"Everyone 10+\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/csiz76udPjXmaJddU_1sanHGlQAAbKkvlprK3DSUNmwu1nY3U6qnXRrI2IDMaivooYK1x11oxz3PEO4z\"]],[null,\"Violent References\"],[null,\"In-App Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/bxs95MghtAOuZR_LPwVCUmUPYEvXsGVOH3chF1OCX0-Ns_S0qdHnzml2CGCgOGbYlftKsmt9gtpxLb8U\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"http