sY6GYw4GZtXXJnAkxnLtkg7a5A0NtltFe4pba2RGUI\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/bV2cAC305V3P9grWuwBbM22h5IgYzs_6LJuD5C4urjafHxi6TPq4l5YIL0z2mHhSrK6UrAbgLsyhlOpnXAytRw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/VeDRI9xLsoj-ga618pbmg5NlJ36C312RMH55Ul3VlZ0SNtV_ezIkKBCpzQk1m3LQ_LAItL3ZXQiI1k-fQEXt\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/UybpQGMELA4IzELj8K-W-dtRy7hzegLrSPNONetFWpzijemjcwJOo8BzwF0qubNT-TGxwEZZYfuPDMG8wTnl7w\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/42jsymEjdKhKuMZEcpvEvKaLObiv367C4HDFBPF_ItGEIfHv1Hlht9fTM0QiA2T7mEu2Ky4V0qK_bJtNjt2R6Eg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/IQfLbS5pkS8NScjr0NYdRB4LMnLXll7gqTKBQY5eLNl1IsY6GYw4GZtXXJnAkxnLtkg7a5A0NtltFe4pba2RGUI\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/bV2cAC305V3P9grWuwBbM22h5IgYzs_6LJuD5C4urjafHxi6TPq4l5YIL0z2mHhSrK6UrAbgLsyhlOpnXAytRw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/VeDRI9xLsoj-ga618pbmg5NlJ36C312RMH55Ul3VlZ0SNtV_ezIkKBCpzQk1m3LQ_LAItL3ZXQiI1k-fQEXt\"]],[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/kawLR-xNvIcRdPf1ywKtwq-6KgLXDKTyp5Au71n503VSi6SX1NiCJdBvgHl6G7gQiwnTH2lCSN-I7t9Rm2GAQw\"],null,[173,194,215,255]]],\"Mini Block Craft\",[\"4.2\",4.180791],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dmini.block.craft.free.mc\\u0026rdid\\u003dmini.block.craft.free.mc\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dmini.block.craft.free.mc\"]],[\"qgJOGkwIE0oTCPWMn8vR2pcDFXkHswYdHWoi8PoBDwoNCAASCQoFZW4tVVMQALICIAoeChhtaW5pLmJsb2NrLmNyYWZ0LmZyZWUubWMQARgD\"],null,[null,\"Mini Block Craft. Creative and Survival in sandbox block world! \\u003cbr\\u003e\\u003cbr\\u003eIn this pixel style sandbox openworld block game. You can create whatever you want!\\u003cbr\\u003eTurn blocks into building materials and create your dream house, or go explore the map and fight dangerous monsters and zombies. Craft, build and explore an amazing living world! \\u003cbr\\u003e\\u003cbr\\u003eExplore territories, accumulate and use resources for the development of your possessions.\\u003cbr\\u003eMini Block Craft game: best simulator is not an official Mojang application. This game is not associated or connected with Minecraft Pocket Edition. Minecraft is a trademark of Mojang and it is not endorsed by or affiliated with this game\\u0026#39;s creator or its licensors.\\u003cbr\\u003e\\u003cbr\\u003e## What\\u0026#39;s New (90.5.121.mc)\\u003cbr\\u003eNEW: Cherry Blossom Trees - plant pink petals, cherry wood, and matching planks to create your own kawaii world.\\u003cbr\\u003e\\u003cbr\\u003eNEW: Glowing Blocks - light up your nights with luminous crystals, glowstone, and 7-color glow glass (transparent and opaque) for cyberpunk builds.\\u003cbr\\u003e\\u003cbr\\u003eNEW: Built-in Skin Editor - design your own character pixel by pixel, share your designs as images right from the game.\\u003cbr\\u003e\\u003cbr\\u003eMULTIPLAYER IS HERE! The #1 requested feature - play with friends on Wi-Fi, up to 4 players. No accounts, no servers.\\u003cbr\\u003e\\u003cbr\\u003eNEW: AI Building Assistant - chat to build anything, from castles to circuits.\\u003cbr\\u003e          The smartest building companion on any mobile block game.\\u003cbr\\u003e          - Chat with an AI that understands your world\\u003cbr\\u003e          - Say \\u0026quot;build me a castle\\u0026quot; and watch it appear block by block\\u003cbr\\u003e          - AI places blocks, wires circuits, spawns entities, and more\\u003cbr\\u003e          - Works with Claude, Ollama, or any OpenAI-compatible model\\u003cbr\\u003e          - Hands-free building, the future of sandbox games\\u003cbr\\u003e\\u003cbr\\u003eNEW: HD Replay Export - record your builds and share them on TikTok, YouTube Shorts, Instagram Reels.\\u003cbr\\u003e\\u003cbr\\u003eNEW: Circuit System 2.0 - new electric components, smarter wiring.\\u003cbr\\u003e\\u003cbr\\u003eNEW: MAP MARKET - SHARE AND DISCOVER\\u003cbr\\u003e           - Upload your best worlds for everyone to play\\u003cbr\\u003e           - Browse and download community and official maps\\u003cbr\\u003e           - Rate, review, and comment on shared creations\\u003cbr\\u003e           - Import worlds from other sandbox building games\\u003cbr\\u003e\\u003cbr\\u003eNEW: Performance and stability improvements across the board.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003e**Real World Maps**\\u003cbr\\u003eTurn the real world into your playground! Generate playable worlds from real-world map data and explore real cities, landmarks, and neighborhoods — then build, mine, and reshape them however you like.\\u003cbr\\u003e\\u003cbr\\u003e**Better Multiplayer**\\u003cbr\\u003eWe\\u0026#39;ve rebuilt key parts of our multiplayer system for speed and reliability. Enjoy faster connections, smoother gameplay, and rock-solid stability when playing with friends online.\\u003cbr\\u003e\\u003cbr\\u003e**Smoother on Every Device**\\u003cbr\\u003eDeep performance optimizations have dramatically reduced memory usage. The game now loads faster, runs smoother, and stays stable even on older phones and devices with limited RAM.\"],\"Build Block Studio - XingTang Software\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/kawLR-xNvIcRdPf1ywKtwq-6KgLXDKTyp5Au71n503VSi6SX1NiCJdBvgHl6G7gQiwnTH2lCSN-I7t9Rm2GAQw\"],null,[173,194,215,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null,\"Suggestive Themes\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dmini.block.craft.free.mc\\u0026rdid\\u003dmini.block.craft.free.mc\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $4.99 per item\",[false]],{\"101\":[null,[[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/kawLR-xNvIcRdPf1ywKtwq-6KgLXDKTyp5Au71n503VSi6SX1NiCJdBvgHl6G7gQiwnTH2lCSN-I7t9Rm2GAQw\"],null,[173,194,215,255]]]]}]],[[[\"com.tellurionmobile.realmcraft\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/3XBogkqFWPvGqMAXjggBk8Ozj3RVPBixElIf7iuj5KUG4jS6F9wcQmITJBk8mjdyIG02sLMOzhEsoUfKZi5H5ZA\"],null,[3,164,214,255],null,null,null,2],[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/_sDhnCvbwjzFfudzF5SnqJBILla_ZhBZ3N-1bb8_PrtnlWONj2EeEqu7oLrnyAizr5HVaG-W54e-cAonRpl_WwU\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/rI_3Q0G-covpaJn82IDWxcxxAhGaayrOUjUzw2o3TWlVcWXkgamFOIoyBhI5fBmoseV-NF3VDIGiwHQwU3WiTg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/K65iyvcK_Q5dF2GC4fmM8GPbMOxi9PJFmsRQN4cphKKl09SHKzNqVSCpyb0y2K8lobIT0PrqbkWYeAkW06NUbw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/0MGtOqi6GxQptKqUEUpsgp2vSEjs4xZUdc-RDDuRvEvx3ixp4wu8RuMryTTZ8Jw_p12U5rGcIX9vnLWRelyjNPI\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/4uJvu8DAQc7QWQDxjn7o-YbLWD99FMuRXIxkgKGY3EgCg9yOK2wssPTwdvslb6jfY9jQjMiskE2EHScx9ahsjg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/sVXaoSJ-dZ4S-_EvF3I0pdwCwWGXLfr5vYBAWtKUS9XiwfNcTVgK8TlP8h7Hsv9eu19ewYPkyiwlxIgp4mYwOw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/sZCxB7EHQGZLxGqdiQxcOuMoTmHW3wh7gPuIIJWfGehFFyGsJyLNuUwKk7vAJUUS2P5wDIO9pe21WCeYPtT1f44\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/iPGISpKFQfUmAz6M68k78cwGaHt0pSrTs54laEQyTcCKsk9BvGjy40n6z7HGdVssT7knJsHVmdKd-pHumc27\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/rI_3Q0G-covpaJn82IDWxcxxAhGaayrOUjUzw2o3TWlVcWXkgamFOIoyBhI5fBmoseV-NF3VDIGiwHQwU3WiTg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/K65iyvcK_Q5dF2GC4fmM8GPbMOxi9PJFmsRQN4cphKKl09SHKzNqVSCpyb0y2K8lobIT0PrqbkWYeAkW06NUbw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/0MGtOqi6GxQptKqUEUpsgp2vSEjs4xZUdc-RDDuRvEvx3ixp4wu8RuMryTTZ8Jw_p12U5rGcIX9vnLWRelyjNPI\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/82PA8hlb-qvGYjxkr8KP9xGjgzzwOWSeiLGbbGLSot2XO4PHogHPD_nUL7GYDxxMuhjmpYWbNQ4b-Z1bOzzqsg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/4uJvu8DAQc7QWQDxjn7o-YbLWD99FMuRXIxkgKGY3EgCg9yOK2wssPTwdvslb6jfY9jQjMiskE2EHScx9ahsjg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/sVXaoSJ-dZ4S-_EvF3I0pdwCwWGXLfr5vYBAWtKUS9XiwfNcTVgK8TlP8h7Hsv9eu19ewYPkyiwlxIgp4mYwOw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/gWKDATOF7VjZkMHrpvNJWAdXT_2RGbgo7wW01jPNNsNWEBZxNqeYN-cJUuGCQ6uSorkwRJVTeQ0yXMcjBV0WXA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/iPGISpKFQfUmAz6M68k78cwGaHt0pSrTs54laEQyTcCKsk9BvGjy40n6z7HGdVssT7knJsHVmdKd-pHumc27\"]],[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/KIbx72821gUsN5iVxSsfD0y4vwjHhbTkVZ-66nuF1JC-knJR1CZO3UpXwuKvv5QZ4Z3woHfiDWifIAubCD_qKA\"],null,[174,213,242,255]]],\"RealmCraft: mine \\u0026 craft world\",[\"4.3\",4.3334804],\"Adventure\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tellurionmobile.realmcraft\\u0026rdid\\u003dcom.tellurionmobile.realmcraft\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.tellurionmobile.realmcraft\"]],[\"qgJcGloIFEoTCPWMn8vR2pcDFXkHswYdHWoi8PoBFwoVCOigwNvhns2OQxIJCgVlbi1VUxAAsgImCiQKHmNvbS50ZWxsdXJpb25tb2JpbGUucmVhbG1jcmFmdBABGAM\\u003d\"],null,[null,\"RealmCraft is a free 3D sandbox game where every craftsman can mine, craft, build, and explore a colorful block world. Start an adventure in a 3D world, collect resources, shape terrain, and create anything from a simple shelter to a huge castle. Every block you mine, every item you craft, and every structure you build helps turn your sandbox world into your own adventure.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eCreate Your Sandbox World\\u003c/b\\u003e\\u003cbr\\u003eRealmCraft gives every craftsman the freedom to build a world block by block. This sandbox experience is made for players who enjoy crafting, mining, building, survival challenges, and exploration. Mine sand, stone, wood, and other blocks, then craft tools and materials to build the world you want to play in.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eMine, Craft, and Build\\u003c/b\\u003e\\u003cbr\\u003eCrafting and building are at the center of every RealmCraft adventure. Mine resources across forests, plains, deserts, and snowy taiga, then craft useful items for survival or creative design. Build homes, towers, farms, castles, cities, islands, and custom block creations using more than 100 blocks.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eKey Features\\u003c/b\\u003e\\u003cbr\\u003e• Mine blocks, gather resources, and craft tools for your world.\\u003cbr\\u003e• Build shelters, castles, villages, farms, and full sandbox cities.\\u003cbr\\u003e• Explore Survival Mode, Creative Mode, multiplayer worlds, and mini-games.\\u003cbr\\u003e• Play as a creative craftsman across colorful biomes and block landscapes.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eSurvival and Creative Modes\\u003c/b\\u003e\\u003cbr\\u003eSurvival Mode turns each mine and craft decision into part of the challenge. Gather blocks, build shelter, craft tools, face enemies, and improve your gear as your survival world grows. Creative Mode gives every craftsman free flight, unlimited building freedom, and endless blocks so you can build without limits and focus on imagination.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eExplore Multiplayer Worlds\\u003c/b\\u003e\\u003cbr\\u003eRealmCraft lets builders explore, craft, mine, and build together in shared spaces. Join multiplayer worlds, meet other players, create block projects, try mini-games, and discover new adventure maps. The sandbox format gives each craftsman room to play alone or connect with a community of builders.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eA Block Game for Creative Adventure\\u003c/b\\u003e\\u003cbr\\u003eEvery world in RealmCraft can become a new adventure. You can mine deep for resources, craft better equipment, build detailed structures, or explore the next biome for ideas. Whether you prefer survival progress or creative block building, the game gives you flexible ways to craft your own path as a craftsman.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eFrequently Asked Questions\\u003c/b\\u003e\\u003cbr\\u003eWhat is RealmCraft?\\u003cbr\\u003eRealmCraft is a sandbox game focused on mining, crafting, building, survival, exploration, multiplayer play, and creative adventure in a 3D block world.\\u003cbr\\u003e\\u003cbr\\u003eIs RealmCraft a free game?\\u003cbr\\u003eYes. RealmCraft is a free sandbox game where you can mine, craft, build, explore, and play in a 3D block world.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eWhat can I do in the game?\\u003cbr\\u003eYou can mine resources, craft tools, build structures, explore biomes, play survival challenges, create block worlds, and join multiplayer mini-games.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eStart Your RealmCraft Adventure\\u003c/b\\u003e\\u003cbr\\u003eDownload RealmCraft and start building your own sandbox world. Mine resources, craft items, explore biomes, survive challenges, build block creations, and shape the adventure you want to play.\"],\"Tellurion Mobile\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/KIbx72821gUsN5iVxSsfD0y4vwjHhbTkVZ-66nuF1JC-knJR1CZO3UpXwuKvv5QZ4Z3woHfiDWifIAubCD_qKA\"],null,[174,213,242,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null,\"Violence, Blood\"],[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tellurionmobile.realmcraft\\u0026rdid\\u003dcom.tellurionmobile.realmcraft\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $48.99 per item\",[false]],{\"101\":[null,[[null,2,[500,1024]