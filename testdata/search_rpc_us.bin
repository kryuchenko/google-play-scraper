GRldmlsEAEYA0oTCPWMn8vR2pcDFXkHswYdHWoi8JoBEwj3x4D+0NqXAxWIrgoJHe7WEyv6AQ8KDQgAEgkKBWVuLVVTEAA\\u003d\"],[[[null,null,\"pv1OtS5TZRs\",[null,null,\"https://www.youtube.com/embed/pv1OtS5TZRs?vq\\u003dlarge\\u0026rel\\u003d0\\u0026autohide\\u003d1\\u0026showinfo\\u003d0\"],\"yt:movie:pv1OtS5TZRs\",null,null,null,null,\"AXH1ezmZ1o-DpeJ8IqYq3h8o0KcrlawUALvnAbaKnUudb90LK3biG9S3J0lhA02CXNW0HnGynHCmtzLUxT51R8b1uNTp9Am98IFtnkEe1C0b3htHV6c_uq7Kj3Onk_rn-Dt4_6YxaficjMhb38kJ5t5Fc2FeWcGWd1oxnOvv5G0OKj0_HfjvYQ_5kv3CBRsAel0Dgk3qWGrFVm7p4tPXFeYI4INQpZDpwpka0Lt2VSvlbUrRvIG7amtg_sdtpHuFF9_bNZGTUt2DbVJAHty7WQdUAwWASespeH_SJb6VKA3mnnnr8A\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/pv1OtS5TZRs/hqdefault.jpg\"]]]],[null,\"A nice, peaceful platformer\\u003cbr\\u003e\\u003cbr\\u003eRun, jump, reach the door, and enjoy a calm little adventure full of fair levels, friendly spikes, trustworthy platforms, and perfectly normal surprises. You will definitely not rage. You will definitely not die again and again. And every trap is probably just your imagination.\\u003cbr\\u003e\\u003cbr\\u003eLevel Devil is a relaxing skill game for players who love hard platformers, impossible jumps, funny fails, and totally safe little challenges. Test your timing, trust the floor, avoid the spikes, ignore the traps, and prove that you are invincible. Or don’t. That’s fine too.\\u003cbr\\u003e\\u003cbr\\u003eFeatures:\\u003cbr\\u003e\\u003cbr\\u003e- 240+ happy little levels\\u003cbr\\u003e- Simple controls for very skilled people\\u003cbr\\u003e- Spikes, traps, and other friendly decorations\\u003cbr\\u003e- Funny fails you will want to pretend never happened\\u003cbr\\u003e- Local 2-player mode to share the suffering\\u003cbr\\u003e- Secrets, surprises, and completely fair level design\\u003cbr\\u003e- A peaceful experience for fans of rage games, hard platformers, memes, and dying again\\u003cbr\\u003e\\u003cbr\\u003eThis is not a troll game.\\u003cbr\\u003eThis is not impossible.\\u003cbr\\u003eThis is not trying to trick you.\\u003cbr\\u003e\\u003cbr\\u003ePlease download Level Devil and have a wonderful, relaxing time. You deserve it.\"],\"WebVentures B.V.\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/hVpMLPVvb99tz6L3978uQO4VmMmFXK-kjzvhacqTj-TixlaSsduhoLYDQi287e4Wa9M93ZQAB06u7NUOrcLadqo\"],null,[153,107,7,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],[null,\"Mild Fantasy Violence\"],[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.unept.leveldevil\\u0026rdid\\u003dcom.unept.leveldevil\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$5.99 per item\",[false]]],[[\"com.fsilva.marcelo.lostminer\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/KDQZxFXNx6y8dH3B4ZSKKwKBbDBnAxpgzpBA4IvQuu6dn1eBS4pXQelkpEWqCY44qNh51bu3yIRSxlGjgImVlA\"],null,[128,129,115,255],null,null,null,2],[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/8JGGKER8QONGV3Z1V0y9v42xIqzV-OqCE7U22dlRIQYprEQ7HVqkii7uDDRiJbit5_PYzEiRNxKsRGtuKInB\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Zkp0SujJPTtyO7hF16j1EHd9HNQZSvZuA0Xa3ykDicyLHBZ4IPGLSvnv1TvEM