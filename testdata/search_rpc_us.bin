48\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/TBieCFXbQT2u5sOEu-ePWkz2fYD8zlcJbTF5pamT84EIYgkjmT4jJDI1BUzVd2Bew7KczjXaqDZ6jVhvyuk9NUQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/VthzBW6LNR8eQIAq-AkjpKZdyPNgDiKPXnLrbIlAJ9GTETwelP7--nGOrYa10VyKkwI2V67d8ixEjiyyy9H1apU\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/oMfbGI9vRkLzEZ0Da_amwalsGESFzPS5N9mvisTj6-g7y6tLPAUKZOXnjt6eHHSyGiyMXAlmCF0PIuIlO-PWNFk\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/-tFKdFgAtikSMayYKh1ursQ48c9gq2UM7RdswiFhG0bP5of9Ly98hnJ-tts1OBoneWT3UMMHkG8JDxQ-6dkv\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/wi7ObDDT6IhL_7IxFBv3g35q0feN5c0ocMzG6hHRPnwdAedT3eJI6_2FxmneEvF642LQF4xtSvC53EbD8xd6hg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/s6P_t16OhrA2tb88ru8Foeo2dF8oMd4WpvDpPe00h3_599VSE0yeIPXPVoigdoUKiW02ME-E_EOCuz0NXl48\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/TBieCFXbQT2u5sOEu-ePWkz2fYD8zlcJbTF5pamT84EIYgkjmT4jJDI1BUzVd2Bew7KczjXaqDZ6jVhvyuk9NUQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/VthzBW6LNR8eQIAq-AkjpKZdyPNgDiKPXnLrbIlAJ9GTETwelP7--nGOrYa10VyKkwI2V67d8ixEjiyyy9H1apU\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/oMfbGI9vRkLzEZ0Da_amwalsGESFzPS5N9mvisTj6-g7y6tLPAUKZOXnjt6eHHSyGiyMXAlmCF0PIuIlO-PWNFk\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/-tFKdFgAtikSMayYKh1ursQ48c9gq2UM7RdswiFhG0bP5of9Ly98hnJ-tts1OBoneWT3UMMHkG8JDxQ-6dkv\"]]],\"Minetap – Merge rpg clicker\",[\"4.3\",4.324528],\"Arcade\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mvgamesteam.minetap\\u0026rdid\\u003dcom.mvgamesteam.minetap\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.mvgamesteam.minetap\"]],[\"qgJqGmgILhIfCh0KF2NvbS5tdmdhbWVzdGVhbS5taW5ldGFwEAEYA0oTCPWMn8vR2pcDFXkHswYdHWoi8JoBEwj3x4D+0NqXAxWIrgoJHe7WEyv6ARcKFQiGh7aM4o6cikMSCQoFZW4tVVMQAA\\u003d\\u003d\"],null,[null,\"MineTap is an idle clicker with merge mechanics and crafting. Also, there is an adventure, where you can fight zombies and other monsters and even build your village!\\u003cbr\\u003e\\u003cbr\\u003eMineTap is, for sure, one of the best free games for every pixel games fan. \\u003cbr\\u003eStart your epic mining adventure right now - click, tap \\u0026amp; rock! \\u003cbr\\u003e\\u003cbr\\u003eEnjoy mining and treasure hunting. Complete quests and level up your character. Craft your ultimate weapon and slay epic monsters!\\u003cbr\\u003eHave you ever dreamed of being a hero and saving the world? Then tap to play and become a legend of crafting.\\u003cbr\\u003e\\u003cbr\\u003eMerge the resources and build more complex materials on the workbench and forge. Become a craftsman. Mine, craft, level up! Gather stone, coal, ore and other blocks. Create precious gems, epic armor, weapons and a handy pickaxe. Build your village, fight zombies and other various monsters. Be the best among the heroes of tapping, titans of merging and legends of crafting! \\u003cbr\\u003e\\u003cbr\\u003eMineTap is one of the best pixel-like clicker RPG games. Your single player adventure is available offline, with no internet connection - idle away your boring time! \\u003cbr\\u003e\\u003cbr\\u003eDigging, mining, crafting and building - everything is available for free. Complete quests, get a better pickaxe, dig deeper, merge resources, craft \\u0026amp; pick up equipment, use special boosts to speed up the process - become an epic miner and craftsman. Soon all the wealth of the Block Earth will be yours! Let\\u0026#39;s write your name in the chronicle of heroes!\\u003cbr\\u003e\\u003cbr\\u003eIn-game features: \\u003cbr\\u003e\\u003cbr\\u003eEnjoy the recognizable graphics - especially for pixel lovers!  \\u003cbr\\u003eHold your pickaxe and dig out dozens of blocks to combine and craft \\u003cbr\\u003eCollect treasure chests to collect more mining resources\\u003cbr\\u003eMerge the same blocks to get epic materials\\u003cbr\\u003eUse powerful boosts to speed up the crafting process \\u003cbr\\u003eCraft equipment and armor - and level up your hero to grow even stronger!\\u003cbr\\u003eTake more than 70 challenging quests \\u003cbr\\u003eTry your luck in the treasure mine - get your free reward daily\\u003cbr\\u003eBe №1 in this epic RPG game with clicker mechanics!\\u003cbr\\u003e\\u003cbr\\u003eDig deeper! Pick up all the valuable resources while mining \\u0026amp; clicking \\u0026amp; tapping!   \\u003cbr\\u003eMine Tap is an awesome game for everyone, perfect idle clicker for short offline sessions. \\u003cbr\\u003eAre you bored? Spend hours and hours in this simple, yet incredibly fun pixel idle adventure! If you want to play one of the best clicker games ever, you should try it now!\\u003cbr\\u003e\\u003cbr\\u003eWe need your opinion on our social networks!\\u003cbr\\u003eFacebook: https://www.facebook.com/Minetap-101341071954634\\u003cbr\\u003eInstagram: https://www.instagram.com/minetapmg/\\u003cbr\\u003eYouTube: https://www.youtube.com/channel/UCTONS2fz_0dZUYRjaMetrDg\"],\"Geeky House\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/KHvSr9MeDckvS1xyDYcOpVqZHEVVXy9DvH9Dt4goDbBiRmsbrdKPWF-wFnZzShVQqEO__aSPqeyDuH3pZaDa_g\"],null,[138,198,254,255]],null,[\"Everyone 10+\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/csiz76udPjXmaJddU_1sanHGlQAAbKkvlprK3DSUNmwu1nY3U6qnXRrI2IDMaivooYK1x11oxz3PEO4z\"]],[null,\"Fantasy Violence, Mild Blood\"],[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/bxs95MghtAOuZR_LPwVCUmUPYEvXsGVOH3chF1OCX0-Ns_S0qdHnzml2CGCgOGbYlftKsmt9gtpxLb8U\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mvgamesteam.minetap\\u0026rdid\\u003dcom.mvgamesteam.minetap\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[\"com.kgs.housedesigner\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/Xdwzhprvgl7Tf88jdEk-c-gdf1_dthadtSKXL87xDzOw6-r05SbCga2hrlCX-Hdcrf97Dv14_-gFeUfVYEKji_g\"],null,[224,231,230,255],null,null,null,2],[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/_L8mcNWDCSbhn_u-aAUzvvTxEjrFwNRWsir3iq_ycOH8T2c-hVMGGB-FpddP_Lwv56lyGMsNIf7BKdGd7O5tS7E\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/SN8CkPUlYAlikOLBEZORGmRGQI9qGyj194OT-_frMXZ1Us9RCnI5kB15gIG4CMij4hZ0fJ88-qNjfl2T5Vuksg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/5Ec3Jxsb4OfXU-7f3RU4NSfy8pXuoEmNvINqi9zTv-Nr33eSV3xeLDnN0NmPue7OtZmS4jdijhIs34bxYpFLaYk\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/ya0HRe5DKNYQdVUYzmVH1cuYq3z9sCIvHd3QcxqHCgwGkJcIoC-g9SXDFhUZW_PPxw2s_423juqD2wHXCLHZmg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/cWtmcGCuNVIxXb__DK94AWhKmLqh67P7e2jEaCUosy9BKESV_n3hklpBiihhTMhU7lgKZWi-Ocakw0zD5lt6Yg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/DlJ8TwRBN6-tC6U3NdBPX8Nzm-980xmfA_9JzSaLafkvkzxrxDbXIb9qyuRqqyTaTl4XMaGHFMWvIsOAoCcA9g\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/dvbfjcQN