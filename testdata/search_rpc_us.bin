xdy1SjV75phpx5c1LWYPOIYopV8ne2N\"]],[null,2,[2160,3840],[null,null,\"https://play-lh.googleusercontent.com/CK4Hk4VCH-7r3oLUGVBTqYqKKnOEJDXwh1260_iTcrvKinzqCGQ0js8vhsz5qqBlRsWzO5xejbeNCA3C3Z24xoM\"]],[null,2,[2160,3840],[null,null,\"https://play-lh.googleusercontent.com/NXEjfIicGNg_5OeKaAMCispIPehPWCw1BRHbDe9LO51jCa9ADeLympBOvDK9rW4GDMoeWj8V6mKlsr8vdAxr3A\"]],[null,2,[2160,3840],[null,null,\"https://play-lh.googleusercontent.com/vynYJIl3SgFThzHJHsPSC01tu6LmYoDtymjQ7jc3d1tpeEx5JiFeRwR7vsF1Ust_GGuxbjS0045rPwpjZ1ptdx4\"]],[null,2,[2160,3840],[null,null,\"https://play-lh.googleusercontent.com/ahJmXSQ-j7gzH1d4QsSPG1GCZZz1eWyNi2hLPYHAToGCQBb9yG2RSHq2c4t_38kWT4FsqjKugn3DGvQyRIyU\"]],[null,2,[2160,3840],[null,null,\"https://play-lh.googleusercontent.com/Nm4jdLdemgnK6YiW0TmAtUHu0pDzLyleBVvOYotdMJpkb6nanKkaKxdy1SjV75phpx5c1LWYPOIYopV8ne2N\"]]],\"Fortnite\",[\"4.6\",4.6121607],\"Action\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.epicgames.fortnite\\u0026rdid\\u003dcom.epicgames.fortnite\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.epicgames.fortnite\"]],[\"qgJhGl8IDxIeChwKFmNvbS5lcGljZ2FtZXMuZm9ydG5pdGUQARgDShMI9Yyfy9HalwMVeQezBh0daiLwmgETCPfHgP7Q2pcDFYiuCgkd7tYTK/oBDwoNCAASCQoFZW4tVVMQAA\\u003d\\u003d\"],[[[null,null,\"Nh98wNmeOaE\",[null,null,\"https://www.youtube.com/embed/Nh98wNmeOaE?vq\\u003dlarge\\u0026rel\\u003d0\\u0026autohide\\u003d1\\u0026showinfo\\u003d0\"],\"yt:movie:Nh98wNmeOaE\",null,null,null,null,\"AXH1ezkuDvH2Y4-mC5u5n7bxz0Qe7aoVUvxJDBsa6qYBbWTAK_-D03RL-HktMM_yNaP3ix0v21SOwq55UB9su-ywvuOTLfnQuSOqSJfTDDZmhTOsYtb3ShB7TRbt3L_QlPoef6M78bH4SUwLazkPFhZW8CW3vUmPJ3CCMwszDoKOuIPGFb3hF-9ik30BBmY6or-fpj8fQgKzW6BcxvVTQQ39oA9DY2udJaxlExlo3E1a9bUCq98eKGdhcoLAyroK6EAToyCqaTEfXgZ72vyPg5rOC_JS3xp2mhRi6lmJIqMrEMzwgA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/Nh98wNmeOaE/hqdefault.jpg\"]]]],[null,\"There is always something new for you and your friends in Fortnite!\\u003cbr\\u003e\\u003cbr\\u003eBe the last player standing in Battle Royale. Get nostalgic in Fortnite OG. Headline a concert in Fortnite Festival. Explore the worlds of LEGO Fortnite. Play thousands of free developer-made, multiplayer action games like tycoons, deathruns, zombie survival, and more. There’s always something new for you and your friends.\\u003cbr\\u003e\\u003cbr\\u003eIn between action-packed games, stop by the Shop to get an Outfit, Back Bling, or Emote. Show off your new look as you go no-building, all action in Zero Build, or get tactical in Reload. Brawl and play Ranked modes and qualify for Fortnite Competitive tournaments, where you can earn rewards like cash or cosmetics.\\u003cbr\\u003e\\u003cbr\\u003eThere’s a new Battle Pass every Season, with tons of rewards you can use across Fortnite, like new Outfits, Pickaxes, and Gliders. Unlock these rewards as you complete Quests and earn XP.\\u003cbr\\u003e\\u003cbr\\u003ePast and present collide in the OG Pass, where you can unlock classic looks with fresh Outfits inspired by past Seasons as you brawl your opponents.\\u003cbr\\u003e\\u003cbr\\u003eNew Seasons of Fortnite Festival bring a brand new music Icon to the stage. Perform as your favorite artists with their Outfits and hit songs in the Shop and Music Pass.\\u003cbr\\u003e\\u003cbr\\u003eGAMES IN THE FORTNITE MOBILE APP:\\u003cbr\\u003e- Battle Royale\\u003cbr\\u003e- Blitz Royale\\u003cbr\\u003e- Zero Build\\u003cbr\\u003e- Fortnite OG\\u003cbr\\u003e- LEGO Fortnite\\u003cbr\\u003e- Fortnite Festival\\u003cbr\\u003e- Droid Tycoon\\u003cbr\\u003e- Action Games\\u003cbr\\u003e- Developer-Made Games\\u003cbr\\u003e- Competitive Games\\u003cbr\\u003e- Multiplayer Games\\u003cbr\\u003e- \\u0026amp; more\\u003cbr\\u003e\\u003cbr\\u003eACTION PACKED BATTLE ROYALE, WHEREVER \\u0026amp; WHENEVER\\u003cbr\\u003e- Choose your Outfit and explore the Island in style\\u003cbr\\u003e- Fight to be the last one standing in this fast-paced third-person PvP shooter\\u003cbr\\u003e- Avoid damage as the Storm closes in\\u003cbr\\u003e- Coming soon: updates bringing new weapons, vehicles, and more to our competitive games\\u003cbr\\u003e\\u003cbr\\u003eBRAWL \\u0026amp; COMPETE SOLO OR TEAM UP IN ZERO BUILD\\u003cbr\\u003e- Battle Royale without the building. Play solo or play together as a duo, trio, or 4-person multiplayer squad\\u003cbr\\u003e- Use your Overshield for protection because no building means more danger\\u003cbr\\u003e- Use natural coverage as you move through the map, and leverage your loadout to the max\\u003cbr\\u003e- Mantle, hurdle, jump, and more to stay competitive\\u003cbr\\u003e\\u003cbr\\u003eMORE TO EXPLORE\\u003cbr\\u003e- Play faster in a smaller map with fewer players in Blitz Royale\\u003cbr\\u003e- Jump into multiplayer games and play together\\u003cbr\\u003e- Perform or remix awesome music with Jam Tracks from the Shop or Music Pass\\u003cbr\\u003e\\u003cbr\\u003eIt’s all right here, in your pocket.\"],\"Epic Games, Inc\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/rUAj0gwbMuol5g-a_b8f8BATk2qnUMS5Xk2_tS_VGtvKAiFqKY-8tfWle7lGgQOOBLfuPq0ryVPCuUoguKx5oto\"],null,[7,16,36,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null,\"Diverse Content: Discretion Advised\"],[null,\"Users Interact, In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q\"]],[null,null,null,null,null,[null,null,\