e Guys\",[\"4.7\",4.7403383],\"Action\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.kitkagames.fallbuddies\\u0026rdid\\u003dcom.kitkagames.fallbuddies\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.kitkagames.fallbuddies\"]],[\"qgJtGmsICBIiCiAKGmNvbS5raXRrYWdhbWVzLmZhbGxidWRkaWVzEAEYA0oTCPWMn8vR2pcDFXkHswYdHWoi8JoBEwj3x4D+0NqXAxWIrgoJHe7WEyv6ARcKFQjtjenmoOOAiUMSCQoFZW4tVVMQAA\\u003d\\u003d\"],null,[null,\"Grab your friends and play Stumble Guys, the fun free-to-play multiplayer party royale game!\\u003cbr\\u003e\\u003cbr\\u003eCompete in fast-paced knockout games with up to 32 players and race through cool obstacle courses and chaotic elimination full of action. Play now and become the last player standing in Stumble Guys, the ultimate online multiplayer party game experience!\\u003cbr\\u003e\\u003cbr\\u003e💥 JOIN THE 32-PLAYER ONLINE MULTIPLAYER MADNESS\\u003cbr\\u003eCall your friends to battle and race in fun knockout games full of action! Dodge giant snowballs, jump over lasers, and make sure to dash through all games — but don’t fall or clash!\\u003cbr\\u003e\\u003cbr\\u003e🌍 EXPLORE 60+ EPIC MAPS FOR ENDLESS FUN\\u003cbr\\u003eDash through obstacle courses, jump over crazy traps, and play against your friends and other players - every map brings a new set of thrilling action games and surprises!\\u003cbr\\u003e\\u003cbr\\u003e🏁 PLAY TOURNAMENTS \\u0026amp; CLIMB THE RANKED LEADERBOARD\\u003cbr\\u003eRun, clash, kick, and fall to survive in competitive battle games, collect points to climb the Ranked leaderboard, and unlock cool rewards!\\u003cbr\\u003e\\u003cbr\\u003e🎨 CUSTOMIZE YOUR STUMBLER\\u003cbr\\u003eUnlock and collect thousands of skins, emotes, and more for free! Become a ninja, superhero, or even a chicken - you craft your very own look to win these cool multiplayer games in style!\\u003cbr\\u003e\\u003cbr\\u003e🔥 LIMITED-TIME EVENTS \\u0026amp; EPIC CROSSOVER COLLABS!\\u003cbr\\u003eJump into special events featuring the best game modes like Floor is Lava and Banana Bonanza, or expand your collection with legendary stumblers from SpongeBob, My Hero Academia, and more.\\u003cbr\\u003e\\u003cbr\\u003e📱 CROSS-PLAY ON STEAM \\u0026amp; MOBILE!\\u003cbr\\u003ePlay Stumble Guys with your friends on mobile and Steam for free! Join battles anytime, anywhere, in this fun, cross-platform online action multiplayer party game.\\u003cbr\\u003e\\u003cbr\\u003eReady to stumble and brawl with your friends? Download Stumble Guys now on mobile and play the fun multiplayer knockout game for free!\"],\"Scopely\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/1wgzoConNvdQg3fSX03QHkcimP5I30hdzMHmDbu99N76byTXMmq2hq0v_uRjpM3rik5OdeKtcfO4ZzLTg0KmZ6U\"],null,[3,68,197,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.kitkagames.fallbuddies\\u0026rdid\\u003dcom.kitkagames.fallbuddies\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,