ntent.com/FdbKVsM7tmvwlYOEbGdXK7gwGU2_ecLRiN-Yle5sRt0ICejIjeU33GapRgMnIJ5CwojCsyd1K9CQ9YspQ7YrjH8\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/8tAemJjZxpJdzShPNdeXGdlX-cPMHJup3T8PIFs6merQajWyQPkfU6Pofonqt5nlGqUFQUL9Plmg8yQaQ4J1pKs\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/UQ8L2Vj6VdJ3s4iLvLBwSVjDW5JtJtlP0zfktcaE3eQSggsAaclVG_9BWM7KTDBEuKnFz_RNE2iECjKVv4cR7Q\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/wFygDPu_X3xbxacx6ioho6Y-acYY1FKNPWU7n7GIEni1uDJCgoj4Zuw9hvh4xwbCTzlSHt1lNtWeY0D6_Tsl\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/q_kV2Gj3MPnB32_nW9678gtAk-Z8cO8ymKnvGkDa5F8ueMNkHUV9I0gNC9M0ZsBQJU_ucDEjb1xjUNg33Yyl4A\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Zhl6vpOBQGxoCFJMTXk73BDIvvNAHLT1vMIckQtJrfG2fR4f06I7UwW8gowO8H6f4EAk0R0KcG20W2XZL5n3\"]]],\"Payback 2 - The Battle Sandbox\",[\"4.5\",4.513586],\"Arcade\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dnet.apex_designs.payback2\\u0026rdid\\u003dnet.apex_designs.payback2\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dnet.apex_designs.payback2\"]],[\"qgJkGmIILRIhCh8KGW5ldC5hcGV4X2Rlc2lnbnMucGF5YmFjazIQARgDShMI9Yyfy9HalwMVeQezBh0daiLwmgETCPfHgP7Q2pcDFYiuCgkd7tYTK/oBDwoNCAASCQoFZW4tR0IQAA\\u003d\\u003d\"],null,[null,\"Gaming App of The Day - Kotaku.com\\u003cbr\\u003e\\u003cbr\\u003e\\u0026quot;[Payback 2] manages to create a sense of overblown fun that permeates everything from straightforward races to capture the flag-inspired heists ... an immensely entertaining experience\\u0026quot; - pocketgamer.co.uk \\u003cbr\\u003e\\u003cbr\\u003eFeatured as one of the best games of the week by The Guardian\\u003cbr\\u003e\\u003cbr\\u003e\\u0026quot;There’s a ton of stuff to do which is what gives Payback 2 such an interesting atmosphere\\u0026quot; - Super Game Droid\\u003cbr\\u003e\\u003cbr\\u003eAndroid Authority\\u0026#39;s Indie App of the Day\\u003cbr\\u003e\\u003cbr\\u003eDESCRIPTION:\\u003cbr\\u003ePayback 2 includes everything from tank battles to high speed helicopter races to huge gang battles - but you really have to try it get a feel for how much variety there is, and we\\u0026#39;re adding more all the time!\\u003cbr\\u003e\\u003cbr\\u003eFEATURES: \\u003cbr\\u003e• VARIED CAMPAIGN. Fifty campaign events featuring massive street brawls, rocket car races and much, much more! \\u003cbr\\u003e• TAKE ON THE WORLD. Battle your friends or over a million other players online with the game\\u0026#39;s extensive multiplayer, leaderboard and Google Play support. \\u003cbr\\u003e• HOURLY, DAILY AND WEEKLY CHALLENGES. Try to beat the rest of the world in the latest new events! \\u003cbr\\u003e• ENDLESS REPLAYABILITY. Make your own events in \\u0026quot;custom mode\\u0026quot; using any combination of the game\\u0026#39;s seven cities, nine game modes, varied weaponry and dozens of vehicles.\"],\"Apex Designs Games LLP\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/R_A9YmJLHmUyc97-dI065lWn3R_cbUHgyyxMSMgATpouG4nFdOUeYJKYYw8Pzrvd9iQvbIFJOHrDZ_LUXPTR\"],null,[32,23,19,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null,\"Violence, Blood\"],[null,\"Digital Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q\"]],[null,null,null,null,null,[null,null,\"https://suppor