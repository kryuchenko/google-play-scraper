ull,[null,\"Buy\"],null,2,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.and.games505.TerrariaPaid\\u0026rdid\\u003dcom.and.games505.TerrariaPaid\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.and.games505.TerrariaPaid\"]],[\"qgJoGmYIGBIlCiMKHWNvbS5hbmQuZ2FtZXM1MDUuVGVycmFyaWFQYWlkEAEYA0oTCPWMn8vR2pcDFXkHswYdHWoi8JoBEwj3x4D+0NqXAxWIrgoJHe7WEyv6AQ8KDQgAEgkKBWVuLVVTEAA\\u003d\"],[[[null,null,\"vfKYwdepkg8\",[null,null,\"https://www.youtube.com/embed/vfKYwdepkg8?vq\\u003dlarge\\u0026rel\\u003d0\\u0026autohide\\u003d1\\u0026showinfo\\u003d0\"],\"yt:movie:vfKYwdepkg8\",null,null,null,null,\"AXH1ezlL6ACY4qkimIOCezplNsVMth9oWVkk6YjGIx4A5omdTupERiWRGryYyPpTab7Gu7VkE8LqwPm0F-awLFPLUxjyt3tq0uUsLk3IiYfjhQXeubvmemKhCUC1Aa_kuGeHL96AYPSI2iBIA2ozyZtAZXRuCr82G00bqX2eloJJaJ0DTK73QMK1veoWpAnTJIELZ1xYV5WG6O3mmKjGcsMO85KnQH7zBn24plMP0uWj_l5NjXko6FKjXS21Dwvt6nXXHdageajt9h-vSNpxCig2T_gTNURY_ooDfj7dQ4JdLEpbUw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/vfKYwdepkg8/hqdefault.jpg\"]]]],[null,\"The world is at your fingertips as you fight for survival, explore for fortune, and dig for glory. Delve deep into cavernous expanses, test your mettle in combat, or construct your own city!\\u003cbr\\u003e\\u003cbr\\u003eTerraria offers more than ever - including the brand new 1.4.5 Bigger and Boulder Content! \\u003cbr\\u003e\\u003cbr\\u003ePresenting an impressive catalogue of 5,000+ items, 25+ NPCs, and 400+ enemies and blending elements of classic action games with sandbox-style creativity, Terraria is truly a unique adventure!\\u003cbr\\u003e\\u003cbr\\u003eThe latest content update includes: \\u003cbr\\u003e\\u003cbr\\u003eNEW 1.4.5 CONTENT:\\u003cbr\\u003e- Dead Cells crossover content – new weapons, combat accessories and more!\\u003cbr\\u003e- Iconic Pals from Palworld have arrived in Terraria!\\u003cbr\\u003e- Fifteen new furniture sets. \\u003cbr\\u003e- Five new types of boulders — watch your step!\\u003cbr\\u003e- Four new transformation mounts.\\u003cbr\\u003e- New whips and Summoner prefixes. \\u003cbr\\u003e- New Kites, critters, and decorative features. \\u003cbr\\u003e- And so much more to discover! \\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eNEW WORLD SEEDS TO DISCOVER:\\u003cbr\\u003e- A new Skyblock world seed.\\u003cbr\\u003e- A new world creation menu allowing you to mix and match special seeds.\\u003cbr\\u003e- Improvements to existing seeds!\\u003cbr\\u003e\\u003cbr\\u003eIMPROVEMENTS:\\u003cbr\\u003e- Reworks and balance improvements to weapons. \\u003cbr\\u003e- Visual updates to many classic sprites.\\u003cbr\\u003e- And so many more improvements!\\u003cbr\\u003e\\u003cbr\\u003e• MULTIPLAYER – Play with up to 7 friends on Local Wifi or Online via device-device Wifi hosted games or through the Mobile Terraria Dedicated Server for PC (available for free on Terraria.org)\\u003cbr\\u003e• TERRARIA REIMAGINED FOR MOBILE – Fully customizable controls and User Interface provide a level of polish and capability not previously possible!\\u003cbr\\u003e• Gamepad support – including fully-remappable buttons - Play with your Bluetooth connected gamepad where supported.\\u003cbr\\u003e• Full array of World sizes – Small/Medium/Large...the same size as on Terraria for PC!  Now includes random world name generator and the ability to use World Seeds (including some hidden easter egg worlds)\\u003cbr\\u003e• Over 400 enemies to combat, defeat, and plunder for loot\\u003cbr\\u003e• Over 20 Biomes and Mini-Biomes to explore, both above and underground – from lush forests to barren deserts to dungeons, the underworld, and even the terrifying Corruption await!\\u003cbr\\u003e• Updated crafting with multiple added item options\\u003cbr\\u003e• Over 20 NPCs to discover, each providing their own benefits and unique style\\u003cbr\\u003e• More than 1000 new items to discover – bringing the total item count to more than 5000!\\u003cbr\\u003e• In-depth building options that are easy to learn but allow for amazing feats of architecture in the hands of a master.\\u003cbr\\u003e• And much, much more!\\u003cbr\\u003e\\u003cbr\\u003eIn short, every pixel of Terraria has been reimagined and hand crafted for the BEST possible mobile experience!\\u003cbr\\u003eFollow us on Twitter @Terraria_Logic and @505_Games\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eJoin our community on Discord @ http://Discord.GG/Terraria\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eLike us on Facebook at www.facebook.com/TerrariaOfficial and https://www.facebook.com/505Games\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eVisit us on the web at www.terraria.org\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eJoin the official Terraria Forums at: https://forums.terraria.org/\"],\"505 Games Srl\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/T2jPp9S-iBVX9dTw_6eZvCMwWzSDqJouiF3J9rXEIZnvPC5dJsroSilVhJcqr5h1ELWNq6y-hF3ismAIZiAr0g\"],null,[68,53,82,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null,\"Alcohol Reference, Blood and Gore, Cartoon Violence, Mild Suggestive Themes\"],[null,\"Users Interact\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[4990000,\"USD\",\"$4.99\"]],null,[null,\"Buy\"],null,2,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003