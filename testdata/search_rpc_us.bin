ent.com/tXfTaNIlluB1_a55vHbUNjIPzYDyzNyFArpsBYdwhsOLNo8q3P3HCTUC8sd8QTZkfQ_w2dQimfuJ1diIr-uj3A\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/upeLjfGyQLvNBZI6dJHt1-uYmWCJBgcQxzTZ8aIBehDx_33Sutr51L4m1jAOmGtHv0hMENawTvHuXFNU_fpS\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/a8uzJfdwpMVr07ZUcuGUrT3fvOx73_of7nUOXdd4M2Gd94une0zcxTTjZNkn6wNzyc0bWiahCEXhvms-VqVN4Q\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/QllLABriGen9-fbXKOqg-k63TY_8btBFC9arAHjfEyPLPeYg676CfZ5WFQS7mOd8iKRhScW-WWUOqZwGZRJqig\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/WsRvsZDtRXRLfonfxXbIrWW5-ZiDYEGVJ1bqGKC_FQpIz5WbRfGJSbBpx32w-1mAF4bBdYqFSCIgZzxkNtAPmg\"]],[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/QWBG-PADeWbMDTtT9mqY_no9uCTgUdyakCzGbGOIxZE1uIHu4kGH4wbMWbRv3c5vPPRLM6use6GptbMnzSubHQ\"],null,[64,197,244,255]]],\"CubeCrafter\",[\"4.4\",4.398856],\"Role Playing\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.cww.cubecraft\\u0026rdid\\u003dcom.cww.cubecraft\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.cww.cubecraft\"]],[\"qgJHGkUIGkoTCPWMn8vR2pcDFXkHswYdHWoi8PoBDwoNCAASCQoFZW4tVVMQALICGQoXChFjb20uY3d3LmN1YmVjcmFmdBABGAM\\u003d\"],[[[null,null,\"OfHs8GUpXd4\",[null,null,\"https://www.youtube.com/embed/OfHs8GUpXd4?vq\\u003dlarge\\u0026rel\\u003d0\\u0026autohide\\u003d1\\u0026showinfo\\u003d0\"],\"yt:movie:OfHs8GUpXd4\",null,null,null,null,\"AXH1ezl057OHJt3i-q70uDmKpFWL39G8uJYt7VU1HDrylZICdyph7E-aeL2PWJUrxZAeneVZHJrZ0U3ze3lBgiH4mUO3X_qa4cDIEXHgHJW0oRQR_famkOxhRY7X_Z8pxzdciY7g3lxMYvo5oNrahoWCWaXEF7LmjbSrYTiIiZjjD5GkVpR7_qtpE31-BLkJvJSSuVVyJTU-ru9BSCOxkbf-BZcPTrjbRZ9CIWHM55RmdC-JEV4E-Inq1X59E6f3S7t5EldJcXpVbEH93Sjtdna25es3mBjpfuu-wDxXgFtNucipRQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/OfHs8GUpXd4/hqdefault.jpg\"]]]],[null,\"\\u003cb\\u003e👾 A MULTI-FACETED ADVENTURE 👾\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eLooking for a casual crafting game that combines resource collecting and time management with action and adventure? CubeCrafter is an enjoyable and original game that covers all the angles – a world-building simulator where you gather resources, craft all sorts of different structures, get to explore a wide and varied game world, and even do a little fighting now and then. And bear in mind, you can do all that while riding around on the back of a pig! (Not to mention all the sheep, who provide useful wool and get in the way a lot…)\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eA CHIP OFF THE OLD BLOCK 🧱\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eThe distinctive design and simple mechanics of this crafting simulator make CubeCrafter a reassuringly familiar and entertaining experience for players of all ages. If you’re after a game that provides fun and fulfilling adventures in time-management, crafting, farming and fighting, then it’s time to explore the world of CubeCrafter 👾.\\u003cbr\\u003e\\u003cbr\\u003e🟩 \\u003cb\\u003eMine, all mine\\u003c/b\\u003e: Mine, log, farm and quarry a wide range of block-shaped resources including wood, stone, clay and wool to get the basic blocks on which to build your crafting empire 🏰.\\u003cbr\\u003e\\u003cbr\\u003e🟩 \\u003cb\\u003eGet crafty\\u003c/b\\u003e: Raw materials are enough to build a few simple structures at the start of the game, but if you want to progress and expand your world, first you’ll need to build factories to craft bricks, boards, shingles and other more advanced building materials.\\u003cbr\\u003e\\u003cbr\\u003e🟩 \\u003cb\\u003eMany hands\\u003c/b\\u003e: The more resources you need for building, the harder it gets to keep track of all your mining and manufacturing enterprises. Fortunately, this doesn’t have to be a block on your progress: You can hire laborers – lumberjacks, stone masons, miners and farmers – to help out.\\u003cbr\\u003e\\u003cbr\\u003e🟩 \\u003cb\\u003eFruits of your labors\\u003c/b\\u003e: Got blocks of resources you don’t need for crafting or building? Sell them to the game’s merchants and get currency to spend on upgrading your skills and those of your employees, including greater carrying capacity, faster movement and crafting, and a whole range of other useful benefits.\\u003cbr\\u003e\\u003cbr\\u003e🟩 \\u003cb\\u003eStart from square one\\u003c/b\\u003e: Build up the full range of mining and craft enterprises this simulator game can offer to get the materials you need to complete a major construction project, then move on to the next level and start all over again in a whole new world, moving between settings from forest to desert, and even underwater. And don’t worry, you’ll keep the upgrades you’ve made to your skills.\\u003cbr\\u003e\\u003cbr\\u003e🟩 \\u003cb\\u003eParry and block\\u003c/b\\u003e: Should ever tire of crafting and construction, you’ll be pleased to know the CubeCrafter world also has more than its fair share of action and adventure. Get ready to fight off zombies and other monsters to stop them terrorizing your lands and stealing your resources.\\u003cbr\\u003e\\u003cbr\\u003eReady for adventure? Then download CubeCrafter now and get ready to craft, construct and explore (and ride pigs)!\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy: https://say.games/privacy-policy\\u003cbr\\u003eTerms of Use: https://say.games/terms-of-use\"],\"SayGames Ltd\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/QWBG-PADeWbMDTtT9mqY_no9uCTgUdyakCzGbGOIxZE1uIHu4kGH4wbMWbRv3c5vPPRLM6use6GptbMnzSubHQ\"],null,[64,197,244,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,[null,\"Content is generally suitable for all ages. May contain minimal cartoon, fantasy or mild violence and/or infrequent use of mild language.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.cww.cubecraft\\u0026rdid\\u003dcom.cww.cubecraft\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$1.99 - $29.99 per item\",[false]],{\"101\":[null,[[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/QWBG-PADeWbMDTtT9mqY_no9uCTgUdyakCzGbGOIxZE1uIHu4kGH4wbMWbRv3c5vPPRLM6use6GptbMnzSubHQ\"],null,[64,197,244,255]]]]}]],[[[\"com.sandboxol.blockymods\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/HiDcr1lfvEM-T_i5DFdX3n9fGr564Ie0g7yKPjr9L-QnZMwl9vRgRD-IbsptQeDjk0LO8xY-sm12tv4V7eVBJg\"],null,[220,180,89,255],null,null,null,2],[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/cP8iRu9nOxNzB8mYaptRFG-C48g0J-yD4zK2dP7f744kvsccUupMy_wpeoc_Tzv6r0VfF3s26KUJ43AIZlqNgSM\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/juCIySeo6YUBYojJRhMe-ngZySW9q8AxFnkBwrgL6H9s1S2DytvagjEgs44cJ5CPBCmnzxCbhJa6HuqsC4jf\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/EPSaY9pvLg2N8Zgd5oSdmIEYfRNsiS6KyCuLKFL7_cm-xMkvn9rikJ7-WPzbkXjc5NFWUfoZ_G3HalGFBQoCRQ\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com