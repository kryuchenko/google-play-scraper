idWGlJQfwncN5Xqj4JYpOohK-QNGU\"],null,[167,152,154,255]]],\"Blockman Go\",[\"4.2\",4.204814],\"Arcade\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.sandboxol.blockymods\\u0026rdid\\u003dcom.sandboxol.blockymods\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.sandboxol.blockymods\"]],[\"qgJOGkwIG0oTCPWMn8vR2pcDFXkHswYdHWoi8PoBDwoNCAASCQoFZW4tVVMQALICIAoeChhjb20uc2FuZGJveG9sLmJsb2NreW1vZHMQARgD\"],null,[null,\"Blockman GO is a free-to-play sandbox game that brings together mini games, social networking, and endless creativity in a vibrant block world. Whether you love action-packed PvP, survival challenges, or building your dream realm, Blockman GO has something for everyone.\\u003cbr\\u003e\\u003cbr\\u003e🧱 Top Features:\\u003cbr\\u003e\\u003cbr\\u003e🎮 Massive Collection of Mini Games\\u003cbr\\u003ePlay a wide variety of popular Minecraft-style games like Bed Wars, Sky Block, Egg Wars, and more. Join friends or team up with players from around the world. With frequent updates, there’s always a new adventure waiting!\\u003cbr\\u003e\\u003cbr\\u003e🧑\\u200d🎨 Fully Customizable Avatars\\u003cbr\\u003eUnlock hundreds of stylish outfits, accessories, and skins. Express yourself and stand out in the online multiplayer community with your one-of-a-kind look.\\u003cbr\\u003e\\u003cbr\\u003e🌐 Global Social Experience\\u003cbr\\u003eMake new online friends through real-time chat, voice rooms, and group messaging. Enjoy a seamless chat app experience with AI-powered translation, making it easy to connect across languages and borders.\\u003cbr\\u003e\\u003cbr\\u003e🏠 Creative Room Building\\u003cbr\\u003eHost your own sandbox realm with free tools to build, customize, and invite others. Enjoy flexible game modes like PvP, parkour, survival, and casual hangouts—all within your own Minecraft-like server.\\u003cbr\\u003e\\u003cbr\\u003e🎉 Exciting Events \\u0026amp; Rewards\\u003cbr\\u003eJoin limited-time events to win exclusive outfits, coins, and vouchers. There’s always something new to collect and celebrate!\\u003cbr\\u003e\\u003cbr\\u003e🌍 Why Choose Blockman GO?\\u003cbr\\u003e\\u003cbr\\u003e- Massive library of mini games\\u003cbr\\u003e- Fully immersive sandbox building game\\u003cbr\\u003e- Built-in voice \\u0026amp; text chat system\\u003cbr\\u003e- Multiplayer social platform\\u003cbr\\u003e- Frequent updates and community events\\u003cbr\\u003e- Perfect for fans of Minecraft, Roblox, and creative world games\\u003cbr\\u003e\\u003cbr\\u003e🔥 Download Blockman GO now and start your adventure! Build, play, and connect with millions of players in the most creative block-style multiplayer world!\\u003cbr\\u003e\\u003cbr\\u003eEmail: bgofficialcontact@sandboxol.com \\u003cbr\\u003eDiscord: https://discord.gg/officialblockmango\\u003cbr\\u003ewebsite: https://www.blockmango.net\"],\"Blockman GO studio\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/TbDRL32U7ohXoubV-GXLcuxNp4x8BrsaPKnayOAZT-Lm3gW3BXlDK1-k47idWGlJQfwncN5Xqj4JYpOohK-QNGU\"],null,[167,152,154,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null,\"Violence\"],[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.sandboxol.blockymods\\u0026rdid\\u003dcom.sandboxol.blockymods\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.09 - $199.99 per item\",[false]],{\"101\":[null,[[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/TbDRL32U7ohXoubV-GXLcuxNp4x8BrsaPKnayOAZT-Lm3gW3BXlDK1-k47idWGlJQfwncN5Xqj4JYpOohK-QNGU\"],null,[167,152,154,255]]]]}]],[[[\"com.sandboxol.indiegame.bedwar\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/Rf2Tl6OBOhh-phuWcdQUdOFGZBNZf8ElcbTg9XNkt-Tv4YpnDMn7EGTk5QEeYTrlKJ3srZTiI4myG_NuS8sID-I\"],null,[239,240,235,255],null,null,null,2],[[null,2,[900,1600],[null,null,\"https://play-lh.googleusercontent.com/XYsypEpNuAFNo12zaoVMBDcNAIvsxzfs08bR7ntjXyekbabS-DG-GoywcIIsZLnBYCEhhRZHcOtMDKI7DbGj\"]],[null,2,[900,1600],[null,null,\"https://play-lh.googleusercontent.com/FtdmgQ_qhfZgNW2FpcrEXC9OOAyCMoMBc0CI8viWrDhMHiPYyNM6Mst2976WlnAIoosuO74wbjTlvKHyajoAXA\"]],[null,2,[900,1600],[null,null,\"https://play-lh.googleusercontent.com/yD8-7A2oqgVopU_fMHs_sJJSmmy5WbgGgNYGDtHASOhCH0ScS7kDRImSbTq74lZ1v_pw8M6nCf7Eo9BW7GxOwg\"]],[null,2,[900,1600],[null,null,\"https://play-lh.googleusercontent.com/gcdCJ3sJhcXkzkrbJV85ZOc6QeblSy5kiwRSpiOy6hMyCPAybgunbbxDidWGG_lhDMjCEHPQGQgs7NBF-7Fa_w\"]],[null,2,[720,1280],[null,null,\"https://play-lh.googleusercontent.com/iDCMIgeksqh3z2fUCtVGGNx0T9yFPevVive2qFpqZnasUwLANDeAF5osbuVd66lwxtMOcBAi7VwjnupNjPM7\"]],[null,2,[900,1600],[null,null,\"https://play-lh.googleusercontent.com/ZjIZ_RLHh9cVIpoZRwuX2GMA8BOy4P1XAk4WSTJ7STAxil7nEUbHh9wYriJiQSELOOqVkpG2b3RD4NZiLyYP\"]],[null,2,[900,1600],[null,null,\"https://play-lh.googleusercontent.com/FtdmgQ_qhfZgNW2FpcrEXC9OOAyCMoMBc0CI8viWrDhMHiPYyNM6Mst2976WlnAIoosuO74wbjTlvKHyajoAXA\"]],[null,2,[900,1600],[null,null,\"https://play-lh.googleusercontent.com/yD8-7A2oqgVopU_fMHs_sJJSmmy5WbgGgNYGDtHASOhCH0ScS7kDRImSbTq74lZ1v_pw8M6nCf7Eo9BW7GxOwg\"]],[null,2,[900,1600],[null,null,\"https://play-lh.googleusercontent.com/gcdCJ3sJhcXkzkrbJV85ZOc6QeblSy5kiwRSpiOy6hMyCPAybgunbbxDidWGG_lhDMjCEHPQGQgs7NBF-7Fa_w\"]],[null,2,[720,1280],[null,null,\"https://play-lh.googleusercontent.com/iDCMIgeksqh3z2fUCtVGGNx0T9yFPevVive2qFpqZnasUwLANDeAF5osbuVd66lwxtMOcBAi7VwjnupNjPM7\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/84SqdyaugqATHSSUSSa08SIggoQjdcPgPCLiCf7NgVeuBa2i2eYg6dNAL8N6aQOxGEGeRt-7fxKIt20ytmqWnBI\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/TQ9IHrMMlwah1gn1WV0fPRSSc3ncCVnIcw2CzUqTYdXw_EfBk8wkQjrRjS0IKRpPmgVVfUR9YpLm1E8mKKOq66U\"]],[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/lP5gc93WuoCMHveW7uBBMpxNyUdofX-99XYlqU_HbyOq38hoiWlO8_ZJ8RL5rG7peyWrtCoLm__fPIj-augP7w\"],null,[171,240,249,255]]],\"Bed Wars\",[\"4.2\",4.204463],\"Action\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.sandboxol.indiegame.bedwar\\u0026rdid\\u003dcom.sandboxol.indiegame.bedwar\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.sandboxol.indiegame.bedwar\"]],[\"qgJUGlIIHEoTCPWMn8vR2pcDFXkHswYdHWoi8PoBDwoNCAASCQoFZW4tVVMQALICJgokCh5jb20uc2FuZGJveG9sLmluZGllZ2FtZS5iZWR3YXIQARgD\"],[[[null,null,\"AuZJzu8mjNs\",[null,null,\"https://www.youtube.com/embed/AuZJzu8mjNs?vq\\u003dlarge\\u0026rel\\u003d0\\u0026autohide\\u003d1\\u0026showinfo\\u003d0\"],\"yt:movie:AuZJzu8mjNs\",null,null,null,null,\"AXH1eznXdR4-1R2LcVvnmnVFwnNIzSxYV-a8oFYuyzyK55YbC2pU4BT_cxEd1-2dXzxoq7itK000Wji1DLXJsV3xTtkWfS4nGKjl0HPMoacqUHmO393B4P9blptwjUVQp-7LKLjaiubux8MqEp1Rg4w3ZnFYFknHubkMgb_090UD86r0QpH65i5Sv4r9vNamYMq8vaDMG0m7UD458O5wtpHcUDS951JFDL1845XgcCzgcI0maRthxxQcqjkpbG7vw4KRXdiTVd3Hw8AmTm-eynyDaLkJ51JlMUZWmuAKd60m3s8D7w\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/AuZJzu8mjNs/hqdefault.jpg\"]]]],[null,\"Bedwars is a teamwork PVP game, you will be battling your opponents on islands in the sky, protect your bed and try to destroy your opponents\\u0026#39; bed to prevent them from respawning, beat all the opponents to win the game!\\u003cbr\\u003e\\u003cbr\\u003eTeam Work⚔️\\u003cbr\\u003e16 players divided into 4 teams,spawning on different islands,build bridges with blocks to attack your opponents and contest the resources to upgrade your weapon and items so you can destroy your enemies\\u0026#39; beds more easily! Get matched in seconds to compete with players from all over the world, the challenger spots are waiting for you!\\u003cbr\\u003e\\u003cbr\\u003eMultiple Modes🏰\\u003cbr\\u003eSolo, Duo, Quad three modes in different maps that are picked randomly, different styles, different tactics, no matter you are solo queueing or queueing with your friends you can get matched in second and enjoy the addicting and intense game pace.\\u003cbr\\u003e\\u003cbr\\u003eVariety of Items💣\\u003cbr\\u003ePurchase different types of blocks, weapons, tools, firebomb, traps, and more items with the resources you collected, different ways and tactics to defeat your opponents for you to discover.；Melee, ranged, techniques with different items, the only limitation is your imagination!\\u003cbr\\u003e\\u003cbr\\u003eLive-time Chat😎\\u003cbr\\u003eCan\\u0026#39;t find buddies to play together? Bedwars has built-in chat systems,identify your language automatically and match you into the correct channel so you can communicate with players who speak the same language as you to make more friends online!\\u003cbr\\u003e\\u003cbr\\u003eCustom Avatar🎲\\u003cbr\\u003eCustomized skins for multiple categories, thousands of avatar skins for you to choose from, there will be always one option fit for you, present yourself with a unique look in the Bedwars!\\u003cbr\\u003e\\u003cbr\\u003eIf you have any fund problem or suggestions please contact us via email.\\u003cbr\\u003ebgofficialcontact@sandboxol.com\"],\"Blockman GO studio\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/lP5gc93WuoCMHveW7uBBMpxNyUdofX-99XYlqU_HbyOq38hoiWlO8_ZJ8RL5rG7peyWrtCoLm__fPIj-augP7w\"],null,[171,240,249,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null,\"Violence\"],[null,\"Users Interact, Digital Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.sandboxol.indiegame.bedwar\\u0026rdid\\u003dcom.sandboxol.indiegame.bedwar\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.09 - $99.99 per item\",[false]],{\"101\":[null,[[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/lP5gc93WuoCMHveW7uBBMpxNyUdofX-99XYlqU_HbyOq38hoiWlO8_ZJ8RL5rG7peyWrtCoLm__fPIj-augP7w\"],null,[171,240,249,255]]]]}]],[[[\"com.indiecreatorluck.minecraftbuild\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/gfp-LS8YmgVlBzAiKjqkdTinG3o4-eK5Rn4FvWgf0YzKr3_Z3Mr0M1ewcyx9EFBEp4qMJkGb7X0_wTvqwDcQrA\"],null,[250,135,32,255],null,null,null,2