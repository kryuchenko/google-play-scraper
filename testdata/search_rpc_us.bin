ll,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tgc.sky.android\\u0026rdid\\u003dcom.tgc.sky.android\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.tgc.sky.android\"]],[\"qgJeGlwIKxIbChkKE2NvbS50Z2Muc2t5LmFuZHJvaWQQARgDShMI9Yyfy9HalwMVeQezBh0daiLwmgETCPfHgP7Q2pcDFYiuCgkd7tYTK/oBDwoNCAASCQoFZW4tVVMQAA\\u003d\\u003d\"],[[[null,null,\"BNoXRsoAPMw\",[null,null,\"https://www.youtube.com/embed/BNoXRsoAPMw?vq\\u003dlarge\\u0026rel\\u003d0\\u0026autohide\\u003d1\\u0026showinfo\\u003d0\"],\"yt:movie:BNoXRsoAPMw\",null,null,null,null,\"AXH1ezlKaSx7xQLeKtaGa9lHzisGckO4IMHMSZHav5yfSKXvB3hWxtYu56Oa1F8lpzBHVacJtVYCufjQMHv_7bsiRR3wf62Pc8HCmpRLgOxSiBi8-JcTUgCxUdcI3n93OfpQhPzeaK857kL4nZAxWL73ZkS9_KBZSqvnfaX6WqNPKD7eXeByizXLZVXbzau1XCXHE4QL77L007frK-tlaLujvBUdS1qzH0a0waV4y5lYn0WBCKnsOyx59uH7Ta5L5OYAy-RqsDE7Zxflmq3I5Lq9lBoE-R8DBA_u_5nWLCABZaV5JA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/BNoXRsoAPMw/hqdefault.jpg\"]]]],[null,\"In Sky, a fellow adventurer takes your hand and leads you somewhere you\\u0026#39;d never have found on your own. That\\u0026#39;s the heart of it: real people quietly looking after each other across a beautiful, forgotten kingdom. A small gesture can become a friendship, and an unfamiliar player can make a lonely journey feel a little less lonely.\\u003cbr\\u003e\\u003cbr\\u003eFree to play and with no ads to break the moment, Sky is a peaceful, award-winning social adventure from the creators of Journey. Explore seven hand-crafted realms, solve gentle puzzles, and find your way home alongside millions of players around the world. Anything you can buy is cosmetic, so all you need to bring is your curiosity.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eGame Features:\\u003cbr\\u003e\\u003cbr\\u003eFRIENDS YOU DIDN\\u0026#39;T EXPECT\\u003cbr\\u003e\\u003cbr\\u003eLight someone\\u0026#39;s candle, offer a hand, share a bench at sunset. There are countless small ways to meet another player here, and friendships tend to start with a gesture rather than a word.\\u003cbr\\u003e\\u003cbr\\u003eMORE REASONS TO RETURN\\u003cbr\\u003e\\u003cbr\\u003eEvery day brings something new to find. Play regularly to unlock fresh experiences and earn candles you can redeem for cosmetics.\\u003cbr\\u003e\\u003cbr\\u003eA STYLE THAT\\u0026#39;S ONLY YOURS\\u003cbr\\u003e\\u003cbr\\u003eEvery season and event brings new looks and accessories. Express yourself, find a style of your own, and dress like someone worth recognizing across a crowded realm.\\u003cbr\\u003e\\u003cbr\\u003ePLENTY TO DO TOGETHER\\u003cbr\\u003e\\u003cbr\\u003eLearn new emotes and gain wisdom from Elder Spirits. Challenge a friend to a race, get cozy around a fire, jam on instruments, or fly down a mountainside. Just beware of the Krill.\\u003cbr\\u003e\\u003cbr\\u003eCROSS-PLATFORM PLAY\\u003cbr\\u003e\\u003cbr\\u003eYour friends are here, whatever they\\u0026#39;re playing on.\\u003cbr\\u003e\\u003cbr\\u003eSHARE WHAT YOU SEE\\u003cbr\\u003e\\u003cbr\\u003eSky has a remarkable community of photographers, artists, and filmmakers. Capture your favorite moments and share the memories you make together.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eWinner of:\\u003cbr\\u003e\\u003cbr\\u003e-Mobile Game of the Year (Apple)\\u003cbr\\u003e-Outstanding Design and Innovation (Apple)\\u003cbr\\u003e-Most users in a concert-themed virtual world (Guinness World Record)\\u003cbr\\u003e-Mobile Game of the Year (SXSW)\\u003cbr\\u003e-Best Visual Design: Aesthetic (Webby)\\u003cbr\\u003e-Best Gameplay \\u0026amp; People’s Choice (Games for Change Awards)\\u003cbr\\u003e-Audience Award (Game Developers Choice Award)\\u003cbr\\u003e-Best Indie Game (Tap Tap Game Awards)\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eAs required by Indonesian law, this game is classified as 13+ by IGRS.\"],\"thatgamecompany inc\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/S88VLRHfwKDQiiSLLh8wbbw3FSMgcg-C3okKfm4GPKaWA7-O1cC_O8PAh7AEmSthaNS_k4bAF19Gu72m7G6A\"],null,[31,57,74,255]],null,[\"Everyone 10+\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/csiz76udPjXmaJddU_1sanHGlQAAbKkvlprK3DSUNmwu1nY3U6qnXRrI2IDMaivooYK1x11oxz3PEO4z\"]],[null,\"Fantasy Violence\"],[null,\"Users Interact, In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/bxs95MghtAOuZR_LPwVCUmUPYEvXsGVOH3chF1OCX0-Ns_S0qdHnzml2CGCgOGbYlftKsmt9gtpxLb8U\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tgc.sky.android\\u0026rdid\\u003dcom.tgc.sky.android\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $49.99 per item\",[false]]],[[\"com.crowdstar.covetHome\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/wMfXqyWkT0mDAkdhg-7C8FTLcWsH9mvWevLbajJyyoletchpqrI97kLrtmPuZAPR2bsmp3v3S9MaP3tE-2cWxos\"],null,[171,201,235,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/Zl2QU26B8sLp6nJtikpxqFzcpYaC-jSgMURiSG51rDbLjU6IXCrJqDLly7egScrA7qmPF_xJQE_5XWy5TikLgg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/fRUFN_XvAkb21yk2JfU0D62Nx58Nxx9vaGgys2P6XX7jB8GhtASpaKS6ZxBYbR95vDrSlOkNccJJojh06eHorEc\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleuser