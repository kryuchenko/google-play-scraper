om.mojang.minecraftedu\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/JbaRbEMRaS8-9MT-jS7P_iiqgJZq1OVh6VM-OEaMuHj6em7JV3ZvuBHoFhg6z8lHCIG81d66boVJl7LUTQZJ\"],null,[192,153,94,255],null,null,null,2],[[null,2,[1364,2560],[null,null,\"https://play-lh.googleusercontent.com/ab-yKOsmbrKSfSOucaBW_TTaLRPc_Y__BYIclR9GPPUa7qE-u2XJZKvFHCPENvmeX4BDhqFroX2KPgKP11-Bgw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/5CxcvdNK-mpm2RPhEjgfKuN-Hpz2mgNA8-BaO-JKDFHvE223YY9-8SJF8Y9wceZVZ9Wqi0f5yaEwcSoDL0g9RKs\"]],[null,2,[1364,2560],[null,null,\"https://play-lh.googleusercontent.com/9qjvZbbmvNKmBwJdLPEum8IHwR6cZDkZN4wvbq02psG-J56nupLDOw9eRYDnSglYIj6dJOQPGkgd-OJbV08v\"]],[null,2,[994,1905],[null,null,\"https://play-lh.googleusercontent.com/UA8rrL_gP5B7kDCnq09JaMfmBLpoXqile8NAio6-hMzEtxIE4OdVM95YtVJCfTyCU0YbtYTokd7ii_hZrieimPM\"]],[null,2,[1362,2560],[null,null,\"https://play-lh.googleusercontent.com/DPJR2CdQsTeyAHNU0gtPlqCs1fT3qUho3Sgk2_ekJ0FvUYonzu1vKtsD_o_97QnIfqDCSsPxEDSW5rEd6kbjVg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/BXTp7-WUP7a7XcRHYfli0FNyO64yAbNvE7BpVSETFX-pjlOuy5-7P6t5xnm0OeJuhgqeq0-nnAppTSQYt5s_gFQ\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/rvGB4N7b13aZrgxiIeVcAHuSmaLyXRU0-7es51H-BqbSurkUoPx3lVLPLKyRiwOfEF7OvvXOhS1rxQ0gUlBbul8\"]],[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/FHNXao7_mUhFPiitEDkiGvZSWT3e27rJuyexIZhw1YBT0V_NzIBjgZTi0qnMyALdM72DwhN50ebsXPo-PYz3Nw\"],null,[92,134,32,255]]],\"Minecraft Education\",[\"4.1\",4.1255045],\"Education\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mojang.minecraftedu\\u0026rdid\\u003dcom.mojang.minecraftedu\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.mojang.minecraftedu\"]],[\"qgJVGlMIAEoTCPWMn8vR2pcDFXkHswYdHWoi8PoBDwoNCAASCQoFZW4tVVMQAIgCBLICHwodChdjb20ubW9qYW5nLm1pbmVjcmFmdGVkdRABGAPKAgIIBA\\u003d\\u003d\"],null,[null,\"THIS APP IS FOR SCHOOL AND ORGANIZATIONAL USE. \\u003cbr\\u003e\\u003cbr\\u003eMinecraft Education is a game-based platform that inspires creative, inclusive learning through play. Explore blocky worlds that unlock new ways to tackle any subject or challenge. \\u003cbr\\u003e\\u003cbr\\u003eDive into subjects like reading, math, history, and coding with lessons and standardized curriculum designed for all types of learners. Or explore and build together in creative open worlds.\\u003cbr\\u003e\\u003cbr\\u003eUSE IT YOUR WAY\\u003cbr\\u003eWith hundreds of ready-to-teach lessons, creative challenges, and blank canvas worlds, there are lots of ways to make Minecraft Education work for your students. It’s easy to get started, no gaming experience necessary.\\u003cbr\\u003e\\u003cbr\\u003ePREPARE STUDENTS FOR THE FUTURE\\u003cbr\\u003eHelp learners develop key key skills like problem solving, collaboration, digital citizenship, and critical thinking to help students them thrive now and in the future workplace. Spark a  passion for STEM.\\u003cbr\\u003e\\u003cbr\\u003eGAME-BASED LEARNING\\u003cbr\\u003eUnlock creativity and deep learning with immersive content created with partners including BBC Earth, NASA, and the Nobel Peace Center. Inspire students to engage in real-world topics with culturally relevant lessons and build challenges.\\u003cbr\\u003e\\u003cbr\\u003eKEY FEATURES \\u003cbr\\u003e - Multiplayer mode enables collaboration in-game across platforms, devices, and hybrid environments \\u003cbr\\u003e - Code Builder supports block-based coding, JavaScript, and Python with intuitive interface and in-game execution\\u003cbr\\u003e - Immersive Reader helps players read and translate text \\u003cbr\\u003e - Camera and Book \\u0026amp; Quill items allow documentation and export of in-game-creations\\u003cbr\\u003e - Integration with Microsoft Teams and Flipgrid supports assessment and teacher controls\\u003cbr\\u003e\\u003cbr\\u003eMinecraft Education licenses can be purchased with Admin access to a Microsoft 365 Admin Center account. Talk to your Tech Lead for information on academic licensing. \\u003cbr\\u003e\\u003cbr\\u003eTerms of use: The terms that apply to this download are the terms that were presented when you purchased your Minecraft Education subscription.\\u003cbr\\u003e\\u003cbr\\u003ePrivacy policy: https://aka.ms/privacy\"],\"Mojang\",\"50,000,000+\",null,\"Ages 9+\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/FHNXao7_mUhFPiitEDkiGvZSWT3e27rJuyexIZhw1YBT0V_NzIBjgZTi0qnMyALdM72DwhN50ebsXPo-PYz3Nw\"],null,[92,134,32,255]],null,[\"Everyone 10+\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/csiz76udPjXmaJddU_1sanHGlQAAbKkvlprK3DSUNmwu1nY3U6qnXRrI2IDMaivooYK1x11oxz3PEO4z\"]],[null,\"Fantasy Violence\"],[null,\"Users Interact\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/bxs95MghtAOuZR_LPwVCUmUPYEvXsGVOH3chF1OCX0-Ns_S0qdHnzml2CGCgOGbYlftKsmt9gtpxLb8U\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mojang.minecraftedu\\u0026rdid\\u003dcom.mojang.minecraftedu\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],{\"102\":[null,[[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/FHNXao7_mUhFPiitEDkiGvZSWT3e27rJuyexIZhw1YBT0V_NzIBjgZTi0qnMyALdM72DwhN50ebsXPo-PYz3Nw\"],null,[