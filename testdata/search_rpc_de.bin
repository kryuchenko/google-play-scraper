,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.dts.freefiremax\"]],[\"qgJeGlwIEBIbChkKE2NvbS5kdHMuZnJlZWZpcmVtYXgQARgDShMIpbrPy9HalwMV722EBh2ZFBYqmgETCLrUnLXR2pcDFeJdhAYd6osV4voBDwoNCAASCQoFZGUtREUQAQ\\u003d\\u003d\"],[[[null,null,\"IGjKTIHRB5I\",[null,null,\"https://www.youtube.com/embed/IGjKTIHRB5I?vq\\u003dlarge\\u0026rel\\u003d0\\u0026autohide\\u003d1\\u0026showinfo\\u003d0\"],\"yt:movie:IGjKTIHRB5I\",null,null,null,null,\"AXH1eznmRyj6wLdlfGWIsJQPZ1fJHKFGSbNVWxM2GLwk2ZkxfoFlpgGgEn45iLm9veh2KIxqrTlqLZQwJ2eSmJAFX-wv9CLNVJzf9lRx3_RXaCAe-0Zs9la7Hl_HypnrLHx5OI2xGXJ2w8mT22EyMQjdpvw0fAnJaUjjc6vyV0T2jWYGjR6sHCF5Ho8SeAupJFc1AiqmfBAOwjrhegoVedeozEqh8yRIKoO9cA6GKpwf2E-eP-Udd22KpMYBzxbnCi17NoxFOr8Whf4luo74ZdB9dPSDp1XtJRHmng89NhAfqBlP6Q\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/IGjKTIHRB5I/hqdefault.jpg\"]]]],[null,\"Ninjas unite. The Nine Tails is back!\\u003cbr\\u003e\\u003cbr\\u003eThe classic collaboration returns with the Hidden Leaf Village, Ninjutsu Scrolls, Reanimation Revival Points, and more, plus new gameplay, ninjutsu, and locations!\\u003cbr\\u003e\\u003cbr\\u003e[Nine Tails Strikes \\u0026amp; Sharingan: Control]\\u003cbr\\u003eWhile players are on the plane, the Nine Tails can trigger random events such as forced parachute jumps, Arsenal openings, and supply drops. Capture Sharingan: Control to direct a Tailed Beast Bomb at any target area!\\u003cbr\\u003e\\u003cbr\\u003e[Ninjutsu Scrolls Return]\\u003cbr\\u003eFireball Jutsu, Water Dragon Jutsu, Chidori, Rasengan, and more are back. Try the new 8 Trigrams Palm Rotation to repel nearby enemies and block incoming shots with a spinning chakra defense.\\u003cbr\\u003e\\u003cbr\\u003e[Explore the New Ninja Academy]\\u003cbr\\u003eThe Hidden Leaf Village returns alongside the new Ninja Academy. Take a seat on the nostalgic swing at the school gate to relive iconic anime moments. Interact with it to get a buff!\\u003cbr\\u003e\\u003cbr\\u003e[Ninjas Unite Against the Nine Tails]\\u003cbr\\u003eComplete tasks to collect event tokens and unlock ninjas and their exclusive combo skills. Defend against the Nine Tails alongside them, and choose either the Jiraiya Bundle or Hinata Bundle as your grand prize!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eFree Fire is a world-famous survival shooter game available on mobile. Each 10-minute game places you on a remote island where you are pit against 49 other players, all seeking survival. Players freely choose their starting point with their parachute, and aim to stay in the safe zone for as long as possible. Drive vehicles to explore the vast map, hide in the wild, or become invisible by proning under grass or rifts. Ambush, snipe, survive, there is only one goal: to survive and answer the call of duty.\\u003cbr\\u003eFree Fire, Battle In Style!\\u003cbr\\u003e\\u003cbr\\u003e[Survival shooter in its original form]\\u003cbr\\u003eSearch for weapons, stay in the play zone, loot your enemies and become the last man standing. Along the way, go for legendary airdrops while avoiding airstrikes to gain that little edge against other players.\\u003cbr\\u003e\\u003cbr\\u003e[10 minutes, 50 players, epic survival goodness awaits]\\u003cbr\\u003eFast and Lite gameplay - Within 10 minutes, a new survivor will emerge. Will you go beyond the call of duty and be the one under the shining lite?\\u003cbr\\u003e\\u003cbr\\u003e[4-man squad, with in-game voice chat]\\u003cbr\\u003eCreate squads of up to 4 players and establish communication with your squad at the very first moment. Answer the call of duty and lead your friends to victory and be the last team standing at the apex.\\u003cbr\\u003e\\u003cbr\\u003e[Clash Squad]\\u003cbr\\u003eA fast paced 4v4 game mode! Manage your economy, purchase weapons, and defeat the enemy squad!\\u003cbr\\u003e\\u003cbr\\u003e[Realistic and smooth graphics]\\u003cbr\\u003eEasy to use controls and smooth graphics promises the optimum survival experience you will find on mobile to help you immortalize your name among the legends.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003e[Contact us]\\u003cbr\\u003eCustomer Service: https://support-freefiresg.garena.com\"],\"GARENA INTERNATIONAL I\",\"500.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/5zknneX-sYhucAkKL0nGAmHn4_r7Vjc8t1Dx6iBLHJwivlnuhcJ7ChbHKfOvuXbrafuS-rNpvChuAEIcbwXw\"],null,[136,164,195,255]],null,[\"USK ab 16 Jahren\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/cq-61uX75JlSRyeihENPRwZbTXESpJAyyMqYwWrHbcnkW3FNbVnjNSEi1-7i3nG3ErpZWLS5AOH_Bq5P\"]],[null,\"Gewalt und Erhöhte Kaufanreize\"],[null,\"Chats und Käufe im Spiel (enthält Zufallsartikel)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eWeitere Informationen\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/pjLkbdMr3lglyi9KcI6G6fW9kIS_Jq0hndGKRLnFtEzPP6-xH6j_W_Qn-z5qeJRoudfL7gK6BuTrkE-3mcU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"EUR\",\"\"]],null,[null,\"Kaufen\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.dts.freefiremax\\u0026rdid\\u003dcom.dts.freefiremax\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Installieren\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"0,09 €–149,99 € bei Abrechnung über Google Play\",[false]]],[[\"com.MaxProGame.RealisticCraft\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/DqIA-RJvi1L0ft27gY-xYL347woZMPej39ZeOr27p-4fFrq1qQGh8ngF4yPzQhiMDuXgT9N8zRn_kz1cjHJrVdc\"],null,[0,0,0,255],null,null,null,2],[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/zTXV0dVC2M96k1T_BbbubGYCX8dZtYq1GNHQDmaqJnXOsFoDg9-sma9ESWvG-