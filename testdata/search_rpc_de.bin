)]}'

[["wrb.fr","lGYRle","[[null,[[null,null,null,[\"qgIdEhsQAKIBEwilus/L0dqXAxXvbYQGHZkUFir6CQA\\u003d\"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[\"Über diese Ergebnisse\",[null,\"Diese Ergebnisse basieren auf deiner Suche. Die Reihenfolge der Ergebnisse wird von drei wesentlichen Faktoren bestimmt: Relevanz, Nutzerinteraktion und Qualität. Der Einfluss dieser Faktoren variiert je nach Art der Suchanfrage.\"],[\"Weitere Informationen\",null,null,[[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dplay_store_search\"]]],\"Weitere Informationen\"],\"Ok\"]],[null,null,null,[\"qgJhEl8QAaIBEwilus/L0dqXAxXvbYQGHZkUFiqKAkQKPAo2YXBwc19tZHBfc2VhcmNoX3Jlc3VsdHNfY2x1c3Rlcl9jb20ubW9qYW5nLm1pbmVjcmFmdHBlEC0YAxAAGAAgAA\\u003d\\u003d\"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,null,[[\"Minecraft\"],null,null,null,null,null,null,null,null,[\"USK ab 6 Jahren\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/8HPdf_L4Or-ku-j-kmUxJEwvGX6EHcrgeqTx-xvQGKCpqK-cFu5J8qLDRE4qUlPCVdd21MfZWWqxIWv1iKA\"]],[null,\"Comic-Gewalt, Schreckmomente und Handlungsdruck\"],[null,\"Chats und Käufe im Spiel\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eWeitere Informationen\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/z9D7ghLEH_YLU71JE65NeArDYb9E_Q3JpvXMoJtp1c7SVoDbWx9XCb96XYrjDMCl0Igaxd7a01JhpIrwsw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],null,null,null,[\"50.000.000+\",50000000,99725720,\"50 Mio.+\"],null,null,null,null,[2],[\"0,50 €–49,99 € bei Abrechnung über Google Play\",[false]],null,null,null,null,null,null,null,null,null,null,[],null,null,null,null,null,null,null,null,null,null,[[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mojang.minecraftpe\"]],[1,true,false],null,null,null,null,null,null,[[\"Erkunde zahllose Welten und lass deiner Kreativität beim Bauen freien Lauf – entweder alleine oder mit deinen Freunden\",\"Spiele im Kreativmodus mit unbegrenzten Ressourcen oder stell Waffen \\u0026 Rüstungen her, um im Überlebensmodus gefährliche Gegner zu bekämpfen\",\"Auf dem Minecraft Marketplace findest du Kreationen anderer Spieler – von einzigartigen Karten bis hin zu Skins, Texturpaketen und Add-ons\"]],null,[[\"4,4\",4.3659782],[null,[\"614.163\",614163],[\"138.621\",138621],[\"204.592\",204592],[\"439.965\",439965],[\"4.472.712\",4472712]],[\"5.870.096\",5870096],[\"138.965\",138965],null,[null,[]]],null,null,null,null,null,[[[[[null,[[6990000,\"EUR\",\"6,99 €\"]],null,[null,\"Kaufen\"],null,2,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mojang.minecraftpe\\u0026rdid\\u003dcom.mojang.minecraftpe\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[],null,null,[[\"Desktopversion separat erhältlich\"]]]],[\"Für 6,99 € kaufen\"],null,[\"CgYKBENBRT0\\u003d\"]]]],null,null,null,null,null,null,null,null,null,null,[\"Mojang\",[null,null,null,null,[null,null,\"/store/apps/dev?id\\u003d4772240228547998649\"]],\"4772240228547998649\"],null,null,null,[[null,\"ERSCHAFFEN \\u003cbr\\u003eBaue alles, was du dir vorstellen kannst, in deiner eigenen unendlichen Welt, die in jedem Spieldurchgang einzigartig ist. \\u003cbr\\u003eERKUNDEN   \\u003cbr\\u003eEntdecke Biome, Ressourcen und Mobs und bahne dir deinen Weg durch eine Welt voller Überraschungen im ultimativen Sandbox-Spiel. \\u003cbr\\u003e\\u003cbr\\u003eÜBERLEBE  \\u003cbr\\u003eErlebe unvergessliche Abenteuer, während du dich geheimnisvollen Feinden stellst, aufregende Landschaften durchquerst und in gefährliche Dimensionen reist. \\u003cbr\\u003e\\u003cbr\\u003eSPIELT ZUSAMMEN  \\u003cbr\\u003eAmüsier dich im plattformübergreifenden Spiel für Konsole, Handy und PC mit deinem Freundeskreis, auch wenn ihr kilometerweit voneinander entfernt seid. Verbinde dich mit Millionen von Spielenden auf den Community-Servern oder abonniere Realms Plus, um mit bis zu 10 Freundinnen und Freunden auf deinem eigenen privaten Server zu spielen \\u003cbr\\u003e\\u003cbr\\u003eMEHR ERLEBEN \\u003cbr\\u003eHol dir auf dem Minecraft Marketplace von den Entwicklenden erstellte Add-ons, spannende Welten und stylische Kosmetika. Abonniere den Marketplace Pass (oder Realms Plus), um Zugang zu mehr als 150 Welten, Skin- und Texturpaketen und vielem mehr zu erhalten, die monatlich aktualisiert werden. \\u003cbr\\u003e \\u003cbr\\u003eSUPPORT: https://www.minecraft.net/help \\u003cbr\\u003eMEHR ERFAHREN: https://www.minecraft.net/ \\u003cbr\\u003e\\u003cbr\\u003eMINIMALE EMPFOHLENE SPEZIFIKATION \\u003cbr\\u003e\\u003cbr\\u003eUm die Anforderungen für dein Gerät zu überprüfen besuche: https://help.minecraft.net/hc/en-us/articles/4409172223501\\u003cbr\\u003e\\u003cbr\\u003eDiese App nutzt Bedienungshilfen-Dienste.\\u003cbr\\u003eMinecraft enthält einen Bedienungshilfen-Dienst, der die Touch-Interaktion bei Verwendung eines Screenreaders verbessert. Dieser Dienst passt lediglich Bereiche an, die Berührungen durchlassen (Touch-Passthrough-Bereiche); er liest, protokolliert oder überträgt weder Ihre Bildschirminhalte noch Ihre persönlichen Daten.\"]],[[null,\"In Minecraft geht es um das Bauen mit Blöcken und das Erleben von Abenteuern!\"]],null,null,null,null,[[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/LvTKBBIfy3RLmCk_EpXDnYMP3NV3MaAOQWnQ1Feuyym2QcmX3sooTLRgkP5KvNp-zGaUyQZ1t11T9YaDea4cdvI\"]],[null,2,[1078,1920],[null,null,\"https://play-lh.googleusercontent.com/65_6L3XiLPiJbckRpUPC9K5XDRyXTxl7Kshm4pWxTXNzl-fdn7CDKEfnyfXcBjrPvp9v1qi4hBp9kI2x3jb0fw\"]],[null,2,[1080,1920],[null,null,\"https://play-l