ercontent.com/rgYnO59uOBQwWSk6YywkHnxXg58MZM1vzb5_SkMUC-bh3bwXTVGxUgb3K662w3M_VX8XciNMiB9rwA8ALP6vcQ\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/JjMEvinxQiGjh7FHS7vj4f5ctYj7jhZMW2yvtKvPiZheG39Ol2QjIB3kyiXp7DSHQJiFp6p6HRvIgW24v0_GYg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/GXxYcAUJIdHFzNo4e9xb1hkaom6bLNwiWuZH6K3a3i8cJWPNMZildTy44u-Hg683WE5cdqXGCt_99dc1mrNYZw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/JTOhlXvOEExc_yegZuAY8eroV59Yyy7eZRwQvNdRWnvAsEDlyRqno1SLaC9prKkanvEcupbLbD24alFOepqcgeA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/0gDOm2z9IJ9psauT6fTweD6qokwTPfcd3AX4VMJcIFp-li49j9ljJIPNGc9Kjr8XWgH81MB8a3CNVv_29jVEVEw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/rgYnO59uOBQwWSk6YywkHnxXg58MZM1vzb5_SkMUC-bh3bwXTVGxUgb3K662w3M_VX8XciNMiB9rwA8ALP6vcQ\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/K_EVUFVp5PxLkyeORM9aJibM7DpLGg-e0TNaap3KTm__IfHfo050ofKFI5b7XnKXcKP88c8DtVIsm3CthK9ZcQ\"]]],\"Pixel Gun 3D - Battle Royale\",[\"4,2\",4.2269025],\"Action\",null,null,[null,[[0,\"EUR\",\"\"]],null,[null,\"Kaufen\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.pixel.gun3d\\u0026rdid\\u003dcom.pixel.gun3d\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.pixel.gun3d\"]],[\"qgJiGmAIAhIXChUKD2NvbS5waXhlbC5ndW4zZBABGANKEwilus/L0dqXAxXvbYQGHZkUFiqaARMIutSctdHalwMV4l2EBh3qixXi+gEXChUIhLLplKaa24tDEgkKBWRlLURFEAA\\u003d\"],null,[null,\"Die Baller Spiele haben einen neuen Champion. Pixel Gun 3D ist ein unterhaltsames Mehrspieler-Ego-Shooter. Lade das Spiel herunter! Spaß ist garantiert – dank Klötzchengrafik, Wettkämpfen im Spiel und vielen weiteren Besonderheiten:\\u003cbr\\u003e\\u003cbr\\u003e🔫 Die Baller Spiele mit über 1000 Waffen\\u003cbr\\u003e💣 40 nützliche Gadgets und Tools\\u003cbr\\u003e🕹️ 10 abwechslungsreiche Spielmodi\\u003cbr\\u003e🎮 10 spannende Mini-Spiele\\u003cbr\\u003e🏰 Über 100 schön gestaltete Karten, die im Jahresverlauf wechseln\\u003cbr\\u003e💀 Zombie-Überlebenskampagne\\u003cbr\\u003e\\u003cbr\\u003e👑 BRANDNEUE CLANS 👑\\u003cbr\\u003eVerbünde dich mit deinen Freunden – steig zusammen mit deinem Clan in die oberste Liga auf und genieße die wertvollen Preise.\\u003cbr\\u003eVerbessere und gestalte deine Festung individuell, wehre PvE-Belagerungen ab und erschaffe mächtige Panzer, um die Festungen fremder Clans anzugreifen.\\u003cbr\\u003e \\u003cbr\\u003e⚔️ KÄMPFE IN CLAN-KRIEGEN! ⚔️\\u003cbr\\u003eErobere Territorien, kontrolliere die riesige globale Karte, sammle Heldenpunkte und fülle mithilfe deiner Ländereien deine Kriegskasse auf.\\u003cbr\\u003e \\u003cbr\\u003e🗡️ HUNDERTE VON WAFFEN 🗡️\\u003cbr\\u003eCoole Baller Spiele kommen nicht ohne viele verschiedene Waffen aus. Pixel Gun 3D bietet mehr als 800 verschiedene Waffen – und du kannst sie alle nutzen. Schwingst du gerne ein mittelalterliches Schwert mit Schild oder hättest du lieber einen Dunkle-Materie-Generator? Leg einfach los! Und vergiss die Granaten nicht …\\u003cbr\\u003e \\u003cbr\\u003e😎 UNMENGEN VON SKINS 👽\\u003cbr\\u003eWärst du gerne ein Ork? Ein Skelett? Eine mächtige Amazone – oder doch etwas völlig anderes? Nutze die unglaublich detaillierten Skins und Outfits und präsentiere dich im besten Licht. Oder gestalte im Skin-Editor dein eigenes Aussehen.\\u003cbr\\u003e\\u003cbr\\u003e👾 SPIELMODI 👾\\u003cbr\\u003eBattle-Royale, Raid, Deathmatch, Duell … Du hast zahlreiche Möglichkeiten, dich im Kampf zu beweisen. Ganz zu schweigen von den wöchentlich wechselnden Brawl-Kämpfen …\\u003cbr\\u003e\\u003cbr\\u003e🎲 MINI-SPIELE 🎲\\u003cbr\\u003eWird es langsam langweilig, immer der Beste auf dem Schlachtfeld zu sein? Dann solltest du an den Wettkämpfen teilnehmen! Miss dich mit den besten Kriegern auf der ganzen Welt. Sniper-Turnier, Parcours-Herausforderung, Glider Rush und weitere Herausforderungen warten auf ihren Helden!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eFolge unseren News:\\u003c/b\\u003e\\u003cbr\\u003eFacebook: https://www.facebook.com/PixelGun3DOfficial/\\u003cbr\\u003eYouTube: https://www.youtube.com/channel/UCsClw1gnMrmF6ssIB_166_Q/\\u003cbr\\u003eSupport: support.gp@cubicgames.com\\u003cbr\\u003e\\u003cbr\\u003eMagst du Baller Spiele? Wenn ja, lade dieses tolle Shooter-Spiel herunter!\"],\"Pixel Gun 3D\",\"100.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/SSeD0E-DrjVboLm6w0VC98EcBtAi0MjE-f85E7Lm5_wHRsqv5ieOZr_cpHRdVhkfv8fmkYnaMtQs9_DCbdPR\"],null,[163,195,219,255]],null,[\"USK ab 12 Jahren\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/R-TrFxpinaWjr37_CZ5GQk7NPeZIZyHcPAaW8wUutdyhiLJncPDZubgf7vJtPWaZN0r0_SPIfq_40cFFkg\"]],[null,\"Fantasy-Gewalt und Schreckmomente\"],[null,\"Chats und Käufe im Spiel (enthält Zufallsartikel)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eWeitere Informationen\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JyiZb7TsaZcHgss7HOlBnkfmLBh-MLN_11Hdn8483VGxoEBp7aQwNhnho4jTgJ4Yo53Z7VVARewJbQmZZg\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"EUR\",\"\"]],null,[null,\"Kaufen\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.pixel.gun3d\\u0026rdid\\u003dcom.pixel.gun3d\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Installieren\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"1,09 €–119,99 € bei Abrechnung über Google Play\",[false]]],[[\"com.sandboxol.indiegame.bedwar\",7],[null,2,[512,512],[null,null,\"https://play-lh.googl