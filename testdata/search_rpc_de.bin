,[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/n42MtgmnQ7jBGMkC3a-hAmsySdL81uYQ0WhiMMjL8mEnV2RVLFnWvPTS4YiQgZmJjOK4-2K3rNpMdDQ0Arnx\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/5vGJfdenHUOcaBaZGidGyXfObXzGhFBsT1RDf886NMVro2AyHYT1yj31_rE-QwamLyXEpUk4krkghVwXoHhI8A\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/dEmvVF3GInJGok9ARpG9H2u3n6Mg7mYdLHai4osPCwNtP1XzVasJWpUQkCITRab47LH4a8B2GSjA5oFeEMmLhQ\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Pp-Yg13ekWChKvUz9u5HtSBAXcjg7lNOhg-5ycwKVsH9SV0cmBCOgDuoEc9DUM0wOBkkn32Df9yRc1XVdLqVDWU\"]]],\"WorldBox - Sandbox Gott Sim\",[\"4,6\",4.56306],\"Simulation\",null,null,[null,[[0,\"EUR\",\"\"]],null,[null,\"Kaufen\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mkarpenko.worldbox\\u0026rdid\\u003dcom.mkarpenko.worldbox\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.mkarpenko.worldbox\"]],[\"qgJhGl8IGxIeChwKFmNvbS5ta2FycGVua28ud29ybGRib3gQARgDShMIpbrPy9HalwMV722EBh2ZFBYqmgETCLrUnLXR2pcDFeJdhAYd6osV4voBDwoNCAASCQoFZGUtREUQAA\\u003d\\u003d\"],[[[null,null,\"9RzAgcnK-fU\",[null,null,\"https://www.youtube.com/embed/9RzAgcnK-fU?vq\\u003dlarge\\u0026rel\\u003d0\\u0026autohide\\u003d1\\u0026showinfo\\u003d0\"],\"yt:movie:9RzAgcnK-fU\",null,null,null,null,\"AXH1ezkY7rKeS2hF0OF5iZqa94x3WKzH6Jl42lX8ZSmVSC1OOaMjJmzWhslM-roEMrMRIPAQ3D9Z_G2GFAr98vRImqzlmKOTEToI1TQQKOl96y1nHt3-FVA2y7XoEdWZCSZupv6MfuAZHbgY6NXNVGWlqvXoYlXDoAw3K8hlfI9wAVGQbv-ZNP4jwF6Ac7Zp9PxDHmKWCGrRN-VyFnSphNVT54P_Gno44feGscI0-VZyy7IuXa1odNB1Qu_6Qe3Hw2Nt91VhUFFiwMyLZ7RVDwoJhW6o2C-OAk_LIVHaxPIJ1xoMyA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/9RzAgcnK-fU/hqdefault.jpg\"]]]],[null,\"\\u003cb\\u003eWorldBox\\u003c/b\\u003e ist ein kostenloses Sandkasten-Spiel, in dem du Gott bist.\\u003cbr\\u003e\\u003cbr\\u003eIn diesem kostenlosen Sandkasten-Gottspiel kannst du \\u003cb\\u003eLeben erschaffen und zusehen, wie es gedeiht!\\u003c/b\\u003e Bringe Schafe, Wölfe, Orks, Elfen, Zwerge und andere magische Kreaturen zum Leben!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eZivilisationen\\u003c/b\\u003e können Häuser und Straßen bauen und miteinander in den Krieg ziehen. Helfe ihnen dabei zu überleben, sich zu entwickeln und eine mächtige Zivilisation aufzubauen!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eDer Sandkasten.\\u003c/b\\u003e Spiele mit verschiedenen Kräften. Du kannst Boden mit saurem Regen auflösen oder sogar eine Atombombe fallen lassen! Starte wütende Windhosen, unterirdische Würmer oder einen Hitzestrahl. Genieße die kreative Zerstörung oder bastel Welten voller Leben!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eBeobachte\\u003c/b\\u003e, wie das klassische Spiel des Lebens von Conway die Völker der Welt zerstören kann. Oder erstelle eine neue Welt mit Langtons Ameisenautomaten.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eSimuliere\\u003c/b\\u003e verschiedene Katastrophen. Meteoriten, Vulkane, Lava, Windhosen, Geysire und mehr. Simuliere und beobachte die Entwicklung von Kreaturen und den Aufstieg von Zivilisationen.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eGestalte eine Pixelwelt\\u003c/b\\u003e. Du kannst deine Pixelwelt mit verschiedenen kostenlosen Werkzeugen, Magie und Pinseln erstellen. Verwende einfach verschiedene Pixelarten zum Färben. Sei kreativ!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eExperimentiere\\u003c/b\\u003e in deinem eigenen Sandkastenspiel. Spiele in der magischen Weltsimulation mit verschiedenen Kreaturen und Kräften.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eWerden zum Gott\\u003c/b\\u003e deiner eigenen Pixelwelt. Erschaffe Leben und baue Zivilisation verschiedener mythologischer Völker auf. Baue die Welt deiner Träume!\\u003cbr\\u003e\\u003cbr\\u003eDu kannst dieses Sandkastenspiel netzlos ohne WIFI oder Internetverbindung spielen\\u003cbr\\u003e\\u003cbr\\u003eLade Super WorldBox UMSONST herunter!\\u003cbr\\u003e\\u003cbr\\u003eBei Problemen wende dich bitte an mich: supworldbox@gmail.com\\u003cbr\\u003e\\u003cbr\\u003eBitte hinterlasse doch eine Rückmeldung oder Vorschläge, wenn du mehr Kräfte und Kreaturen in diesem kostenlosen Sandkastenspiel sehen möchtest!\\u003cbr\\u003e\\u003cbr\\u003eVerweis zur Netzseite und unseren Gemeinschaften:\\u003cbr\\u003eUnsere Netzseite: https://www.superworldbox.com\\u003cbr\\u003eUnser Discord: https://discord.gg/worldbox\\u003cbr\\u003eUnsere Facebook Seite: https://www.facebook.com/superworldbox\\u003cbr\\u003eMein Twitter: https://twitter.com/Mixamko \\u003cbr\\u003eReddit: https://reddit.com/r/worldbox\\u003cbr\\u003eInstagram: https://www.instagram.com/superworldbox/\\u003cbr\\u003eMein Twitter: https://twitter.com/superworldbox\"],\"Mako Mako\",\"50.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/herr2Xbs95WNsND4aJKVdOjMkK_KusoNY-HzfLVL4adEaQ2daGrKjgFuCdIOZRlOETyKV8JVTehs2VQNaLIJwg\"],null,[124,161,224,255]],null,[\"USK ab 12 Jahren\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/R-TrFxpinaWjr37_CZ5GQk7NPeZIZyHcPAaW8wUutdyhiLJncPDZubgf7vJtPWaZN0r0_SPIfq_40cFFkg\"]],[null,\"Angedeutete Gewalt und Kriegsthematik\"],[null,\"Käufe im Spiel\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eWeitere Informationen\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JyiZb7TsaZcHgss7HOlBnkfmLBh-MLN_11Hdn8483VGxoEBp7aQwNhnho4jTgJ4Yo53Z7VVARewJbQmZZg\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"EUR\",\"\"]],null,[null,\"Kaufen\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mk