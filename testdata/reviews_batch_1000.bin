isplay_content_language\",[1]],[\"vaf_never_display_difficult_to_use\",[2]]]],null,null,null,1],[\"545b83e0-53f4-4084-a8a1-dc3f2baa2fad\",[\"Jasurbek Xasanov\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJYv6ZPvONmGotqmYa_qwHdC248qRbhP7s5MkmTGjG3-KSrSQ\\u003dmo\"]]],5,null,\"zoʻr\",[1787384711,966000000],0,null,null,[\"111444759757698170407\",\"Jasurbek Xasanov\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJYv6ZPvONmGotqmYa_qwHdC248qRbhP7s5MkmTGjG3-KSrSQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"f8ca77b7-7b61-4186-985f-488e45223eb3\",[\"Елена Вельтерлих\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUrNg_BM_cOSSaDjgWi1Wn-zgYp8o_LI4GaCZN95oz2lmY8UrBL\"]]],1,null,\"это звездец. Всегда пользовалась этим такси, была уважительна к водителям, ставила высокие оценки и чаевые оставляла всегда. Мой рейтинг был всегда 5. Решила съездить в другой город в отпуск, и там мой рейтинг сильно упал. И теперь, вернувшись домой, я заметила что очень резко цена за поездки стала выше, как и время ожидания машины. Пробок нет, машин полно, спрос не большой. Однако мое время ожидания составляет сейчас в среднем 9-10 минут. Хотя раньше, даже во время нагрузки было 2-3минуты\",[1787384459,698000000],4,null,null,[\"111254338002976171816\",\"Елена Вельтерлих\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUrNg_BM_cOSSaDjgWi1Wn-zgYp8o_LI4GaCZN95oz2lmY8UrBL\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.72.0\",null,null,null,null,null,1],[\"d5bdffd6-bfdb-4635-a85d-5edf0a345e95\",[\"Анастасия Соклакова\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK7Yhb86NlCY38-7qMpycoNBIFN34S9rcOIb6oXjBQelS82Yw\\u003dmo\"]]],1,null,\"Списывают деньги сколько хотят, вызываешь по одной цене , пока приезжаешь списывают больше, и не возможно доказать, ожидание включают водители даже не доехав до места, выйдешь и ещё ждёшь их оставляла отзыв два года назад, и ни чего не поменялось блин какое тупое приложение\",[1787384162,926000000],2,[\"Mikromobilnost LLC Belgrade\",\"Жаль, что списания и ожидание испортили впечатление. Хотим проверить ваши поездки: пришлите номер телефона, дату, время и сумму списаний на blogs@go.yandex.ru или в Telegram @Yandex_Gobot\",[1787382209,283000000]],null,[\"101905991223714721135\",\"Анастасия Соклакова\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK7Yhb86NlCY38-7qMpycoNBIFN34S9rcOIb6oXjBQelS82Yw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.18.0\",null,null,null,[true,false],null,1],[\"b8c39dd9-34ac-48e2-b3b6-f088c5ae16dd\",[\"Ардак Тасмабаева\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJyXsMoSXzYtwbJucPVUsfS2zqib0gct_PoWSQ9hbWmt7iPhw\\u003dmo\"]]],5,null,\"отлично спасибо большое\",[1787384108,778000000],0,null,null,[\"104475970891299541667\",\"Ардак Тасмабаева\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJyXsMoSXzYtwbJucPVUsfS2zqib0gct_PoWSQ9hbWmt7iPhw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.87.0\",null,null,null,null,null,1],[\"c6bdb5c8-5487-412f-a366-5b39e55fa42e\",[\"Наталья Пикалова\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIeYuggEUN4C_wZV_1PgW1WpSaAxEJO6B26fl7ggYyHUnf4ig\\u003dmo\"]]],5,null,\"спасибо за поездку\",[1787384085,306000000],0,null,null,[\"109794087345150802099\",\"Наталья Пикалова\",null,[[null,2,null,[null,nu