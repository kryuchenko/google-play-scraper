00],0,[\"Mikromobilnost LLC Belgrade\",\"Жаль, что доставка заняла так много времени — три часа ожидания это действительно долго. Хотим проверить, что произошло с заказом. Напишите, пожалуйста, на support@dostavka.yandex.ru номер заказа и адрес доставки\",[1787594118,362000000]],null,[\"101756513910116819009\",\"Саадат Нурбекова\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVAahOzKQ8S0Ya8JvWxjmfbaMlsrZiC-D6DcF4J_Glsb32MfBg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"59ce2594-f0b1-4e0e-8c4b-27be44ebe9d3\",[\"RU V\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJJqrjj6ewaTKyc8Khf9JtyrSwHy8pP1pJzc0QH0qS98wElrw\\u003dmo\"]]],1,null,\"Цены абсолютно неадекватно высокие. Часто в 3-4 раза больше реальной стоимости. это от точно\",[1787593301,738000000],0,[\"Mikromobilnost LLC Belgrade\",\"Давайте проверим, почему списались деньги. Отправьте нам, пожалуйста, на почту — blogs@go.yandex.ru ваш номер телефона из приложения\",[1697777729,724000000]],null,[\"106968551858457613605\",\"RU V\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJJqrjj6ewaTKyc8Khf9JtyrSwHy8pP1pJzc0QH0qS98wElrw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.90.0\",null,null,null,[true,false],null,1],[\"40bcbc0d-dfac-41a4-aeb2-f8a5078610b4\",[\"Ilyas !!!!\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJoRaByC_lS5UoxwGNpV0-fmslfCvgjLcdqtrqiBfLzhTezQA\\u003dmo\"]]],5,null,\"rahmat!\",[1787591021,378000000],0,null,null,[\"112647915697936264465\",\"Ilyas !!!!\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJoRaByC_lS5UoxwGNpV0-fmslfCvgjLcdqtrqiBfLzhTezQA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"01787e81-ea01-42de-8eaa-9b7fd27ff84e\",[\"Светлана Панова\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKUXfIA7pdqohXMU5_RM6yj_FBdug0UCMvoL5My6Y2ZvSHW9A\\u003dmo\"]]],5,null,\"очень быстро приехал, и быстро, акуратно ,довёз. Огромное спасибо.\",[1787590586,429000000],0,null,null,[\"108544170668504174286\",\"Светлана Панова\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKUXfIA7pdqohXMU5_RM6yj_FBdug0UCMvoL5My6Y2ZvSHW9A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.84.1\",null,null,null,null,null,1],[\"083af55d-2080-4188-a560-618e2bcc9216\",[\"Саша Дорен\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLnvNxp_uEvd5yRrwwE7Tgx_6VzdBGRo2Xu8i_cgzOT1mcjxA\\u003dmo\"]]],2,null,\"сервис хороший, но такси стало дольше искаться, таксисты отказываются везти людей потому что незнают куда до самого начала поездки... служба доставки ужаснейшая, пришлось отказаться от товара потому что его несмогли привезти в указанный срок и даже на следующий день...\",[1787590444,929000000],0,[\"Mikromobilnost LLC Belgrade\",\"Жаль, что и с такси, и с доставкой вышло так. Хотим разобраться в обеих ситуациях. Напишите, пожалуйста, на blogs@go.yandex.ru или в Telegram @Yandex_Gobot, укажите номер телефона и детали по заказам — проверим. По поводу Доставки можно обратиться на эту почту support@dostavka.yandex.ru\",[1787591073,78000000]],null,[\"104330335233391173057\",\"Саша Дорен\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLnvNxp_uEvd5yRrwwE7Tgx_6VzdBGRo2Xu8i_cgzOT1mcjxA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,[[[\"vaf_app_quality_ads_frequency\",[2]],[\"vaf_app_quality_stability\",[1]],[\"vaf_app_quality_visual_appeal\",[1]]]],null,null,null,1],[\"6bbb01ce-cbb1-4724-9c59-39e2bcf68d5c\",[\"Сергей Котляров\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUFUEiafYlzihJxO_qJc1PiG8RinRi5HmMfkTOndJ79PYB0wl8\"]]],1,null,\"Ужасное приложение ужасная поддержка , ждал почти час , поддержка игнорировала , отменили заказ по причине не нашли курьера , было 2 промокода , оба сгорели , мне в качестве извержения дали на 15% скидки , но 30% заметно меньше 15, итог мало того что ждал долго сижу голодный ещё и на денги обманули.\",[1787590438,607000000],1,[\"Mikromobilnost LLC Belgrade\",\"Жаль, что ожидание заказа и ответ поддержки оставили такой неприятный осадок, а промокоды сгорели. Хотим разобраться в этой ситуации. Напишите, пожалуйста, на love@eda.yandex.ru номер заказа и детали — проверим и начисление скидки, и работу поддержки.\",[1787591142,473000000]],null,[\"105054526053049312685\",\"Сергей Котляров\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUFUEiafYlzihJxO_qJc1PiG8RinRi5HmMfkTOndJ79PYB0wl8\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,[[[\"vaf_app_quality_stability\",[2]],[\"vaf_app_quality_battery_efficiency\",[1]],[\"vaf_app_quality_usability\",[3]]]],null,null,null,1],[\"f2e06f32-d6fc-45d2-85ae-d6f33cdc012b\",[\"Ольга Лященко\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJAXb2l3kj18H48HIcT88xFssLU76k6SP8QWY8weTgEU-Mv-g\\u003dmo\"]]],5,null,\"самый лучший водитель 👍\",[1787590233,557000000],0,null,null,[\"112214015074796593803\",\"Ольга Лященко\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJAXb2l3kj18H48HIcT88xFssLU76k6SP8QWY8weTgEU-Mv-g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"bafb7fed-9379-48a2-99b0-3046e9758704\",[\"nat cont\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIkumPphJPfsKrzjI7i9tD-_H2_Y_Z6aWAvTrm8ntdF8ft7Xw\\u003dmo\"]]],1,null,\"Стали отвратительно работать. Сегодня два раза подряд не приехали водители, при этом включили платное ожидание, на звонки и сообщения не отвечали. Удалось уехать только с третьего раза. Написать в поддержку из приложения нельзя, позвонить нельзя. Висит в приложении долг, хотя не приехал водитель. Стали мошенничать, пользоваться ими надо прекращать. Обманывают и воруют по мелочи, аж противно.\",[1787589902,814000000],1,[\"Mikromobilnost LLC Belgrade\",\"Жаль, что дважды не приехали водители и пришлось ждать третью машину. Хотим проверить и отмены, и списание за ожидание. Пришлите номер телефона и время заказов на blogs@go.yandex.ru или в Telegram @Yandex_Gobot\",[1787590409,135000000]],null,[\"108183748776389363409\",\"nat cont\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIkumPphJPfsKrzjI7i9tD-_H2_Y_Z6aWAvTrm8ntdF8ft7Xw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,[true,false],null,1],[\"5d43155b-ced3-4b87-8c67-2b2f79db7226\",[\"Касенов Нуржан\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKmX-Xudf9qNXz3RX7i2OUswDtQ9K6UflFQVmx12VtLTnC9Xg\\u003dmo\"]]],5,null,\"керемет келдик коликти жаксы баскарат\",[1787589242,114000000],0,null,null,[\"115730342516684052163\",\"Касенов Нуржан\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKmX-Xudf9qNXz3RX7i2OUswDtQ9K6UflFQVmx12VtLTnC9Xg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.