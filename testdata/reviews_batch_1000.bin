1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"a5253ff6-c55f-4824-bd20-b4c4aab860c8\",[\"Татьяна\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJL1EZtKZueojhcT9pJv5MmiF3a050Ik4t-WsOBfUoUfG76ZQ\\u003dmo\"]]],5,null,\"отличный, вежливый водитель, побольше таких водителей.\",[1787661224,65000000],0,[\"Mikromobilnost LLC Belgrade\",\"Рады, что водитель порадовал — приятно, когда поездка начинается с хорошего настроения. Будем держать планку\",[1787661322,815000000]],null,[\"102257508113890149498\",\"Татьяна\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJL1EZtKZueojhcT9pJv5MmiF3a050Ik4t-WsOBfUoUfG76ZQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"0f0df0ac-5c70-468f-959e-53b7b8533df7\",[\"Борис К\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIveP2mvu2fkpHDLPh7ZS6obLHNqUBRQt8zRzXzVkig7L5i7w\\u003dmo\"]]],5,null,\"Понравились профессиональные навыки водителя. В дороге - приятная музыка, в меру громкая. Чистый салон и багажник.\",[1787660327,929000000],0,[\"Mikromobilnost LLC Belgrade\",\"Рады, что поездка оставила приятное впечатление — и музыка, и чистота в салоне это то, на что мы обращаем внимание. Спасибо, что отметили 👍\",[1787660712,343000000]],null,[\"100650671421468774073\",\"Борис К\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIveP2mvu2fkpHDLPh7ZS6obLHNqUBRQt8zRzXzVkig7L5i7w\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"4815d728-db49-4e02-aa59-6d51d5c19e57\",[\"Елена Сендина\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIlk40hBrNa9Sd4kJpNn0emFQPtzFgTa1DwkavCZZm3MjbU\\u003dmo\"]]],5,null,\"Большое спасибо водителю Алексею. Ехала уставшая после работы. Профессионал.\",[1787660256,141000000],0,[\"Mikromobilnost LLC Belgrade\",\"Рады, что поездка с Алексеем прошла так хорошо, и вы доехали с комфортом. Приятно, когда водитель — настоящий профессионал. Спасибо, что поделились\",[1787660697,208000000]],null,[\"107826497085743790476\",\"Елена Сендина\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIlk40hBrNa9Sd4kJpNn0emFQPtzFgTa1DwkavCZZm3MjbU\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.90.0\",null,null,null,null,null,1],[\"b9d9cd13-a7b5-4e18-a8c6-aa8fd72790b9\",[\"VredinochKa VredinochKa\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLEqFS7zytG8LINRxYbYUmAP2FqbAN6dPvqHSaYHVYnR7Mfxg\\u003dmo\"]]],1,null,\"Ну про поддержку мы знаем, есть новая фишка. НЕВОЗМОЖНО УДАЛИТЬ ДОБАВЛЕННЫЕ РАНЕЕ КАРТЫ, ОСТАВИВ ОДНУ. Права и законы? Не, не слышали. upd. Написала в бот, сделали хуже, залезли в акк и грохнули нужную карту, попробуйте нанять людей с мозгами и логикой. upd. был бы толк от писанины.\",[1787659183,297000000],4,[\"Mikromobilnost LLC Belgrade\",\"Жаль, что удаление карт превратилось в такую проблему, а обращение в поддержку только усугубило ситуацию. Хотим разобраться, что произошло с вашим аккаунтом. Напишите, пожалуйста, на blogs@go.yandex.ru номер телефона и опишите подробнее, что именно сделали в боте\",[1787659531,262000000]],null,[\"110257362875773804793\",\"VredinochKa VredinochKa\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLEqFS7zytG8LINRxYbYUmAP2FqbAN6dPvqHSaYHVYnR7Mfxg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,[[[\"vaf_never_display_ads_experience\",null,[1]],[\"vaf_never_display_ease_of_use\",null,[1]]]],null,[true,false],null,1],[\"de045ec5-af5d-4623-9da1-49bcf6a918ed\",[\"Kuba Sport\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLbM8WT8c9th30COueMtDn2Pg7nfarBEWA8E91WjktMmuziLw\\u003dmo\"]]],2,null,\"дорого\",[1787658974,274000000],0,null,null,[\"106369348117708816537\",\"Kuba Sport\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLbM8WT8c9th30COueMtDn2Pg7nfarBEWA8E91WjktMmuziLw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"4f733909-4be8-48b7-8ddc-bdd14a96755b\",[\"Михаил Гоголев\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIx6Oqvw0e0IuuBtil_59ClOUr7BdWmAW7rTK7e7sI7VILNvg\\u003dmo\"]]],1,null,\"Свалка рекламы. Понапихали всё подряд в один сервис и теперь он жутко тормозит. И каждые 3 секунды предлагает включить геолокацию. Мне нужно только такси, а вынужден смотреть на этот посторонний хлам. Было отличное приложение, пока конкурентов из страны не выгнали. Сейчас пользуюсь от безысходности.\",[1787658887,913000000],0,[\"Mikromobilnost LLC Belgrade\",\"Жаль, что приложение стало тормозить и раздражать рекламой. Хотим разобраться, почему так происходит. Напишите нам на blogs@go.yandex.ru или в Telegram @Yandex_Gobot, укажите модель телефона и версию приложения — проверим\",[1787659493,951000000]],null,[\"116045766685209142976\",\"Михаил Гоголев\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIx6Oqvw0e0IuuBtil_59ClOUr7BdWmAW7rTK7e7sI7VILNvg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,[true,false],null,1],[\"967fcfd1-79f7-4211-9789-d5755726a317\",[\"Юлия\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJNepFbDdO4hnpXW2aBhR17XDpjqnwoFFcvOQIwpi09H8nF4A\\u003dmo\"]]],5,null,\"Спасибо за поездку! Очень хороший водитель, вежливый, аккуратный!\",[1787658745,253000000],0,null,null,[\"102314553007698770446\",\"Юлия\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJNepFbDdO4hnpXW2aBhR17XDpjqnwoFFcvOQIwpi09H8nF4A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"a630b606-8325-4ba2-a4eb-5b4bd64d7ffe\",[\"Жайна Иргинбаева\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLLN8Qu2wZXWxmVFBqEStoidYn2EkLBZFxAn78hIP_-nnfCWw\\u003dmo\"]]],5,null,\"приехал во время,молодец\",[1787658688,205000000],0,null,null,[\"108449268095356910359\",\"Жайна Иргинбаева\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLLN8Qu2wZXWxmVFBqEStoidYn2EkLBZFxAn78hIP_-nnfCWw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"9173bc8c-d632-4c3a-9ce2-aad3b32b93eb\",[\"Dhdh Hddh\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJWVRK7_4fotC1sriZURLvvALfGD2YUlfFRZkXJ2RPrq3wQDA\\u003dmo\"]]],5,null,\"супер\",[1787658069,727000000],0,null,null,[\"107435993977919100725\",\"Dhdh Hddh\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJWVRK7_4fotC1sriZURLvvALfGD2YUlfFRZkXJ2RPrq3wQDA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"a93f036a-a682-48fb-90b1-1b831ed414e0\",[\"El Жoparlo\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJeRJIugwgJLiRmSK5Jy_5EtvkJ3kxPBabqOQ3-wVDHrd1jfw\\u003dmo\"]]],1,null,\"БудуПисатьПроТакси,т.к. другие опции не использовала. Ценники запредельно высокие. Плата за ожидание начинает капать ещё до того, как водитель подъедет к точке. Часто отказываются везти, особенно с животными, когда стоит плажка «с питомцем». Из-за такой их привычки я однажды могла опоздать на самолет. Их поведение из-за монополии в край заманало, ещё долго можно распинаться, какие они г*****ы, но лучше оставлю список такси, не принадлежащих компании Яндекс: Maxim, Drivee, Ситимобил, Таксовичкоф.\",[1787658012,246000000],0,[\"Mikromobilnost LLC Belgrade\",\"Цены и ожидание — серьёзные поводы для недовольства, жаль, что поездки складываются так. Хотим проверить, почему списание за ожидание началось до подачи машины. Напишите нам на blogs@go.yandex.ru или в Telegram @Yandex_Gobot, укажите номер телефона и дату поездки\",[1787658313,687000000]],null,[\"105682986656697588713\",\"El Жoparlo\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJeRJIugwgJLiRmSK5Jy_5EtvkJ3kxPBabqOQ3-wVDHrd1jfw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.54.1\",null,null,null,null,null,1],[\"db66823f-b841-44d7-aa9d-795a1c1b8788\",[\"Жанара Кожобекова\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLDZ9d8VO6ORNPFO7TOGWI-BugfaATnE-69bnKHNi0K_6I-\\u003dmo\"]]],5,null,\"водитель вежливый\",[1787657986,33000000],0,null,null,[\"102055884121405508044\",\"Жанара Кожобекова\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLDZ9d8VO6ORNPFO7TOGWI-BugfaATnE-69bnKHNi0K_6I-\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"b808789a-15af-479d-a13d-ade6edcb032c\",[\"Elena\",[null,2,nu