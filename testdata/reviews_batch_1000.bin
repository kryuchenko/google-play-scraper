sercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"96e2d0c2-c71f-48d6-8af2-e6693ee08714\",[\"Геннадий Петров\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWmUSviRBrm9UX_Lp_fY-xI5Ijh10fVQx3kKUYrl_HC2rN-csQ\"]]],5,null,\"всё супер!👍\",[1787733924,664000000],0,null,null,[\"116192498551434575617\",\"Геннадий Петров\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWmUSviRBrm9UX_Lp_fY-xI5Ijh10fVQx3kKUYrl_HC2rN-csQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.90.0\",null,null,null,null,null,1],[\"e371d6d8-8672-4304-a707-4d5a01d9757c\",[\"Мария Завьялова\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJEUNgQsxgzJ5-vzdZsF7x5j7f2Kh_lOgTtcmv_n96AwzHCqA\\u003dmo\"]]],2,null,\"отзыв конкретно о части с такси. сервис совсем не следит за своими водителями такси. ждёшь 10 минут, водитель подъезжает с другой стороны дома и отменяет заказ. если ты не хотел ехать - так не работай в такси вообще! 400р за 10 минут поездки не нравится даже водителям, наверное работу тогда поменять надо. плохо явно штрафы работают для водителей\",[1787733747,575000000],0,[\"Mikromobilnost LLC Belgrade\",\"Не хотим, чтобы вы после долгого ожидания сталкивались с тем, что машина ожидает с другой стороны дома и что заказ оказался отменён :(\\nХотим присоединиться к проверке. И если водителя не устраивает цена, то пишите об этом в чат приложения или нам на почту blogs@go.yandex.ru или в Телеграм-бота @Yandex_Gobot. Мы постараемся быстро помочь!\",[1787738312,931000000]],null,[\"103660931451707696060\",\"Мария Завьялова\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJEUNgQsxgzJ5-vzdZsF7x5j7f2Kh_lOgTtcmv_n96AwzHCqA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"98b21244-63d6-4f6f-8e79-d0c263ddaf45\",[\"Baunty\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXD_k5bua84N6buLaZsuvhxofjqfp4s5_SW0zEybb-rL_gQbqYK\"]]],1,null,\"позорище за налоги граждан\",[1787733692,975000000],0,null,null,[\"106740554825962935877\",\"Baunty\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXD_k5bua84N6buLaZsuvhxofjqfp4s5_SW0zEybb-rL_gQbqYK\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"f36c1ef2-eebe-493c-9deb-63d66c8af56b\",[\"Мария Леонова\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVbXuORROLngu8dwaGiUkjbFJThbk0Z6rjGvfQjvlMDv_jhwls\"]]],1,null,\"Ужасно, заказала такси ждала пол часа вместо показаных 10 минут и как только водитель уже почти подъехал к дому сам отменил заказ. Такое уже не в первый раз. сегодня так сделал мартюшов Михаил Сергеевич на белой Весте О476КА75. большое вам блин спасибо уважаемый водитель 👎\",[1787733488,707000000],0,[\"Mikromobilnost LLC Belgrade\",\"Понимаем, как неприятно сталкиваться с отказом от поездки, особенно когда долго ждёшь машину :(\\nХотим присоединиться к проверке. Напишите, пожалуйста, нам на почту blogs@go.yandex.ru или в Телеграм-бота @Yandex_Gobot и пришлите ваш номер телефона вместе с датой и временем, когда вызывали авто\",[1787738454,642000000]],null,[\"110940064502772155074\",\"Мария Леонова\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVbXuORROLngu8dwaGiUkjbFJThbk0Z6rjGvfQjvlMDv_jhwls\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,[[[\"vaf_app_quality_visual_appeal\",[2]],[\"vaf_app_quality_performance\",[2]],[\"vaf_app_quality_battery_efficiency\",[1]]]],null,[true,false],null,1],[\"1b80fc81-d1ce-455f-84a7-6a312ceb8634\",[\"Svetlana Yatsenko\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLcOGhwFgzfzaaKpD4L1HavKVnunUXVUtVz7Xb_hu2aM70UuA\\u003dmo\"]]],5,null,\"спасибо за понимание и участие\",[1787733377,783000000],0,null,null,[\"109721706448791960254\",\"Svetlana Yatsenko\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLcOGhwFgzfzaaKpD4L1HavKVnunUXVUtVz7Xb_hu2aM70UuA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"1a02b728-2b97-4e0d-89bd-01c330e95006\",[\"Alex\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKkP9v-FleRKY7uxgOf3U7v2_tnwECeaE008_6BC0ILjZQsWA\\u003dmo\"]]],1,null,\"Стали просить на самокатах подтверждение возврата по фото, при то что аккаунт и так привязан к мос.ру. Это сбор биометрических данных. Судя по практике вопрос времени, когда они утекут. Отказался от сервиса. Готов подтвердить возврат личным визитом или на госуслугах, но такой вариант поддержка мне не предложила. Вынужден отказаться от вашего сервиса. Тем кто придумал такое решение без альтернативы отдельный привет\",[1787733374,909000000],2,null,null,[\"110112925480410904472\",\"Alex\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKkP9v-FleRKY7uxgOf3U7v2_tnwECeaE008_6BC0ILjZQsWA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,[[[\"vaf_app_quality_performance\",[1]],[\"vaf_app_quality_usability\",[2]],[\"vaf_app_quality_ads_frequency\",[1]]]],null,null,null,1],[\"4b9ce132-ac19-43ce-9463-6e1d533c28b1\",[\"Владимир\",[null,2,null,[null,null