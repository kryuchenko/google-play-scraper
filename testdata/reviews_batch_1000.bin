что позвонит полиций и что то еще,с таким калективом лучше вообще не заказывать здесь такси!\",[1787684948,32000000],0,[\"Mikromobilnost LLC Belgrade\",\"Жаль, что поездка обернулась таким конфликтом. Хотим разобраться в ситуации — пришлите номер телефона и дату заказа на blogs@go.yandex.ru или в Telegram @Yandex_Gobot\",[1787685626,219000000]],null,[\"110455217325740228522\",\"Alexandra\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUk_Q461ZlyblOJEYDxmMCBbfi8FtqI6BRgOZF6gEwxZCa-Q8Nc\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.87.0\",null,null,null,null,null,2],[\"e7af617a-37a2-4210-9a9b-6965569839a9\",[\"Куат Кошкарбаев\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJuNk6P0Xl02IBG7v2RaE7VW-6E0PJgavXeifnY4qL-q0itow\\u003dmo\"]]],5,null,\"классный водитель\",[1787684612,245000000],0,null,null,[\"107950776279288574900\",\"Куат Кошкарбаев\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJuNk6P0Xl02IBG7v2RaE7VW-6E0PJgavXeifnY4qL-q0itow\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"2992b2a6-15d1-4e4b-81fa-2b0a25cbee43\",[\"Цацкин Александр\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJJAyFxikTjI4iJwPWD6KYttsUNE_m16S4gvJYghjt6VW3juA\\u003dmo\"]]],5,null,\"Прекрасная комфортная поездка\",[1787684417,78000000],0,null,null,[\"118005522997934263554\",\"Цацкин Александр\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJJAyFxikTjI4iJwPWD6KYttsUNE_m16S4gvJYghjt6VW3juA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.87.0\",null,null,null,null,null,1],[\"c420c08c-4cce-4fb6-bdaf-ec7181fe36ff\",[\"Виктория\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI7LXTzwkY73o464N54EfdBuUziRTv6WLLbTl_P18lqtir99g\\u003dmo\"]]],5,null,\"вежливый,добрый,комфортный\",[1787684092,637000000],0,null,null,[\"110236640260464905012\",\"Виктория\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI7LXTzwkY73o464N54EfdBuUziRTv6WLLbTl_P18lqtir99g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.90.0\",null,null,null,null,null,1],[\"8aa88748-2b0d-4324-a3d1-82a46a122fdf\",[\"Иван Иванов\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVvyJpUa6aVkEYPuoU0P4RhWEx0dQpN_Do5nCQk5lL2ZMQxTIs\"]]],1,null,\"Таксист Яндекса ждал не в той точке, пришлось идти к нему по мокрой траве, в итоге он увидел что я иду и уехал прямо перед носом. Списали деньги за ожидание, неизбежное опоздание на работу. Поддержка Яндекса встала на сторону таксиста, отказались дать даже конечный промокод в качестве извинения. В итоге потеряли клиента с ежемесячными заказами в приложении на 60000, чтобы зажать извинения и промокод на 100р, гениальное бизнес решение! Призываю всех не пользоваться данным сервисом.\",[1787682857,404000000],0,[\"Mikromobilnost LLC Belgrade\",\"Жаль, что поездка сорвалась, а поддержка не помогла. Хотим проверить и ожидание, и списание, и ответ поддержки. Пришлите номер телефона и дату поездки на blogs@go.yandex.ru или в Telegram @Yandex_Gobot\",[1787683036,538000000]],null,[\"116559300165956754967\",\"Иван Иванов\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVvyJpUa6aVkEYPuoU0P4RhWEx0dQpN_Do5nCQk5lL2ZMQxTIs\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.48.1\",null,null,null,null,null,1],[\"4b440336-f94f-4005-8c43-19b124a18f3f\",[\"Ramina Amirova\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWiF8zhuUZ5_n7OZeIqi6M4zTdvezrdT0_6ybbFHeF5YBfeGdk\"]]],5,null,\"👍👍👍👍👍👍\",[1787682385,588000000],0,null,null,[\"102587620049073466787\",\"Ramina Amirova\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWiF8zhuUZ5_n7OZeIqi6M4zTdvezrdT0_6ybbFHeF5YBfeGdk\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"e9f1ccbd-0496-4e14-a393-6535f62946ab\",[\"Александра Вячеславовна\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXTFgMrhlEhNKwaM2psv045LwBowr6BoUQ09_LvN_s7ikL7FOk\"]]],3,null,\"Приложение имеет ряд недостатков. Для меня главным является лаг из-за которого я не могу заказать машину на конкретно свою точку, я работаю в организации, коммерческое помещение которой находится с фасадной стороны жилого дома. Я пишу в заказе название машазина, в комментарии дублирую, что со стороны магазина, но приложение передаёт голый адрес и я бегаю, ищу машину. Далее: во время того, как я заказала тариф межгород и машина с родственником была в пути, возможность заказа такси для себя ушла\",[1787681275,966000000],0,[\"Mikromobilnost LLC Belgrade\",\"Жаль, что приложение не передаёт водителю уточнение про магазин — из-за этого приходится искать машину. Хотим разобраться и с этим, и с ситуацией с тарифом «Межгород». Напишите нам на blogs@go.yandex.ru или в Telegram @Yandex_Gobot, укажите номер телефона и детали — проверим\",[1787681849,800000000]],null,[\"111778106231874262052\",\"Александра Вячеславовна\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXTFgMrhlEhNKwaM2psv045LwBowr6BoUQ09_LvN_s7ikL7FOk\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,[[[\"vaf_app_quality_visual_appeal\",[1]],[\"vaf_app_quality_stability\",[2]],[\"vaf_app_quality_ads_intrusiveness\",[2]]]],null,[true,false],null,1],[\"ce48ea9c-4d07-4a8f-86a3-685351cee342\",[\"Сергей\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWX9tVOXn6DHz6IidRzvmSOcqf-cCrG1HqOF0hodqVJLxrq8zxm\"]]],5,null,\"Всё, супер!!!\",[1787681140,634000000],0,null,null,[\"107807349388240853282\",\"Сергей\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWX9tVOXn6DHz6IidRzvmSOcqf-cCrG1HqOF0hodqVJLxrq8zxm\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"027af9ec-8665-4aea-a068-67acb079d6eb\",[\"Лариса Дончу\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJDmZC-u-iWG2s4a0GJXMRqyGy1ZMZZjc4HZANV9fPmWhoBzQ\\u003dmo\"]]],1,null,\"ужасное обслуживание заказали такси в село а пришел не доехал до дома так ещё он не ехал в в то село обозвал нас и начал орать что вызовет полицию. таким людям даже работать не надо\",[1787681073,934000000],0,[\"Mikromobilnost LLC Belgrade\",\"Проверим действия водителя — это недопустимо. Пришлите номер телефона и дату поездки на blogs@go.yandex.ru или в Telegram @Yandex_Gobot\",[1787681225,880000000]],null,[\"104699019520726726866\",\"Лариса Дончу\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJDmZC-u-iWG2s4a0GJXMRqyGy1ZMZZjc4HZANV9fPmWhoBzQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.86.0\",null,null,null,null,null,1],[\"323a0c72-5006-4860-9e44-2d5b64d5759f\",[\"Владимир Васильковский\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJAGRxd3TZZzrVy5ney3NuHN