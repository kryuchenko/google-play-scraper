427,837000000],0,null,null,[\"117691257130326487977\",\"Олег Хабаров\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVuPl4OhMltb2rF-_7NzMZq4NCD6XiKy-y0PeQYAky5x-8JnVI\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.82.0\",null,null,null,null,null,1],[\"bbdddf48-8f72-4991-9121-9eb14c860a92\",[\"Emil Tatarinov\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIuTrK3PrimZPqQg_128oHXtbKn97vvkyjS8u8rfJI9ij5SvQ\\u003dmo\"]]],1,null,\"Была бы возможность поставил бы ноль, не рабочие промокоды, техподдержка занимается отписками, а по итогу просто игнорит. По мимо этого уйма проблем с этим агрегатором. Ни кому не рекомендую. Единственный плюс быстрая подача.\",[1787521444,44000000],1,[\"Mikromobilnost LLC Belgrade\",\"Жаль, что промокоды не сработали, а поддержка оставила вас без ответа. Хотим разобраться в ситуации. Напишите нам на blogs@go.yandex.ru или в Telegram @Yandex_Gobot, укажите номер телефона и промокоды, которые не применились — проверим\",[1787522172,918000000]],null,[\"116427616808006515180\",\"Emil Tatarinov\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIuTrK3PrimZPqQg_128oHXtbKn97vvkyjS8u8rfJI9ij5SvQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.91.2\",null,null,null,null,null,1],[\"7168ba5f-8f31-42d3-ba3b-fd6c3ec5e940\",[\"Max\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL2LpOKYymAc94S-SyWyowX0QNZoXk2FV0i7POtjqDqJYOgMA\\u003dmo\"]]],1,null,\"реклама реклама реклама и конкурентов никогда не будет ибо они сразу исчезают\",[1787521046,518000000],2,null,null,[\"106652520785182409837\",\"Max\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL2LpOKYymAc94S-SyWyowX0QNZoXk2FV0