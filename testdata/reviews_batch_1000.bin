sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.90.0\",null,null,null,null,null,1],[\"2eabd050-c11d-43be-96c9-b2545f1b2338\",[\"Станислав Дементьева\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIAr7AEaeuh6q5-ugVVz9Kc5i8ug3rO527gcxa5yfTJ-mzTrA\\u003dmo\"]]],1,null,\"ужаснооо тупое обновление\",[1787326475,89000000],0,null,null,[\"103975222279929021972\",\"Станислав Дементьева\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIAr7AEaeuh6q5-ugVVz9Kc5i8ug3rO527gcxa5yfTJ-mzTrA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.90.0\",null,null,null,null,null,1],[\"d978db16-d5c5-43fd-9aba-fd21421ef09d\",[\"Антоний В\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVrv5qDbEie_Pa-vjBdNhbgu3sPkrkt1eEcb2Mkl3j7udWaO-M6cA\"]]],4,null,\"Приложение отличное, работает стабильно. Есть претензии к самокатам. Фото перед арендой - отличная идея, чтобы не давать школоте гонять. Введите еще проверку номера телефона и чередуйте. Неплохо было бы внести бонусы за фото нарушений. Некоторые точки парковки совсем бестолковые и неудобные. Введите нормальный аудит поездок, чтобы те же школьники и неадекваты не срывали номера. Однако... Из за кучи рекламы поставил бы 1. Не нужно мне в транспортном приложении это всё.\",[1787326464,784000000],3,[\"Mikromobilnost LLC Belgrade\",\"Здравствуйте! Пожалуйста, расскажите нам на blogs@taxi.yandex.ru, когда была эта поездка, и на какой номер телефона оформлена — найдём и разберёмся.\",[1540892327,452000000]],null,[\"102192245470628593860\",\"Антоний В\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVrv5qDbEie_Pa-vjBdNhbgu3sPkrkt1eEcb2Mkl3j7udWaO-M6cA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaH