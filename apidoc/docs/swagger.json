    "info": {
        "description": "Reverse-engineered description of the PRIVATE, undocumented\nHTTP endpoints of the Google Play Store web frontend that the\ngoogle-play-scraper Go library calls.\n\nDISCLAIMER: These endpoints are NOT a public, supported Google\nAPI. This project is NOT affiliated with, endorsed by, or\nsponsored by Google. The endpoints are undocumented, may change\nor disappear without notice, and accessing them may be subject\nto the Google Play / Google Terms of Service. This spec is\nprovided for interoperability and educational purposes only.\n\nTwo response shapes appear:\n* AF_initDataCallback: GET endpoints return text/html whose\nbody embeds `AF_initDataCallback({key:'ds:N', data:[...]})`\nscript blocks; the scraper extracts the logical model from\na numbered data block (e.g. ds:5).\n* batchexecute envelope: POST /_/PlayStoreUi/data/batchexecute\nreturns a `)]}'`-prefixed, `wrb.fr`-framed envelope; the\nscraper decodes the inner URL-encoded JSON for the RPC.",
        "license": {
            "name": "MIT",
            "url": "https://github.com/kryuchenko/google-play-scraper/blob/main/LICENSE"
        },
        "title": "Google Play Store private HTTP API (reverse-engineered)",
        "version": "1.0.0"
    },
    "externalDocs": {
        "description": "google-play-scraper source",
        "url": "https://github.com/kryuchenko/google-play-scraper"
    },
    "paths": {
        "/_/PlayStoreUi/data/batchexecute(IJ4APc)": {
            "post": {
                "description": "POST /_/PlayStoreUi/data/batchexecute?rpcids=IJ4APc. Returns the\nbatchexecute envelope; a []string of suggested query terms is\ndecoded from the inner payload.",
                "operationId": "batchSuggestIJ4APc",
                "parameters": [
                    {
                        "description": "IJ4APc",
                        "in": "query",
                        "name": "rpcids",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "title": "f.req",
                                        "type": "string"
                                    }
                                ]
                            }
                        }
                    },
                    "description": "URL-encoded JSON envelope [[['IJ4APc','\u003cinner-args\u003e']]]",
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "items": {
                                        "type": "string"
                                    },
                                    "type": "array"
                                }
                            }
                        },
                        "description": "Suggested terms decoded from batchexecute envelope"
                    },
                    "x-response-encoding": "batchexecute-envelope",
                    "x-rpcid": "IJ4APc"
                },
                "summary": "Search suggestions RPC (IJ4APc)",
                "tags": [
                    "batchexecute-rpc"
                ]
            }
        },
        "/_/PlayStoreUi/data/batchexecute(oCPfdb)": {
            "post": {
                "description": "POST /_/PlayStoreUi/data/batchexecute. Unlike the other RPCs the\nscraper does NOT put rpcids in the query string; the rpcid lives\nonly inside the f.req body. Handles both the initial fetch and\npagination. Returns the batchexecute envelope; ReviewsResult\n(reviews + nextToken) is decoded from the inner payload.",
                "operationId": "batchReviewsOCPfdb",
                "requestBody": {
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "title": "f.req",
                                        "type": "string"
                                    }
                                ]
                            }
                        }
                    },
                    "description": "URL-encoded JSON envelope [[['oCPfdb','\u003cinner-args\u003e',null,'generic']]]",
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "$ref": "#/components/schemas/apidoc.ReviewsResult"
                                }
                            }
                        },
                        "description": "Decoded from batchexecute envelope"
                    },
                    "x-response-encoding": "batchexecute-envelope",
                    "x-rpcid": "oCPfdb"
                },
                "summary": "Reviews RPC (oCPfdb)",
                "tags": [
                    "batchexecute-rpc"
                ]
            }
        },
        "/_/PlayStoreUi/data/batchexecute(qnKhOb)": {
            "post": {
                "description": "POST /_/PlayStoreUi/data/batchexecute?rpcids=qnKhOb. Advances a\nlist, cluster or search result set using a continuation token.\nReturns the batchexecute envelope; []SearchResult plus the next\ntoken are decoded from the inner payload.",
                "operationId": "batchPaginateQnKhOb",
                "parameters": [
                    {
                        "description": "qnKhOb",
                        "in": "query",
                        "name": "rpcids",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "title": "f.req",
                                        "type": "string"
                                    }
                                ]
                            }
                        }
                    },
                    "description": "URL-encoded JSON carrying the continuation token",
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/apidoc.SearchResult"
                                    },
                                    "type": "array"
                                }
                            }
                        },
                        "description": "Decoded from batchexecute envelope; includes next token"
                    },
                    "x-response-encoding": "batchexecute-envelope",
                    "x-rpcid": "qnKhOb"
                },
                "summary": "Paginate list/cluster/search RPC (qnKhOb)",
                "tags": [
                    "batchexecute-rpc"
                ]
            }
        },
