#!/bin/sh
# MCPB chooses a command per OS, not per CPU, so the Linux entry point picks
# the binary for this machine. Everything else is passed through untouched.
dir=$(dirname "$0")
case "$(uname -m)" in
  x86_64 | amd64) exec "$dir/gpscrape-mcp-linux-amd64" "$@" ;;
  aarch64 | arm64) exec "$dir/gpscrape-mcp-linux-arm64" "$@" ;;
  *) echo "gpscrape-mcp: no binary for $(uname -m) in this bundle; use the container image or build from source" >&2; exit 1 ;;
esac
