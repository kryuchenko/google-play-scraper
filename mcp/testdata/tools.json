        },
        "returned": {
          "type": "integer"
        },
        "reviews": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "lang": {
                "type": "string"
              },
              "reply_date": {
                "type": "string"
              },
              "score": {
                "type": "integer"
              },
              "thumbs_up": {
                "type": "integer"
              },
              "truncated": {
                "type": "boolean"
              },
              "untrusted_reply_text": {
                "type": "string"
              },
              "untrusted_text": {
                "type": "string"
              },
              "untrusted_user_name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "score",
