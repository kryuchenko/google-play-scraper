[
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": "Availability by country"
    },
    "description": "Check in which of the given countries an app can be installed. region_locked: the listing exists but cannot be installed there; not_listed: the store has no listing there. One store request per country, so pass only the countries you need (at most 50). Says nothing about countries not asked for.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "description": "package id",
          "maxLength": 512,
          "type": "string"
        },
        "countries": {
          "description": "two-letter country codes to check, e.g. [\"us\",\"de\",\"br\"]",
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "app_id",
        "countries"
      ],
      "type": "object"
    },
    "name": "play_check_availability",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "type": "string"
        },
        "available": {
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "checked": {
          "type": "integer"
        },
        "errors": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "not_listed": {
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "note": {
          "type": "string"
        },
        "region_locked": {
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        }
      },
      "required": [
        "app_id",
        "available",
        "region_locked",
        "not_listed",
        "checked"
      ],
      "type": "object"
    },
    "title": "Availability by country"
  },
