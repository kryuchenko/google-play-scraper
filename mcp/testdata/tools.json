          "maxLength": 16,
          "type": "string"
        },
        "num": {
          "description": "apps to return, 1 to 200; default 50. The store stops at about 200",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
